# Tracht Digital Solutions — static Astro build, served by Apache on the production host.
#
# The domain has Phusion Passenger enabled. Without this file Passenger
# intercepts sub-path requests such as /preise and answers with its
# generic "something went wrong" error instead of letting Apache serve
# the built dist/preise/index.html. (The homepage works only because /
# resolves straight to the root index.html.)
#
# Turning Passenger off makes Apache serve the static files directly.
<IfModule mod_passenger.c>
  PassengerEnabled off
</IfModule>

# Clean URLs: a request for /preise should serve dist/preise/index.html.
DirectoryIndex index.html

# Serve the contact vCard as text/vcard so mobile clients offer "add contact"
# (the prerendered /kontakt.vcf carries no MIME of its own — Apache decides it).
<IfModule mod_mime.c>
  AddType text/vcard .vcf
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # When the request maps to an existing directory that has an
  # index.html, serve it internally — no visible trailing-slash redirect.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ %{REQUEST_URI}/index.html [L]
</IfModule>
