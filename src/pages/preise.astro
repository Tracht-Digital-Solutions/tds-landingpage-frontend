---
/**
 * `/preise` answers with a 301 to the pricing SECTION of the home page.
 *
 * The prices have lived in three places: on this URL, then in a drawer on the
 * home page, and since the 2026-09 redesign in an ordinary section (`#preise`)
 * that shows every rate without a click. The address stays alive because it was
 * indexed, sits in old footers and bookmarks — a 404 would throw that away.
 *
 * The target is the section's own anchor, so a visitor from an old link lands
 * on the prices rather than at the top of a long page. The section also keeps
 * an alias anchor under the old id `pricing-teaser` for links that still carry
 * it.
 *
 * Same treatment as a withdrawn service (`pages/leistungen/[slug].astro`) and
 * as `/kontakt`.
 */
export const prerender = false;

return Astro.redirect("/#preise", 301);
---
