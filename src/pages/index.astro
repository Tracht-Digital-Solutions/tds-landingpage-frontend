---
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import Hero from "~/components/islands/Hero.tsx";
import About from "~/components/sections/About.astro";
import Services from "~/components/sections/Services.astro";
import WebsiteDemos from "~/components/sections/WebsiteDemos.astro";
import PricingTeaser from "~/components/sections/PricingTeaser.astro";
import Process from "~/components/sections/Process.astro";
import Journal from "~/components/sections/Journal.astro";
import Consulting from "~/components/sections/Consulting.astro";
import FAQ from "~/components/sections/FAQ.astro";
import Contact from "~/components/sections/Contact.astro";
import {
  asGraph,
  faqPageSchema,
  howToSchema,
  organizationSchema,
  personSchema,
  speakableSchema,
  websiteSchema,
} from "~/lib/jsonld";
import { siteConfig } from "~/lib/seo";
import { resolveLang, tFor } from "~/lib/i18n";
import { getFaqContent } from "~/lib/faq";
import { cmsFor } from "~/lib/cms";
import { getHomeContent } from "~/lib/homeContent";

const lang = resolveLang(Astro.currentLocale);

// Hero copy is editable over the API; the island gets the resolved block.
const hero = await cmsFor("home_hero", lang, getHomeContent(lang).hero);

// Home gets the canonical entity graph — Organization, Person (founder),
// and WebSite all live here. Subpages reference them by @id rather than
// redefining them.
//
// FAQPage + HowTo + WebPage(speakable) enrich the same graph so the
// rich-snippet eligibility lands without a second <script> block.
const t = tFor(Astro.currentLocale);
// Resolve the FAQ block here too so the FAQPage JSON-LD stays 1:1 with the
// (possibly admin-edited) answers FAQ.astro renders. cms.ts memoises the
// fetch, so this shares FAQ.astro's request.
const faq = await cmsFor("faq_v2", lang, getFaqContent(lang));
const process = await cmsFor("process", lang, {
  headline: t.process.headline,
  headlineAccent: t.process.headlineAccent,
  steps: t.process.steps,
});
const jsonLd = asGraph(
  organizationSchema(),
  personSchema(),
  websiteSchema(),
  faqPageSchema(faq.items),
  howToSchema(`${process.headline} ${process.headlineAccent}`, process.steps),
  {
    "@type": "WebPage",
    "@id": `${siteConfig.url}/#webpage-${lang}`,
    url: lang === "de" ? siteConfig.url : `${siteConfig.url}/en`,
    inLanguage: lang === "de" ? "de-DE" : "en-GB",
    isPartOf: { "@id": `${siteConfig.url}/#website` },
    primaryImageOfPage: `${siteConfig.url}/og/default.png`,
    speakable: speakableSchema([
      "#hero-heading",
      "[aria-labelledby='digital-responsibility-heading']",
    ]),
  },
);

// Keyword-first (primary Germany-wide keyword leads, brand follows, ≤60 chars).
// The local qualifier lives in the description, schema geo/NAP and footer.
const titles = {
  de: "Digitalisierung für Unternehmen — Tracht Digital Solutions",
  en: "Digitalization for Businesses — Tracht Digital Solutions",
};
---

<Layout
  title={titles[lang]}
  description={siteConfig.description[lang]}
  lang={lang}
  jsonLd={jsonLd}
>
  <Header />
  <main id="main">
    <Hero client:load lang={lang} hero={hero} />
    <About />
    <Services />
    <WebsiteDemos />
    <Consulting />
    <Process />
    <PricingTeaser />
    <Journal />
    <FAQ />
    <Contact />
  </main>
  <Footer />
</Layout>
