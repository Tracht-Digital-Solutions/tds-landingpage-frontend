---
import Layout from "~/layouts/Layout.astro";
import { translations } from "@tracht-digital-solutions/tds-shared/i18n";

const t = translations.de;
---

<Layout title="Tracht Digital Solutions — Persönliche digitale Lösungen">
  <main id="main" class="min-h-screen">
    <!--
      PORT TARGET (TODO Phase 5):

      Each section under this comment is a placeholder for the
      corresponding component in tds-lp/app/components/sections/.
      Port them in this order:

        1. Hero        (tds-lp/app/components/sections/Hero.tsx)
        2. About       (... About.tsx)
        3. Services    (... Services.tsx)
        4. PricingTeaser
        5. TechMarquee
        6. Portfolio
        7. Process
        8. Journal     (build-time fetch from tds-content-api)
        9. Contact     (form posts to tds-contact-api)

      Static markup → .astro files in src/components/sections/
      Interactive (ContactForm, SmoothScroll, SectionSnap) → React
      islands in src/components/islands/ with client:load or client:visible.

      i18n strings come from @tracht-digital-solutions/tds-shared/i18n
      (already imported above as `t`). Brand tokens come from the
      Tailwind preset at @tracht-digital-solutions/tds-shared/brand/
      tailwind-preset (wired up in tailwind.config.ts).
    -->
    <section class="min-h-screen flex items-center justify-center px-6 py-24">
      <div class="max-w-3xl text-center">
        <p class="text-xs uppercase tracking-[0.08em] text-[var(--color-muted)] mb-4">
          {t.hero.availability}
        </p>
        <h1 class="font-[var(--font-display)] text-5xl md:text-7xl leading-[0.95] tracking-tight mb-8">
          {t.hero.headline}{" "}
          <span class="text-[var(--color-accent)]">{t.hero.headlineAccent}</span>{" "}
          {t.hero.headlineSuffix}
        </h1>
        <p class="text-lg text-[var(--color-muted)] leading-relaxed max-w-xl mx-auto mb-10">
          {t.hero.sub}
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="#contact" class="inline-block px-8 py-4 bg-[var(--color-primary)] text-white text-sm font-semibold hover:bg-[var(--color-accent)] transition-colors">
            {t.hero.cta1}
          </a>
          <a href="#services" class="inline-block px-8 py-4 border border-[var(--color-line)] text-sm font-semibold hover:bg-[var(--color-soft)] transition-colors">
            {t.hero.cta2}
          </a>
        </div>
      </div>
    </section>

    <p class="max-w-3xl mx-auto px-6 py-12 text-center text-sm text-[var(--color-muted)]">
      Phase 5 in progress — sections to be ported from tds-lp.
    </p>
  </main>
</Layout>
