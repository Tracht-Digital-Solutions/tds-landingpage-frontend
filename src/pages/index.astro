---
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import Hero from "~/components/islands/Hero.tsx";
import About from "~/components/sections/About.astro";
import Services from "~/components/sections/Services.astro";
import PricingTeaser from "~/components/sections/PricingTeaser.astro";
import TechMarquee from "~/components/sections/TechMarquee.astro";
import Portfolio from "~/components/sections/Portfolio.astro";
import Process from "~/components/sections/Process.astro";
import Currently from "~/components/sections/Currently.astro";
import Journal from "~/components/sections/Journal.astro";
import Consulting from "~/components/sections/Consulting.astro";
import FAQ from "~/components/sections/FAQ.astro";
import Contact from "~/components/sections/Contact.astro";
import {
  asGraph,
  faqPageSchema,
  howToSchema,
  organizationSchema,
  personSchema,
  speakableSchema,
  websiteSchema,
} from "~/lib/jsonld";
import { siteConfig } from "~/lib/seo";
import { resolveLang, tFor } from "~/lib/i18n";
import { fetchTopics, topicHref, topicFallback } from "~/lib/content";
import { getFaqContent } from "~/lib/faq";

const lang = resolveLang(Astro.currentLocale);

// The Hero pill always surfaces the current most important topic.
// Prefer the live top post from tds-content-api; fall back to the
// same hand-written list the Currently section uses (first entry =
// most important) so the pill never degrades to a static blurb and
// stays in sync with the Currently section.
const heroTopics = await fetchTopics(lang, 1);
const topTopic = heroTopics[0] ?? topicFallback(lang)[0];
const featuredTopic = {
  slug: topTopic.slug,
  title: topTopic.title,
  category: topTopic.category,
  href: topicHref(topTopic.slug),
};

// Home gets the canonical entity graph — Organization, Person (founder),
// and WebSite all live here. Subpages reference them by @id rather than
// redefining them.
//
// FAQPage + HowTo + WebPage(speakable) enrich the same graph so the
// rich-snippet eligibility lands without a second <script> block.
const t = tFor(Astro.currentLocale);
const faq = getFaqContent(lang);
const jsonLd = asGraph(
  organizationSchema(),
  personSchema(),
  websiteSchema(),
  faqPageSchema(faq.items),
  howToSchema(`${t.process.headline} ${t.process.headlineAccent}`, t.process.steps),
  {
    "@type": "WebPage",
    "@id": `${siteConfig.url}/#webpage-${lang}`,
    url: lang === "de" ? siteConfig.url : `${siteConfig.url}/en`,
    inLanguage: lang === "de" ? "de-DE" : "en-GB",
    isPartOf: { "@id": `${siteConfig.url}/#website` },
    primaryImageOfPage: `${siteConfig.url}/og/default.png`,
    speakable: speakableSchema([
      "#hero-heading",
      "[aria-labelledby='currently-heading']",
    ]),
  },
);

const titles = {
  de: "Tracht Digital Solutions — Persönliche digitale Lösungen für den Mittelstand",
  en: "Tracht Digital Solutions — Personally crafted digital solutions for the mid-market",
};
---

<Layout
  title={titles[lang]}
  description={siteConfig.description[lang]}
  lang={lang}
  jsonLd={jsonLd}
>
  <Header />
  <main id="main">
    {/* Narrative arc: hook → who → what → capability → proof → method →
        cost → thinking → convert. PricingTeaser moved after Process
        because pricing reads better once the visitor knows how the work
        actually happens. */}
    <Hero client:load lang={lang} featuredTopic={featuredTopic} />
    <About />
    <Services />
    <TechMarquee />
    <Portfolio />
    <Process />
    <Currently />
    <PricingTeaser />
    <Journal />
    <Consulting />
    <FAQ />
    <Contact />
  </main>
  <Footer />
</Layout>
