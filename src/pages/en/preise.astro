---
import Layout from "~/layouts/Layout.astro";
import Footer from "~/components/Footer.astro";
import AccentLetters from "~/components/ui/AccentLetters.astro";
import { breadcrumbSchema, pricingSchema } from "~/lib/jsonld";
import { siteConfig } from "~/lib/seo";
import { tFor, resolveLang, localizePath } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";

const lang = resolveLang(Astro.currentLocale);
const t = tFor(Astro.currentLocale);
const pricing = await cmsFor("pricing", lang, t.pricing);
const homeHref = localizePath("/", lang);

const formatRate = (rate: number) =>
  new Intl.NumberFormat(lang === "de" ? "de-DE" : "en-IE", {
    style: "currency",
    currency: "EUR",
    maximumFractionDigits: 0,
  }).format(rate);

// Both stay under the ~160 characters Google renders, and both carry the
// local signal — a pricing page is a high-intent landing page for
// "Digitalisierung Kosten" style queries, so the town belongs inside the cut.
const pageDescriptions = {
  de: "Transparente Stundensätze für Digitalisierung, Web- und App-Entwicklung, Wartung und Schulungen — klar kalkulierbar, zzgl. MwSt. Aus Schwarzenbek.",
  en: "Transparent hourly rates for digitalization, web and app development, maintenance and training — clearly calculated, excl. VAT. From Schwarzenbek.",
};

const pricingPath = localizePath("/preise", lang);

const jsonLd = [
  pricingSchema(
    pricing.items.map((item) => ({
      name: item.title,
      description: item.description,
      rate: item.rate,
    })),
  ),
  breadcrumbSchema([
    { name: lang === "de" ? "Home" : "Home", url: `${siteConfig.url}${homeHref}` },
    { name: pricing.label.replace(/^—\s*/, ""), url: `${siteConfig.url}${pricingPath}` },
  ]),
];
---

<Layout
  title={`${pricing.label.replace(/^—\s*/, "")} — Tracht Digital Solutions`}
  description={pageDescriptions[lang]}
  lang={lang}
  jsonLd={jsonLd}
>
  <main id="main" class="min-h-screen bg-[var(--color-paper)] relative overflow-hidden">
    <div
      aria-hidden="true"
      class="absolute top-0 left-0 right-0 h-[480px] pointer-events-none opacity-70"
      style="background: radial-gradient(ellipse 80% 60% at 70% 0%, rgba(255,122,156,0.12), transparent 70%), radial-gradient(ellipse 60% 50% at 20% 0%, rgba(5,15,104,0.10), transparent 70%);"
    ></div>

    <div class="page-flyin relative max-w-6xl mx-auto px-6 md:px-8 py-16 md:py-24">
      <div class="flex items-center justify-between mb-12">
        <a
          href={homeHref}
          class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors inline-flex items-center gap-2 group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-0.5 transition-transform"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          {pricing.back}
        </a>
      </div>

      <h1
        class="text-5xl md:text-6xl lg:text-7xl font-[var(--font-display)] font-medium leading-tight tracking-tight text-[var(--color-black)] mb-6 max-w-4xl"
        style='font-variation-settings: "opsz" 144;'
      >
        {pricing.headline}{" "}
        <AccentLetters text={pricing.headlineAccent} />
      </h1>

      <p class="text-lg text-[var(--color-muted)] max-w-2xl mb-16 leading-relaxed">
        {pricing.sub}
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 mb-16">
        {pricing.items.map((item) => {
          const isHighlight = item.highlight;
          return (
            <div
              class:list={[
                "relative rounded-[6px] p-7 flex flex-col",
                isHighlight
                  ? "bg-[var(--color-surface-navy)] text-white shadow-[0_20px_50px_rgba(5,15,104,0.18)]"
                  : "bg-[var(--color-soft)]",
              ]}
            >
              {isHighlight && (
                <span
                  aria-hidden="true"
                  class="absolute -top-px left-6 right-6 h-px bg-[var(--color-accent)]"
                ></span>
              )}

              <h2
                class:list={[
                  "font-[var(--font-display)] font-medium text-xl mb-3",
                  isHighlight ? "text-white" : "text-[var(--color-black)]",
                ]}
              >
                {item.title}
              </h2>

              <div class="flex items-baseline gap-2 mb-5">
                <span
                  class:list={[
                    "font-[var(--font-display)] text-4xl font-medium tabular-nums",
                    isHighlight ? "text-white" : "text-[var(--color-primary)]",
                  ]}
                  style='font-variation-settings: "opsz" 144;'
                >
                  {formatRate(item.rate)}
                </span>
                <span
                  class:list={[
                    "text-sm",
                    isHighlight ? "text-white/70" : "text-[var(--color-muted)]",
                  ]}
                >
                  {pricing.hourSuffix}
                </span>
              </div>

              <p
                class:list={[
                  "text-sm leading-relaxed mb-6",
                  isHighlight ? "text-white/80" : "text-[var(--color-muted)]",
                ]}
              >
                {item.description}
              </p>

              <div class="pt-8 mt-auto">
                <p
                  class:list={[
                    "text-xs font-medium tracking-wider uppercase mb-3",
                    isHighlight ? "text-white/60" : "text-[var(--color-muted)]",
                  ]}
                >
                  {pricing.includesLabel}
                </p>
                <ul class="space-y-2">
                  {item.includes.map((inc) => (
                    <li
                      class:list={[
                        "text-sm leading-snug flex gap-2",
                        isHighlight ? "text-white/90" : "text-[var(--color-black)]",
                      ]}
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class:list={[
                          "mt-0.5 shrink-0",
                          isHighlight ? "text-[var(--color-accent-pink)]" : "text-[var(--color-accent)]",
                        ]}
                        aria-hidden="true"
                      >
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span>{inc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        })}
      </div>

      <section
        class="rounded-[6px] p-8 mb-16 bg-[var(--color-soft)]"
        aria-labelledby="pricing-notes-heading"
      >
        <h2
          id="pricing-notes-heading"
          class="font-[var(--font-display)] italic text-base text-[var(--color-muted)] mb-4"
        >
          {pricing.notesTitle}
        </h2>
        <ul class="grid sm:grid-cols-2 gap-3">
          {pricing.notes.map((note) => (
            <li class="text-sm text-[var(--color-black)] leading-snug flex gap-2">
              <span class="text-[var(--color-accent)] select-none" aria-hidden="true">·</span>
              {note}
            </li>
          ))}
        </ul>
      </section>

      {/* Navy focus surface, matching the two callouts on the homepage: a
          flat brand navy cut by one quarter-circle rather than the 135deg
          navy→bordeaux gradient this carried until 2026-08-16. That gradient
          was replaced everywhere else in the "Digitale Maßarbeit" pass and
          this page was simply missed, so /preise ended with the one panel on
          the site that still looked like a stock hero card. */}
      <section class="tds-tone-navy relative overflow-hidden rounded-[6px] p-10 md:p-14 text-center">
        <span
          aria-hidden="true"
          class="tds-shape tds-shape--quarter-bl tds-shape--coral"
          style="top: -4rem; right: -4rem; width: 20rem; height: 20rem; --tds-decor-shape-alpha: 0.2;"></span>
        {/* Positioned, so it paints above the absolute shape above it — a
            static sibling would sit UNDER it. */}
        <div class="relative">
        <h2
          class="font-[var(--font-display)] font-medium text-3xl md:text-4xl mb-4"
          style='font-variation-settings: "opsz" 144;'
        >
          {pricing.ctaTitle}
        </h2>
        <p class="text-white/80 max-w-xl mx-auto mb-8 leading-relaxed">
          {pricing.ctaSub}
        </p>
        <a
          href={`${homeHref === "/" ? "" : homeHref.replace(/\/$/, "")}/#contact`}
          class="inline-flex items-center gap-2 bg-white text-[var(--color-surface-navy)] px-7 py-3.5 rounded-[100px] text-sm font-medium hover:bg-white/85 transition-colors group"
        >
          {pricing.ctaButton}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-0.5 transition-transform"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* Entrance: the pricing content flies in from the left on load.
     The parent <main> is overflow-hidden, so the off-screen start
     never produces a horizontal scrollbar. */
  @keyframes page-flyin {
    from {
      opacity: 0;
      transform: translateX(-3rem);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .page-flyin {
    animation: page-flyin 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-flyin {
      animation: none;
    }
  }
</style>
