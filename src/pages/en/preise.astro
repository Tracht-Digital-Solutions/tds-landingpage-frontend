---
/**
 * The English twin of `pages/preise.astro` — see there for why this is a 301.
 *
 * The path keeps its German spelling because that is the URL that was
 * published and indexed. The target is `/en/` WITH its trailing slash: the
 * redirect used to point at `/en#…`, a second spelling of the English home page
 * next to the canonical `/en/`.
 */
export const prerender = false;

return Astro.redirect("/en/#preise", 301);
---
