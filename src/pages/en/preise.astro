---
/**
 * Retired with its German twin — see `pages/preise.astro` for why this is a
 * 301 and not a deletion.
 *
 * The path keeps its German spelling because that is the URL that was
 * published and indexed; `localizePath("/preise", "en")` produced `/en/preise`
 * rather than `/en/pricing`, and renaming a retired URL on the way out helps
 * nobody.
 */
export const prerender = false;

return Astro.redirect("/en#pricing-teaser", 301);
---
