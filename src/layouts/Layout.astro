---
import "~/styles/global.css";
import SmoothScroll from "~/components/islands/SmoothScroll.tsx";
import ScrollProgress from "~/components/islands/ScrollProgress.tsx";
import JsonLd from "~/components/JsonLd.astro";
import { siteConfig } from "~/lib/seo";

interface Props {
  title: string;
  description?: string;
  lang?: "de" | "en";
  /** Canonical URL — defaults to the current page's URL on `astro.config.site`. */
  canonical?: string;
  /** Absolute URL or site-relative path. Used for og:image + twitter:image. */
  ogImage?: string;
  /** Set `noindex` to keep the page out of search (legal pages, drafts). */
  noindex?: boolean;
  /** Optional structured data — object, array of objects, or @graph wrapper. */
  jsonLd?: object | object[];
}

const {
  title,
  description = siteConfig.description.de,
  lang = "de",
  canonical,
  ogImage = siteConfig.defaultOgImage,
  noindex = false,
  jsonLd,
} = Astro.props;

const site = Astro.site?.origin ?? siteConfig.url;
const url = canonical ?? new URL(Astro.url.pathname, site).toString();
const ogImageAbs = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, site).toString();
const ogLocale = lang === "de" ? "de_DE" : "en_GB";
const altOgLocale = lang === "de" ? "en_GB" : "de_DE";

// Compute hreflang alternates. The neutral path is the URL without
// the /en prefix; the EN alternate is /en + the neutral path. Skip
// alternates entirely when the page opts out of search via
// `noindex` (legal pages are DE-only by regulation, no EN sibling).
const neutralPath = Astro.url.pathname.replace(/^\/en\/?/, "/") || "/";
const deAltUrl = new URL(neutralPath, site).toString();
const enAltUrl = new URL(
  neutralPath === "/" ? "/en/" : `/en${neutralPath}`,
  site,
).toString();
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050f68" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />

    <!-- Resource hints — connect to the API origins we know we'll
         hit (the contact form on submit, the content API on every
         page that has a Currently / Journal section). `preconnect`
         opens the TLS handshake early; `dns-prefetch` is the cheap
         fallback for browsers that ignore preconnect on a different
         origin. -->
    <link rel="preconnect" href="https://api.tracht-digital.de" crossorigin />
    <link rel="dns-prefetch" href="https://api.tracht-digital.de" />
    <link rel="preconnect" href="https://blog.tracht-digital.de" crossorigin />
    <link rel="dns-prefetch" href="https://blog.tracht-digital.de" />

    <!-- i18n alternates — only emitted when the page is indexable.
         Legal pages opt out of both search and hreflang. -->
    {!noindex && (
      <>
        <link rel="alternate" hreflang="de" href={deAltUrl} />
        <link rel="alternate" hreflang="en" href={enAltUrl} />
        <link rel="alternate" hreflang="x-default" href={deAltUrl} />
      </>
    )}

    <!-- Cross-property: sibling blog at blog.tracht-digital.de -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === "en" ? "Tracht Digital — Journal" : "Tracht Digital — Journal (Feed)"}
      href={`${siteConfig.blogUrl}/rss.xml`}
    />
    <link rel="me" href={siteConfig.blogUrl} />

    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />
    {!noindex && <meta property="og:locale:alternate" content={altOgLocale} />}
    <meta property="og:site_name" content={siteConfig.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    {jsonLd && <JsonLd data={jsonLd} />}

    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="absolute -top-full left-0 z-50 px-6 py-3 bg-[var(--color-primary)] text-white text-sm font-semibold focus:top-0 transition-all"
    >
      Skip to content
    </a>
    <SmoothScroll client:load />
    <ScrollProgress client:load />
    <slot />
  </body>
</html>
