---
import "~/styles/global.css";
import SmoothScroll from "~/components/islands/SmoothScroll.tsx";
import ScrollProgress from "~/components/islands/ScrollProgress.tsx";
import FloatingCta from "~/components/FloatingCta.astro";
import BackToTop from "~/components/BackToTop.astro";
import JsonLd from "~/components/JsonLd.astro";
import { siteConfig } from "~/lib/seo";

interface Props {
  title: string;
  description?: string;
  lang?: "de" | "en";
  /** Canonical URL — defaults to the current page's URL on `astro.config.site`. */
  canonical?: string;
  /** Absolute URL or site-relative path. Used for og:image + twitter:image. */
  ogImage?: string;
  /** Set `noindex` to keep the page out of search (legal pages, drafts). */
  noindex?: boolean;
  /** Optional structured data — object, array of objects, or @graph wrapper. */
  jsonLd?: object | object[];
}

const {
  title,
  description = siteConfig.description.de,
  lang = "de",
  canonical,
  ogImage = siteConfig.defaultOgImage,
  noindex = false,
  jsonLd,
} = Astro.props;

const site = Astro.site?.origin ?? siteConfig.url;
const url = canonical ?? new URL(Astro.url.pathname, site).toString();
const ogImageAbs = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, site).toString();
const ogLocale = lang === "de" ? "de_DE" : "en_GB";
const altOgLocale = lang === "de" ? "en_GB" : "de_DE";

// Compute hreflang alternates. The neutral path is the URL without
// the /en prefix; the EN alternate is /en + the neutral path. Skip
// alternates entirely when the page opts out of search via
// `noindex` (legal pages are DE-only by regulation, no EN sibling).
const neutralPath = Astro.url.pathname.replace(/^\/en\/?/, "/") || "/";
const deAltUrl = new URL(neutralPath, site).toString();
const enAltUrl = new URL(
  neutralPath === "/" ? "/en/" : `/en${neutralPath}`,
  site,
).toString();
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050f68" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0a07" media="(prefers-color-scheme: dark)" />

    {/* No-flash theme bootstrap — runs synchronously in <head>
        before the body parses so the correct `data-theme` is on
        <html> by the time CSS resolves. localStorage win over OS
        preference; if neither, follow the OS. */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("tds-theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.setAttribute("data-theme", saved);
            return;
          }
        } catch (e) { /* storage disabled — fall through to OS */ }
        var dark = window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
      })();
    </script>
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="icon" type="image/png" href="/favicon.png" sizes="any" />
    <link rel="canonical" href={url} />

    <!-- Resource hints — connect to the API origins we know we'll
         hit (the contact form on submit, the content API on every
         page that has a Currently / Journal section). `preconnect`
         opens the TLS handshake early; `dns-prefetch` is the cheap
         fallback for browsers that ignore preconnect on a different
         origin. -->
    <link rel="preconnect" href="https://api.tracht-digital.de" crossorigin />
    <link rel="dns-prefetch" href="https://api.tracht-digital.de" />
    <link rel="preconnect" href="https://blog.tracht-digital.de" crossorigin />
    <link rel="dns-prefetch" href="https://blog.tracht-digital.de" />

    <!-- i18n alternates — only emitted when the page is indexable.
         Legal pages opt out of both search and hreflang. -->
    {!noindex && (
      <>
        <link rel="alternate" hreflang="de" href={deAltUrl} />
        <link rel="alternate" hreflang="en" href={enAltUrl} />
        <link rel="alternate" hreflang="x-default" href={deAltUrl} />
      </>
    )}

    <!-- Cross-property: sibling blog at blog.tracht-digital.de -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === "en" ? "Tracht Digital — Journal" : "Tracht Digital — Journal (Feed)"}
      href={`${siteConfig.blogUrl}/rss.xml`}
    />
    <link rel="me" href={siteConfig.blogUrl} />

    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />
    {!noindex && <meta property="og:locale:alternate" content={altOgLocale} />}
    <meta property="og:site_name" content={siteConfig.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    {jsonLd && <JsonLd data={jsonLd} />}

    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="absolute -top-full left-0 z-50 px-6 py-3 bg-[var(--color-surface-navy)] text-white text-sm font-semibold focus:top-0 transition-all"
    >
      Skip to content
    </a>
    <SmoothScroll client:load />
    <ScrollProgress client:load />
    <slot />
    <FloatingCta />
    <BackToTop />

    {/* Dynamic document.title — observes every <section id="…"> on
        the page and prefixes the tab title with the section name as
        the user scrolls past it. Hero keeps the canonical page
        title. Pages with no multi-section layout (legal pages,
        /preise) naturally no-op because there's at most one section.

        Labels come from a hand-curated id→title map so the tab
        text reads consistently — no "— 02 / X" leftover prefixes,
        no "Tech Stack" / "FAQ" / "Über mich" word-count mismatch.
        Falls back through eyebrow text → aria-label → id for any
        future section id that doesn't have a map entry yet. */}
    <script>
      const ORIGINAL_TITLE = document.title;
      const BRAND = ORIGINAL_TITLE.includes(" — ")
        ? ORIGINAL_TITLE.split(" — ")[0]
        : ORIGINAL_TITLE;

      const lang = document.documentElement.lang.startsWith("en")
        ? "en"
        : "de";

      const TITLES: Record<"de" | "en", Record<string, string>> = {
        de: {
          about: "Über mich",
          services: "Leistungen",
          tech: "Tech-Stack",
          portfolio: "Portfolio",
          process: "Vorgehen",
          currently: "Aktuelle Themen",
          "pricing-teaser": "Preise",
          blog: "Journal",
          consulting: "Beratung",
          faq: "Häufige Fragen",
          contact: "Kontakt",
        },
        en: {
          about: "About",
          services: "Services",
          tech: "Tech stack",
          portfolio: "Portfolio",
          process: "Process",
          currently: "Current topics",
          "pricing-teaser": "Pricing",
          blog: "Journal",
          consulting: "Consulting",
          faq: "FAQ",
          contact: "Contact",
        },
      };
      const map = TITLES[lang];

      const sections = document.querySelectorAll<HTMLElement>("section[id]");
      if (sections.length > 1) {
        const labelFor = (el: HTMLElement): string => {
          if (el.dataset.title) return el.dataset.title;
          if (map[el.id]) return map[el.id];
          // Defensive fallback if a new section id appears that's
          // not yet mapped — keeps the title from going blank.
          const eyebrow = el.querySelector(".section-num, .eyebrow");
          if (eyebrow?.textContent) {
            return eyebrow.textContent
              .replace(/^[—–-]\s*(\d+\s*\/\s*)?/, "")
              .trim();
          }
          return el.getAttribute("aria-label") || el.id;
        };

        let active: string | null = null;
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const target = entry.target as HTMLElement;
              if (target.id === active) continue;
              active = target.id;
              if (target.id === "hero") {
                document.title = ORIGINAL_TITLE;
              } else {
                document.title = `${labelFor(target)} · ${BRAND}`;
              }
            }
          },
          // rootMargin pulls the intersection band to ~30% from the top
          // of the viewport. A section "becomes active" as it crosses
          // that band on the way down — feels natural under scroll.
          { rootMargin: "-30% 0px -60% 0px", threshold: 0 },
        );
        sections.forEach((s) => observer.observe(s));
      }
    </script>
  </body>
</html>
