---
// Font faces must be imported here (not via @import in global.css):
// @tailwindcss/postcss inlines CSS @imports without rebasing their
// relative url(./files/*.woff2) refs, so Vite never emits the fonts.
import "@fontsource/lato/400.css";
import "@fontsource/lato/700.css";
// Lato 900 is NOT imported. It was, and no rule in this site or in
// tds-shared's stylesheets ever selected it — 22.5 KB woff2 plus a 17.2 KB
// legacy woff and a 5.6 KB latin-ext, downloaded for a weight nothing asked
// for. Re-add it only together with the rule that uses it.
//
// Body + mono, matching --font-body / --font-mono in tds-shared's base.css.
// This site used to load Geist and nothing at all for mono (Geist Mono was
// never installed, so `font-mono` silently fell back to a system face).
//
// JetBrains Mono stays although it is 40 KB for seven micro-labels: it is a
// brand invariant (AGENTS.md names the three faces), and it is measurably
// NOT in the LCP path — it starts at 654 ms against an LCP of 628 ms,
// because nothing above the fold uses it. Its cyrillic, greek and vietnamese
// subsets cost nothing on the wire; `unicode-range` means a German or
// English page never requests them.
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/jetbrains-mono";
// The one font file the LCP element needs, imported for its hashed URL so it
// can be preloaded below. `?url` gives the emitted asset path rather than
// inlining the file. Lato is not variable, and the H1 asks for weight 500 —
// the font-matching algorithm resolves that to the 400 face, which is why
// this is the file to preload and not the 700.
import latoLcpFont from "@fontsource/lato/files/lato-latin-400-normal.woff2?url";
import "~/styles/global.css";
import SmoothScroll from "~/components/islands/SmoothScroll.tsx";
import ScrollProgress from "~/components/islands/ScrollProgress.tsx";
import CustomCursor from "~/components/islands/CustomCursor.tsx";
import FloatingCta from "~/components/FloatingCta.astro";
import PropertyTabs from "~/components/PropertyTabs.astro";
import JsonLd from "~/components/JsonLd.astro";
import { LiveChatCta } from "@tracht-digital-solutions/tds-shared/components";
import { ConsentBanner } from "@tracht-digital-solutions/tds-shared/consent";
import { themeBootstrapScript } from "@tracht-digital-solutions/tds-shared/astro";
import { PAGE_ENTER_SCRIPT } from "~/lib/motion/constants";
import { A11Y_BOOT_SCRIPT } from "~/lib/a11yPrefs";
import { siteConfig } from "~/lib/seo";
import { isExcluded } from "~/lib/sitemap";
import { tFor } from "~/lib/i18n";

interface Props {
  title: string;
  description?: string;
  lang?: "de" | "en";
  /** Canonical URL — defaults to the current page's URL on `astro.config.site`. */
  canonical?: string;
  /** Explicit locale siblings for routes whose slugs differ by language. */
  alternates?: { de: string; en: string };
  /** Absolute URL or site-relative path. Used for og:image + twitter:image. */
  ogImage?: string;
  /** Set `noindex` to keep the page out of search (legal pages, drafts). */
  noindex?: boolean;
  /** Optional structured data — object, array of objects, or @graph wrapper. */
  jsonLd?: object | object[];
  /** Render only the slot — no floating CTA / scroll chrome. Error pages. */
  bare?: boolean;
}

const {
  title,
  description = siteConfig.description.de,
  lang = "de",
  canonical,
  alternates,
  ogImage = siteConfig.defaultOgImage,
  noindex = false,
  jsonLd,
  bare = false,
} = Astro.props;

const site = Astro.site?.origin ?? siteConfig.url;
const url = canonical ?? new URL(Astro.url.pathname, site).toString();
const ogImageAbs = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, site).toString();
const ogLocale = lang === "de" ? "de_DE" : "en_GB";
const altOgLocale = lang === "de" ? "en_GB" : "de_DE";

// A page the panel excluded from the sitemap is also served `noindex`, and
// loses its alternates with it. Both halves are required and neither is
// sufficient: a sitemap omission is a hint a crawler may ignore, while
// `noindex` beside an alternate tells it to follow a link it is simultaneously
// told to disregard. `noindex` (the prop) stays the local override for pages
// that are never public — the legal texts, `/install`, the error pages.
const hidden = noindex || (await isExcluded(Astro.url.pathname));

// Compute hreflang alternates. The neutral path is the URL without
// the /en prefix; the EN alternate is /en + the neutral path. Skip
// alternates entirely when the page opts out of search via
// `noindex` (legal pages are DE-only by regulation, no EN sibling).
const neutralPath = Astro.url.pathname.replace(/^\/en\/?/, "/") || "/";
const absoluteUrl = (value: string) =>
  value.startsWith("http") ? value : new URL(value, site).toString();
const deAltUrl = alternates
  ? absoluteUrl(alternates.de)
  : new URL(neutralPath, site).toString();
const enAltUrl = alternates
  ? absoluteUrl(alternates.en)
  : new URL(neutralPath === "/" ? "/en/" : `/en${neutralPath}`, site).toString();

/**
 * The privacy notice, on every page that is not `bare`.
 *
 * It used to hang off `cookieBannerEnabled()` — a `cookie_banner` CMS block,
 * baked at build time and **off when absent, in demo mode, or with the API
 * down**. Three ways for the disclosure of what this site stores to be missing
 * for reasons that have nothing to do with what it stores, and the default of
 * the three was "missing".
 *
 * That gate is gone. Whether a visitor is told what is kept on their device is
 * not a content decision, and it is not one an unreachable API should make. The
 * same reasoning removed the equivalent gate on the journal and the tools site.
 *
 * No `categories`: this site sets nothing optional — no analytics, no
 * advertising, no embeds — so the banner states that fact and offers one
 * acknowledgement rather than soliciting a consent nobody needs. The day
 * something optional ships, adding it here turns the same component into a real
 * gate.
 */
const showCookieNotice = !bare;
---

<!DOCTYPE html>
<!-- data-surface selects the geometry layer from tds-shared's design
     library (surfaces/marketing.css): round pills, 6px lifted cards, the
     700 display voice. Do not author radii locally. -->
<html lang={lang} data-surface="marketing">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* The page transition's hand-over, first in <head>: after an internal
        click it marks <html> so the incoming <main> starts at its entrance
        state before the body paints (lib/motion/pageTransition.ts). A first
        visit never carries the flag, so the LCP never sees it. */}
    {/* The visitor's accessibility settings (lib/a11yPrefs.ts), first of
        all: text size and contrast must be right in the first paint, and the
        page-enter flag below reads the motion switch. */}
    <script is:inline set:html={A11Y_BOOT_SCRIPT} />
    <script is:inline set:html={PAGE_ENTER_SCRIPT} />
    {/* The LCP element's font, fetched as early as the parser can see it.
        Without this it is discovered only when the inlined CSS is parsed —
        measured live, the two Lato faces did not finish until 520 ms against
        an LCP of 628 ms, so the headline's glyphs were on the critical path
        with nothing telling the browser to start them sooner.

        `crossorigin` is REQUIRED even though the file is same-origin: fonts
        are always fetched in CORS mode, and a preload without it is a second,
        separate request that warms nothing — the classic way this tag makes a
        page slower instead of faster. */}
    <link rel="preload" href={latoLcpFont} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050f68" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0a07" media="(prefers-color-scheme: dark)" />

    {/* No-flash theme bootstrap — shared with the blog and the frontend host
        (tds-shared/astro). Must stay `is:inline` and stay in <head>: it has to
        run synchronously, before the body parses, so the right `data-theme` is
        on <html> by the time CSS resolves. `set:html` (not a template body —
        that would leak literal braces into dist/). */}
    <script is:inline set:html={themeBootstrapScript} />
    {hidden && <meta name="robots" content="noindex,nofollow" />}

    <link rel="icon" type="image/png" href="/favicon.png" sizes="any" />
    <link rel="canonical" href={url} />

    <!-- Resource hints — connect to the API origins we know we'll
         hit (the contact form on submit, the content API on every
         page that has a Journal section). `preconnect`
         opens the TLS handshake early; `dns-prefetch` is the cheap
         fallback for browsers that ignore preconnect on a different
         origin. -->
    <link rel="preconnect" href="https://api.tracht-digital.de" crossorigin />
    <link rel="dns-prefetch" href="https://api.tracht-digital.de" />
    <link rel="preconnect" href="https://blog.tracht-digital.de" crossorigin />
    <link rel="dns-prefetch" href="https://blog.tracht-digital.de" />

    <!-- i18n alternates — only emitted when the page is indexable.
         Legal pages opt out of both search and hreflang. -->
    {!hidden && (
      <>
        <link rel="alternate" hreflang="de" href={deAltUrl} />
        <link rel="alternate" hreflang="en" href={enAltUrl} />
        <link rel="alternate" hreflang="x-default" href={deAltUrl} />
      </>
    )}

    <!-- Cross-property: sibling blog at blog.tracht-digital.de -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === "en" ? "Tracht Digital — Journal" : "Tracht Digital — Journal (Feed)"}
      href={`${siteConfig.blogUrl}/rss.xml`}
    />
    <link rel="me" href={siteConfig.blogUrl} />

    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />
    {!hidden && <meta property="og:locale:alternate" content={altOgLocale} />}
    <meta property="og:site_name" content={siteConfig.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    {jsonLd && <JsonLd data={jsonLd} />}

    <slot name="head" />
  </head>
  <body>
    {/* The page's ONE ground.

        The sections used to alternate paper and sand and each washed section
        painted its own `.tds-wash` fields, so the ground restarted at every
        section edge: six colour events down the home page, each with its own
        1px seam, and three separate copies of the same three radial fields
        beginning again at a boundary the reader can see.

        This is the replacement: one layer, `position: fixed`, so it is
        anchored to the VIEWPORT rather than stretched over the document.
        That distinction is the whole point — `primitives.css` warns that
        putting `.tds-wash` on the body flattens it into one dull tint,
        which is what happens when three small radial fields are asked to
        cover ten thousand pixels of scroll. Fixed, they stay the size they
        were drawn at and the page moves over them.

        A section that wants a different colour simply paints over it
        (`.tds-tone-navy` on the contact block). Nothing has to be
        maintained per section for that to hold. */}
    <div class="page-ground" aria-hidden="true"></div>
    {/* In the page's language: it said "Skip to content" on every German page.
        z-50 lifts it over the fixed header (z-40) when it takes focus. */}
    <a
      href="#main"
      class="absolute -top-full left-3 z-50 rounded-full px-6 py-3 bg-[var(--color-surface-navy)] text-white text-sm font-semibold focus:top-3 transition-all"
    >
      {tFor(lang).a11y.skipToContent}
    </a>
    {/* Non-critical chrome — deferred to idle so it never competes with the
        first paint. SmoothScroll as well: until it hydrates, an anchor jump is
        the browser's own smooth scroll, and `client:load` put its chunk (Lenis
        and React) among the requests a phone waited on before the headline. */}
    {!bare && <SmoothScroll client:idle />}
    {!bare && <ScrollProgress client:idle />}
    {!bare && <CustomCursor client:idle />}
    <slot />
    {!bare && <FloatingCta />}
    {!bare && <PropertyTabs />}
    {showCookieNotice && (
      <ConsentBanner
        client:idle
        lang={lang}
        privacyUrl="/legal/datenschutz"
        imprintUrl="/legal/impressum"
      />
    )}
    {/* Floating support widget — self-hides unless the live-chat-cta extension
        enables the "landingpage" frontend in the admin.
        No apiBase prop on purpose: the widget then resolves through tds-shared's
        apiFetch, which honours the host's tds-runtime.json — so
        /install/ can re-point it (or route it through the same-origin
        proxy) without a rebuild. A hard-coded origin would silently opt the
        widget out of that. */}
    {!bare && (
      <LiveChatCta client:idle frontend="landingpage" lang={lang} />
    )}

    {/* Scroll reveal for every `[data-reveal]` element on the page. NOT
        `is:inline` — an inline script is not bundled, so the import below
        would reach the browser as a bare specifier. The visual state lives
        in styles/global.css; this only decides when each element arrives. */}
    <script>
      import { mountReveal } from "~/lib/reveal";

      mountReveal();
    </script>

    {/* The Motion layer: CTA, photos, page transitions, business card, nav
        indicator. It loads its runtime with `import()` at idle (at once only
        after an internal navigation) and nothing under reduced motion —
        see lib/motion/boot.ts. */}
    <script>
      import { bootMotion } from "~/lib/motion/boot";

      bootMotion();
    </script>

    {/* Dynamic document.title — observes every <section id="…"> on
        the page and prefixes the tab title with the section name as
        the user scrolls past it. Hero keeps the canonical page
        title. Pages with no multi-section layout (legal pages,
        /preise) naturally no-op because there's at most one section.

        Labels come from a hand-curated id→title map so the tab
        text reads consistently — no "— 02 / X" leftover prefixes,
        no "Tech Stack" / "FAQ" / "Über mich" word-count mismatch.
        Falls back through eyebrow text → aria-label → id for any
        future section id that doesn't have a map entry yet. */}
    <script>
      const ORIGINAL_TITLE = document.title;
      const BRAND = ORIGINAL_TITLE.includes(" — ")
        ? ORIGINAL_TITLE.split(" — ")[0]
        : ORIGINAL_TITLE;

      const lang = document.documentElement.lang.startsWith("en")
        ? "en"
        : "de";

      const TITLES: Record<"de" | "en", Record<string, string>> = {
        de: {
          about: "Wieso ich?",
          services: "Leistungen",
          cases: "Kundenprojekte",
          process: "Vorgehen",
          showcase: "Beispielseiten",
          blog: "Journal",
          preise: "Preise",
          faq: "Häufige Fragen",
          contact: "Kontakt",
        },
        en: {
          about: "Why me?",
          services: "Services",
          cases: "Client projects",
          process: "Process",
          showcase: "Example sites",
          blog: "Journal",
          preise: "Pricing",
          faq: "FAQ",
          contact: "Contact",
        },
      };
      const map = TITLES[lang];

      const sections = document.querySelectorAll<HTMLElement>("section[id]");
      if (sections.length > 1) {
        const labelFor = (el: HTMLElement): string => {
          if (el.dataset.title) return el.dataset.title;
          if (map[el.id]) return map[el.id];
          // Defensive fallback if a new section id appears that's not yet
          // mapped — keeps the title from going blank. It reads the
          // heading each section already names itself by, NOT an eyebrow:
          // the numbered chapter marks this used to read are gone, and
          // the `.eyebrow` class that remains marks FIELD labels, so that
          // query would have titled the Contact section "E-Mail".
          const headingId = el.getAttribute("aria-labelledby");
          const heading = headingId ? document.getElementById(headingId) : null;
          if (heading?.textContent) return heading.textContent.trim();
          return el.getAttribute("aria-label") || el.id;
        };

        let active: string | null = null;
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const target = entry.target as HTMLElement;
              if (target.id === active) continue;
              active = target.id;
              if (target.id === "hero") {
                document.title = ORIGINAL_TITLE;
              } else {
                document.title = `${labelFor(target)} · ${BRAND}`;
              }
            }
          },
          // rootMargin pulls the intersection band to ~30% from the top
          // of the viewport. A section "becomes active" as it crosses
          // that band on the way down — feels natural under scroll.
          { rootMargin: "-30% 0px -60% 0px", threshold: 0 },
        );
        sections.forEach((s) => observer.observe(s));
      }
    </script>
  </body>
</html>
