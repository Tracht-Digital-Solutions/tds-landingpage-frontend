---
import { resolveLang } from "~/lib/i18n";

/**
 * "Back to top" button — a glass circle pinned to the bottom-left
 * corner (mirroring FloatingCta on the right). Hidden until the user
 * scrolls roughly one viewport down, then fades in. Uses the Lenis
 * instance (exposed on `window.lenis` by SmoothScroll) so the scroll
 * matches the site's smooth feel; falls back to native scroll on touch
 * devices where Lenis isn't mounted. A glass/card style keeps it legible
 * over both light and the dark navy sections without needing the
 * navy-on-navy inversion FloatingCta does.
 */
const lang = resolveLang(Astro.currentLocale);
const label = lang === "en" ? "Back to top" : "Nach oben";
---

<button
  id="back-to-top"
  type="button"
  class="back-to-top"
  aria-label={label}
  data-visible="false"
>
  <svg
    aria-hidden="true"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="back-to-top__icon"
  >
    <line x1="12" y1="19" x2="12" y2="5" />
    <polyline points="5 12 12 5 19 12" />
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 35;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    color: var(--color-primary);
    background-color: color-mix(in srgb, var(--color-card) 80%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 14%, var(--color-line));
    box-shadow: 0 10px 26px -12px rgba(5, 15, 104, 0.4);
    cursor: pointer;
    /* Only the unprefixed property is authored — lightningcss adds the
       -webkit- prefix at build time per the configured cssTarget. */
    backdrop-filter: blur(12px);
    /* Hidden state — faded out, nudged down, and click-through. */
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
    transition:
      opacity 240ms ease,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
      color 200ms ease,
      border-color 200ms ease;
  }

  .back-to-top[data-visible="true"] {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .back-to-top:hover {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 30%, var(--color-line));
    transform: translateY(-3px) scale(1);
  }
  .back-to-top:active {
    transform: translateY(-1px) scale(0.97);
  }
  .back-to-top:hover .back-to-top__icon {
    transform: translateY(-2px);
  }
  .back-to-top__icon {
    transition: transform 220ms ease;
  }

  @media (min-width: 768px) {
    .back-to-top {
      left: 1.5rem;
      bottom: 1.5rem;
      width: 3rem;
      height: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: opacity 200ms ease;
    }
    .back-to-top[data-visible="true"],
    .back-to-top:hover {
      transform: none;
    }
  }
</style>

<script>
  type LenisLike = {
    scrollTo: (target: number, options?: { immediate?: boolean }) => void;
  };

  const btn = document.getElementById("back-to-top");

  if (btn) {
    let frame = 0;
    const update = () => {
      frame = 0;
      // Show once the user has scrolled roughly one screen down.
      btn.dataset.visible =
        window.scrollY > window.innerHeight * 0.8 ? "true" : "false";
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);

    btn.addEventListener("click", () => {
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const lenis = (window as unknown as { lenis?: LenisLike }).lenis;
      if (lenis) {
        lenis.scrollTo(0, { immediate: reduce });
      } else {
        window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      }
    });
  }
</script>
