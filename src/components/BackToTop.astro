---
import { resolveLang } from "~/lib/i18n";

/**
 * "Back to top" button — a glass circle pinned just above the
 * "Gespräch vereinbaren" CTA (shared bottom-right corner). Hidden until
 * the user scrolls roughly one viewport down, then surfaces with a fluid
 * "drop" animation, as if a droplet rose out of the CTA. Uses the Lenis
 * instance (exposed on `window.lenis` by SmoothScroll) so the scroll
 * matches the site's smooth feel; falls back to native scroll on touch
 * devices where Lenis isn't mounted. A glass/card style keeps it legible
 * over both light and the dark navy sections without needing the
 * navy-on-navy inversion FloatingCta does.
 */
const lang = resolveLang(Astro.currentLocale);
const label = lang === "en" ? "Back to top" : "Nach oben";
---

<button
  id="back-to-top"
  type="button"
  class="back-to-top"
  aria-label={label}
  data-visible="false"
>
  <svg
    aria-hidden="true"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="back-to-top__icon"
  >
    <line x1="12" y1="19" x2="12" y2="5" />
    <polyline points="5 12 12 5 19 12" />
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    /* Pinned just above the "Gespräch vereinbaren" CTA so it reads as a
       droplet surfacing from that button (shared bottom-right corner). */
    right: 1rem;
    bottom: 4.75rem;
    z-index: 35;
    transform-origin: bottom center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    color: var(--color-primary);
    background-color: color-mix(in srgb, var(--color-card) 80%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 14%, var(--color-line));
    box-shadow: 0 10px 26px -12px rgba(5, 15, 104, 0.4);
    cursor: pointer;
    /* Only the unprefixed property is authored — lightningcss adds the
       -webkit- prefix at build time per the configured cssTarget. */
    backdrop-filter: blur(12px);
    /* Hidden state — collapsed down toward the CTA and click-through;
       the drop animation below grows it up into place. */
    opacity: 0;
    transform: translateY(2.4rem) scaleX(0.86) scaleY(0.5);
    pointer-events: none;
    transition:
      opacity 240ms ease,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
      color 200ms ease,
      border-color 200ms ease;
  }

  .back-to-top[data-visible="true"] {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    animation: back-to-top-drop 560ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Fluid "drop" entrance — surfaces from the CTA, overshoots upward with
     a stretch, then squashes and settles. Origin is pinned to the bottom
     (set above) so the stretch/squash reads as a droplet forming. No
     fill-mode, so the resting + :hover transforms take over once done. */
  @keyframes back-to-top-drop {
    0% {
      opacity: 0;
      transform: translateY(2.4rem) scaleX(0.86) scaleY(0.5);
    }
    50% {
      opacity: 1;
    }
    62% {
      transform: translateY(-0.4rem) scaleX(0.94) scaleY(1.12);
    }
    80% {
      transform: translateY(0.12rem) scaleX(1.04) scaleY(0.94);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scaleX(1) scaleY(1);
    }
  }

  .back-to-top:hover {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 30%, var(--color-line));
    transform: translateY(-3px) scale(1);
  }
  .back-to-top:active {
    transform: translateY(-1px) scale(0.97);
  }
  .back-to-top:hover .back-to-top__icon {
    transform: translateY(-2px);
  }
  .back-to-top__icon {
    transition: transform 220ms ease;
  }

  @media (min-width: 768px) {
    .back-to-top {
      right: 1.5rem;
      bottom: 5.5rem;
      width: 3rem;
      height: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: opacity 200ms ease;
      transform: none;
    }
    .back-to-top[data-visible="true"] {
      animation: none;
      transform: none;
    }
    .back-to-top:hover {
      transform: none;
    }
  }
</style>

<script>
  type LenisLike = {
    scrollTo: (target: number, options?: { immediate?: boolean }) => void;
  };

  const btn = document.getElementById("back-to-top");

  if (btn) {
    let frame = 0;
    const update = () => {
      frame = 0;
      // Show once the user has scrolled roughly one screen down.
      btn.dataset.visible =
        window.scrollY > window.innerHeight * 0.8 ? "true" : "false";
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);

    btn.addEventListener("click", () => {
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const lenis = (window as unknown as { lenis?: LenisLike }).lenis;
      if (lenis) {
        lenis.scrollTo(0, { immediate: reduce });
      } else {
        window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      }
    });
  }
</script>
