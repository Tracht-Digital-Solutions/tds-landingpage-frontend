---
/**
 * The price list itself: one card per service, the notes, the closing CTA.
 *
 * It has been a page, a drawer on the home page, and since the 2026-09
 * redesign it is part of the home page's pricing section
 * (`sections/Pricing.astro`). It is a component so there is ONE definition of
 * what a price card says — the rates, the included keywords and the "Gut zu
 * wissen" notes were the kind of thing that gets copied for a second surface
 * and then updated on one of them.
 *
 * Renders no `<main>`, no header and no footer: it is a fragment, placed by
 * whoever shows it.
 *
 * ### Heading levels are a prop, not a guess
 *
 * The titles sit under whatever heading the caller placed above the list —
 * `<h2>` on a page of its own, `<h3>` inside the home page's pricing section. A
 * component that hardcoded one level would skip or repeat a level depending on
 * where it was dropped, which nobody sees and a screen reader announces.
 *
 * ### The facts box
 *
 * The notes box is also where the caller explains how a price comes about:
 * pass `factsTitle` and put the explanation in the default slot, and it renders
 * above the notes, in the same box. The home section first came out as two
 * boxes, one under the other, that both said "Festpreis".
 */
import { localizePath, type Lang } from "~/lib/i18n";
import { getPricingContent, getServiceRate } from "~/lib/pricing";
import {
  resolveServiceContent,
  serviceDefinitions,
  serviceHref,
} from "~/lib/services";

interface Props {
  lang: Lang;
  /** The level for a card's title. The caller knows what sits above it. */
  headingLevel?: 2 | 3;
  /** Title of the notes box when the default slot adds an explanation to it. */
  factsTitle?: string;
}

const { lang, headingLevel = 2, factsTitle } = Astro.props;
// One level under the "Stundensätze" heading the cards now sit beneath.
const CardHeading = `h${headingLevel + 1}` as "h3" | "h4";
const SectionHeading = `h${headingLevel}` as "h2" | "h3";
const hasFacts = Astro.slots.has("default");

const pricing = await getPricingContent(lang);
const services = await Promise.all(
  serviceDefinitions.map(async (definition) => ({
    definition,
    content: await resolveServiceContent(definition, lang),
  })),
);

const formatRate = (rate: number) =>
  new Intl.NumberFormat(lang === "de" ? "de-DE" : "en-IE", {
    style: "currency",
    currency: "EUR",
    maximumFractionDigits: 0,
  }).format(rate);

const homeHref = localizePath("/", lang);
const contactHref = `${homeHref}#contact`;
const detailsLabel = lang === "de" ? "Leistung im Detail" : "Service details";
// Code-owned: the heading names what the block IS. The packages under it are
// the editable part.
const packagesTitle = lang === "de" ? "Festpreise" : "Fixed prices";
const ratesTitle = lang === "de" ? "Stundensätze" : "Hourly rates";
const netLabel = lang === "de" ? "netto" : "net";
---

<div class="pricing-list">
  {/* Fixed prices FIRST (2026-09-21): three packages with one figure each,
      then the hourly rates for everything else. The committed packages are
      hours × the Webauftritt rate (lib/pricing.ts); a panel list replaces
      them as a whole. The block still renders nothing for an empty list. */}
  {
    pricing.packages.length > 0 && (
      <section class="pricing-packages" aria-labelledby="pricing-packages-heading">
        <SectionHeading
          id="pricing-packages-heading"
          class="font-[var(--font-display)] text-2xl text-[var(--color-black)] mb-5"
        >
          {packagesTitle}
        </SectionHeading>
        <ul class="pricing-packages__grid" data-motion-cards>
          {pricing.packages.map((pkg) => (
            <li class="pricing-packages__card">
              <p class="pricing-packages__title">{pkg.title}</p>
              <p class="pricing-packages__price">
                <span class="tabular-nums">{formatRate(pkg.price)}</span>
                <span class="pricing-packages__net">{netLabel}</span>
              </p>
              {pkg.description && (
                <p class="pricing-packages__text">{pkg.description}</p>
              )}
              {pkg.includes.length > 0 && (
                <ul class="pricing-packages__includes">
                  {pkg.includes.map((entry) => (
                    <li>
                      <span aria-hidden="true" class="text-[var(--color-accent)]">
                        ✓
                      </span>
                      <span>{entry}</span>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <SectionHeading
    id="pricing-rates-heading"
    class="font-[var(--font-display)] text-2xl text-[var(--color-black)] mb-5"
  >
    {ratesTitle}
  </SectionHeading>
  <div class="pricing-list__grid" data-motion-cards>
    {
      services.map(({ definition, content }) => {
        const rate = getServiceRate(pricing, definition.id);
        return (
          <article class="relative rounded-[6px] p-6 md:p-7 flex flex-col bg-[var(--color-soft)]">
            {/* No number above the title — see the note in
                ServiceDetailPage.astro. The card's own edge separates it from
                its neighbours; a mono "03" only ever said which slot it
                happened to sit in. */}
            <CardHeading class="font-[var(--font-display)] text-2xl mb-3 text-[var(--color-black)]">
              {content.title}
            </CardHeading>

            <div class="flex items-baseline gap-2 mb-5 min-h-12">
              <span class="font-[var(--font-display)] font-medium tabular-nums text-4xl text-[var(--color-primary)]">
                {formatRate(rate)}
              </span>
              <span class="text-sm text-[var(--color-muted)]">{pricing.hourSuffix}</span>
            </div>

            {/* Neither the summary nor the keyword list is repeated here.
                `sections/Services.astro` sits one section above this one and
                already gives every service its situation, its outcome and the
                SAME keyword chips — this card was the second half of a
                duplicate, down to a second link to the same page under a
                different name. What a rate card owes the reader is the rate.
                The service's own words are one scroll up, and behind the
                link. */}
            <div class="mt-auto">
              <a
                href={serviceHref(definition, lang)}
                class="inline-flex items-center gap-2 text-sm font-medium transition-colors text-[var(--color-primary)] hover:text-[var(--color-accent)] [@media(pointer:coarse)]:min-h-11"
              >
                {detailsLabel}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        );
      })
    }
  </div>

  <section
    class="rounded-[6px] p-6 md:p-8 mb-10 bg-[var(--color-soft)]"
    aria-labelledby="pricing-notes-heading"
  >
    <SectionHeading
      id="pricing-notes-heading"
      class="font-[var(--font-display)] text-2xl text-[var(--color-black)] mb-5"
    >
      {factsTitle ?? pricing.notesTitle}
    </SectionHeading>
    <slot />
    <ul class:list={["grid sm:grid-cols-2 gap-x-8 gap-y-4", hasFacts && "pricing-list__notes--after"]}>
      {
        pricing.notes.map((note) => (
          <li class="text-sm text-[var(--color-black)] leading-relaxed flex gap-3">
            <span class="text-[var(--color-accent)]" aria-hidden="true">
              —
            </span>
            <span>{note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    class="tds-tone-navy relative overflow-hidden rounded-[6px] p-8 md:p-12 text-center"
    aria-labelledby="pricing-cta-heading"
  >
    <span
      aria-hidden="true"
      class="tds-shape tds-shape--quarter-bl tds-shape--coral"
      style="top: -4rem; right: -4rem; width: 20rem; height: 20rem; --tds-decor-shape-alpha: 0.2;"
    ></span>
    <div class="relative">
      <SectionHeading id="pricing-cta-heading" class="display text-3xl text-white mb-4">
        {pricing.ctaTitle}
      </SectionHeading>
      <p class="text-white/80 max-w-2xl mx-auto mb-8 leading-relaxed">{pricing.ctaSub}</p>
      <a
        href={contactHref}
        data-cta
        class="inline-flex items-center gap-2 bg-white text-[var(--color-surface-navy)] px-7 py-3.5 rounded-[100px] text-sm font-medium hover:bg-white/85 transition-colors group"
      >
        {pricing.ctaButton}
        <span aria-hidden="true" class="group-hover:translate-x-0.5 transition-transform">→</span>
      </a>
    </div>
  </section>
</div>

<style>
  /* A CONTAINER query, not a media query.
   *
   * The list has lived in a 34rem drawer and lives in a full-width section
   * now. A `@media (min-width: 60rem)` asks the VIEWPORT how much room there
   * is and got the answer for the window, not for the panel — two columns
   * opened inside a 544px drawer and each card had ~250px for a heading like
   * "Prozessoptimierung". The column count belongs to the box the list sits
   * in, wherever that is.
   *
   * The caller declares the containment (`.pricing-host` in
   * `sections/Pricing.astro`), because a container cannot query itself. */
  .pricing-list__grid {
    display: grid;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  @container pricing-list (min-width: 42rem) {
    .pricing-list__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* The full-width home section (`sections/Pricing.astro`) has room for all
     four side by side — the one arrangement in which every rate is visible at
     once, which is the point of showing prices at all. */
  @container pricing-list (min-width: 64rem) {
    .pricing-list__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* (`.pricing-list__includes` lived here. The rate cards stopped repeating
     the keyword list that `sections/Services.astro` already shows one section
     above them, so there is nothing left for it to style.) */

  /* === Fixed-price packages ========================================
     Their own band above the rate grid, so a fixed price is never mistaken
     for an hourly one. Auto-fit rather than a fixed column count: how many
     packages exist is editorial, and `auto-fit` with a floor keeps a lone
     package from being stretched into a poster — the same trap the demo
     shelf's grid caps for. */
  .pricing-packages {
    margin-bottom: 3rem;
  }
  .pricing-packages__net {
    margin-left: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .pricing-packages__grid {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @container pricing-list (min-width: 42rem) {
    .pricing-packages__grid {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    }
  }
  .pricing-packages__card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: 6px;
    /* Differs from the rate cards' `--color-soft` on purpose: two price
       families on one ground need two fills, or the eye reads eight cards of
       one kind. */
    background: var(--lp-surface-card);
  }
  .pricing-packages__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-black);
  }
  .pricing-packages__price {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 1.6rem + 1.2vw, 2.75rem);
    line-height: 1.1;
    color: var(--color-primary);
  }
  .pricing-packages__text {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
  .pricing-packages__includes {
    display: grid;
    gap: 0.5rem;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-black);
  }
  .pricing-packages__includes li {
    display: flex;
    gap: 0.5rem;
  }

  .pricing-list__notes--after {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
</style>
