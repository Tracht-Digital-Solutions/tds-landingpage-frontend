---
/**
 * The price list itself: one card per service, the notes, the closing CTA.
 *
 * Extracted out of `PricingPage.astro` when the list stopped being a page of
 * its own and became a drawer on the home page. It is a component so there is
 * ONE definition of what a price card says — the rates, the included keywords
 * and the "Gut zu wissen" notes were the kind of thing that gets copied for a
 * second surface and then updated on one of them.
 *
 * Renders no `<main>`, no header and no footer: it is a fragment, placed by
 * whoever shows it.
 *
 * ### Heading levels are a prop, not a guess
 *
 * On a page of its own the cards sat under an `<h1>` and were `<h2>`. In the
 * drawer they sit under the drawer's own title, which is itself inside a
 * document that already has an `<h1>`. A component that hardcoded `h2` would
 * produce a document outline with a level skipped or repeated depending on
 * where it was dropped, which is exactly the sort of thing nobody sees and a
 * screen reader announces.
 */
import { localizePath, type Lang } from "~/lib/i18n";
import { getPricingContent, getServiceRate } from "~/lib/pricing";
import {
  resolveServiceContent,
  serviceDefinitions,
  serviceHref,
} from "~/lib/services";

interface Props {
  lang: Lang;
  /** The level for a card's title. The caller knows what sits above it. */
  headingLevel?: 2 | 3;
}

const { lang, headingLevel = 2 } = Astro.props;
const CardHeading = `h${headingLevel}` as "h2" | "h3";
const SectionHeading = `h${headingLevel}` as "h2" | "h3";

const pricing = await getPricingContent(lang);
const services = await Promise.all(
  serviceDefinitions.map(async (definition) => ({
    definition,
    content: await resolveServiceContent(definition, lang),
  })),
);

const formatRate = (rate: number) =>
  new Intl.NumberFormat(lang === "de" ? "de-DE" : "en-IE", {
    style: "currency",
    currency: "EUR",
    maximumFractionDigits: 0,
  }).format(rate);

const homeHref = localizePath("/", lang);
const contactHref = `${homeHref}#contact`;
const detailsLabel = lang === "de" ? "Leistung im Detail" : "Service details";
---

<div class="pricing-list">
  <div class="pricing-list__grid">
    {
      services.map(({ definition, content }) => {
        const rate = getServiceRate(pricing, definition.id);
        return (
          <article class="relative rounded-[6px] p-6 md:p-7 flex flex-col bg-[var(--color-soft)]">
            {/* No number above the title — see the note in
                ServiceDetailPage.astro. The card's own edge separates it from
                its neighbours; a mono "03" only ever said which slot it
                happened to sit in. */}
            <CardHeading class="font-[var(--font-display)] text-2xl mb-3 text-[var(--color-black)]">
              {content.title}
            </CardHeading>

            <div class="flex items-baseline gap-2 mb-5 min-h-12">
              <span class="font-[var(--font-display)] font-medium tabular-nums text-4xl text-[var(--color-primary)]">
                {formatRate(rate)}
              </span>
              <span class="text-sm text-[var(--color-muted)]">{pricing.hourSuffix}</span>
            </div>

            <p class="text-sm leading-relaxed mb-7 text-[var(--color-muted)]">
              {content.summary}
            </p>

            <div class="mt-auto">
              <p class="text-xs font-medium tracking-wider uppercase mb-3 text-[var(--color-muted)]">
                {pricing.includesLabel}
              </p>
              {/* The code-owned keyword list, not the first four lines of "Was
                  ich übernehme". Cards side by side are scanned, not read, and
                  four full sentences per card turned this grid into a wall of
                  prose. The detail page behind each card is where the
                  sentences belong. */}
              <ul class="space-y-2 mb-7">
                {definition.keywords[lang].map((keyword) => (
                  <li class="text-sm leading-snug flex gap-2 text-[var(--color-black)]">
                    <span aria-hidden="true" class="text-[var(--color-accent)]">
                      ✓
                    </span>
                    <span>{keyword}</span>
                  </li>
                ))}
              </ul>
              <a
                href={serviceHref(definition, lang)}
                class="inline-flex items-center gap-2 text-sm font-medium transition-colors text-[var(--color-primary)] hover:text-[var(--color-accent)]"
              >
                {detailsLabel}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        );
      })
    }
  </div>

  <section
    class="rounded-[6px] p-6 md:p-8 mb-10 bg-[var(--color-soft)]"
    aria-labelledby="pricing-notes-heading"
  >
    <SectionHeading
      id="pricing-notes-heading"
      class="font-[var(--font-display)] text-2xl text-[var(--color-black)] mb-5"
    >
      {pricing.notesTitle}
    </SectionHeading>
    <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-4">
      {
        pricing.notes.map((note) => (
          <li class="text-sm text-[var(--color-black)] leading-relaxed flex gap-3">
            <span class="text-[var(--color-accent)]" aria-hidden="true">
              —
            </span>
            <span>{note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    class="tds-tone-navy relative overflow-hidden rounded-[6px] p-8 md:p-12 text-center"
    aria-labelledby="pricing-cta-heading"
  >
    <span
      aria-hidden="true"
      class="tds-shape tds-shape--quarter-bl tds-shape--coral"
      style="top: -4rem; right: -4rem; width: 20rem; height: 20rem; --tds-decor-shape-alpha: 0.2;"
    ></span>
    <div class="relative">
      <SectionHeading id="pricing-cta-heading" class="display text-3xl text-white mb-4">
        {pricing.ctaTitle}
      </SectionHeading>
      <p class="text-white/80 max-w-2xl mx-auto mb-8 leading-relaxed">{pricing.ctaSub}</p>
      <a
        href={contactHref}
        class="inline-flex items-center gap-2 bg-white text-[var(--color-surface-navy)] px-7 py-3.5 rounded-[100px] text-sm font-medium hover:bg-white/85 transition-colors group"
      >
        {pricing.ctaButton}
        <span aria-hidden="true" class="group-hover:translate-x-0.5 transition-transform">→</span>
      </a>
    </div>
  </section>
</div>

<style>
  /* A CONTAINER query, not a media query.
   *
   * This list lives in a drawer that is 34rem wide on a 90rem screen. A
   * `@media (min-width: 60rem)` asks the VIEWPORT how much room there is and
   * gets the answer for the window, not for the panel — so two columns opened
   * inside a 544px drawer and each card had ~250px for a heading like
   * "Prozessoptimierung". It is the mistake this repo has already paid for
   * once; see the note on container queries in the blog's layout.
   *
   * The parent (`.pricing-drawer__body`) declares the containment, because a
   * container cannot query itself. */
  .pricing-list__grid {
    display: grid;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  @container pricing-list (min-width: 42rem) {
    .pricing-list__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
