---
/**
 * Leistungsassistent — the service finder behind a button, in ONE native
 * `<dialog>` on the home page.
 *
 * ### Why a button and a dialog
 *
 * Decided 2026-09-15: the assistant is for visitors who do not know what they
 * need or what it costs — not a section everybody has to scroll past. It waits
 * behind a button in the services section and one in the pricing section
 * (`[data-assistant-open]`), and `/#leistungsassistent` (or the old
 * `/#leistungsfinder`) opens it directly.
 *
 * The dialog is the platform's, like `ui/PreviewLightbox.astro`: Escape, the
 * focus trap, the inert page behind it and the backdrop come for free. What is
 * written here is what the platform does not do — giving focus back to the
 * button that opened it, closing on a backdrop click, and closing WITHOUT
 * giving focus back when the visitor follows a link to a section of this page
 * (the hand-off to the contact form, "So entsteht dein Preis"): focusing the
 * opener there would scroll the page back up to it.
 *
 * ### Hydration
 *
 * `client:idle`, not `client:visible`. A closed dialog is never "visible", and
 * the server-rendered first question is a real `<form>`: a click on "Weiter"
 * before hydration would submit it natively and reload the page. Idle
 * hydration has finished long before anybody finds the button.
 *
 * The buttons ship `hidden` and are revealed by the script below once
 * `showModal` exists — a button that cannot open anything is never shown.
 *
 * The island renders its own markup, which carries no Astro scope — so every
 * `.finder` rule below is `:global`, anchored on the `.finder` root.
 */
import { localizePath, resolveLang } from "~/lib/i18n";
import { getPricingContent } from "~/lib/pricing";
import { platformDefinitions, platformHref } from "~/lib/platforms";
import { resolveServiceContent, serviceDefinitions, serviceHref } from "~/lib/services";
import { FINDER_SECTION } from "~/lib/serviceFinder";
import ServiceFinderIsland from "~/components/islands/ServiceFinder";

const lang = resolveLang(Astro.currentLocale);
const section = FINDER_SECTION[lang];
const pricing = await getPricingContent(lang);
const lowestPackage = pricing.packages.length > 0 ? Math.min(...pricing.packages.map((pkg) => pkg.price)) : undefined;
const services = await Promise.all(
  serviceDefinitions.map(async (definition) => {
    const content = await resolveServiceContent(definition, lang);
    return {
      id: definition.id,
      title: content.title,
      summary: content.summary,
      href: serviceHref(definition, lang),
      situations: content.situations.slice(0, 4),
      // Only the Webauftritt has packages; everything else is on request.
      ...(definition.id === "web-presence" && lowestPackage !== undefined ? { fromPrice: lowestPackage } : {}),
      ...(definition.id === "web-presence"
        ? {
            platforms: platformDefinitions.map((platform) => ({
              label: platform.name,
              href: platformHref(platform, lang),
            })),
          }
        : {}),
    };
  }),
);
const home = localizePath("/", lang);
const contactHref = `${home}#contact`;
const pricesHref = `${home}#preise`;
---

<dialog
  id="leistungsassistent"
  class="assistant"
  data-assistant-dialog
  data-lenis-prevent
  aria-labelledby="assistant-title"
>
  <div class="assistant__frame">
    <div class="assistant__head">
      {/* The compass: the assistant finds the way when the services alone do
          not say which one is yours. */}
      <span class="assistant__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9.5"></circle>
          <polygon points="15.5 8.5 13.4 13.4 8.5 15.5 10.6 10.6 15.5 8.5" fill="currentColor"></polygon>
        </svg>
      </span>
      <div>
        <h2 id="assistant-title" class="assistant__title">{section.title}</h2>
        <p class="assistant__intro">{section.intro}</p>
      </div>
      <button type="button" class="assistant__close" data-assistant-close>
        <span class="sr-only">{section.close}</span>
        <svg
          aria-hidden="true"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>
    <ServiceFinderIsland
      client:idle
      lang={lang}
      services={services}
      contactHref={contactHref}
      pricesHref={pricesHref}
    />
  </div>
</dialog>

<style>
  /* The triggers carry a display utility of their own, which beats the UA's
     `[hidden]` rule — so hidden has to be said again, unlayered. */
  :global([data-assistant-open][hidden]) {
    display: none;
  }

  .assistant {
    /* Centring, for the same reason as `ui/PreviewLightbox.astro`: Tailwind's
       preflight resets `margin: 0` on `*`, which beats the UA's
       `dialog { margin: auto }`. Without this the modal opens in the top left
       corner. */
    margin: auto;
    width: min(96vw, 56rem);
    max-width: none;
    max-height: 92vh;
    padding: 0;
    border: none;
    border-radius: 1.75rem;
    /* Over the navy backdrop a navy offset would vanish: black ink here. */
    --tds-shadow-ink: rgb(0 0 0 / 0.5);
    --tds-shadow-hard: 6px 6px 0 0 var(--tds-shadow-ink);
    box-shadow: 10px 10px 0 0 var(--tds-shadow-ink);
    background: var(--color-paper);
    color: var(--color-black);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .assistant::backdrop {
    /* ONE flat colour behind every modal (2026-09-21): the brand navy, dense
       enough that the page behind stops competing, in both themes. It fades
       in with the dialog and out while `lib/motion/dialog.ts` plays the exit. */
    background: var(--color-surface-navy);
    opacity: 0.9;
    transition: opacity 300ms var(--tds-ease-out);
  }
  .assistant[data-closing]::backdrop {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .assistant[open]::backdrop {
      animation: assistantBackdropIn 220ms var(--tds-ease-out);
    }
  }
  @keyframes assistantBackdropIn {
    from {
      opacity: 0;
    }
  }
  .assistant__frame {
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .assistant__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .assistant__icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    background: var(--color-accent-pink);
    color: var(--color-surface-navy);
    box-shadow: var(--tds-shadow-hard-sm);
  }
  .assistant__head > div {
    flex: 1;
    min-width: 0;
  }
  .assistant__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    line-height: 1.2;
    color: var(--color-black);
  }
  .assistant__intro {
    margin: 0.5rem 0 0;
    max-width: 40rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .assistant__close {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: none;
    border-radius: 100px;
    /* A bare cross, no chip behind it (2026-09-21). The hover answers with
       colour and a quarter turn instead of a fill. */
    background: none;
    color: var(--color-black);
    cursor: pointer;
    transition:
      color 200ms var(--tds-ease-out),
      transform 260ms var(--tds-ease-out);
  }
  .assistant__close:hover {
    color: var(--color-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .assistant__close:hover {
      transform: rotate(90deg);
    }
  }
  .assistant__close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* No panel of its own inside the dialog: the modal is ONE flat colour
     (2026-09-21), so the finder sits directly on it. Redesigned 2026-09-22:
     round answer cards with the site's hard shadow that lift under the
     pointer, a segmented progress, and result cards with a rank badge. */
  :global(.finder) {
    padding: 0;
    background: none;
  }
  :global(.finder__stage) {
    min-width: 0;
  }

  /* Progress: the words carry it; the segments only repeat it for the eye. */
  :global(.finder__progress) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 1.25rem;
    font: 500 0.75rem/1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  :global(.finder__segments) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.375rem;
    flex: 0 1 12rem;
  }
  :global(.finder__segment) {
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 14%, var(--color-paper));
  }
  :global(.finder__segment i) {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-accent);
    transform-origin: left center;
  }

  :global(.finder__fieldset) {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  /* Takes focus on a step change (tabIndex -1): a target for the screen
     reader and the scroll, not a keyboard stop, so no ring. */
  :global(.finder__question) {
    padding: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    line-height: 1.15;
    color: var(--color-black);
    outline: none;
    text-wrap: balance;
  }
  :global(.finder__help) {
    margin: 0.4rem 0 1.5rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  :global(.finder__options) {
    display: grid;
    gap: 0.875rem;
  }
  @media (min-width: 40rem) {
    :global(.finder__options) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  :global(.finder__option) {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    min-height: 3.25rem;
    padding: 1rem 1.125rem;
    border-radius: 1.25rem;
    background: var(--lp-surface-card);
    box-shadow: var(--tds-shadow-hard-sm);
    cursor: pointer;
    transition:
      background-color 150ms var(--tds-ease-out),
      color 150ms var(--tds-ease-out),
      translate 160ms var(--tds-ease-out);
  }
  @media (hover: hover) {
    :global(.finder__option:hover) {
      translate: -2px -2px;
      box-shadow: var(--tds-shadow-hard-sm-hover);
    }
  }
  :global(.finder__option:active) {
    translate: 1px 1px;
    box-shadow: var(--tds-shadow-hard-press);
  }
  :global(.finder__option:has(:checked)) {
    background: var(--color-surface-navy);
    color: #fff;
  }
  :global(.finder__option:has(:checked) .finder__option-label) {
    color: #fff;
  }
  :global(.finder__option:has(:checked) .finder__option-hint) {
    color: rgb(255 255 255 / 0.75);
  }
  /* The ring goes around the whole answer, the control itself draws none. */
  :global(.finder__option:has(:focus-visible)) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  /* The native input stays in the page — focusable, announced, operable with
     Space — but is drawn by `.finder__check` instead. */
  :global(.finder__input) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  :global(.finder__check) {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.05rem;
    border-radius: 0.5rem;
    background: var(--color-paper);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--color-primary) 35%, transparent);
    color: var(--color-surface-navy);
  }
  :global(.finder__option--radio .finder__check) {
    border-radius: 999px;
  }
  :global(.finder__option:has(:checked) .finder__check) {
    background: var(--color-accent-pink);
    box-shadow: none;
  }
  :global(.finder__option-body) {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }
  :global(.finder__option-label) {
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-black);
  }
  :global(.finder__option-hint) {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  :global(.finder__hint) {
    margin: 1rem 0 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--tds-eyebrow-color, var(--color-accent));
  }

  :global(.finder__nav),
  :global(.finder__actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
    margin-top: 1.75rem;
  }
  :global(.finder__nav) {
    justify-content: flex-end;
  }
  :global(.finder__cta) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0.75rem 1.5rem;
    border: 0;
    border-radius: var(--tds-radius-pill, 100px);
    background: var(--color-surface-navy);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: var(--tds-shadow-hard-sm);
    cursor: pointer;
    transition:
      background-color 200ms var(--tds-ease-out),
      translate 160ms var(--tds-ease-out);
  }
  :global(.finder__cta:is(:hover, :focus-visible)) {
    background: var(--color-surface-accent);
    translate: -2px -2px;
    box-shadow: var(--tds-shadow-hard-sm-hover);
  }
  :global(.finder__cta:active) {
    translate: 2px 2px;
    box-shadow: var(--tds-shadow-hard-press);
  }
  /* The hand-off to the contact form is the goal of the whole assistant. */
  :global(.finder__cta--contact) {
    background: var(--color-accent-pink);
    color: var(--color-surface-navy);
  }
  :global(.finder__cta--contact:is(:hover, :focus-visible)) {
    background: var(--color-surface-navy);
    color: #fff;
  }
  :global(.finder__cta:focus-visible),
  :global(.finder__secondary:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  :global(.finder__secondary) {
    min-height: 3rem;
    padding: 0.75rem 1.25rem;
    border: 0;
    border-radius: var(--tds-radius-pill, 100px);
    background: var(--lp-surface-card);
    color: var(--color-black);
    font-size: 0.9375rem;
    font-weight: 500;
    box-shadow: var(--tds-shadow-hard-press);
    cursor: pointer;
    transition: translate 160ms var(--tds-ease-out);
  }
  :global(.finder__secondary:hover) {
    translate: -1px -1px;
    box-shadow: var(--tds-shadow-hard-sm);
  }

  :global(.finder__result-title) {
    margin: 0 0 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    line-height: 1.2;
    color: var(--color-black);
    outline: none;
  }
  :global(.finder__matches) {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Side by side where there is room: a result is compared, not read top to
     bottom. */
  @media (min-width: 48rem) {
    :global(.finder__matches) {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }
  :global(.finder__match) {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: var(--lp-surface-card);
    box-shadow: var(--tds-shadow-hard);
  }
  /* The best fit is the one navy card. */
  :global(.finder__match[data-rank="best"]) {
    background: var(--color-surface-navy);
    color: #fff;
  }
  :global(.finder__match[data-rank="best"] :is(.finder__match-title, .finder__rate, .finder__why, .finder__why-label)) {
    color: #fff;
  }
  :global(.finder__match[data-rank="best"] .finder__summary) {
    color: rgb(255 255 255 / 0.78);
  }
  :global(.finder__match[data-rank="best"] :is(.finder__rate-value, .finder__detail, .finder__tick, .finder__rank)) {
    color: var(--color-accent-pink);
  }
  :global(.finder__rank) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tds-eyebrow-color, var(--color-accent));
  }
  :global(.finder__rank-badge) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: var(--color-accent-pink);
    color: var(--color-surface-navy);
    font: 700 0.8125rem/1 var(--font-display);
    letter-spacing: 0;
  }
  :global(.finder__match-title) {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.25;
    color: var(--color-black);
  }
  :global(.finder__summary) {
    max-width: 65ch;
    margin: 0 0 0.75rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
  :global(.finder__rate) {
    margin: 0 0 0.875rem;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-black);
  }
  :global(.finder__rate-label) {
    font-weight: 600;
  }
  :global(.finder__rate-value) {
    font-weight: 600;
    color: var(--color-primary);
  }
  :global(.finder__why-label) {
    margin: 0 0 0.35rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-black);
  }
  :global(.finder__why) {
    display: grid;
    gap: 0.3rem;
    max-width: 65ch;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-black);
  }
  :global(.finder__why li) {
    display: flex;
    gap: 0.5rem;
  }
  :global(.finder__tick) {
    flex: none;
    color: var(--color-accent);
  }
  :global(.finder__platforms) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
  }
  :global(.finder__platforms a) {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-paper));
    color: var(--color-accent);
    font-size: 0.8125rem;
    text-decoration: none;
  }
  :global(.finder__platforms a:hover) {
    background: color-mix(in srgb, var(--color-accent) 18%, var(--color-paper));
  }
  @media (pointer: coarse) {
    :global(.finder__platforms a) {
      min-height: 2.75rem;
    }
  }
  /* Pinned to the card's foot, so the links line up across cards of different length. */
  :global(.finder__detail) {
    align-self: flex-start;
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }
  :global(.finder__detail:hover) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  :global(.finder__note) {
    margin: 1.5rem 0 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  :global(.finder__price-link) {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  :global(.finder__handoff) {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.finder__option),
    :global(.finder__cta),
    :global(.finder__secondary),
    .assistant__close,
    .assistant__close:hover {
      transition: none;
      transform: none;
      translate: none !important;
    }
  }
</style>

<script>
  // NOT `is:inline` — an inline script is not bundled, so this import would
  // reach the browser as a bare specifier.
  import { CONTACT_DRAFT_EVENT } from "~/lib/contactDraft";
  import { animatedDialog } from "~/lib/motion/dialog";

  const dialog = document.querySelector<HTMLDialogElement>("[data-assistant-dialog]");
  /** Addresses that open the assistant: its own, and the old section anchor. */
  const HASHES = new Set(["#leistungsassistent", "#leistungsfinder"]);

  // No dialog support means no assistant. The buttons stay `hidden`, the state
  // they shipped in, so nothing has to be undone.
  if (dialog && typeof dialog.showModal === "function") {
    // Bounces in and out (lib/motion/dialog.ts); Escape goes the same way.
    const modal = animatedDialog(dialog);
    let opener: HTMLElement | null = null;
    let restoreFocus = true;
    /** Where a link inside the dialog moved the page — focus follows it on close. */
    let destination: HTMLElement | null = null;

    const open = (trigger: HTMLElement | null) => {
      if (dialog.open) return;
      opener = trigger;
      restoreFocus = true;
      destination = null;
      modal.open();
    };

    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-assistant-open]")) {
      button.addEventListener("click", () => open(button));
      // Revealed only now that there is something behind it.
      button.hidden = false;
    }

    dialog.querySelector<HTMLButtonElement>("[data-assistant-close]")?.addEventListener("click", () => {
      modal.close();
    });

    dialog.addEventListener("click", (event) => {
      // A click on the backdrop reports the dialog itself as its target.
      if (event.target === dialog) {
        modal.close();
        return;
      }
      // A link to a section of THIS page (the contact form, the prices):
      // close, and let the page scroll there instead of back to the opener.
      const link = (event.target as Element | null)?.closest?.("a[href]");
      if (link instanceof HTMLAnchorElement && link.hash && link.pathname === location.pathname) {
        restoreFocus = false;
        destination = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        modal.close();
      }
    });

    // The result's call to action hands its draft to the contact form first.
    window.addEventListener(CONTACT_DRAFT_EVENT, () => {
      if (!dialog.open) return;
      restoreFocus = false;
      destination = document.getElementById("contact");
      modal.close();
    });

    dialog.addEventListener("close", () => {
      // `close` fires after the click that caused it, so a link's jump has
      // already happened. The platform has meanwhile handed focus back to
      // whatever had it before `showModal` — also after a link moved the page
      // on, which left a keyboard user on the services button while looking at
      // the contact form. Focus follows the page instead, without scrolling.
      if (restoreFocus) {
        opener?.focus();
      } else if (destination) {
        if (!destination.hasAttribute("tabindex")) {
          destination.setAttribute("tabindex", "-1");
          // A section is a destination, not a control: no ring around a block.
          destination.style.outline = "none";
        }
        destination.focus({ preventScroll: true });
      }
      opener = null;
      destination = null;
      if (HASHES.has(location.hash)) {
        history.replaceState(null, "", `${location.pathname}${location.search}`);
      }
    });

    const openFromHash = () => {
      if (HASHES.has(location.hash)) open(null);
    };
    openFromHash();
    window.addEventListener("hashchange", openFromHash);
  }
</script>
