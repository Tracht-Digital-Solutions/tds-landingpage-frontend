---
import { tFor, resolveLang, localizePath } from "~/lib/i18n";

const lang = resolveLang(Astro.currentLocale);
const t = tFor(Astro.currentLocale);
const pricingHref = localizePath("/preise", lang);
---

<footer class="bg-[var(--color-black)] text-white pt-16 pb-10">
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <div class="grid md:grid-cols-3 gap-12 mb-12">
      <div>
        <p class="brand-wordmark text-2xl mb-4">
          Tracht <span class="italic text-[var(--color-accent-pink)]">Digital</span> Solutions
        </p>
        <p class="text-white/60 text-sm leading-relaxed max-w-xs">
          {t.footer.tagline}
        </p>
      </div>

      <div>
        <p class="eyebrow text-white/50 mb-4">
          {t.footer.nav}
        </p>
        <ul class="space-y-2 text-sm">
          <li><a href="#about" class="text-white/70 hover:text-white">{t.nav.about}</a></li>
          <li><a href="#services" class="text-white/70 hover:text-white">{t.nav.services}</a></li>
          <li><a href="#portfolio" class="text-white/70 hover:text-white">{t.nav.portfolio}</a></li>
          <li><a href={pricingHref} class="text-white/70 hover:text-white">{t.footer.pricing}</a></li>
          <li><a href="https://blog.tracht-digital.de" class="text-white/70 hover:text-white">{t.nav.blog}</a></li>
        </ul>
      </div>

      <div>
        <p class="eyebrow text-white/50 mb-4">
          {t.footer.contactTitle}
        </p>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={`mailto:${t.contact.info.email}`} class="text-white/70 hover:text-white">
              {t.contact.info.email}
            </a>
          </li>
          <li class="text-white/50">{t.contact.info.location}</li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-white/40">
      <p>{t.footer.copyright}</p>
      <div class="flex flex-wrap gap-6">
        <a href="/legal/impressum" class="hover:text-white">{t.footer.impressum}</a>
        <a href="/legal/datenschutz" class="hover:text-white">{t.footer.datenschutz}</a>
        <a
          href="/legal/agb.pdf"
          download
          class="inline-flex items-center gap-1 hover:text-white"
        >
          AGB
          <span aria-hidden="true" class="text-[10px]">↓</span>
        </a>
      </div>
    </div>
  </div>
</footer>
