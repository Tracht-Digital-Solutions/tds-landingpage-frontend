---
import { ConsentLink } from "@tracht-digital-solutions/tds-shared/consent";

import { tFor, resolveLang, localizePath } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
import { legalCopy } from "~/lib/legal";
import { sectionLinks } from "~/lib/navigation";
import { platformDefinitions, platformHref } from "~/lib/platforms";
import { siteConfig } from "~/lib/seo";
import { socialLinks } from "~/lib/socials";
import SocialLinks from "~/components/ui/SocialLinks.astro";
import PlaceMap from "~/components/ui/PlaceMap.astro";

const lang = resolveLang(Astro.currentLocale);
const t = tFor(Astro.currentLocale);

// Editable footer strings + contact info (shared with the Contact section's
// block) — both override the tds-shared defaults at build time.
const footer = await cmsFor("footer", lang, t.footer);
const contact = await cmsFor("contact", lang, {
  label: t.contact.label,
  headline: t.contact.headline,
  headlineAccent: t.contact.headlineAccent,
  sub: t.contact.sub,
  email: t.contact.info.email,
  phone: t.contact.info.phone,
  location: t.contact.info.location,
});

// The AGB link goes to the PAGE, not straight to the PDF — the page carries
// the inline viewer and the download button, and works on a phone where an
// embedded PDF does not.
const agbHref = localizePath("/legal/agb", lang);
// Section links resolve against the homepage so they work from subpages,
// where these sections don't exist.
const homeHref = localizePath("/", lang);
// Strip spaces for the dialer href; keep the spaced version for display.
const telHref = `tel:${contact.phone.replace(/\s+/g, "")}`;

// The same sections the header lists (`lib/navigation.ts`), plus Kontakt —
// the footer is where a reader who scrolled past the form looks for it. The
// pricing label stays the editable `footer.pricing`.
const navItems = [
  ...sectionLinks(lang).map((item) => ({
    href: `${homeHref}#${item.id}`,
    label: item.id === "preise" ? footer.pricing : item.label,
  })),
  { href: `${homeHref}#contact`, label: lang === "de" ? "Kontakt" : "Contact" },
];

// The shop system and CMS pages, from every page of the site: the one place a
// crawler — and a reader who scrolled to the end — reaches all of them at once.
const systemsTitle = lang === "de" ? "Shopsysteme & CMS" : "Shop systems & CMS";
const placeCaption =
  lang === "de"
    ? "Schwarzenbek bei Hamburg · Kreis Herzogtum Lauenburg"
    : "Schwarzenbek near Hamburg · District of Herzogtum Lauenburg";
---

{/* Fast Schwarz / sehr dunkles Navy, with the page tokens re-mapped by
    `.tds-tone-ink` so the hairlines inside read as low-opacity white
    rather than as the light ground's warm line.

    CONTRAST, measured rather than judged: the legal row used to be
    `text-white/40` at 12px, which is 3.77:1 on this ground — below the 4.5:1
    AA needs for small text, and flagged by axe on every page. It is `/70`
    now; the column labels moved from `/50` to `/60` with it. */}
<footer class="site-footer tds-tone-ink pt-16">
  <div class="lp-container">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <div>
        <p class="brand-wordmark text-2xl mb-3">
          Tracht <span class="italic text-[var(--color-accent-pink)]">Digital</span> Solutions
        </p>
        {/* Small brand accent under the wordmark — the footer's one
            decorative detail. */}
        <span aria-hidden="true" class="tds-brandbar tds-brandbar--sm tds-brandbar--on-dark mb-4"></span>
        <p class="font-[var(--font-display)] italic text-[var(--color-accent-pink)] text-base mb-4">
          {footer.slogan}
        </p>
        {/* `footer.tagline` no longer renders (2026-10-11); the field stays
            so a stored block loads. */}
      </div>

      <nav aria-labelledby="footer-nav-title">
        <p id="footer-nav-title" class="eyebrow text-white/60 mb-4">
          {footer.nav}
        </p>
        <ul class="space-y-2 text-sm">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class="footer-link text-white/80 hover:text-white">
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href={siteConfig.blogUrl} class="footer-link text-white/80 hover:text-white">
              {t.nav.blog}
            </a>
          </li>
        </ul>
      </nav>

      <nav aria-labelledby="footer-systems-title">
        <p id="footer-systems-title" class="eyebrow text-white/60 mb-4">
          {systemsTitle}
        </p>
        <ul class="space-y-2 text-sm">
          {platformDefinitions.map((platform) => (
            <li>
              <a href={platformHref(platform, lang)} class="footer-link text-white/80 hover:text-white">
                {platform.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <p class="eyebrow text-white/60 mb-4">
          {footer.contactTitle}
        </p>
        {/* Each line says what it is by its icon (2026-10-11). The small
            labels above the values went on 2026-10-12, asked for: the icon
            and the value say it. */}
        <ul class="footer-contact text-sm">
          <li class="footer-contact__row">
            <span class="footer-contact__icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m2 7 10 6 10-6" />
              </svg>
            </span>
            <span class="footer-contact__text">
              <a href={`mailto:${contact.email}`} class="footer-link text-white/85 hover:text-white">
                {contact.email}
              </a>
            </span>
          </li>
          <li class="footer-contact__row">
            <span class="footer-contact__icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </span>
            <span class="footer-contact__text">
              <a href={telHref} class="footer-link text-white/85 hover:text-white">
                {contact.phone}
              </a>
            </span>
          </li>
          {/* Visible NAP for local SEO: postal code + locality from siteConfig
              (not the CMS string) so it always matches the Impressum and the
              PostalAddress in JSON-LD. Street stays Impressum-only.

              Hover, focus or a tap opens a bubble with a map of the area:
              OpenStreetMap through Leaflet, draggable and zoomable, loaded on
              the first open (`lib/placeMap.ts`, 2026-10-12), over the drawn
              map (`ui/PlaceMap.astro`) that stands in until then. Without the script, hover and
              focus-within show it; with it, `data-open` does, so Escape and a
              second tap can close it. The bubble is hoverable itself, so the
              pointer can move onto it (WCAG 1.4.13). */}
          <li class="footer-contact__row">
            <span class="footer-contact__icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            <span class="footer-contact__text">
              <span class="footer-place" data-footer-place>
                <button
                  type="button"
                  class="footer-place__trigger footer-link"
                  aria-expanded="false"
                  aria-controls="footer-place-bubble"
                >
                  {siteConfig.address.postalCode} {siteConfig.address.addressLocality}
                </button>
                <span class="footer-place__bubble" id="footer-place-bubble">
                  <span class="footer-place__card">
                    {/* The drawn map is the picture without JavaScript and
                        while tiles load; the live map (`lib/placeMap.ts`)
                        mounts over it on the first open. */}
                    <span class="footer-place__map">
                      <PlaceMap lang={lang} />
                      <span class="footer-place__live" data-place-live></span>
                    </span>
                    <span class="footer-place__caption">{placeCaption}</span>
                  </span>
                </span>
              </span>
            </span>
          </li>
        </ul>
      </div>
    </div>

    {/* Three parts on one line from `md`: copyright, the social row in the
        exact middle, the legal links. `1fr auto 1fr` keeps the icons centred
        on the page however long the texts either side of them are — a flex
        row with `space-between` centres them only when both sides happen to
        be equally wide. On a phone everything stacks, centred. */}
    <div class="footer-bottom pt-12 text-xs text-white/70">
      <p class="footer-bottom__copy">{footer.copyright}</p>
      {/* The same row as the contact section (lib/socials.ts), so a reader
          who scrolled past the form still finds the profiles. */}
      <SocialLinks links={socialLinks(contact.phone)} class="footer-bottom__social" />
      <div class="footer-bottom__legal flex flex-wrap gap-x-6 gap-y-1">
        <a href="/legal/impressum" class="footer-link hover:text-white">{footer.impressum}</a>
        <a href="/legal/datenschutz" class="footer-link hover:text-white">{footer.datenschutz}</a>
        <a href={agbHref} class="footer-link hover:text-white">{legalCopy[lang].agbShort}</a>
        {/* Not a page — it reopens the privacy settings on this one. Art. 7
            Abs. 3 DSGVO wants withdrawing a consent to be as easy as giving
            it, and a notice that appears once leaves no route back without
            this. It belongs in this row because this row is where a reader
            already looks for exactly that kind of thing. */}
        <ConsentLink client:idle lang={lang} className="footer-link hover:text-white" />
      </div>
    </div>
  </div>
</footer>

<script>
  import type { LiveMap } from "~/lib/placeMap";

  /**
   * The location bubble: open on hover (fine pointer), keyboard focus or a
   * tap; closed on leaving, blur, a second tap or Escape. The first open
   * mounts the live map; it stays open while the map is dragged.
   */
  document.querySelectorAll<HTMLElement>("[data-footer-place]").forEach((place) => {
    const trigger = place.querySelector<HTMLButtonElement>(".footer-place__trigger");
    const live = place.querySelector<HTMLElement>("[data-place-live]");
    const bubble = place.querySelector<HTMLElement>(".footer-place__bubble");
    if (!trigger) return;
    let map: Promise<LiveMap> | null = null;
    const ensureMap = () => {
      if (!live) return;
      if (!map) {
        const lang = document.documentElement.lang.startsWith("en") ? "en" : "de";
        map = import("~/lib/placeMap").then(({ mountLiveMap }) => mountLiveMap(live, lang));
        map.then(() => place.setAttribute("data-live", "")).catch(() => {
          // No map service: the drawn map stays.
          map = null;
        });
      }
      void map?.then((m) => m.refresh());
    };
    let busy = () => false;
    const set = (open: boolean) => {
      place.toggleAttribute("data-open", open);
      trigger.setAttribute("aria-expanded", String(open));
      if (open && bubble) {
        // Keep the bubble on screen: measured once it is displayed.
        bubble.style.removeProperty("--place-shift");
        const over = bubble.getBoundingClientRect().right - (document.documentElement.clientWidth - 12);
        if (over > 0) bubble.style.setProperty("--place-shift", `${-Math.ceil(over)}px`);
      }
      if (open) {
        ensureMap();
        void map?.then((m) => (busy = m.busy));
      }
    };
    place.setAttribute("data-enhanced", "");
    const hoverable = window.matchMedia("(hover: hover) and (pointer: fine)");
    // A click right after the pointer opened it must not close it again.
    let openedByHover = false;
    place.addEventListener("pointerenter", () => {
      if (!hoverable.matches) return;
      openedByHover = true;
      set(true);
    });
    place.addEventListener("pointerleave", () => {
      openedByHover = false;
      // A drag on the map may leave the bubble; it closes when the hand lets go outside.
      if (busy()) {
        window.addEventListener(
          "pointerup",
          (event) => {
            if (!place.contains(document.elementFromPoint(event.clientX, event.clientY))) set(false);
          },
          { once: true },
        );
        return;
      }
      if (hoverable.matches && !place.contains(document.activeElement)) set(false);
    });
    trigger.addEventListener("focus", () => {
      if (trigger.matches(":focus-visible")) set(true);
    });
    place.addEventListener("focusout", (event) => {
      if (!place.contains(event.relatedTarget as Node | null)) set(false);
    });
    trigger.addEventListener("click", () => {
      if (openedByHover) {
        openedByHover = false;
        set(true);
        return;
      }
      set(!place.hasAttribute("data-open"));
    });
    place.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !place.hasAttribute("data-open")) return;
      set(false);
      trigger.focus();
    });
  });
</script>

<style>
  /* --- Contact column: icon, label, value ------------------------------ */
  .footer-contact {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-contact__row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .footer-contact__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.08);
    color: var(--color-accent-pink);
  }
  .footer-contact__text {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.0625rem;
  }
  .footer-contact__text a {
    overflow-wrap: anywhere;
  }

  /* --- The location bubble ---------------------------------------------- */
  .footer-place {
    position: relative;
    display: inline-block;
  }
  .footer-place__trigger {
    padding: 0;
    border: 0;
    background: none;
    color: rgb(255 255 255 / 0.85);
    font: inherit;
    text-align: left;
    text-decoration: underline dotted rgb(255 255 255 / 0.45);
    text-underline-offset: 0.25em;
    cursor: pointer;
  }
  .footer-place__trigger:hover {
    color: #fff;
  }
  .footer-place__trigger:focus-visible {
    outline: 2px solid var(--color-accent-pink);
    outline-offset: 3px;
    border-radius: 3px;
  }
  /* Above the trigger. The bubble's own bottom padding bridges the gap, so the
     pointer can travel onto it without it closing. Anchored to the trigger's
     left edge on a phone (the column starts at the gutter) and to its right
     edge from `md`, where the column sits at the right of the page. */
  .footer-place__bubble {
    position: absolute;
    bottom: 100%;
    left: 0;
    z-index: 20;
    width: min(22rem, calc(100vw - 3rem));
    /* Pulled back inside the screen when the trigger sits too far right for
       the bubble's width (set by the script on open; a phone overflowed by
       28px). */
    margin-left: var(--place-shift, 0px);
    padding-bottom: 0.75rem;
    /* `display: none` while closed, not `visibility: hidden`: a hidden box
       still counts toward the page's scroll width, and on a phone this one
       made every page with the footer 28px wider than the screen. The fade
       survives through `allow-discrete` and `@starting-style`. */
    display: none;
    opacity: 0;
    translate: 0 0.5rem;
    transition:
      opacity 180ms var(--tds-ease-out),
      translate 180ms var(--tds-ease-out),
      display 180ms allow-discrete;
  }
  @media (min-width: 768px) {
    .footer-place__bubble {
      left: auto;
      right: 0;
    }
  }
  .footer-place:not([data-enhanced]):is(:hover, :focus-within) .footer-place__bubble,
  .footer-place[data-open] .footer-place__bubble {
    display: block;
    opacity: 1;
    translate: 0 0;
  }
  @starting-style {
    .footer-place:not([data-enhanced]):is(:hover, :focus-within) .footer-place__bubble,
    .footer-place[data-open] .footer-place__bubble {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }
  .footer-place__card {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: 0.625rem;
    border-radius: 6px;
    background: color-mix(in srgb, #fff 7%, var(--color-surface-navy));
    box-shadow: 6px 6px 0 0 var(--color-accent-pink);
  }
  /* The tail, pointing down at the trigger. */
  .footer-place__card::after {
    content: "";
    position: absolute;
    bottom: -0.375rem;
    left: 1.5rem;
    width: 0.75rem;
    height: 0.75rem;
    background: inherit;
    rotate: 45deg;
  }
  @media (min-width: 768px) {
    .footer-place__card::after {
      left: auto;
      right: 1.5rem;
    }
  }
  /* The live map lies exactly over the drawn one (same 4:3 box). */
  .footer-place__map {
    position: relative;
    display: block;
    border-radius: 6px;
    overflow: hidden;
  }
  .footer-place__live {
    position: absolute;
    inset: 0;
    display: block;
    visibility: hidden;
    background: transparent;
  }
  .footer-place[data-live] .footer-place__live {
    visibility: visible;
  }
  /* Leaflet's DOM is created at runtime, so these reach it with :global(). The
     tiles are muted toward the site's palette; the controls take its shapes. */
  .footer-place__live :global(.leaflet-tile-pane) {
    filter: grayscale(0.55) contrast(0.95) brightness(1.03);
  }
  .footer-place__live :global(.leaflet-control-zoom) {
    border: 0;
    box-shadow: 3px 3px 0 0 var(--color-accent-pink);
    border-radius: 6px;
    overflow: hidden;
  }
  .footer-place__live :global(.leaflet-control-zoom a) {
    color: var(--color-surface-navy);
  }
  .footer-place__live :global(.leaflet-control-attribution) {
    font-size: 9px;
  }
  .footer-place__live :global(.place-live__label) {
    padding: 2px 8px;
    border: 0;
    border-radius: 9999px;
    background: var(--color-surface-navy);
    box-shadow: none;
    color: #fff;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
  }
  .footer-place__live :global(.place-live__label::before) {
    border-top-color: var(--color-surface-navy);
  }
  .footer-place__caption {
    padding: 0 0.25rem 0.125rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: rgb(255 255 255 / 0.75);
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-place__bubble {
      translate: none;
      transition: none;
    }
  }

  /* The legal row is the last thing on every page, and the cookie notice and
     the floating call to action are fixed over the bottom of the viewport. A
     page cannot scroll past its own end, so `scroll-padding-bottom` alone left
     these links under the notice when they took keyboard focus (WCAG 2.4.11 —
     measured at 720×450 and 390×844). Both lanes are 0px while their element
     is absent, so the clearance goes away with the notice. */
  /* Since 2026-10-06 the floating control's lane is NOT added any more: it
     put up to 168px of empty paper under the footer on a phone. The control
     is a ~48px column on the RIGHT edge, so instead of reserving its whole
     height under the full width, the centred legal row keeps clear of it
     sideways (below). The cookie notice spans the full width and keeps its
     lane. */
  .site-footer {
    padding-bottom: calc(2rem + var(--tds-bottom-lane, 0px) + env(safe-area-inset-bottom, 0px));
  }
  /* Symmetric, so the row stays centred: 3.75rem clears the control's
     48px column plus its 1rem offset from the edge, at every width. */
  .footer-bottom {
    padding-inline: 3.75rem;
  }

  .footer-bottom {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  .footer-bottom__legal {
    justify-content: center;
  }
  @media (min-width: 768px) {
    .footer-bottom {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 2rem;
      text-align: left;
    }
    .footer-bottom__copy {
      justify-self: start;
    }
    .footer-bottom__legal {
      justify-self: end;
      justify-content: flex-end;
    }
  }

  /* Finger-sized links. The footer's rows were 20px tall on a phone, and
     "AGB"/"Terms" are narrower than a fingertip. Global, because `ConsentLink`
     is a React island and never receives this component's scoping attribute. */
  @media (pointer: coarse) {
    :global(.footer-link) {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      min-width: 2.75rem;
    }
  }
</style>
