---
import { ConsentLink } from "@tracht-digital-solutions/tds-shared/consent";

import { tFor, resolveLang, localizePath } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
import { legalCopy } from "~/lib/legal";
import { siteConfig } from "~/lib/seo";

const lang = resolveLang(Astro.currentLocale);
const t = tFor(Astro.currentLocale);

// Editable footer strings + contact info (shared with the Contact section's
// block) — both override the tds-shared defaults at build time.
const footer = await cmsFor("footer", lang, t.footer);
const contact = await cmsFor("contact", lang, {
  label: t.contact.label,
  headline: t.contact.headline,
  headlineAccent: t.contact.headlineAccent,
  sub: t.contact.sub,
  email: t.contact.info.email,
  phone: t.contact.info.phone,
  location: t.contact.info.location,
});

const pricingHref = localizePath("/preise", lang);
// The AGB link goes to the PAGE, not straight to the PDF — the page carries
// the inline viewer and the download button, and works on a phone where an
// embedded PDF does not.
const agbHref = localizePath("/legal/agb", lang);
// Section links resolve against the homepage so they work from subpages
// like /preise, where these sections don't exist.
const homeHref = localizePath("/", lang);
// Strip spaces for the dialer href; keep the spaced version for display.
const telHref = `tel:${contact.phone.replace(/\s+/g, "")}`;
---

{/* Fast Schwarz / sehr dunkles Navy, with the page tokens re-mapped by
    `.tds-tone-ink` so the hairlines inside read as low-opacity white
    rather than as the light ground's warm line. */}
<footer class="tds-tone-ink pt-16 pb-10">
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <div class="grid md:grid-cols-3 gap-12 mb-12">
      <div>
        <p class="brand-wordmark text-2xl mb-3">
          Tracht <span class="italic text-[var(--color-accent-pink)]">Digital</span> Solutions
        </p>
        {/* Small brand accent under the wordmark — the footer's one
            decorative detail. */}
        <span aria-hidden="true" class="tds-brandbar tds-brandbar--sm tds-brandbar--on-dark mb-4"></span>
        <p class="font-[var(--font-display)] italic text-[var(--color-accent-pink)] text-base mb-4">
          {footer.slogan}
        </p>
        <p class="text-white/60 text-sm leading-relaxed max-w-xs">
          {footer.tagline}
        </p>
      </div>

      <div>
        <p class="eyebrow text-white/50 mb-4">
          {footer.nav}
        </p>
        <ul class="space-y-2 text-sm">
          <li><a href={`${homeHref}#about`} class="text-white/70 hover:text-white">{lang === "de" ? "Wieso ich?" : "Why me?"}</a></li>
          <li><a href={`${homeHref}#services`} class="text-white/70 hover:text-white">{lang === "de" ? "Was ich anbiete?" : "What I offer?"}</a></li>
          <li><a href={pricingHref} data-pricing-open class="text-white/70 hover:text-white">{footer.pricing}</a></li>
          <li><a href="https://blog.tracht-digital.de" class="text-white/70 hover:text-white">{t.nav.blog}</a></li>
        </ul>
      </div>

      <div>
        <p class="eyebrow text-white/50 mb-4">
          {footer.contactTitle}
        </p>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={`mailto:${contact.email}`} class="text-white/70 hover:text-white">
              {contact.email}
            </a>
          </li>
          <li>
            <a href={telHref} class="text-white/70 hover:text-white">
              {contact.phone}
            </a>
          </li>
          {/* Visible NAP for local SEO: postal code + locality from siteConfig
              (not the CMS string) so it always matches the Impressum and the
              PostalAddress in JSON-LD. Street stays Impressum-only. */}
          <li class="text-white/50">
            {siteConfig.address.postalCode} {siteConfig.address.addressLocality}
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-white/40">
      <p>{footer.copyright}</p>
      <div class="flex flex-wrap gap-6">
        <a href="/legal/impressum" class="hover:text-white">{footer.impressum}</a>
        <a href="/legal/datenschutz" class="hover:text-white">{footer.datenschutz}</a>
        <a href={agbHref} class="hover:text-white">{legalCopy[lang].agbShort}</a>
        {/* Not a page — it reopens the privacy settings on this one. Art. 7
            Abs. 3 DSGVO wants withdrawing a consent to be as easy as giving
            it, and a notice that appears once leaves no route back without
            this. It belongs in this row because this row is where a reader
            already looks for exactly that kind of thing. */}
        <ConsentLink client:idle lang={lang} className="hover:text-white" />
      </div>
    </div>
  </div>
</footer>
