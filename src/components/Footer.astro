---
import { ConsentLink } from "@tracht-digital-solutions/tds-shared/consent";

import { tFor, resolveLang, localizePath } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
import { legalCopy } from "~/lib/legal";
import { sectionLinks } from "~/lib/navigation";
import { platformDefinitions, platformHref } from "~/lib/platforms";
import { siteConfig } from "~/lib/seo";
import { socialLinks } from "~/lib/socials";
import SocialLinks from "~/components/ui/SocialLinks.astro";
import PlaceBubble from "~/components/ui/PlaceBubble.astro";

const lang = resolveLang(Astro.currentLocale);
const t = tFor(Astro.currentLocale);

// Editable footer strings + contact info (shared with the Contact section's
// block) — both override the tds-shared defaults at build time.
const footer = await cmsFor("footer", lang, t.footer);
const contact = await cmsFor("contact", lang, {
  label: t.contact.label,
  headline: t.contact.headline,
  headlineAccent: t.contact.headlineAccent,
  sub: t.contact.sub,
  email: t.contact.info.email,
  phone: t.contact.info.phone,
  location: t.contact.info.location,
});

// The AGB link goes to the PAGE, not straight to the PDF — the page carries
// the inline viewer and the download button, and works on a phone where an
// embedded PDF does not.
const agbHref = localizePath("/legal/agb", lang);
// Section links resolve against the homepage so they work from subpages,
// where these sections don't exist.
const homeHref = localizePath("/", lang);
// Strip spaces for the dialer href; keep the spaced version for display.
const telHref = `tel:${contact.phone.replace(/\s+/g, "")}`;

// The same sections the header lists (`lib/navigation.ts`), plus Kontakt —
// the footer is where a reader who scrolled past the form looks for it. The
// pricing label stays the editable `footer.pricing`.
const navItems = [
  ...sectionLinks(lang).map((item) => ({
    href: `${homeHref}#${item.id}`,
    label: item.id === "preise" ? footer.pricing : item.label,
  })),
  { href: `${homeHref}#contact`, label: lang === "de" ? "Kontakt" : "Contact" },
];

// The shop system and CMS pages, from every page of the site: the one place a
// crawler — and a reader who scrolled to the end — reaches all of them at once.
const systemsTitle = lang === "de" ? "Shopsysteme & CMS" : "Shop systems & CMS";
---

{/* Fast Schwarz / sehr dunkles Navy, with the page tokens re-mapped by
    `.tds-tone-ink` so the hairlines inside read as low-opacity white
    rather than as the light ground's warm line.

    CONTRAST, measured rather than judged: the legal row used to be
    `text-white/40` at 12px, which is 3.77:1 on this ground — below the 4.5:1
    AA needs for small text, and flagged by axe on every page. It is `/70`
    now; the column labels moved from `/50` to `/60` with it. */}
<footer class="site-footer tds-tone-ink pt-16">
  <div class="lp-container">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <div>
        <p class="brand-wordmark text-2xl mb-3">
          Tracht <span class="italic text-[var(--color-accent-pink)]">Digital</span> Solutions
        </p>
        {/* Small brand accent under the wordmark — the footer's one
            decorative detail. */}
        <span aria-hidden="true" class="tds-brandbar tds-brandbar--sm tds-brandbar--on-dark mb-4"></span>
        <p class="font-[var(--font-display)] italic text-[var(--color-accent-pink)] text-base mb-4">
          {footer.slogan}
        </p>
        {/* `footer.tagline` no longer renders (2026-10-11); the field stays
            so a stored block loads. */}
      </div>

      <nav aria-labelledby="footer-nav-title">
        <p id="footer-nav-title" class="eyebrow text-white/60 mb-4">
          {footer.nav}
        </p>
        <ul class="space-y-2 text-sm">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class="footer-link text-white/80 hover:text-white">
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href={siteConfig.blogUrl} class="footer-link text-white/80 hover:text-white">
              {t.nav.blog}
            </a>
          </li>
          <li>
            <a
              href={`${siteConfig.freelanceUrl}${lang === "en" ? "/en/" : "/"}`}
              class="footer-link text-white/80 hover:text-white"
            >
              {lang === "de" ? "Freelancer-Portfolio" : "Freelance portfolio"}
            </a>
          </li>
        </ul>
      </nav>

      <nav aria-labelledby="footer-systems-title">
        <p id="footer-systems-title" class="eyebrow text-white/60 mb-4">
          {systemsTitle}
        </p>
        <ul class="space-y-2 text-sm">
          {platformDefinitions.map((platform) => (
            <li>
              <a href={platformHref(platform, lang)} class="footer-link text-white/80 hover:text-white">
                {platform.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <p class="eyebrow text-white/60 mb-4">
          {footer.contactTitle}
        </p>
        {/* Each line says what it is by its icon (2026-10-11). The small
            labels above the values went on 2026-10-12, asked for: the icon
            and the value say it. */}
        <ul class="footer-contact text-sm">
          <li class="footer-contact__row">
            <span class="footer-contact__icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m2 7 10 6 10-6" />
              </svg>
            </span>
            <span class="footer-contact__text">
              <a href={`mailto:${contact.email}`} class="footer-link text-white/85 hover:text-white">
                {contact.email}
              </a>
            </span>
          </li>
          <li class="footer-contact__row">
            <span class="footer-contact__icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </span>
            <span class="footer-contact__text">
              <a href={telHref} class="footer-link text-white/85 hover:text-white">
                {contact.phone}
              </a>
            </span>
          </li>
          {/* Visible NAP for local SEO: postal code + locality from siteConfig
              (not the CMS string) so it always matches the Impressum and the
              PostalAddress in JSON-LD. Street stays Impressum-only.

              Hover, focus or a tap opens a bubble with a map of the area:
              OpenStreetMap through Leaflet, draggable and zoomable, loaded on
              the first open (`lib/placeMap.ts`, 2026-10-12), over the drawn
              map (`ui/PlaceMap.astro`) that stands in until then. Without the script, hover and
              focus-within show it; with it, `data-open` does, so Escape and a
              second tap can close it. The bubble is hoverable itself, so the
              pointer can move onto it (WCAG 1.4.13). */}
          <li class="footer-contact__row">
            <span class="footer-contact__icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            <span class="footer-contact__text">
              <PlaceBubble lang={lang} id="footer-place-bubble" anchor="end" />
            </span>
          </li>
        </ul>
      </div>
    </div>

    {/* Three parts on one line from `md`: copyright, the social row in the
        exact middle, the legal links. `1fr auto 1fr` keeps the icons centred
        on the page however long the texts either side of them are — a flex
        row with `space-between` centres them only when both sides happen to
        be equally wide. On a phone everything stacks, centred. */}
    <div class="footer-bottom pt-12 text-xs text-white/70">
      <p class="footer-bottom__copy">{footer.copyright}</p>
      {/* The same row as the contact section (lib/socials.ts), so a reader
          who scrolled past the form still finds the profiles. */}
      <SocialLinks links={socialLinks(contact.phone)} class="footer-bottom__social" />
      <div class="footer-bottom__legal flex flex-wrap gap-x-6 gap-y-1">
        <a href="/legal/impressum" class="footer-link hover:text-white">{footer.impressum}</a>
        <a href="/legal/datenschutz" class="footer-link hover:text-white">{footer.datenschutz}</a>
        <a href={agbHref} class="footer-link hover:text-white">{legalCopy[lang].agbShort}</a>
        {/* Not a page — it reopens the privacy settings on this one. Art. 7
            Abs. 3 DSGVO wants withdrawing a consent to be as easy as giving
            it, and a notice that appears once leaves no route back without
            this. It belongs in this row because this row is where a reader
            already looks for exactly that kind of thing. */}
        <ConsentLink client:idle lang={lang} className="footer-link hover:text-white" />
      </div>
    </div>
  </div>
</footer>

<style>
  /* --- Contact column: icon, label, value ------------------------------ */
  .footer-contact {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-contact__row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .footer-contact__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.08);
    color: var(--color-accent-pink);
  }
  .footer-contact__text {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.0625rem;
  }
  .footer-contact__text a {
    overflow-wrap: anywhere;
  }

  /* The legal row is the last thing on every page, and the cookie notice and
     the floating call to action are fixed over the bottom of the viewport. A
     page cannot scroll past its own end, so `scroll-padding-bottom` alone left
     these links under the notice when they took keyboard focus (WCAG 2.4.11 —
     measured at 720×450 and 390×844). Both lanes are 0px while their element
     is absent, so the clearance goes away with the notice. */
  /* Since 2026-10-06 the floating control's lane is NOT added any more: it
     put up to 168px of empty paper under the footer on a phone. The control
     is a ~48px column on the RIGHT edge, so instead of reserving its whole
     height under the full width, the centred legal row keeps clear of it
     sideways (below). The cookie notice spans the full width and keeps its
     lane. */
  .site-footer {
    padding-bottom: calc(2rem + var(--tds-bottom-lane, 0px) + env(safe-area-inset-bottom, 0px));
  }
  /* Symmetric, so the row stays centred: 3.75rem clears the control's
     48px column plus its 1rem offset from the edge, at every width. */
  .footer-bottom {
    padding-inline: 3.75rem;
  }

  .footer-bottom {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  .footer-bottom__legal {
    justify-content: center;
  }
  @media (min-width: 768px) {
    .footer-bottom {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 2rem;
      text-align: left;
    }
    .footer-bottom__copy {
      justify-self: start;
    }
    .footer-bottom__legal {
      justify-self: end;
      justify-content: flex-end;
    }
  }

  /* Finger-sized links. The footer's rows were 20px tall on a phone, and
     "AGB"/"Terms" are narrower than a fingertip. Global, because `ConsentLink`
     is a React island and never receives this component's scoping attribute. */
  @media (pointer: coarse) {
    :global(.footer-link) {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      min-width: 2.75rem;
    }
  }
</style>
