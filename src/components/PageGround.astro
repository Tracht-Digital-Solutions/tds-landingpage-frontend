---
/**
 * The page's ONE ground (was a plain `<div class="page-ground">` in
 * `Layout.astro`; shapes since 2026-11-03).
 *
 * One layer, `position: fixed`, anchored to the VIEWPORT. The sections used
 * to alternate paper and sand, each with its own `.tds-wash`, and the ground
 * restarted at every section edge. A section that wants another colour
 * paints over this layer (`.tds-tone-navy` on the contact block). No section
 * lays a photo over it: that only covered the shapes (hero, "about" and the
 * detail heads lost theirs on 2026-11-03).
 *
 * On the paper lie the brand's constructed 3D bodies, generated by
 * `lib/groundShapes.ts` (seeded, the same on every render): few and large,
 * in the outer bands. Three depth planes; each plane is a tile drawn three
 * times one above the other, so moving it by up to one tile height never
 * shows an edge.
 *
 * `lib/motion/groundScroll.ts` writes three numbers onto this layer and CSS
 * alone turns them into motion:
 *
 * - `--lp-ground-y`, the scroll position: each plane slides by
 *   `mod(y × speed, tile)` (parallax, seamless) and each body turns further.
 * - `--lp-ground-px` / `--lp-ground-py`, the pointer in -1…1, only while the
 *   hero is on screen and only under a fine pointer: the bodies lean toward
 *   it and the planes shift by their depth — the hero's interactive 3D.
 *
 * Under reduced motion nothing writes them and the bodies stay in their
 * turned resting pose.
 *
 * `z-index: -1` needs nothing between `<body>` and this layer to open a
 * stacking context — a `transform`, `filter`, `opacity` or `will-change` on
 * `<body>` would hide the ground with no error anywhere.
 */
import { generateGround } from "~/lib/groundShapes";

interface Props {
  /** Bare pages (embeds, the business card) keep the plain paper. */
  bare?: boolean;
}

const { bare = false } = Astro.props;
const planes = bare ? [] : generateGround();
/** Outline rings behind each face; they carry the depth when a body turns. */
const RINGS = 3;
const COPIES = [0, 1, 2];
---

<div class="page-ground" aria-hidden="true">
  {
    planes.map((plane) => (
      <div class={`page-ground__plane page-ground__plane--${plane.id}`} style={`--speed: ${plane.speed}`}>
        {COPIES.map((copy) => (
          <div class="page-ground__tile" style={`--copy: ${copy}`}>
            {plane.shapes.map((shape) => (
              <span
                class="page-ground__shape"
                style={`left: ${shape.x}%; top: ${shape.y}%; --w: ${shape.width}; --h: ${shape.height}; --rx: ${shape.rx}; --ry: ${shape.ry}; --vx: ${shape.vx}; --vy: ${shape.vy}`}
              >
                <span class="page-ground__body">
                  {Array.from({ length: RINGS }, (_, index) => (
                    <span
                      class={`page-ground__layer tds-shape tds-shape--outline tds-shape--${shape.kind} tds-shape--${shape.colour}`}
                      style={`--z: ${RINGS - index}`}
                    />
                  ))}
                  <span class={`page-ground__layer page-ground__face tds-shape tds-shape--${shape.kind} tds-shape--${shape.colour}`} />
                </span>
              </span>
            ))}
          </div>
        ))}
      </div>
    ))
  }
</div>

<style>
  /* Unitless, so each can become an angle as well as a length. Written by
     `lib/motion/groundScroll.ts` onto `.page-ground` only: they inherit into
     this layer's nodes, never the page's 1,700. */
  @property --lp-ground-y {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  @property --lp-ground-px {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  @property --lp-ground-py {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  .page-ground {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: clip;
    background: var(--color-paper);
    --lp-ground-tile: max(100lvh, 56rem);
    /* rem per generated size unit; smaller on a phone (below). */
    --ground-scale: 1;
    /* The layer's own decor alphas: present, but the bodies lie under text.
       Raising them needs `npm run audit:contrast`. */
    --tds-decor-shape-alpha: 0.085;
    --tds-decor-line-opacity: 0.26;
  }
  :global(:is(:root, .tds-theme-preview__page)[data-theme="dark"]) .page-ground:not(:where([data-theme="dark"] [data-theme="light"] *)) {
    --tds-decor-shape-alpha: 0.1;
    --tds-decor-line-opacity: 0.28;
  }

  .page-ground__plane {
    position: absolute;
    inset-inline: 0;
    top: calc(-1 * var(--lp-ground-tile));
    height: calc(3 * var(--lp-ground-tile));
    will-change: transform;
    /* Pointer parallax, px at the screen's edge: the nearer, the further. */
    --reach: 14;
    transform: translate3d(
      calc(var(--lp-ground-px) * var(--reach) * 1px),
      calc(var(--lp-ground-py) * var(--reach) * 1px),
      0
    );
  }
  @supports (top: mod(3px, 2px)) {
    .page-ground__plane {
      transform: translate3d(
        calc(var(--lp-ground-px) * var(--reach) * 1px),
        calc(
          var(--lp-ground-py) * var(--reach) * 1px -
            mod(var(--lp-ground-y) * var(--speed) * 1px, var(--lp-ground-tile))
        ),
        0
      );
    }
  }
  .page-ground__plane--mid {
    --reach: 30;
    --depth-step: -0.8rem;
  }
  .page-ground__plane--near {
    --reach: 52;
    --depth-step: -1.1rem;
  }

  .page-ground__tile {
    position: absolute;
    inset-inline: 0;
    top: calc(var(--copy) * var(--lp-ground-tile));
    height: var(--lp-ground-tile);
  }

  .page-ground__shape {
    position: absolute;
    width: calc(var(--w) * var(--ground-scale) * 1rem);
    height: calc(var(--h) * var(--ground-scale) * 1rem);
    transform-style: preserve-3d;
  }
  /* Resting pose + scroll turn + pointer lean, one transform. */
  .page-ground__body {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: perspective(900px)
      rotateX(calc((var(--rx) + var(--lp-ground-y) * var(--vx) - var(--lp-ground-py) * 16) * 1deg))
      rotateY(calc((var(--ry) + var(--lp-ground-y) * var(--vy) + var(--lp-ground-px) * 20) * 1deg));
  }
  .page-ground__layer {
    inset: 0;
    width: 100%;
    height: 100%;
    transform: translateZ(calc(var(--z, 0) * var(--depth-step, -0.5rem)));
  }
  .page-ground__layer.tds-shape--outline {
    border-width: 1.5px;
  }

  /* A phone gets the same composition at about two thirds of the size, and
     no near plane: its 22rem bodies would lie under the copy. */
  @media (max-width: 48rem) {
    .page-ground {
      --ground-scale: 0.62;
    }
    .page-ground__plane--near {
      display: none;
    }
  }

  /* Print is paper only. */
  @media print {
    .page-ground__plane {
      display: none;
    }
  }
</style>
