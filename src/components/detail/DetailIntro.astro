---
/**
 * The large statement under a detail page's opening band. On a service page it
 * is the service's `intro`; on a platform page it is the answer a reader (or an
 * answer engine) should be able to quote on its own.
 */
import Emphasis from "~/components/ui/Emphasis.astro";

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div class="max-w-5xl mx-auto px-6 md:px-8 lg:px-12 py-12 md:py-16">
  <p class="font-[var(--font-display)] text-2xl md:text-3xl leading-snug text-[var(--color-black)]">
    <Emphasis text={text} />
  </p>
</div>
