---
/**
 * A detail page's questions: heading on the left, the shared accordion on the
 * right from `lg`, stacked below. The tone is a prop because this band's
 * neighbours differ by page — it keeps the paper/sand alternation intact.
 */
import FaqAccordion from "~/components/ui/FaqAccordion.astro";

interface Props {
  title: string;
  items: readonly { q: string; a: string }[];
  tone?: "sand" | "paper";
}

const { title, items, tone = "sand" } = Astro.props;
---

<div class:list={["section-spacing", tone === "sand" && "tds-tone-sand"]}>
  <section
    class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12 grid gap-8 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-16 lg:items-start"
    aria-labelledby="platform-faq-title"
  >
    <h2
      id="platform-faq-title"
      class="display text-3xl md:text-4xl text-[var(--color-black)]"
    >
      {title}
    </h2>
    <div class="grid gap-1">
      <FaqAccordion items={items} name="platform-faq" />
    </div>
  </section>
</div>
