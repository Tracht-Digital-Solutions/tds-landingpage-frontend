---
/**
 * Where a platform page leads next: the service it belongs to, the other
 * systems, and journal articles on the same question. Internal links in plain
 * words — for the reader who is not done yet, and for the crawler that should
 * see how the pages belong together.
 */
interface RelatedLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  parentTitle: string;
  parent: RelatedLink;
  platformsTitle: string;
  platforms: readonly RelatedLink[];
  articlesTitle: string;
  articles: readonly RelatedLink[];
}

const {
  title,
  parentTitle,
  parent,
  platformsTitle,
  platforms,
  articlesTitle,
  articles,
} = Astro.props;
// A card's fill has to differ from the ground it sits on, and the ground is
// paper everywhere now.
const fill = "bg-[var(--color-soft)]";
const groups = [
  { title: parentTitle, links: [parent] },
  { title: platformsTitle, links: platforms },
  { title: articlesTitle, links: articles },
].filter((group) => group.links.length > 0);
---

<div class="section-spacing">
  <section class="lp-container" aria-labelledby="platform-related-title">
    <h2
      id="platform-related-title"
      class="display text-3xl md:text-4xl text-[var(--color-black)] mb-8"
    >
      {title}
    </h2>
    <div class="grid gap-5 md:gap-6 md:grid-cols-3">
      {groups.map((group) => (
        <div class:list={["rounded-[6px] p-7", fill]}>
          <h3 class="font-[var(--font-display)] text-xl text-[var(--color-black)] mb-4">{group.title}</h3>
          <ul class="space-y-2">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex items-center gap-2 text-[var(--color-primary)] hover:text-[var(--color-accent)] transition-colors [@media(pointer:coarse)]:min-h-11"
                >
                  <span>{link.label}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</div>
