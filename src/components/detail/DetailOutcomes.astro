---
/**
 * What the reader ends up with, and what is not part of it — side by side on
 * paper. Moved verbatim from `services/ServiceDetailPage.astro`.
 */
interface Props {
  outcomesTitle: string;
  outcomes: readonly string[];
  boundariesTitle: string;
  boundaries: readonly string[];
}

const { outcomesTitle, outcomes, boundariesTitle, boundaries } = Astro.props;
---

<div class="section-spacing">
  <div class="lp-container grid lg:grid-cols-2 gap-12 lg:gap-20">
    <section aria-labelledby="service-outcomes-title">
      <h2
        id="service-outcomes-title"
        class="display text-3xl md:text-4xl text-[var(--color-black)] mb-8"
      >
        {outcomesTitle}
      </h2>
      {/* Goals, not by-products: each line is something the reader ends up
          with, so the marker is a target rather than a bullet. Decorative —
          the text carries the meaning. */}
      <ul class="grid sm:grid-cols-2 lg:grid-cols-1 gap-4">
        {outcomes.map((item) => (
          <li
            class="flex items-start gap-3 bg-[color-mix(in_srgb,var(--color-accent-pink)_12%,var(--color-paper))] rounded-[6px] px-5 py-4 text-[var(--color-black)] leading-snug"
            data-reveal
          >
            <svg
              aria-hidden="true"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="mt-0.5 shrink-0 text-[var(--color-accent)]"
            >
              <circle cx="12" cy="12" r="9" />
              <circle cx="12" cy="12" r="4.5" />
              <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="service-boundaries-title">
      <h2
        id="service-boundaries-title"
        class="display text-3xl md:text-4xl text-[var(--color-black)] mb-8"
      >
        {boundariesTitle}
      </h2>
      <ul class="space-y-6">
        {boundaries.map((item) => (
          <li class="flex gap-4 text-[var(--color-muted)] leading-relaxed">
            <span aria-hidden="true" class="font-mono text-[var(--color-accent)]">—</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</div>
