---
/**
 * Error view for 404 and 500: the big three-digit code as the picture, and
 * underneath it what actually happened plus the ways back a visitor needs.
 *
 * It used to be the code alone, as ONE link labelled "Zurück zur Startseite".
 * That left the page with no heading at all (a screen reader user heard a link
 * and nothing that said why), gave a visitor who arrived from an English page
 * a single German exit, and made "Kontakt" — the thing most people who land on
 * a dead URL were looking for — two clicks away.
 *
 * Bilingual on purpose: these pages are prerendered once and answer for both
 * language trees, so there is no locale to choose from. Each half carries its
 * own `lang` so it is pronounced correctly.
 *
 * Looping animations respect the global prefers-reduced-motion reset in
 * tds-shared base.css.
 */
interface Props {
  code: string;
}
const { code } = Astro.props;

const copy =
  code === "404"
    ? { de: "Diese Seite gibt es nicht.", en: "This page does not exist." }
    : { de: "Hier ist etwas schiefgelaufen.", en: "Something went wrong here." };
---

<div class="err">
  <span class="err-glow" aria-hidden="true"></span>
  <div class="err-body">
    <p class="err-code" aria-hidden="true">{code}</p>
    <h1 class="err-title">
      <span lang="de">{copy.de}</span>
      <span class="err-title-en" lang="en">{copy.en}</span>
    </h1>
    <nav class="err-links" aria-label="Weiter / Continue">
      <a href="/">Zur Startseite</a>
      <a href="/#services">Leistungen</a>
      <a href="/#contact">Kontakt</a>
      <a href="/en/" lang="en" hreflang="en">English</a>
    </nav>
  </div>
</div>

<style>
  .err {
    min-height: 100svh;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 2rem 1.5rem;
    position: relative;
    overflow: hidden;
    background: var(--color-paper);
  }
  .err-glow {
    position: absolute;
    z-index: 0;
    width: min(72vmin, 540px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 22%, transparent),
      transparent 70%
    );
    animation: err-glow 6s ease-in-out infinite;
    pointer-events: none;
  }
  .err-body {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
  }
  .err-code {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
    font-size: clamp(6rem, 28vw, 16rem);
    color: var(--color-ink);
    animation:
      err-in 700ms cubic-bezier(0.22, 1, 0.36, 1) both,
      err-float 7s ease-in-out 700ms infinite;
  }
  .err-title {
    margin: 0;
    display: grid;
    gap: 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    line-height: 1.25;
    color: var(--color-ink);
  }
  .err-title-en {
    font-size: 0.75em;
    color: var(--color-muted);
  }
  .err-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .err-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 1.125rem;
    border-radius: var(--tds-radius-pill, 100px);
    background: var(--color-soft);
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }
  .err-links a:first-child {
    background: var(--color-surface-navy);
    color: #fff;
  }
  .err-links a:hover {
    color: var(--color-accent);
  }
  .err-links a:first-child:hover {
    color: #fff;
    background: var(--color-surface-accent);
  }
  @keyframes err-in {
    from { opacity: 0; transform: translateY(1.5rem) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes err-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-0.6rem); }
  }
  @keyframes err-glow {
    0%, 100% { opacity: 0.45; transform: scale(1); }
    50% { opacity: 0.85; transform: scale(1.08); }
  }
</style>
