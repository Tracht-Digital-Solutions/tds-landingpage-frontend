---
import ImagePlaceholder from "./ImagePlaceholder.astro";

interface Props {
  number: string;
  badge: string;
  title: string;
  description: string;
  stack: readonly string[];
  comingSoon: string;
  placeholderLabel: string;
  imagePlaceholder: string;
}

const { number, badge, title, description, stack, comingSoon, placeholderLabel, imagePlaceholder } = Astro.props;
---

<article class="group bg-[var(--color-paper)] border border-[var(--color-line)] rounded-[2px] overflow-hidden transition-shadow duration-200 hover:shadow-[0_24px_48px_-24px_rgba(5,15,104,0.18)]">
  <ImagePlaceholder aspect="aspect-[4/3]" label={placeholderLabel} description={imagePlaceholder} />
  <div class="p-6 md:p-8">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-medium tracking-widest text-[var(--color-muted)]">
        {number}
      </span>
      <span class="text-[10px] font-medium tracking-widest uppercase text-[var(--color-accent)] bg-[var(--color-accent)]/10 px-2 py-0.5 rounded-[100px]">
        {badge}
      </span>
    </div>
    <h3 class="text-xl font-[var(--font-display)] font-medium mb-3">
      {title}
    </h3>
    <p class="text-sm text-[var(--color-muted)] leading-relaxed mb-4">
      {description}
    </p>
    <div class="flex flex-wrap gap-2 mb-3">
      {stack.map((s) => (
        <span class="text-[11px] font-mono text-[var(--color-muted)]">{s}</span>
      ))}
    </div>
    <span class="text-[11px] uppercase tracking-widest text-[var(--color-line)]">
      {comingSoon}
    </span>
  </div>
</article>
