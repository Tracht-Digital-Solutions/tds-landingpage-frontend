---
/**
 * A small drawn map of the area around Schwarzenbek, for the footer's location
 * bubble (2026-10-11).
 *
 * Drawn, not tiled: a map service would load third-party tiles on every page
 * (a request before consent) and bring its own colours. This is constructed
 * line work in the site's palette — the Elbe, the A24, the Elbe-Lübeck canal
 * and the neighbouring towns, placed from their coordinates with a plain
 * equirectangular projection (lon 9.95–10.85, lat 53.33–53.73, x scaled by
 * cos 53.5°). Schwarzenbek is the marked area.
 *
 * Decorative geometry plus one label for the whole picture: the SVG is
 * `role="img"` with an `aria-label`; the town names inside are `aria-hidden`.
 */
import type { Lang } from "~/lib/i18n";

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const label =
  lang === "de"
    ? "Karte: Schwarzenbek, östlich von Hamburg zwischen Bergedorf, Mölln und Lauenburg an der Elbe"
    : "Map: Schwarzenbek, east of Hamburg between Bergedorf, Mölln and Lauenburg on the Elbe";

/** Neighbouring towns, projected (see above). `dx`/`dy` place the label. */
const towns = [
  { name: "Hamburg", x: 15, y: 107, r: 3.5, dx: 7, dy: -10, anchor: "start" },
  { name: "Ahrensburg", x: 103, y: 33, r: 2, dx: 6, dy: 3, anchor: "start" },
  { name: "Bergedorf", x: 93, y: 145, r: 2, dx: 0, dy: 13, anchor: "middle" },
  { name: "Geesthacht", x: 150, y: 176, r: 2, dx: -5, dy: -4, anchor: "end" },
  { name: "Lauenburg", x: 219, y: 213, r: 2, dx: -6, dy: -4, anchor: "end" },
  { name: "Mölln", x: 263, y: 62, r: 2, dx: 7, dy: 3, anchor: "start" },
  { name: "Büchen", x: 237, y: 149, r: 2, dx: 7, dy: 3, anchor: "start" },
] as const;
---

<svg
  class:list={["place-map", className]}
  viewBox="0 0 320 240"
  role="img"
  aria-label={label}
>
  <rect class="place-map__ground" x="0" y="0" width="320" height="240" rx="6" />

  {/* The Elbe, from Hamburg up to Lauenburg and on to the east. */}
  <path
    class="place-map__river"
    d="M0 110.6 L7.1 113.5 L28.4 131.5 L39.1 158.4 L53.3 179.3 L81.8 197.2 L124.5 188.2 L160 186.5 L188.5 200.2 L219.4 216.3 L273.8 212.1 L320 236"
  />
  {/* The Elbe-Lübeck canal, north from Lauenburg past Büchen and Mölln. */}
  <path class="place-map__canal" d="M219.4 214 L238.3 149.4 L263.1 65.7 L273.8 0" />
  {/* The A24, Hamburg to Berlin, north of the town. */}
  <path class="place-map__road" d="M0 101.6 L71.1 104.6 L135.1 104.6 L195.6 116.5 L266.7 119.5 L320 125.5" />

  <g aria-hidden="true">
    <text class="place-map__note" x="96" y="211">Elbe</text>
    <text class="place-map__note" x="112" y="99">A24</text>

    {towns.map((town) => (
      <g>
        <circle class="place-map__town" cx={town.x} cy={town.y} r={town.r} />
        <text
          class="place-map__label"
          x={town.x + town.dx}
          y={town.y + town.dy}
          text-anchor={town.anchor}
        >
          {town.name}
        </text>
      </g>
    ))}

    {/* Schwarzenbek: the surroundings, the town area, the pin. */}
    <circle class="place-map__halo" cx="188" cy="135" r="26" />
    <path class="place-map__area" d="M180 126 L190 123.5 L198.5 128.5 L199.5 139 L192.5 146 L182 145.5 L176.5 137.5 Z" />
    <circle class="place-map__pin" cx="188" cy="135" r="3.5" />
    <text class="place-map__label place-map__label--home" x="188" y="174" text-anchor="middle">Schwarzenbek</text>
  </g>
</svg>

<style>
  .place-map {
    display: block;
    width: 100%;
    height: auto;
  }
  .place-map__ground {
    fill: rgb(255 255 255 / 0.04);
  }
  .place-map__river {
    fill: none;
    stroke: rgb(147 167 255 / 0.55);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .place-map__canal {
    fill: none;
    stroke: rgb(147 167 255 / 0.45);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }
  .place-map__road {
    fill: none;
    stroke: rgb(255 255 255 / 0.28);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .place-map__town {
    fill: rgb(255 255 255 / 0.7);
  }
  .place-map__label {
    fill: rgb(255 255 255 / 0.72);
    font-family: var(--font-body);
    font-size: 9.5px;
  }
  .place-map__label--home {
    fill: #fff;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
  }
  .place-map__note {
    fill: rgb(147 167 255 / 0.8);
    font-family: var(--font-body);
    font-size: 8.5px;
    font-style: italic;
  }
  .place-map__halo {
    fill: color-mix(in srgb, var(--color-accent-pink) 14%, transparent);
    stroke: var(--color-accent-pink);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }
  .place-map__area {
    fill: color-mix(in srgb, var(--color-accent-pink) 55%, transparent);
    stroke: var(--color-accent-pink);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .place-map__pin {
    fill: #fff;
    stroke: var(--color-surface-navy);
    stroke-width: 1.5;
  }
</style>
