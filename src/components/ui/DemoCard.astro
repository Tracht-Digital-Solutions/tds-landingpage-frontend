---
/**
 * One website demo: genre, screenshot, favicon, name, the site's own
 * description and its address.
 *
 * The picture here is CONTENT, not a ground. `ServiceCard` renders its photo
 * at 0.34 opacity behind a scrim with `alt=""` because there the image is
 * decoration under the copy; here the screenshot IS the point — it is what a
 * visitor came to look at — so it runs at full strength, in front, with a real
 * `alt`, and a magnifier opens the full 1440×900 capture without leaving the
 * page.
 *
 * Everything textual on this card came from the demo itself via
 * `npm run demos:sync`, with ONE deliberate exception: the genre etiquette
 * (`definition.kind`, see `DEMO_KINDS` in `lib/demoCatalog.ts`). Nothing else
 * here is written about a site; a demo with no meta description simply shows
 * no description.
 *
 * ### Why this is not one big `<a>` any more
 *
 * It was, and the magnifier is why it stopped being one: a `<button>` inside
 * an `<a>` is invalid, and no amount of `preventDefault` makes it valid. The
 * card is a plain element now, and the link lives in `ui/CardActions.astro` at
 * the bottom, stretching over the whole card with a `::after`. The full-card
 * hit area, the hover response and the focus ring all survive that swap — they
 * are the invariant, not the tag that used to provide them. The magnifier then
 * sits above the stretched layer on `z-index`, which is exactly the layering
 * the pattern exists for.
 *
 * The link moved off the TITLE and into the bar when the card gained a second
 * destination. A card with two links must not also have a third anchor saying
 * the same thing as one of them: a screen reader would read the demo out twice
 * and the visitor would be offered a choice that is not one. The title is
 * plain text now and the bar holds exactly two links — the service this demo
 * is evidence for, and the demo itself.
 *
 * ### Why the sizes are container queries, not a `featured` prop
 *
 * The shelf gives its lead card two tracks (see `sections/Showcase.astro`).
 * A wide card wants a wider screenshot band and a bigger title, and it wants
 * them BY BEING WIDE — on a phone the same card is one track wide and must
 * look like every other card. The slot is already an inline-size container,
 * so the card answers its own width and nobody has to thread a flag through
 * two components and keep it in step with the CSS.
 *
 * The wide band is `32 / 10`, i.e. exactly twice `16 / 10`. That is not a
 * taste decision: the slides stretch to the tallest card, so a lead card with
 * a TALLER band would pad every other card's body with the difference. Twice
 * the width at the same height doubles the picture and leaves the shelf's
 * height alone. `object-position: top center` then crops to the demo's hero,
 * which is the half worth showing.
 */
import type { Lang } from "~/lib/i18n";
import { DEMO_KINDS } from "~/lib/demoCatalog";
import { demoUi, type ResolvedDemo } from "~/lib/demos";
import type { CardAction } from "~/lib/cardActions";
import CardActions from "~/components/ui/CardActions.astro";

interface Props {
  demo: ResolvedDemo;
  lang: Lang;
  /**
   * The service page this demo is evidence for, handed in by the section.
   *
   * A prop rather than a field on `demoCatalog.ts`, which has no imports and
   * must keep none — and rather than a lookup here, because the answer depends
   * on WHERE the card is rendered: on the Webauftritt page the demos already
   * sit on their service, and `null` is what stops a link back to the page the
   * visitor is standing on.
   */
  serviceLink?: CardAction | null;
}

const { demo, lang, serviceLink = null } = Astro.props;
const ui = demoUi[lang];

const { definition, title, description, favicon, preview, previewWidth, previewHeight } = demo;

/**
 * The screenshot's alt text, in the language of the PAGE.
 *
 * A screenshot's accessible description is this site talking about the demo,
 * so it follows the visitor's locale — unlike `title` and `description`, which
 * are the demo's own words and stay in whatever language it wrote them.
 */
const previewAlt =
  lang === "de"
    ? `Startseite der Demo-Webseite ${title}`
    : `Home page of the demo website ${title}`;

/** Genre, from the closed vocabulary. Never the demo's subject matter. */
const kind = DEMO_KINDS[definition.kind][lang];
---

<article class="demo-card-slot" data-reveal>
  <div class="demo-card">
    <div class="demo-card__shot">
      {/* Intrinsic size stated so the box is reserved before the file
          arrives — screenshots loading lazily into unsized boxes is a
          section that reflows under the reader. */}
      <img
        src={preview}
        alt={previewAlt}
        width={previewWidth}
        height={previewHeight}
        loading="lazy"
        decoding="async"
      />

      {/* Starts `hidden`; `PreviewLightbox.astro` reveals it once its dialog
          is wired. Same fallback as the shelf's arrows — without JavaScript
          the card is still a complete, working link, and there is no dead
          control sitting on the picture. */}
      <button
        type="button"
        class="demo-card__zoom"
        hidden
        data-preview-open
        data-preview-src={preview}
        data-preview-alt={previewAlt}
        data-preview-title={title}
        data-preview-host={definition.host}
        data-preview-href={definition.url}
      >
        <span class="sr-only">{ui.zoom}</span>
        <svg
          aria-hidden="true"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          <line x1="11" y1="8" x2="11" y2="14"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </button>
    </div>

    <div class="demo-card__body">
      <p class="demo-card__kind">{kind}</p>

      <div class="demo-card__head">
        {favicon && (
          /* Decorative: the site's name is right beside it in text, so a
             screen reader announcing the icon too would just say it twice. */
          <img
            class="demo-card__favicon"
            src={favicon}
            alt=""
            aria-hidden="true"
            width="20"
            height="20"
            loading="lazy"
            decoding="async"
          />
        )}
        {/* PLAIN TEXT, not a link. The demo's one destination is the call to
            action in the bar below, and its stretched layer already makes this
            heading part of that hit area. A second anchor here would announce
            the same demo twice. */}
        <h3 class="demo-card__title">{title}</h3>
      </div>

      {description && <p class="demo-card__text">{description}</p>}

      {/* The address, as a caption. Pinned to the bottom of the BODY so it sits
          directly on the bar across a row whose descriptions are different
          lengths. It is not a link: it names the host the call to action leads
          to, which is a fact about the card, not a second way to leave. */}
      <p class="demo-card__host">
        <span class="sr-only">{ui.hostLabel}: </span>
        {definition.host}
      </p>
    </div>

    <CardActions
      lang={lang}
      service={serviceLink}
      cta={{
        href: definition.url,
        label: ui.visit,
        external: true,
        hreflang: demo.siteLang ?? undefined,
        // The bar's link is the card's link, so its accessible name has to say
        // which demo it opens — "Demo ansehen" alone would read identically on
        // every card in the shelf.
        detail: title,
      }}
    />
  </div>
</article>

<style>
  .demo-card-slot {
    /* A grid child, not a flex item: under size containment a flex item takes
       its base size from max-content and collapses. Same note as the journal
       card, same reason.

       It is also what the wide-card rules at the bottom of this file query. */
    container-type: inline-size;
  }

  .demo-card {
    /* The section this sits in keeps the plain paper ground, so the card takes
       the sand fill — the inverse of the service grid one section above, where
       sand is the ground and the cards are paper. A borderless card whose fill
       matches its section is not a card. */
    --demo-card-bg: var(--color-soft);
    --demo-card-bg-hover: color-mix(in srgb, var(--color-primary) 6%, var(--color-soft));
    /* Overridden by the wide-card container query at the bottom. */
    --demo-shot-aspect: 16 / 10;

    position: relative;
    display: flex;
    flex-direction: column;
    /* Without it a card in a shorter row stops at its content and the row's
       cards end on different baselines. */
    height: 100%;
    background: var(--demo-card-bg);
    border-radius: 6px;
    overflow: hidden;
    color: inherit;
    transition: background-color 200ms var(--tds-ease-out);
  }
  .demo-card:hover,
  .demo-card:focus-within {
    background: var(--demo-card-bg-hover);
  }
  /* The ring used to come from the card being the focusable element. It is a
     plain box now, and the ring is drawn for it when the bar's call to action
     takes focus — that link's stretched layer IS this card's hit area. The
     rule itself lives in `ui/CardActions.astro`, in the one global block that
     file keeps: the selector needs both this card's class and another
     component's, and an Astro scoped style can only ever name its own. */

  .demo-card__shot {
    position: relative;
    aspect-ratio: var(--demo-shot-aspect);
    overflow: hidden;
    /* Shows through while the screenshot is still loading, and behind a
       capture whose own background is transparent. */
    background: var(--color-paper);
    /* A screenshot of a page has a page edge; without this it bleeds into the
       card's fill and the card reads as a broken layout rather than a picture
       of one. */
    border-bottom: 1px solid color-mix(in srgb, var(--color-black) 8%, transparent);
  }
  .demo-card__shot img {
    display: block;
    width: 100%;
    height: 100%;
    /* `cover` anchored to the top: a demo's hero belongs on the card, and the
       bottom of a 900px capture is whatever happened to be in the fold. */
    object-fit: cover;
    object-position: top center;
    transition: transform 700ms var(--lp-ease-soft);
  }
  .demo-card:hover .demo-card__shot img,
  .demo-card:focus-within .demo-card__shot img {
    transform: scale(1.03);
  }

  .demo-card__zoom {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    /* Above the stretched link, which is what makes this button clickable at
       all — the bar's stretched `::after` covers the entire card. */
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* The shared 44px minimum. */
    width: 2.75rem;
    height: 2.75rem;
    border: none;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-card) 88%, transparent);
    color: var(--color-black);
    cursor: pointer;
    /* Off until the picture is worth a second look — a control permanently
       parked on the screenshot competes with the screenshot. */
    opacity: 0;
    transition:
      opacity 200ms var(--tds-ease-out),
      background-color 200ms var(--tds-ease-out);
  }
  /* MUST stay, and must stay after the rule above: `display: inline-flex`
     out-specifies the user agent's `[hidden] { display: none }`, so the
     attribute the script removes would do nothing without this and the button
     would sit there before its dialog exists. Same trap as the shelf's
     arrows. */
  .demo-card__zoom[hidden] {
    display: none;
  }
  .demo-card:hover .demo-card__zoom,
  .demo-card:focus-within .demo-card__zoom,
  .demo-card__zoom:focus-visible {
    opacity: 1;
  }
  .demo-card__zoom:hover {
    background: var(--color-card);
  }
  .demo-card__zoom:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  /* No hover to reveal it on a touch screen, so it is simply always there. */
  @media (hover: none) {
    .demo-card__zoom {
      opacity: 1;
    }
  }

  .demo-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    padding: 1.125rem 1.25rem 1rem;
  }

  .demo-card__kind {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .demo-card__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .demo-card__favicon {
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    object-fit: contain;
  }
  .demo-card__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-black);
    margin: 0;
    /* A demo's own <title> can be a sentence. Two lines, then it stops. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 200ms var(--tds-ease-out);
  }
  .demo-card:hover .demo-card__title,
  .demo-card:focus-within .demo-card__title {
    color: var(--color-primary);
  }

  .demo-card__text {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .demo-card__host {
    margin: 0;
    /* Pinned to the bottom of the body so the addresses line up across a row
       whose descriptions are different lengths — the bar underneath then lands
       on one line too. */
    margin-top: auto;
    padding-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }

  /* THE LEAD CARD. Two tracks wide on desktop and nothing at all on a phone,
     because the same card is one track wide there. See the header note for
     why the band doubles in WIDTH rather than in height. */
  @container (min-width: 30rem) {
    .demo-card {
      --demo-shot-aspect: 32 / 10;
    }
    .demo-card__body {
      padding: 1.375rem 1.5rem 1.25rem;
    }
    .demo-card__title {
      font-size: 1.625rem;
      -webkit-line-clamp: 1;
      line-clamp: 1;
    }
    .demo-card__text {
      font-size: 0.9375rem;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      max-width: 46ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-card__shot img,
    .demo-card__zoom {
      transition: none;
    }
    .demo-card:hover .demo-card__shot img,
    .demo-card:focus-within .demo-card__shot img {
      transform: none;
    }
  }
</style>
