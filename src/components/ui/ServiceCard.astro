---
interface Props {
  number: string;
  title: string;
  description: string;
  tags: readonly string[];
}

const { number, title, description, tags } = Astro.props;
---

<div class="bg-[var(--color-paper)] p-8 md:p-10 cursor-pointer group transition-colors duration-200 hover:bg-[var(--color-soft)]">
  <span class="text-xs font-medium text-[var(--color-muted)] tracking-widest block mb-6">
    {number}
  </span>
  <h3 class="text-xl font-[var(--font-display)] font-medium text-[var(--color-black)] mb-4">
    {title}
  </h3>
  <p class="text-[var(--color-muted)] text-sm leading-relaxed mb-8">
    {description}
  </p>
  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="px-3 py-1 text-xs rounded-[100px] border border-[var(--color-line)] text-[var(--color-muted)] group-hover:border-[var(--color-primary)] group-hover:text-[var(--color-primary)] transition-colors duration-200">
        {tag}
      </span>
    ))}
  </div>
</div>
