---
interface Props {
  href: string;
  /** Not shown any more — keys the decoration below, i.e. the grid rhythm. */
  number: string;
  title: string;
  description: string;
  /** Plain everyday words, code-owned per service (see `lib/services.ts`). */
  keywords: readonly string[];
  /** Optional background photo under `/images/services/`; null renders none. */
  image?: string | null;
}

const { href, number, title, description, keywords, image = null } = Astro.props;

/**
 * A background for every card, with no asset dependency.
 *
 * The six cards were six identical text boxes: same fill, same rhythm. Now
 * that the number and the icon are gone, this ground is the only thing that
 * tells them apart at a glance, so it carries more weight than before, not
 * less. The brief asks for background imagery, and photography for
 * six abstract services does not exist yet (IMAGES.md tracks it) — so the
 * ground is CONSTRUCTED, from the same shared decoration layer the hero and
 * the section callouts use. Each service gets a different form and tint, so
 * the six read as six things at a glance rather than as one thing repeated.
 *
 * When `image` is filled in, the photo layers OVER this and the geometry
 * keeps showing through the scrim — the card does not become a different
 * component, it gains a layer.
 *
 * Keyed on `number` rather than `id` because the number is the display
 * order, and this is a decision about the visual rhythm of the grid.
 */
const shapes: Record<string, { form: string; tint: string; style: string }> = {
  "01": {
    form: "tds-shape--capsule",
    tint: "tds-shape--navy",
    style: "top: -3rem; left: -6rem; width: 20rem; height: 9rem;",
  },
  "02": {
    form: "tds-shape--quarter-tl",
    tint: "tds-shape--bordeaux",
    style: "bottom: -5rem; right: -4rem; width: 16rem; height: 16rem;",
  },
  "03": {
    form: "tds-shape--rect tds-shape--outline",
    tint: "tds-shape--navy",
    style: "top: 2rem; right: -5rem; width: 13rem; height: 15rem;",
  },
  "04": {
    form: "tds-shape--quarter-br",
    tint: "tds-shape--navy",
    style: "top: -4rem; right: -3rem; width: 14rem; height: 14rem;",
  },
  "05": {
    form: "tds-shape--capsule",
    tint: "tds-shape--coral",
    style: "bottom: -3.5rem; left: 15%; width: 18rem; height: 8rem;",
  },
  "06": {
    form: "tds-shape--quarter-tr",
    tint: "tds-shape--bordeaux",
    style: "bottom: -6rem; left: -6rem; width: 18rem; height: 18rem;",
  },
  "07": {
    form: "tds-shape--half",
    tint: "tds-shape--gold",
    style: "bottom: -6rem; right: -6rem; width: 17rem; height: 17rem;",
  },
};
const shape = shapes[number] ?? shapes["01"];
---

<a
  href={href}
  class="service-card relative flex flex-col h-full overflow-hidden bg-[var(--lp-surface-card)] rounded-[6px] p-6 sm:p-8 md:p-10 group transition-colors duration-200 hover:bg-[color-mix(in_srgb,var(--color-accent-pink)_10%,var(--color-card))] text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-4 focus-visible:ring-offset-[var(--color-soft)]"
  data-reveal
>
  {/* `.tds-decor` is inset-0, click-through and CLIPPING, so each shape is
      authored oversized and cut by the card's own edge — the same grammar
      as the hero. It also lifts every following sibling to `z-index: 1`
      (primitives.css), which is what keeps the copy above the ground
      without a `relative` on each block. */}
  <span class="tds-decor" aria-hidden="true">
    <span class:list={["service-card__shape tds-shape", shape.form, shape.tint]} style={shape.style}></span>
    {image && (
      <>
        <img
          src={image}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          class="service-card__photo absolute inset-0 h-full w-full object-cover"
        />
        {/* Without this the copy sits on whatever the photo happens to be
            doing behind it. The scrim is the CARD's own fill fading out,
            not a grey wash, so the card keeps its colour. */}
        <span
          class="absolute inset-0 bg-[linear-gradient(to_top,var(--lp-surface-card)_28%,color-mix(in_srgb,var(--lp-surface-card)_78%,transparent)_70%,color-mix(in_srgb,var(--lp-surface-card)_55%,transparent)_100%)]"
        ></span>
      </>
    )}
  </span>

  <h3 class="text-2xl font-[var(--font-display)] text-[var(--color-black)] mb-3 leading-tight text-balance break-words">
    {title}
  </h3>
  <p class="text-[var(--color-muted)] text-sm leading-relaxed mb-8 max-w-prose mx-auto">
    {description}
  </p>
  {/* Plain words, not the first three sentences of "Was ich übernehme" —
      a chip three words wide cannot carry a sentence. */}
  <div class="flex flex-wrap gap-2 justify-center mt-auto">
    {keywords.map((keyword) => (
      <span class="px-3 py-1 text-xs rounded-full bg-[color-mix(in_srgb,var(--color-accent)_10%,var(--lp-surface-card))] text-[var(--color-accent)] group-hover:bg-[color-mix(in_srgb,var(--color-accent)_18%,var(--lp-surface-card))] transition-colors duration-200">
        {keyword}
      </span>
    ))}
  </div>
  {/* Der Pfeil war die einzige Affordanz der Karte und stand oben rechts
      neben dem Icon. In einer zentrierten Karte klebte er dort neben der
      Überschrift, also steht er jetzt unter den Chips auf derselben
      Mittelachse — und anders als vorher ist er auch mobil da. */}
  <span
    aria-hidden="true"
    class="mt-6 self-center text-[var(--color-muted)] group-hover:text-[var(--color-primary)] group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-200"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <line x1="7" y1="17" x2="17" y2="7" />
      <polyline points="7 7 17 7 17 17" />
    </svg>
  </span>
</a>

<style>
  /* The ground reacts, gently. Scale rather than travel so nothing can be
     pushed past the card's clipped edge and reveal a gap, and the spring
     is on `transform` only — see the rule in global.css. */
  .service-card__shape {
    transition: transform 420ms var(--lp-ease-bounce);
  }
  .service-card:hover .service-card__shape,
  .service-card:focus-visible .service-card__shape {
    transform: scale(1.08);
  }

  /* Low, but not invisible. This is a GROUND, not an illustration: at
     full strength a photo behind eight lines of copy is a legibility
     problem the scrim then has to undo, which leaves a washed-out
     picture and grey text. Dark mode drops it further — the same reason
     the shared decor tokens dial themselves down there.

     Der erste Durchgang stand hier auf 0.18 und war zu zurueckhaltend:
     die Motive lasen sich als Papierstruktur statt als Bild. Die Werte
     sind gemeinsam angehoben worden, der Abstand zwischen Ruhe, Hover
     und Dark Mode ist derselbe geblieben. */
  .service-card__photo {
    opacity: 0.34;
    transition: transform 700ms var(--lp-ease-soft), opacity 300ms ease;
  }
  .service-card:hover .service-card__photo,
  .service-card:focus-visible .service-card__photo {
    opacity: 0.42;
    transform: scale(1.05);
  }
  :global(:root[data-theme="dark"]) .service-card__photo {
    opacity: 0.22;
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card__shape,
    .service-card__photo {
      transition: none;
      transform: none;
    }
    .service-card:hover .service-card__shape,
    .service-card:focus-visible .service-card__shape,
    .service-card:hover .service-card__photo,
    .service-card:focus-visible .service-card__photo {
      transform: none;
    }
  }
</style>
