---
interface Props {
  href: string;
  title: string;
  description: string;
  keywords: readonly string[];
  /** Photo under `/images/services/`; null renders the tile without a band. */
  image?: string | null;
}

const { href, title, description, keywords, image = null } = Astro.props;
---

{/*
  One tile of the services mosaic.

  This used to be a floating card: a rounded box on sand, told apart from its
  neighbours by the gutter between them and by a decorative `.tds-shape` behind
  the copy. Both of those existed for the same reason, stated in the old
  comment here — photography for the services "does not exist yet", so geometry
  had to do the distinguishing.

  The photographs exist now, so they do the work instead. The shape is gone
  (one accessory removed, not repainted), the gutter is gone with it, and the
  picture is CONTENT in its own band rather than a 34%-opacity ground behind
  eight lines of text. Separation comes from the 1px seam the parent grid
  shows through, which is why this element paints its own fill and must not
  add a margin of its own.

  `object-position: top` is not a taste call: IMAGES.md composes every service
  photo with the subject in the upper two thirds and the lower third empty, so
  a band cropped from the bottom shows table.
*/}
<a
  href={href}
  class="service-tile group relative flex flex-col bg-[var(--lp-surface-card)] transition-colors duration-200 hover:bg-[color-mix(in_srgb,var(--color-accent-pink)_10%,var(--color-card))] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--color-accent)]"
>
  {image && (
    <div class="service-tile__shot" aria-hidden="true">
      <img src={image} alt="" loading="lazy" decoding="async" />
    </div>
  )}

  <div class="flex flex-col flex-1 p-6 sm:p-7 md:p-8">
    <h3 class="font-[var(--font-display)] text-xl md:text-2xl text-[var(--color-black)] mb-3">
      {title}
    </h3>
    <p class="text-sm leading-relaxed text-[var(--color-muted)] mb-6">
      {description}
    </p>

    <ul class="flex flex-wrap gap-2 mt-auto">
      {keywords.map((keyword) => (
        <li class="px-3 py-1 text-xs rounded-full bg-[color-mix(in_srgb,var(--color-accent)_10%,var(--lp-surface-card))] text-[var(--color-accent)] transition-colors duration-200 group-hover:bg-[color-mix(in_srgb,var(--color-accent)_18%,var(--lp-surface-card))]">
          {keyword}
        </li>
      ))}
    </ul>

    <span
      aria-hidden="true"
      class="mt-6 text-[var(--color-accent)] transition-transform duration-200 group-hover:text-[var(--color-primary)] group-hover:translate-x-1 group-hover:-translate-y-1"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="7 7 17 7 17 17"></polyline>
      </svg>
    </span>
  </div>
</a>

<style>
  /* The band reserves its ratio before the image loads, so the mosaic does
     not reflow and shift the seams while the photos arrive. */
  .service-tile__shot {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-paper);
  }
  .service-tile__shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 700ms var(--lp-ease-soft);
  }
  .service-tile:hover .service-tile__shot img,
  .service-tile:focus-visible .service-tile__shot img {
    transform: scale(1.04);
  }

  /* Duration alone is not a reduced-motion implementation — the shared block
     in tds-shared clamps duration to 0.01ms, which still travels. */
  @media (prefers-reduced-motion: reduce) {
    .service-tile__shot img,
    .service-tile:hover .service-tile__shot img,
    .service-tile:focus-visible .service-tile__shot img {
      transition: none;
      transform: none;
    }
  }
</style>
