---
/**
 * The town with a map bubble (2026-10-12: out of `Footer.astro`, so the
 * contact card shows the same one). Postal code and locality come from
 * `siteConfig`, never the CMS string, so they always match the Impressum and
 * the PostalAddress in JSON-LD; the street stays Impressum-only.
 *
 * Hover, focus or a tap opens a bubble with a map of the area: OpenStreetMap
 * through Leaflet, draggable and zoomable, loaded on the first open
 * (`lib/placeMap.ts`), over the drawn map (`ui/PlaceMap.astro`) that stands in
 * until then. Without the script, hover and focus-within show it; with it,
 * `data-open` does, so Escape and a second tap can close it. The bubble is
 * hoverable itself, so the pointer can move onto it (WCAG 1.4.13).
 *
 * Both callers sit on a dark ground; the colours assume one.
 */
import type { Lang } from "~/lib/i18n";
import { siteConfig } from "~/lib/seo";
import PlaceMap from "~/components/ui/PlaceMap.astro";

interface Props {
  lang: Lang;
  /** Unique per page: the trigger's `aria-controls` points at it. */
  id: string;
  /**
   * Which trigger edge the bubble hangs from from `md`: `end` for the footer
   * column at the right of the page, `start` for a trigger at a card's left.
   */
  anchor?: "start" | "end";
  /**
   * The map itself, shown in place, with no trigger and no bubble (the contact
   * card, 2026-10-12). The live map still loads only on the first hover, focus
   * or tap of the map, so nothing goes to OpenStreetMap before that.
   */
  inline?: boolean;
  class?: string;
}

const { lang, id, anchor = "start", inline = false, class: className } = Astro.props;
const inlineLabel =
  lang === "de"
    ? "Karte: Schwarzenbek und Umgebung. Berühren oder fokussieren lädt die interaktive Karte."
    : "Map: Schwarzenbek and surroundings. Touch or focus it to load the interactive map.";
const placeCaption =
  lang === "de"
    ? "Schwarzenbek bei Hamburg · Kreis Herzogtum Lauenburg"
    : "Schwarzenbek near Hamburg · District of Herzogtum Lauenburg";
---

{inline ? (
  <span
    class={`place place--inline${className ? ` ${className}` : ""}`}
    data-place
    data-place-inline
    id={id}
    tabindex="0"
    role="group"
    aria-label={inlineLabel}
  >
    <span class="place__map">
      <PlaceMap lang={lang} />
      <span class="place__live" data-place-live></span>
    </span>
  </span>
) : (
<span class={`place place--${anchor}${className ? ` ${className}` : ""}`} data-place>
  <button
    type="button"
    class="place__trigger footer-link"
    aria-expanded="false"
    aria-controls={id}
  >
    {siteConfig.address.postalCode} {siteConfig.address.addressLocality}
  </button>
  <span class="place__bubble" id={id}>
    <span class="place__card">
      {/* The drawn map is the picture without JavaScript and
          while tiles load; the live map (`lib/placeMap.ts`)
          mounts over it on the first open. */}
      <span class="place__map">
        <PlaceMap lang={lang} />
        <span class="place__live" data-place-live></span>
      </span>
      <span class="place__caption">{placeCaption}</span>
    </span>
  </span>
</span>
)}

<script>
  import type { LiveMap } from "~/lib/placeMap";

  /**
   * The location bubble: open on hover (fine pointer), keyboard focus or a
   * tap; closed on leaving, blur, a second tap or Escape. The first open
   * mounts the live map; it stays open while the map is dragged.
   */
  document.querySelectorAll<HTMLElement>("[data-place]").forEach((place) => {
    const trigger = place.querySelector<HTMLButtonElement>(".place__trigger");
    const live = place.querySelector<HTMLElement>("[data-place-live]");
    const bubble = place.querySelector<HTMLElement>(".place__bubble");
    let map: Promise<LiveMap> | null = null;
    const ensureMap = () => {
      if (!live) return;
      if (!map) {
        const lang = document.documentElement.lang.startsWith("en") ? "en" : "de";
        map = import("~/lib/placeMap").then(({ mountLiveMap }) => mountLiveMap(live, lang));
        map.then(() => place.setAttribute("data-live", "")).catch(() => {
          // No map service: the drawn map stays.
          map = null;
        });
      }
      void map?.then((m) => m.refresh());
    };
    // The map shown in place: the first touch of it loads the live one.
    if (place.hasAttribute("data-place-inline")) {
      const load = () => ensureMap();
      for (const type of ["pointerenter", "pointerdown", "focusin"]) {
        place.addEventListener(type, load, { once: true });
      }
      return;
    }
    if (!trigger) return;
    let busy = () => false;
    const set = (open: boolean) => {
      place.toggleAttribute("data-open", open);
      trigger.setAttribute("aria-expanded", String(open));
      if (open && bubble) {
        // Keep the bubble on screen: measured once it is displayed.
        bubble.style.removeProperty("--place-shift");
        const over = bubble.getBoundingClientRect().right - (document.documentElement.clientWidth - 12);
        if (over > 0) bubble.style.setProperty("--place-shift", `${-Math.ceil(over)}px`);
      }
      if (open) {
        ensureMap();
        void map?.then((m) => (busy = m.busy));
      }
    };
    place.setAttribute("data-enhanced", "");
    const hoverable = window.matchMedia("(hover: hover) and (pointer: fine)");
    // A click right after the pointer opened it must not close it again.
    let openedByHover = false;
    place.addEventListener("pointerenter", () => {
      if (!hoverable.matches) return;
      openedByHover = true;
      set(true);
    });
    place.addEventListener("pointerleave", () => {
      openedByHover = false;
      // A drag on the map may leave the bubble; it closes when the hand lets go outside.
      if (busy()) {
        window.addEventListener(
          "pointerup",
          (event) => {
            if (!place.contains(document.elementFromPoint(event.clientX, event.clientY))) set(false);
          },
          { once: true },
        );
        return;
      }
      if (hoverable.matches && !place.contains(document.activeElement)) set(false);
    });
    trigger.addEventListener("focus", () => {
      if (trigger.matches(":focus-visible")) set(true);
    });
    place.addEventListener("focusout", (event) => {
      if (!place.contains(event.relatedTarget as Node | null)) set(false);
    });
    trigger.addEventListener("click", () => {
      if (openedByHover) {
        openedByHover = false;
        set(true);
        return;
      }
      set(!place.hasAttribute("data-open"));
    });
    place.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !place.hasAttribute("data-open")) return;
      set(false);
      trigger.focus();
    });
  });
</script>

<style>
  /* --- The location bubble ---------------------------------------------- */
  .place {
    position: relative;
    display: inline-block;
  }
  .place__trigger {
    padding: 0;
    border: 0;
    background: none;
    color: rgb(255 255 255 / 0.85);
    font: inherit;
    text-align: left;
    text-decoration: underline dotted rgb(255 255 255 / 0.45);
    text-underline-offset: 0.25em;
    cursor: pointer;
  }
  .place__trigger:hover {
    color: #fff;
  }
  .place__trigger:focus-visible {
    outline: 2px solid var(--color-accent-pink);
    outline-offset: 3px;
    border-radius: 3px;
  }
  /* Above the trigger. The bubble's own bottom padding bridges the gap, so the
     pointer can travel onto it without it closing. Anchored to the trigger's
     left edge on a phone (the column starts at the gutter) and to its right
     edge from `md`, where the column sits at the right of the page. */
  .place__bubble {
    position: absolute;
    bottom: 100%;
    left: 0;
    z-index: 20;
    width: min(22rem, calc(100vw - 3rem));
    /* Pulled back inside the screen when the trigger sits too far right for
       the bubble's width (set by the script on open; a phone overflowed by
       28px). */
    margin-left: var(--place-shift, 0px);
    padding-bottom: 0.75rem;
    /* `display: none` while closed, not `visibility: hidden`: a hidden box
       still counts toward the page's scroll width, and on a phone this one
       made every page with the footer 28px wider than the screen. The fade
       survives through `allow-discrete` and `@starting-style`. */
    display: none;
    opacity: 0;
    translate: 0 0.5rem;
    transition:
      opacity 180ms var(--tds-ease-out),
      translate 180ms var(--tds-ease-out),
      display 180ms allow-discrete;
  }
  @media (min-width: 768px) {
    .place--end .place__bubble {
      left: auto;
      right: 0;
    }
  }
  .place:not([data-enhanced]):is(:hover, :focus-within) .place__bubble,
  .place[data-open] .place__bubble {
    display: block;
    opacity: 1;
    translate: 0 0;
  }
  @starting-style {
    .place:not([data-enhanced]):is(:hover, :focus-within) .place__bubble,
    .place[data-open] .place__bubble {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }
  .place__card {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding: 0.625rem;
    border-radius: 6px;
    background: color-mix(in srgb, #fff 7%, var(--color-surface-navy));
    box-shadow: 6px 6px 0 0 var(--color-accent-pink);
  }
  /* The tail, pointing down at the trigger. */
  .place__card::after {
    content: "";
    position: absolute;
    bottom: -0.375rem;
    left: 1.5rem;
    width: 0.75rem;
    height: 0.75rem;
    background: inherit;
    rotate: 45deg;
  }
  @media (min-width: 768px) {
    .place--end .place__card::after {
      left: auto;
      right: 1.5rem;
    }
  }
  /* The live map lies exactly over the drawn one (same 4:3 box). */
  .place__map {
    position: relative;
    display: block;
    border-radius: 6px;
    overflow: hidden;
  }
  .place__live {
    position: absolute;
    inset: 0;
    display: block;
    visibility: hidden;
    background: transparent;
  }
  .place[data-live] .place__live {
    visibility: visible;
  }
  /* Leaflet's DOM is created at runtime, so these reach it with :global(). The
     tiles are muted toward the site's palette; the controls take its shapes. */
  .place__live :global(.leaflet-tile-pane) {
    filter: grayscale(0.55) contrast(0.95) brightness(1.03);
  }
  .place__live :global(.leaflet-control-zoom) {
    border: 0;
    box-shadow: 3px 3px 0 0 var(--color-accent-pink);
    border-radius: 6px;
    overflow: hidden;
  }
  .place__live :global(.leaflet-control-zoom a) {
    color: var(--color-surface-navy);
  }
  .place__live :global(.leaflet-control-attribution) {
    font-size: 9px;
  }
  .place__live :global(.place-live__label) {
    padding: 2px 8px;
    border: 0;
    border-radius: 9999px;
    background: var(--color-surface-navy);
    box-shadow: none;
    color: #fff;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
  }
  .place__live :global(.place-live__label::before) {
    border-top-color: var(--color-surface-navy);
  }
  /* In place (the contact card): no bubble, no tail, no plate; the map is the card. */
  .place--inline {
    display: block;
    border-radius: 6px;
  }
  .place--inline:focus-visible {
    outline: 2px solid var(--color-accent-pink);
    outline-offset: 3px;
  }
  .place__caption {
    padding: 0 0.25rem 0.125rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: rgb(255 255 255 / 0.75);
  }
  @media (prefers-reduced-motion: reduce) {
    .place__bubble {
      translate: none;
      transition: none;
    }
  }

</style>
