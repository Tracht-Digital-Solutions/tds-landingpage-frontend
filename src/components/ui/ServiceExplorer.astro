---
import { imageHints } from "~/lib/imageCatalog";
/**
 * The services as an INTERACTIVE LIST (2026-09-22) — the home page's
 * services section, replacing the four-tile mosaic.
 *
 * Left, the titles alone (the `tagline` under each went on 2026-10-11; the
 * prop stays for callers); right, one panel: the photo, what I do (the
 * service's `summary`), the typical starting point, the outcome, the scope
 * and the way to the service page. On a phone the same markup is an
 * accordion. Behaviour and its reasons: `lib/serviceExplorer.ts`.
 *
 * Every panel is server-rendered from the SAME resolved content the service
 * pages use (`situations[0]`, `outcomes[0]`, the keywords), so a panel edit
 * moves both. `hidden` is set only by the script: without it, all four
 * panels simply show.
 *
 * The title is an `<h3>` around the button — the disclosure pattern keeps
 * the section's heading outline, which the tiles' `<h3>` links had.
 */
import type { Lang } from "~/lib/i18n";
import { SERVICE_PHOTO_VARIANT_WIDTHS, srcsetFor } from "~/lib/imageVariants";

interface ExplorerService {
  id: string;
  href: string;
  title: string;
  tagline: string;
  summary: string;
  problem: string;
  result: string;
  keywords: readonly string[];
  image: string | null;
}

interface Props {
  services: ExplorerService[];
  lang: Lang;
}

const { services, lang } = Astro.props;
const ui =
  lang === "de"
    ? { summary: "Das mache ich", problem: "Typische Ausgangslage", result: "Ergebnis", scope: "Umfang", more: "Details & Ablauf" }
    : { summary: "What I do", problem: "Typical starting point", result: "Outcome", scope: "Scope", more: "Details & process" };
/** Active editorial service photos are committed at 1536 × 960. */
const PHOTO = { width: 1536, height: 960 };
/**
 * The panel spans EXACTLY the title rows — first to last, nothing after.
 *
 * It used to span one filler row on top of them, and that filler is what let
 * it grow past the list: the panel is the tallest thing in the grid, the
 * filler row took the slack, and the card ended some 300px below the last
 * service (measured at 1440: card 715, titles 417). Bounded by the titles, the
 * photo takes whatever height is left instead of setting it.
 */
const panelRows = "1 / -1";
/*
 * 2026-10-12: "1 / -1" ends at the last EXPLICIT row line, and the grid
 * declared four rows for five services — the card stopped one title short,
 * and its text was cut wherever it was longer than the space left. The row
 * count is `--rows` now, and the panels are back in the track sizing (see
 * the desktop block): the list and the card share one height, and when a
 * text needs more, the title rows grow with it instead of the text being
 * clipped.
 */
---

<div class="svc-explorer" data-service-explorer data-reveal style={`--rows: ${services.length}`}>
  <span class="svc-explorer__marker" aria-hidden="true" data-explorer-marker hidden></span>
  {
    services.map((service, index) => (
      <>
        <h3 class="svc-explorer__head" style={`grid-row: ${index + 1}`}>
          <button
            type="button"
            class="svc-explorer__button"
            id={`svc-button-${service.id}`}
            aria-expanded="true"
            aria-controls={`svc-panel-${service.id}`}
            data-explorer-button
          >
            <span class="svc-explorer__title">{service.title}</span>
            <span class="svc-explorer__chevron" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 6 15 12 9 18" />
              </svg>
            </span>
          </button>
        </h3>
        <div
          class="svc-explorer__panel"
          id={`svc-panel-${service.id}`}
          role="region"
          aria-labelledby={`svc-button-${service.id}`}
          style={`--panel-rows: ${panelRows}`}
        >
          {service.image && (
            <div class="svc-explorer__shot" data-explorer-shot>
              <img
                src={service.image}
                srcset={imageHints(service.image, lang)?.srcSet ?? srcsetFor(service.image, SERVICE_PHOTO_VARIANT_WIDTHS, PHOTO.width)}
                sizes="(min-width: 64rem) 55vw, 100vw"
                alt=""
                width={PHOTO.width}
                height={PHOTO.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="svc-explorer__body" data-explorer-body>
            <dl class="svc-explorer__facts">
              {service.summary && (
                <div>
                  <dt>{ui.summary}</dt>
                  <dd>{service.summary}</dd>
                </div>
              )}
              {service.problem && (
                <div>
                  <dt>{ui.problem}</dt>
                  <dd>{service.problem}</dd>
                </div>
              )}
              {service.result && (
                <div>
                  <dt>{ui.result}</dt>
                  <dd>{service.result}</dd>
                </div>
              )}
              {service.keywords.length > 0 && (
                <div>
                  <dt>{ui.scope}</dt>
                  <dd>
                    <ul class="svc-explorer__chips">
                      {service.keywords.map((keyword) => (
                        <li>{keyword}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )}
            </dl>
            <a href={service.href} class="svc-explorer__more">
              {ui.more}
              <span class="sr-only">: {service.title}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </>
    ))
  }
</div>

<style>
  .svc-explorer {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* --- Titles ------------------------------------------------------- */
  .svc-explorer__head {
    position: relative;
    z-index: 1;
    margin: 0;
  }
  .svc-explorer__button {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
    align-items: center;
    width: 100%;
    min-height: 3.5rem;
    padding: 1.125rem 1.25rem;
    border: none;
    border-radius: 6px;
    --lp-fill: var(--lp-surface-card);
    --lp-shade: initial;
    background: var(--lp-fill);
    box-shadow: var(--tds-shadow-hard-sm);
    color: var(--color-black);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 200ms var(--tds-ease-out),
      color 200ms var(--tds-ease-out),
      translate 200ms var(--tds-ease-out);
  }
  .svc-explorer__button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  /* Hover lifts a title toward the pointer (the open one on the desktop is
     painted by the marker and stays put). */
  .svc-explorer__button:is(:hover, :focus-visible):not(:active) {
    translate: -2px -2px;
    box-shadow: var(--tds-shadow-hard-sm-hover);
  }
  .svc-explorer__button:active {
    translate: 2px 2px;
    box-shadow: var(--tds-shadow-hard-press);
  }
  .svc-explorer__title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.75rem);
    font-weight: 500;
    line-height: 1.2;
  }
  .svc-explorer__chevron {
    grid-column: 2;
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    transition: rotate 260ms var(--lp-ease-bounce, var(--tds-ease-out));
  }
  /* The accordion turns the chevron down when a panel is open. */
  .svc-explorer__button[aria-expanded="true"] .svc-explorer__chevron {
    rotate: 90deg;
  }
  .svc-explorer__button[aria-expanded="true"] {
    background: var(--color-surface-navy);
    color: #fff;
  }
  .svc-explorer__button[aria-expanded="true"] .svc-explorer__chevron {
    background: rgb(255 255 255 / 0.16);
    color: #fff;
  }
  @media (hover: hover) {
    .svc-explorer__button[aria-expanded="false"]:hover {
      background: color-mix(in srgb, var(--color-accent-pink) 14%, var(--lp-surface-card));
    }
  }
  /* Before the script: every panel shows, so no title claims to be the one
     that is open. */
  .svc-explorer:not([data-enhanced]) .svc-explorer__chevron {
    display: none;
  }
  .svc-explorer:not([data-enhanced]) .svc-explorer__button {
    background: var(--lp-surface-card);
    color: var(--color-black);
  }

  /* --- Panel ------------------------------------------------------- */
  .svc-explorer__panel {
    border-radius: 6px;
    overflow: hidden;
    background: var(--lp-surface-card);
    box-shadow: var(--tds-shadow-hard);
  }
  .svc-explorer__panel[hidden] {
    display: none;
  }
  .svc-explorer__shot {
    aspect-ratio: 21 / 9;
    overflow: hidden;
    background: var(--color-paper);
  }
  .svc-explorer__shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* IMAGES.md composes every service photo with the subject in the upper
       two thirds. */
    object-position: top center;
  }
  .svc-explorer__body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
  }
  .svc-explorer__facts {
    display: grid;
    gap: 1rem;
    margin: 0;
  }
  .svc-explorer__facts dt {
    margin-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .svc-explorer__facts dd {
    margin: 0;
    color: var(--color-black);
    line-height: 1.55;
  }
  .svc-explorer__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.375rem 0 0;
    padding: 0;
    list-style: none;
  }
  .svc-explorer__chips li {
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-accent) 10%, var(--lp-surface-card));
    color: var(--color-accent);
    font-size: 0.75rem;
  }
  .svc-explorer__more {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 9999px;
    --lp-fill: var(--color-surface-navy);
    --lp-shade: var(--color-accent-pink);
    background: var(--lp-fill);
    box-shadow: var(--tds-shadow-hard-sm);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 200ms var(--tds-ease-out),
      translate 200ms var(--tds-ease-out);
  }
  .svc-explorer__more:hover {
    --lp-fill: var(--color-surface-accent);
    --lp-shade: initial;
  }
  /* Dark mode (2026-10-05): navy on the near-black ground measured 1.3–1.6:1
     against it — the button was barely there. The CTA takes the dark
     theme's pastel pair instead: periwinkle `--color-primary` with dark
     `--color-on-primary`, coral `--color-accent` on hover. In the light theme
     nothing here applies. */
  :global(:root[data-theme="dark"]) .svc-explorer__more {
    --lp-fill: var(--color-primary);
    --lp-shade: var(--color-accent-pink);
    color: var(--color-on-primary);
  }
  :global(:root[data-theme="dark"]) .svc-explorer__more:hover {
    --lp-fill: var(--color-accent);
    --lp-shade: initial;
    color: var(--color-on-accent);
  }
  .svc-explorer__more:is(:hover, :focus-visible):not(:active) {
    translate: -2px -2px;
    box-shadow: var(--tds-shadow-hard-sm-hover);
  }
  .svc-explorer__more:active {
    translate: 2px 2px;
    box-shadow: var(--tds-shadow-hard-press);
  }
  .svc-explorer__more:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* The marker is only a desktop idea (it slides behind the open title). */
  .svc-explorer__marker {
    display: none;
  }

  /* --- Desktop: list left, panel right ------------------------------ */
  @media (min-width: 64rem) {
    /* Only once the script runs: without it every panel is open, and four
       panels in one grid cell would lie on top of each other. */
    .svc-explorer[data-enhanced] {
      /* The containing block for the panel, which is taken out of flow below. */
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
      /* No filler row any more — see `panelRows` above. */
      grid-template-rows: repeat(var(--rows, 5), auto);
      column-gap: 2rem;
      row-gap: 0.75rem;
      align-items: stretch;
    }
    .svc-explorer[data-enhanced] .svc-explorer__head {
      grid-column: 1;
    }
    /* A title row that grew for a long card keeps its button filling it. */
    .svc-explorer[data-enhanced] .svc-explorer__button {
      height: 100%;
    }
    /* ONE HEIGHT FOR LIST AND CARD (2026-09-28, asked for; reworked
       2026-10-12). Every panel stays laid out in the same area, spanning
       all title rows, and a closed one is only invisible. The area is as
       tall as the list or the tallest card, whichever is more; extra height
       goes to the title rows. So the card is never shorter than the list,
       never longer, and no text is cut — and switching moves nothing.

       Until 2026-10-12 the panel was taken out of the track sizing
       (`position: absolute; inset: 0`) and clipped whatever did not fit:
       up to 172 px of text at 1024 px. */
    .svc-explorer[data-enhanced] .svc-explorer__panel {
      grid-column: 2;
      grid-row: var(--panel-rows);
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    /* The switch's END STATES only. The motion between them is the script's
       (`animateSwitch`, Web Animations, 2026-10-19): the old card leaves
       against the direction of travel while the new one comes in with it,
       the photo settling and the facts following one by one. Until then the
       cards crossfaded on one CSS transition, and because a closed card's
       offset was the same `--dir` the old one left by, both moved the same
       way — the switch read as a flicker, not as cards changing places. */
    .svc-explorer[data-enhanced] .svc-explorer__panel[data-closed] {
      visibility: hidden;
      opacity: 0;
    }
    .svc-explorer[data-enhanced] .svc-explorer__panel:not([data-closed]) {
      z-index: 1;
      visibility: visible;
      opacity: 1;
    }
    /* The PHOTO absorbs the difference. It is the one part of the panel with
       no information in its height: the text underneath says the same thing at
       any size, a band of a photograph does not. `cover` keeps the framing. */
    .svc-explorer__shot {
      flex: 1 1 7rem;
      min-height: 7rem;
      aspect-ratio: auto;
    }
    /* A band this shallow crops to a strip, and a centred strip of a
       photograph is usually its emptiest part — the middle distance. Lifting
       the crop slightly keeps the subject in it. */
    .svc-explorer__shot img {
      object-position: 50% 38%;
    }
    .svc-explorer__body {
      flex: none;
    }
    .svc-explorer__body {
      padding: 2rem;
    }
    .svc-explorer__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
    .svc-explorer__facts > div:last-child {
      grid-column: 1 / -1;
    }
    /* On the desktop the OPEN title is not painted by the button itself:
       a navy marker slides behind it from title to title. */
    .svc-explorer[data-enhanced] .svc-explorer__button[aria-expanded="true"] {
      background: transparent;
      box-shadow: none;
    }
    .svc-explorer[data-enhanced] .svc-explorer__button[aria-expanded="true"] .svc-explorer__chevron {
      rotate: 0deg;
    }
    .svc-explorer__marker:not([hidden]) {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      z-index: 0;
      width: var(--marker-w, 0px);
      height: var(--marker-h, 0px);
      translate: 0 var(--marker-y, 0px);
      border-radius: 6px;
      background: var(--color-surface-navy);
      /* Navy fill, so a coral offset — never the navy ink (tds-shared rule). */
      box-shadow: 3px 3px 0 0 var(--color-accent-pink);
      /* 260ms, down from 380 (2026-09-29). The marker is the fastest signal
         that the click landed, so it must not be the slowest thing on screen —
         it now settles before the panel's own spring does. The bounce still
         reads at this length; below ~200ms it flattens into a slide. */
      transition:
        translate 520ms var(--lp-ease-spring, var(--tds-ease-out)),
        height 260ms var(--tds-ease-out);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-explorer[data-enhanced] .svc-explorer__panel,
    .svc-explorer[data-enhanced] .svc-explorer__panel[data-closed],
    .svc-explorer__shot img,
    .svc-explorer__marker:not([hidden]),
    .svc-explorer__chevron,
    .svc-explorer__button,
    .svc-explorer__more {
      transition: none;
    }
  }
</style>

<script>
  import { EXPLORER_DESKTOP_QUERY, mountServiceExplorer } from "~/lib/serviceExplorer";
  import { lessMotion } from "~/lib/a11yPrefs";
  import { keepInView } from "~/lib/keepInView";

  /**
   * Motion, WARMED BEFORE THE FIRST SWITCH RATHER THAN DURING IT.
   *
   * It used to be imported inside `onOpen`, which is what made the switch feel
   * late (reported 2026-09-29). `show()` unhides the panel synchronously, so
   * the content was already on screen by the time the module arrived — and the
   * animation then started from `opacity: 0` and faded the visible panel in a
   * second time, one network round trip after the click. The durations were the
   * smaller half of the problem.
   *
   * So: warm it on the first sign of interest, and if it still has not arrived
   * when a panel opens, animate NOTHING. A panel that simply appears reads as
   * instant; a panel that appears and then fades in reads as broken.
   */
  type MotionDom = typeof import("@tracht-digital-solutions/tds-shared/motion/dom");
  let motion: MotionDom | null = null;
  let warming = false;

  const warmMotion = () => {
    if (motion || warming || lessMotion()) return;
    warming = true;
    void import("@tracht-digital-solutions/tds-shared/motion/dom")
      .then((module) => {
        motion = module;
      })
      .catch(() => {
        // Stays null, so every switch is a plain unhide. Nothing to report.
      });
  };

  /**
   * The desktop switch: cards changing places, not one picture fading into
   * the next.
   *
   * Plain Web Animations, so the very first hover animates like the tenth
   * (no module to wait for, unlike `warmMotion`). Transform and opacity only;
   * nothing here relayouts. A new switch cancels the running one, so a pointer
   * running down the list never stacks them.
   */
  const SPRING =
    getComputedStyle(document.documentElement).getPropertyValue("--lp-ease-spring").trim() ||
    "cubic-bezier(0.22, 1, 0.36, 1)";
  const SOFT = "cubic-bezier(0.22, 1, 0.36, 1)";
  const running = new Set<Animation>();
  const play = (el: Element | null, frames: Keyframe[], timing: KeyframeAnimationOptions) => {
    if (!el) return;
    const animation = el.animate(frames, { fill: "backwards", ...timing });
    running.add(animation);
    void animation.finished.catch(() => undefined).finally(() => running.delete(animation));
  };
  const animateSwitch = (panel: HTMLElement, previous: HTMLElement | null, dir: 1 | -1) => {
    running.forEach((animation) => animation.cancel());
    running.clear();
    if (previous && previous !== panel) {
      // Held visible for its own exit; the CSS end state hides it afterwards.
      play(
        previous,
        [
          { visibility: "visible", opacity: 1, translate: "0 0", scale: "1" },
          { visibility: "visible", opacity: 0, translate: `0 ${dir * -1.5}rem`, scale: "0.97" },
        ],
        { duration: 200, easing: "cubic-bezier(0.4, 0, 1, 1)", fill: "none" },
      );
    }
    play(
      panel,
      [
        { opacity: 0, translate: `0 ${dir * 2.25}rem`, scale: "0.97" },
        { opacity: 1, translate: "0 0", scale: "1" },
      ],
      { duration: 640, delay: 70, easing: SPRING },
    );
    play(panel.querySelector("[data-explorer-shot] img"), [{ scale: "1.08" }, { scale: "1" }], {
      duration: 900,
      delay: 70,
      easing: SOFT,
    });
    panel
      .querySelectorAll("[data-explorer-body] dl > div, [data-explorer-body] > a")
      .forEach((row, index) => {
        play(
          row,
          [
            { opacity: 0, translate: `0 ${dir * 0.75}rem` },
            { opacity: 1, translate: "0 0" },
          ],
          { duration: 420, delay: 170 + index * 55, easing: SOFT },
        );
      });
  };

  document.querySelectorAll<HTMLElement>("[data-service-explorer]").forEach((root) => {
    // Interest, in the three ways it can arrive. `once` on each: the module is
    // fetched one time and cached in `motion` from then on.
    root.addEventListener("pointerenter", warmMotion, { once: true });
    root.addEventListener("focusin", warmMotion, { once: true });
    root.addEventListener("touchstart", warmMotion, { once: true, passive: true });

    mountServiceExplorer(root, {
      onOpen: (panel, previous, dir) => {
        if (window.matchMedia(EXPLORER_DESKTOP_QUERY).matches) {
          if (!lessMotion()) animateSwitch(panel, previous, dir);
          return;
        }
        // The accordion: the tapped title and its panel come fully on screen
        // (a row closed above it may just have pulled it upwards).
        const title = root.querySelector<HTMLElement>(`[aria-controls="${panel.id}"]`);
        keepInView(title ?? panel, panel);
        // From 64rem the switch is `animateSwitch` above; Motion only
        // animates the phone's accordion.
        if (lessMotion()) return;
        // Not loaded yet (a click inside the first few hundred milliseconds, or
        // a failed fetch): leave the panel as it is. See the note above.
        if (!motion) {
          warmMotion();
          return;
        }
        // The photo settles from a hair larger, the text rises. Short: this is
        // a control responding, not content arriving — the panel's photo is
        // server-rendered and was already on screen a moment ago.
        const { animate } = motion;
        const shot = panel.querySelector<HTMLElement>("[data-explorer-shot] img");
        const body = panel.querySelector<HTMLElement>("[data-explorer-body]");
        if (shot) void animate(shot, { scale: [1.04, 1], opacity: [0.55, 1] }, { type: "spring", bounce: 0, visualDuration: 0.3 });
        if (body) void animate(body, { y: [10, 0], opacity: [0, 1] }, { type: "spring", bounce: 0.2, visualDuration: 0.24 });
      },
    });
  });
</script>
