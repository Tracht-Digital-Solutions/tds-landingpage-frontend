---
interface Props {
  aspect?: string;
  label: string;
  description: string;
}

const { aspect = "aspect-[4/3]", label, description } = Astro.props;
---

{/* `--color-card`, not `--color-soft`: this frame renders on BOTH grounds —
    inside a paper card and directly on a `.tds-tone-sand` section — and soft
    IS the sand ground, so it vanished there once the border was removed. Card
    is the only fill that reads against both. */}
<div class:list={["relative overflow-hidden bg-[var(--color-card)] rounded-[6px]", aspect]}>
  <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center">
    <span class="text-xs font-medium tracking-widest uppercase text-[var(--color-muted)] mb-3">
      {label}
    </span>
    <span class="text-sm text-[var(--color-muted)] max-w-xs leading-relaxed">
      {description}
    </span>
  </div>
</div>
