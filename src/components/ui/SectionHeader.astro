---
/**
 * Shared section masthead — display headline with italic accent word.
 * Used by Services / Process / FAQ / Journal so
 * every section opens the same way.
 *
 * NO eyebrow. The site used to prefix each headline with a numbered
 * chapter mark ("— 01 / Über mich", `.section-num`); those are gone
 * from this site — the headline opens the section. `.section-num`
 * itself stays in tds-shared for the blog + legacy portal.
 *
 * Dark-mode flips the headline to white and switches the italic accent
 * to --color-accent-pink for legibility against the dark backgrounds
 * (Contact).
 */
import AccentLetters from "~/components/ui/AccentLetters.astro";

interface Props {
  headline: string;
  headlineAccent: string;
  id: string;
  dark?: boolean;
  headingClass?: string;
  /**
   * Render the three-part brand accent (bordeaux · coral · gold) under
   * the headline.
   *
   * OPT-IN, and deliberately so. The brand direction is explicit —
   * "Nicht in jedem Abschnitt verwenden" — and this component is used by
   * seven sections, so a default of `true` would turn a punctuation mark
   * into wallpaper and it would stop meaning anything. Three chapters
   * carry it today (About, Process, Contact).
   */
  bar?: boolean;
}

const {
  headline,
  headlineAccent,
  id,
  dark = false,
  headingClass = "mb-16",
  bar = false,
} = Astro.props;

// With the bar showing, the headline's own bottom margin moves to the
// bar so the section's rhythm below the masthead is unchanged.
const headingSpacing = bar ? "mb-5" : headingClass;
---

{/* `data-reveal` (2026-09-29): every section masthead now arrives with the
    content under it instead of standing there while the cards below it fade in.
    The cards, the FAQ rows and the service list were already revealed — the
    headings were the one part that never was, which is what made the entrance
    look like it belonged to the cards rather than to the section.

    One place, seven sections. It is NEVER the hero: that is an `<h1>` outside
    this component, it is the LCP element (`audit:perf` pins it to
    `h1#hero-heading`), and `tds-reveal`'s own contract in tds-shared forbids it
    there. The hidden state sits behind `html[data-reveal-active]`, which only
    `lib/reveal.ts` sets, so with no JavaScript this renders fully visible. */}
<div class="text-center md:text-left" data-reveal>
  <h2
    id={id}
    class:list={[
      "display text-4xl md:text-5xl lg:text-6xl",
      dark ? "text-white" : "text-[var(--color-black)]",
      headingSpacing,
    ]}
  >
    {headline}{" "}
    <AccentLetters text={headlineAccent} tone={dark ? "dark" : "light"} />
  </h2>
  {
    bar && (
      /* Decorative punctuation, not content — `aria-hidden` keeps it out
         of the accessibility tree, and it is centred with the masthead on
         phones the same way the type is. */
      <span
        aria-hidden="true"
        class:list={[
          "tds-brandbar mx-auto md:mx-0",
          dark ? "tds-brandbar--on-dark" : null,
          headingClass,
        ]}
      />
    )
  }
</div>
