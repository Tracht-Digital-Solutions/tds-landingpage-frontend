---
/**
 * Shared section masthead — eyebrow + display headline with italic
 * accent word. Used by About / Services / Tech / Portfolio / Process /
 * Journal / Contact so each section reads as a numbered chapter in
 * one publication.
 *
 * Dark-mode flips the eyebrow rule + headline to white and switches
 * the italic accent to --color-accent-pink for legibility against the
 * dark backgrounds (Tech, Contact, PricingTeaser callout).
 */
interface Props {
  label: string;
  headline: string;
  headlineAccent: string;
  id: string;
  dark?: boolean;
  labelClass?: string;
  headingClass?: string;
}

const {
  label,
  headline,
  headlineAccent,
  id,
  dark = false,
  labelClass = "mb-6",
  headingClass = "mb-16",
} = Astro.props;
---

<p
  class:list={[
    "section-num",
    dark ? "text-white/60" : null,
    labelClass,
  ]}
>
  {label}
</p>
<h2
  id={id}
  class:list={[
    "display text-4xl md:text-5xl lg:text-6xl",
    dark ? "text-white" : "text-[var(--color-black)]",
    headingClass,
  ]}
>
  {headline}{" "}
  <em
    class:list={[
      "not-italic italic",
      dark ? "text-[var(--color-accent-pink)]" : "text-[var(--color-accent)]",
    ]}
    style="font-variation-settings: 'opsz' 144"
  >
    {headlineAccent}
  </em>
</h2>
