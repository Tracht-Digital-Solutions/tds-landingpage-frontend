---
import ProcessIcon from "./ProcessIcon.astro";

interface Props {
  number: string;
  title: string;
  duration: string;
  description: string;
  isLast?: boolean;
}

const { number, title, duration, description } = Astro.props;
---

<div class="relative flex gap-4 md:gap-6 py-5 md:py-6 group cursor-default">
  {/* Numbered marker. The Process section wraps this column in a
      vertical gradient spine + start/end caps, so the marker just
      needs to punch through that line. The ring matches the section
      bg (--color-soft) so the spine doesn't bleed under the circle. */}
  <div class="relative flex-shrink-0">
    <span
      aria-hidden="true"
      class="relative z-10 inline-flex items-center justify-center w-11 h-11 md:w-12 md:h-12 rounded-full bg-[var(--color-paper)] text-[var(--color-accent)] ring-4 ring-[var(--color-soft)] group-hover:scale-110 transition-transform duration-300"
    >
      <ProcessIcon number={number} />
    </span>
  </div>

  <div class="flex-1 min-w-0 pb-2 md:hover:translate-x-2 transition-transform duration-200">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
      <span class="text-xs font-medium tracking-widest text-[var(--color-muted)] tabular-nums">
        {number}
      </span>
      <h3 class="text-lg font-[var(--font-display)] font-medium text-[var(--color-black)]">
        {title}
      </h3>
      <span class="text-xs text-[var(--color-muted)] bg-[var(--color-card)] px-2.5 py-1 rounded-[100px]">
        {duration}
      </span>
    </div>
    <p class="text-sm text-[var(--color-muted)] leading-relaxed">
      {description}
    </p>
  </div>
</div>
