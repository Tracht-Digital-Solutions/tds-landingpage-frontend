---
import ProcessIcon from "./ProcessIcon.astro";

/**
 * One step of the home page's process list: marker, number, title, duration,
 * what happens, and what the visitor has afterwards.
 *
 * The OUTCOME line used to live in a detail panel beside the list that opened
 * only on hover or when the list item itself took keyboard focus — and to take
 * focus, each `<li>` carried `tabindex="0"` with no role and no name, i.e. a
 * focus stop that announced nothing. The panel was also `aria-hidden`, so a
 * screen reader never got the outcome at all. It is part of the step now,
 * visible to everyone, and nothing here is focusable because nothing here is
 * interactive.
 */
interface Props {
  number: string;
  title: string;
  duration: string;
  description: string;
  /** "Ergebnis: …" — what the visitor holds after this step. Optional for CMS blocks without it. */
  outcome?: string;
}

const { number, title, duration, description, outcome = "" } = Astro.props;
---

<div class="relative flex gap-4 md:gap-6 py-5 md:py-6">
  {/* Numbered marker. The Process section wraps this column in a
      vertical gradient spine + start/end caps, so the marker just
      needs to punch through that line. The ring matches the section
      bg (--color-soft) so the spine doesn't bleed under the circle. */}
  <div class="relative flex-shrink-0">
    <span
      aria-hidden="true"
      class="relative z-10 inline-flex items-center justify-center w-11 h-11 md:w-12 md:h-12 rounded-full bg-[var(--color-paper)] text-[var(--color-accent)] ring-4 ring-[var(--color-soft)]"
    >
      <ProcessIcon number={number} />
    </span>
  </div>

  <div class="flex-1 min-w-0 pb-2">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
      {/* The order is carried by the `<ol>`; the numeral is for the eye. */}
      <span aria-hidden="true" class="text-xs font-medium tracking-widest text-[var(--color-muted)] tabular-nums">
        {number}
      </span>
      <h3 class="text-lg font-[var(--font-display)] font-medium text-[var(--color-black)]">
        {title}
      </h3>
      <span class="text-xs text-[var(--color-muted)] bg-[var(--color-card)] px-2.5 py-1 rounded-[100px]">
        {duration}
      </span>
    </div>
    <p class="text-sm text-[var(--color-muted)] leading-relaxed">
      {description}
    </p>
    {outcome && (
      <p class="mt-3 text-sm font-medium text-[var(--color-accent)]">
        {outcome}
      </p>
    )}
  </div>
</div>
