---
import ProcessIcon from "./ProcessIcon.astro";

interface Props {
  number: string;
  title: string;
  duration: string;
  description: string;
  isLast?: boolean;
}

const { number, title, duration, description, isLast = false } = Astro.props;
---

<div class="relative flex gap-4 md:gap-6 py-6 md:py-8 group cursor-default">
  {/* Numbered marker with icon + a connecting line that runs down to
      the next step. The line stops at the last step so the chain
      doesn't dangle past the section. */}
  <div class="relative flex-shrink-0 flex flex-col items-center">
    <span
      aria-hidden="true"
      class="relative z-10 inline-flex items-center justify-center w-11 h-11 md:w-12 md:h-12 rounded-full bg-[var(--color-paper)] border border-[var(--color-line)] text-[var(--color-accent)] group-hover:bg-[var(--color-accent)] group-hover:text-white group-hover:border-[var(--color-accent)] group-hover:scale-110 transition-all duration-300"
    >
      <ProcessIcon number={number} />
    </span>
    {
      !isLast && (
        <span
          aria-hidden="true"
          class="absolute left-1/2 top-11 md:top-12 -translate-x-1/2 w-px h-[calc(100%+0.75rem)] bg-gradient-to-b from-[var(--color-line)] to-transparent"
        />
      )
    }
  </div>

  <div class="flex-1 min-w-0 pb-2 md:hover:translate-x-2 transition-transform duration-200">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
      <span class="text-xs font-medium tracking-widest text-[var(--color-muted)] tabular-nums">
        {number}
      </span>
      <h3 class="text-lg font-[var(--font-display)] font-medium text-[var(--color-black)]">
        {title}
      </h3>
      <span class="text-xs text-[var(--color-muted)] bg-white px-2.5 py-1 rounded-[100px]">
        {duration}
      </span>
    </div>
    <p class="text-sm text-[var(--color-muted)] leading-relaxed">
      {description}
    </p>
  </div>
</div>
