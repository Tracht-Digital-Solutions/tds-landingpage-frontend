---
interface Props {
  number: string;
  title: string;
  duration: string;
  description: string;
}

const { number, title, duration, description } = Astro.props;
---

<div class="flex gap-8 py-8 border-b border-[var(--color-line)] group cursor-default transition-transform duration-200 hover:translate-x-4">
  <div class="flex-shrink-0 w-10 text-sm font-medium text-[var(--color-muted)] pt-0.5">
    {number}
  </div>
  <div class="flex-1">
    <div class="flex items-baseline gap-3 mb-2">
      <h3 class="text-lg font-[var(--font-display)] font-medium text-[var(--color-black)]">
        {title}
      </h3>
      <span class="text-xs text-[var(--color-muted)] bg-[var(--color-soft)] px-2.5 py-1 rounded-[100px]">
        {duration}
      </span>
    </div>
    <p class="text-sm text-[var(--color-muted)] leading-relaxed">{description}</p>
  </div>
</div>
