---
/**
 * Interactive italic accent. Splits `text` into per-character <span>s so each
 * letter can react on hover (colour cycle through the brand palette + lift +
 * tilt). Siblings nudge the opposite way on group-hover so the whole word
 * reads as coupled.
 *
 * The visual styles live in `src/styles/global.css` under
 * `.accent-letters / .accent-letter`.
 *
 * Accessibility — the word is spoken ONCE, and from real text:
 * - a visually hidden copy of the word carries it for assistive tech;
 * - the per-character glyphs sit in one `aria-hidden` wrapper.
 *
 * This used to be `aria-label` on the wrapper `<span>`. A span has no role,
 * and ARIA prohibits naming a generic element (axe `aria-prohibited-attr`,
 * serious): assistive tech may ignore such a label, and then there was nothing
 * left to read, because the glyphs were hidden. Ten headings on the home page
 * carried it, so ten headings could lose their accent word.
 *
 * The spans are written on ONE line on purpose: whitespace between the hidden
 * copy and the glyphs would render as a visible gap before the word.
 *
 * The H1 does not use this component. Its accent word is a single span — the
 * page's most important heading should not be a row of letter boxes.
 *
 * Set `tone="dark"` on the navy grounds so the hover palette switches to white
 * + bright pink.
 */
interface Props {
  text: string;
  tone?: "light" | "dark";
  class?: string;
}

const { text, tone = "light", class: className = "" } = Astro.props;
const chars = Array.from(text);
---

<span class:list={["accent-letters", className]} data-tone={tone}><span class="sr-only">{text}</span><span class="accent-letters__glyphs" aria-hidden="true">{chars.map((char) => <span class="accent-letter">{char === " " ? " " : char}</span>)}</span></span>
