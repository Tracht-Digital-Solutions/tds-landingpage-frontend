---
interface Props {
  number: string;
  class?: string;
}

const { number, class: className = "" } = Astro.props;
---

<svg
  class={className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {number === "01" && (
    <>
      <path d="M4 5.5h16v10H9l-5 4v-14Z" />
      <path d="M8 9h8M8 12h5" />
    </>
  )}
  {number === "02" && (
    <>
      <rect x="2.5" y="3" width="6" height="6" rx="1" />
      <rect x="15.5" y="3" width="6" height="6" rx="1" />
      <rect x="9" y="15" width="6" height="6" rx="1" />
      <path d="M8.5 6h7M5.5 9l5 6M18.5 9l-5 6" />
    </>
  )}
  {number === "03" && (
    <>
      <path d="M8.5 7.5 5 11a4 4 0 0 0 5.7 5.7l2.1-2.1" />
      <path d="m15.5 16.5 3.5-3.5a4 4 0 0 0-5.7-5.7l-2.1 2.1" />
      <path d="m9 15 6-6" />
    </>
  )}
  {number === "04" && (
    <>
      <path d="m8 6-5 6 5 6M16 6l5 6-5 6M14 3l-4 18" />
    </>
  )}
  {number === "05" && (
    <>
      <rect x="2.5" y="3.5" width="19" height="16" rx="2" />
      <path d="M2.5 8.5h19" />
      <circle cx="5.5" cy="6" r=".6" fill="currentColor" stroke="none" />
      <circle cx="7.5" cy="6" r=".6" fill="currentColor" stroke="none" />
    </>
  )}
  {number === "06" && (
    <>
      <path d="M12 2.5 20 6v5.5c0 4.8-3.2 8.2-8 10-4.8-1.8-8-5.2-8-10V6l8-3.5Z" />
      <path d="m8.5 12 2.2 2.2 4.8-5" />
    </>
  )}
</svg>
