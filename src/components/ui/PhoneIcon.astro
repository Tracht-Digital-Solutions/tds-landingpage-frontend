---
/**
 * The two phone glyphs (2026-11-03, asked for): the landline is a desk
 * telephone, the mobile a handset. One component, so the contact card and the
 * footer can never drift apart.
 */
interface Props {
  kind: "landline" | "mobile";
  size?: number;
}

const { kind, size = 18 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    kind === "landline" ? (
      <>
        <path d="M3 9.5C3 6.9 7 5 12 5s9 1.9 9 4.5v1a1 1 0 0 1-1 1h-2.5a1 1 0 0 1-1-1V9.3A13 13 0 0 0 12 8.6a13 13 0 0 0-4.5.7v1.2a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z" />
        <path d="M7.5 12.5 5 19h14l-2.5-6.5" />
        <circle cx="12" cy="15.5" r="1.5" />
      </>
    ) : (
      <>
        <rect x="6" y="2" width="12" height="20" rx="2.5" />
        <path d="M11 18h2" />
      </>
    )
  }
</svg>
