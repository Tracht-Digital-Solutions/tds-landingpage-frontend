---
/**
 * One certificate: the document itself, then who issued it, when, and what it
 * covered.
 *
 * ### Why the picture is `contain` and not `cover`
 *
 * Every other card on this site crops its picture to a band — a screenshot's
 * hero is the part worth showing and the rest is fold. A certificate has no
 * such part. It is one page with a title, a name, a date and an id, and a
 * cropped certificate is an unreadable certificate. So the band keeps the
 * document's own ratio and shows all of it, on the paper colour, and the
 * enlargement is for reading the small print rather than for seeing more.
 *
 * ### Why the title is not translated
 *
 * It is the name of a document. The German page shows the English title
 * printed on the paper and puts the German sentence underneath, which is what
 * a translated title would only pretend to be — a visitor comparing the card
 * with the picture has to find the same words in both.
 */
import {
  formatCompleted,
  formatDuration,
  credentialImageSrc,
  type Credential,
} from "~/lib/credentials";
import { CREDENTIAL_IMAGE } from "~/lib/credentialMeta";
import type { Lang } from "~/lib/i18n";
import { PREVIEW_VARIANT_WIDTHS, srcsetFor } from "~/lib/imageVariants";
import { mediaSrc } from "~/lib/mediaSrc";
import CardActions from "~/components/ui/CardActions.astro";

interface Props {
  credential: Credential;
  lang: Lang;
}

const { credential, lang } = Astro.props;

const ui =
  lang === "de"
    ? { open: "Zertifikat ansehen", idLabel: "Zertifikat-Nr.", skillsLabel: "Inhalte" }
    : { open: "View the certificate", idLabel: "Certificate no.", skillsLabel: "Covered" };

const src = credentialImageSrc(credential.id);
const alt =
  lang === "de"
    ? `Zertifikat: ${credential.title}, abgeschlossen von Julian Tracht`
    : `Certificate: ${credential.title}, completed by Julian Tracht`;

const completed = formatCompleted(credential.completedAt, lang);
const duration = formatDuration(credential.durationMinutes, lang);
const meta = `${credential.issuer} · ${completed} · ${duration}`;
---

<article class="credential-card-slot" data-reveal>
  <div class="credential-card">
    <div class="credential-card__sheet">
      <img
        src={mediaSrc(src)}
        srcset={srcsetFor(src, PREVIEW_VARIANT_WIDTHS, CREDENTIAL_IMAGE.width, mediaSrc)}
        sizes="(min-width: 64rem) 30vw, (min-width: 48rem) 45vw, 88vw"
        alt={alt}
        width={CREDENTIAL_IMAGE.width}
        height={CREDENTIAL_IMAGE.height}
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="credential-card__body">
      <h3 class="credential-card__title">{credential.title}</h3>
      <p class="credential-card__meta">{meta}</p>
      <p class="credential-card__note">{credential.note[lang]}</p>

      <ul class="credential-card__skills" aria-label={ui.skillsLabel}>
        {credential.skills.map((skill) => <li>{skill}</li>)}
      </ul>

      {/* The id, as a caption. It is the one thing on the card that makes the
          picture checkable against the document, so it is shown rather than
          hidden behind the enlargement — in the mono face, where a 64-digit
          hash is read as data and not as a sentence. */}
      <p class="credential-card__id">
        <span class="sr-only">{ui.idLabel}: </span>
        {credential.certificateId}
      </p>
    </div>

    <CardActions
      lang={lang}
      cta={{
        label: ui.open,
        // The bar's control is the card's control, so its accessible name has
        // to name the certificate — "Zertifikat ansehen" alone would read
        // identically thirteen times.
        detail: credential.title,
        preview: {
          src: mediaSrc(src),
          alt,
          title: credential.title,
          caption: meta,
          ratio: `${CREDENTIAL_IMAGE.width} / ${CREDENTIAL_IMAGE.height}`,
        },
      }}
    />
  </div>
</article>

<style>
  .credential-card-slot {
    /* A grid child, not a flex item: under size containment a flex item takes
       its base size from max-content and collapses. Same note as the demo
       card, same reason. */
    container-type: inline-size;
  }

  .credential-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--lp-surface-card);
    border-radius: 6px;
    overflow: hidden;
    color: inherit;
    transition: background-color 200ms var(--tds-ease-out);
  }
  .credential-card:hover,
  .credential-card:focus-within {
    background: color-mix(in srgb, var(--color-primary) 5%, var(--lp-surface-card));
  }

  .credential-card__sheet {
    /* The document's own ratio, taken from the file rather than chosen: all
       thirteen are one US-Letter page in landscape. */
    aspect-ratio: 1584 / 1224;
    overflow: hidden;
    /* The certificate's own margin is a pale blue-grey; paper behind it keeps
       the sheet from floating on the card's fill. */
    background: var(--color-paper);
    border-bottom: 1px solid color-mix(in srgb, var(--color-black) 8%, transparent);
  }
  .credential-card__sheet img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .credential-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    padding: 1.125rem 1.25rem 1rem;
  }

  .credential-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-black);
    transition: color 200ms var(--tds-ease-out);
  }
  .credential-card:hover .credential-card__title,
  .credential-card:focus-within .credential-card__title {
    color: var(--color-primary);
  }

  .credential-card__meta {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  .credential-card__note {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-black);
  }

  .credential-card__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .credential-card__skills li {
    padding: 0.25rem 0.625rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-accent) 10%, var(--lp-surface-card));
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .credential-card__id {
    margin: 0;
    /* Pinned to the bottom of the body so the bars line up across a row whose
       titles and skill rows run to different heights. */
    margin-top: auto;
    padding-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1.5;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }
</style>
