---
/**
 * One published reference case: an optional screenshot of the customer's site,
 * the context, the outcome, an optional metric, and the links the case earns.
 *
 * Extracted out of `sections/References.astro` when that section merged into
 * `sections/Showcase.astro`. It is a component now for one concrete reason:
 * the merged shelf puts reference cards and demo cards side by side in the
 * same track, and two card families that sit next to each other have to be
 * tuned against each other in one place rather than inside a section body.
 *
 * ### What this card shares with `DemoCard`
 *
 * They are neighbours in the same carousel, so: the sand fill on the paper
 * ground, the 16:10 screenshot band with its page edge, `height: 100%` so a
 * row of slides ends on one baseline, the 6px radius, the footer bar from
 * `ui/CardActions.astro`, and — since a case with an approved screenshot can
 * now be the shelf's lead card — the container query that widens the band
 * instead of heightening it.
 *
 * ### The links
 *
 * Two, in the bar, like every other card on the shelf: the service this case
 * belongs to first, and one way to read more about it. A case can name several
 * services, and the ones the bar does not carry stay above it as badges — see
 * the note at that markup.
 *
 * Every destination is code-owned (`lib/references.ts`); none of them can come
 * from the CMS, and no LABEL on this card is editable either — the link labels
 * follow the page's locale, the badges name pages this site owns.
 * `references_home.serviceCta` is therefore unrendered; it stays in the CMS
 * schema so an existing panel block keeps loading.
 */
import type { Lang } from "~/lib/i18n";
import type { CardAction } from "~/lib/cardActions";
import { PREVIEW_VARIANT_WIDTHS, srcsetFor } from "~/lib/imageVariants";
import CardActions from "~/components/ui/CardActions.astro";

export interface ReferenceCardData {
  id: string;
  preview: { src: string; width: number; height: number } | null;
  reference: {
    title: string;
    context: string;
    result: string;
    metric?: string | null;
  };
  /** Every service the case used, in catalog order, each with its page. */
  services: { label: string; href: string }[];
  articleHref: string | null;
  siteHref: string | null;
}

interface Props {
  card: ReferenceCardData;
  lang: Lang;
  /**
   * What KIND of work this card shows — "Kundenprojekt" on the home page.
   * A prop, not a constant: the label is the answer to "is this real client
   * work or a sample?", and only the section placing the card knows it is
   * asked there.
   */
  badge?: string;
}

const { card, lang, badge } = Astro.props;

const ui =
  lang === "de"
    ? {
        context: "Kontext",
        result: "Ergebnis",
        metric: "Belegbare Kennzahl",
        article: "Mehr erfahren",
        site: "Webseite ansehen",
        previewAlt: (title: string) => `Startseite der Webseite: ${title}`,
      }
    : {
        context: "Context",
        result: "Outcome",
        metric: "Verifiable metric",
        article: "Learn more",
        site: "View the website",
        previewAlt: (title: string) => `Home page of the website: ${title}`,
      };

/**
 * The service the bar leads with, and the ones the badges keep.
 *
 * The first service is the primary one — the same choice `toReferenceSlide()`
 * makes for the hero. The rest stay as badges, MINUS the primary: naming it
 * twice on one card would make the badge row look like the complete answer
 * while it repeats the link directly under it. A single-service case therefore
 * has no badge row at all, which is the common case and the quietest card.
 */
const [primaryService, ...furtherServices] = card.services;

/**
 * The one way to read more, in order of how much it actually adds.
 *
 * A journal article is the fuller story and wins when there is one. Otherwise
 * the customer's own site is the thing to look at — and a case with neither
 * gets no call to action, so its bar carries the service link alone rather
 * than a button that goes nowhere.
 */
const cta: CardAction | null = card.articleHref
  ? { href: card.articleHref, label: ui.article, detail: card.reference.title }
  : card.siteHref
    ? {
        href: card.siteHref,
        label: ui.site,
        external: true,
        // Hardcoded: the one named case today is a German-only site. A customer
        // site in another language needs a field on the case, not a guess here.
        hreflang: "de",
        detail: card.reference.title,
      }
    : null;
---

{/* The slot exists for the container query at the bottom of this file — the
    card asks its own width whether it is the shelf's lead card. `data-reveal`
    stays on the outer element, which is the one the observer watches. */}
<article class="reference-card-slot" data-reveal>
  <div class="reference-card">
    {/* The picture, where the customer allowed one. A screenshot, captured
        offline by `npm run references:sync` — never an iframe: a live embed of
        somebody else's site fails on their `X-Frame-Options` with no way to know
        in advance, and the page cache would then freeze the broken state. */}
    {card.preview && (
      <div class="reference-card__shot">
        <img
          src={card.preview.src}
          srcset={srcsetFor(card.preview.src, PREVIEW_VARIANT_WIDTHS, card.preview.width)}
          sizes="(min-width: 80rem) 40rem, (min-width: 48rem) 50vw, 100vw"
          alt={ui.previewAlt(card.reference.title)}
          width={card.preview.width}
          height={card.preview.height}
          loading="lazy"
          decoding="async"
        />
      </div>
    )}

    <div class="reference-card__body">
      {badge && <p class="reference-card__badge">{badge}</p>}
      <p class="eyebrow text-[var(--color-accent)] mb-3">
        <span class="sr-only">{ui.context}: </span>
        {card.reference.context}
      </p>
      <h3 class="reference-card__title">{card.reference.title}</h3>
      {/* Result only. The starting point and the approach are the article's job
          — repeating them here made every card three labelled paragraphs long,
          which is not a card. In the carousel it is clamped as well: slides in a
          flex track all take the height of the tallest one, so a single long
          outcome would set the height of every demo card beside it. */}
      <p class="reference-card__result">
        <span class="sr-only">{ui.result}: </span>
        {card.reference.result}
      </p>
      {card.reference.metric && (
        <p class="reference-card__metric">
          <span class="sr-only">{ui.metric}: </span>
          {card.reference.metric}
        </p>
      )}

      {/* The services this case used BEYOND the one the bar already links. A
          case that used three of them is a stronger statement than the primary
          service alone, and dropping the extras to fit two links in a bar would
          quietly narrow what the case says it did.

          `.status-pill` is the shared badge from tds-shared/styles/primitives.css
          rather than a fourth local pill. It carries `white-space: nowrap`, so
          the row it sits in MUST wrap — "Individuelle Lösungen" set in caps is
          wider than a phone column, and `body { overflow-x: hidden }` would clip
          the overflow rather than show it.

          No Tailwind utility belongs on these: unlayered CSS out of tds-shared
          beats a utility class, so it would simply do nothing here. */}
      {furtherServices.length > 0 && (
        <ul class="reference-card__services">
          {furtherServices.map((service) => (
            <li>
              <a href={service.href} class="status-pill status-pill--accent reference-card__service">
                {service.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <CardActions
      lang={lang}
      service={primaryService ? { href: primaryService.href, label: primaryService.label } : null}
      cta={cta}
    />
  </div>
</article>

<style>
  .reference-card-slot {
    /* A grid child, not a flex item: under size containment a flex item takes
       its base size from max-content and collapses to 0px. `.showcase__slide`
       is a grid for exactly this reason — see the note there. Same containment
       and same trap as `.demo-card-slot`. */
    container-type: inline-size;
  }

  .reference-card {
    /* Overridden by the wide-card container query at the bottom. */
    --reference-shot-aspect: 16 / 10;

    /* The positioning context for the footer bar's stretched link. Without it
       that `::after` would spread over whatever ancestor happens to be
       positioned, which on the shelf is the whole carousel. */
    position: relative;
    display: flex;
    flex-direction: column;
    /* Without it a card in a shorter row stops at its content and the row's
       cards end on different baselines. Same line, same reason, as
       `.demo-card` — the two are neighbours in one track. */
    height: 100%;
    /* Sand on the showcase's paper ground: the same fill as `.demo-card`, so
       the two families read as one shelf rather than as two pasted-together
       sections. A borderless card whose fill matches its section is not a
       card, which is why this is NOT `--color-paper` any more — it was, back
       when the references section carried the sand ground itself. */
    background: var(--color-soft);
    border-radius: 6px;
    overflow: hidden;
  }

  /* The screenshot is CONTENT, not a ground: full strength, in front, with a
     real alt. Same rule as DemoCard — the difference between a picture of a
     site and a texture behind text is the whole point of showing it.

     The ratio is reserved before the image loads so neighbouring cards keep
     their headings aligned while the shot arrives. */
  .reference-card__shot {
    position: relative;
    aspect-ratio: var(--reference-shot-aspect);
    overflow: hidden;
    background: var(--color-paper);
    /* A screenshot of a page has a page edge. Without this it bleeds into the
       card's fill and reads as a broken layout rather than a picture of one. */
    border-bottom: 1px solid color-mix(in srgb, var(--color-black) 8%, transparent);
  }
  .reference-card__shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .reference-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem 1.5rem 1.375rem;
  }

  /* The card's kind, before anything else on it. Ink on a light accent tint,
     so it reads as a label and not as a link. */
  .reference-card__badge {
    align-self: flex-start;
    margin: 0 0 0.875rem;
    padding: 0.25rem 0.625rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-paper));
    color: var(--color-black);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .reference-card__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-black);
    margin: 0 0 1rem;
  }

  .reference-card__result {
    margin: 0;
    color: var(--color-black);
    line-height: 1.6;
    /* See the note at the call site: one long outcome would otherwise set the
       height of every slide in the track. The full text stays on the service
       page and in the journal article, which is where it belongs. */
    display: -webkit-box;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .reference-card__metric {
    margin: 1.25rem 0 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-black);
  }

  /* Pinned to the bottom of the BODY, so the badges sit directly on the bar
     across cards whose outcomes are different lengths. The bar itself is a
     sibling of the body and needs no help staying at the bottom; this is what
     keeps the last line of the body on one level too. */
  .reference-card__services {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: auto 0 0;
    padding: 1.75rem 0 0;
    list-style: none;
  }
  .reference-card__service {
    /* ABOVE the bar CTA's stretched layer (`CardActions.astro`), exactly like
       the bar's own service link. Without it every tap on a badge landed on
       the card's destination — measured: "Prozessoptimierung" opened the
       journal article — and the badges were links for the keyboard only. */
    position: relative;
    z-index: 1;
    text-decoration: none;
    transition:
      background-color 200ms var(--tds-ease-out),
      border-color 200ms var(--tds-ease-out);
  }
  /* A 19px badge is hit by luck on a phone. */
  @media (pointer: coarse) {
    .reference-card__service {
      min-height: 2.75rem;
    }
  }
  .reference-card__service:hover {
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
    border-color: var(--color-accent);
  }

  @media (min-width: 768px) {
    .reference-card__body {
      padding: 1.75rem 1.75rem 1.5rem;
    }
  }

  /* THE LEAD CARD, on the home page's shelf and only there. Two tracks wide on
     desktop and nothing at all on a phone, where the same card is one track
     wide. Identical treatment to `DemoCard`, and it has to be: whichever of
     the two families leads, the shelf must not change height.

     The band doubles in WIDTH, not in height. The slides stretch to the
     tallest card, so height spent here is height every other card in the row
     pays for as padding — `32 / 10` is exactly twice `16 / 10` at the same
     height, and `object-position: top center` then crops to the top of the
     captured page, which is the half worth showing. */
  @container (min-width: 30rem) {
    .reference-card {
      --reference-shot-aspect: 32 / 10;
    }
    .reference-card__title {
      font-size: 1.75rem;
    }
    .reference-card__result {
      -webkit-line-clamp: 4;
      line-clamp: 4;
      max-width: 60ch;
    }
  }
</style>
