---
/**
 * One dialog per section, shared by every screenshot in it.
 *
 * A visitor looking at the shelf sees each capture at card size — a few
 * hundred pixels wide, cropped to its top third. The file behind it is
 * 1440 × 900. This is what closes that gap without sending anyone away: the
 * magnifier on a card opens the whole picture over the page, and the card's
 * own link still goes to the live site.
 *
 * ### Three kinds of subject, one dialog
 *
 * - A DEMO screenshot: 16:10, and a link to the running site.
 * - A CERTIFICATE (`components/CredentialsPage.astro`): 13:10, and nowhere to
 *   go — the document is the whole of it, so the call to action is hidden.
 * - A DESIGN STUDY (`lib/designStudies.ts`): a full page, up to three times
 *   taller than it is wide, and sometimes with a second capture of the same
 *   page on a phone.
 *
 * Each opener therefore states the box it needs (`data-preview-ratio`),
 * whether the well should scroll instead of squashing it
 * (`data-preview-fit="tall"`), and any further captures
 * (`data-preview-views`). None of that changes what a demo card sends, which
 * is why the demos still look exactly as they did.
 *
 * ### Why a native `<dialog>`
 *
 * Escape, the focus trap, the inert background and the backdrop element are
 * all free and all correct. A hand-built overlay has to re-implement each one
 * and gets the focus trap wrong roughly every time. The only two things left
 * to write are restoring focus to the button that opened it (the platform
 * does not) and dismissing on a backdrop click (the platform gives us the
 * element but not the behaviour).
 *
 * ### Why ONE dialog rather than one per card
 *
 * The content is three strings and an image source. Rendering a modal per
 * card would put N copies of an identical shell in the document for a feature
 * that can only ever show one at a time.
 *
 * ### Progressive enhancement
 *
 * Every opener — the magnifier on `DemoCard.astro`, the call to action that
 * `ui/CardActions.astro` renders as a button, the one on a certificate card —
 * ships `hidden` and is revealed HERE, after this script has confirmed it has
 * a working dialog. So a browser without `showModal`, or a page whose bundle
 * failed, shows cards with no control at all rather than a button that does
 * nothing — the same contract as the shelf's arrows.
 */
import type { Lang } from "~/lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const ui =
  lang === "de"
    ? {
        label: "Vergrößerte Vorschau",
        close: "Vorschau schließen",
        visit: "Zur Seite",
        newTab: "öffnet in neuem Tab",
        views: "Ansichten",
      }
    : {
        label: "Enlarged preview",
        close: "Close preview",
        visit: "Open the site",
        newTab: "opens in a new tab",
        views: "Views",
      };
---

<dialog class="preview" data-preview-dialog aria-label={ui.label}>
  <div class="preview__frame">
    <button type="button" class="preview__close" data-preview-close>
      <span class="sr-only">{ui.close}</span>
      <svg
        aria-hidden="true"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="18" y1="6" x2="6" y2="18"></line>
      </svg>
    </button>

    {/* No `width`/`height`: the source varies and the frame already reserves
        the box with an aspect ratio, so a stated intrinsic size would only be
        a second, staler answer to the same question.

        The resting source is a 1×1 transparent GIF, not `src=""`: an empty
        `src` is invalid markup, and older engines answered it by requesting
        the page itself as an image. */}
    {/* The picture sits in a well of its own so a FULL-PAGE capture can be
        scrolled instead of squashed. A design study is a whole page, two
        metres of it in one file; `object-fit: contain` in a 16:10 box would
        reduce it to a strip nobody can read, which is the opposite of what
        this dialog is for. The well only scrolls in the tall mode — for a
        16:10 screenshot it is an ordinary block and the layout is unchanged. */}
    <div class="preview__well" data-preview-well>
      <img
        class="preview__img"
        data-preview-img
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
        alt=""
      />
    </div>

    {/* Filled and revealed only for a subject that has more than one capture —
        the same page on a phone, a second screen of the same site. Empty and
        `hidden` otherwise, which is every demo and every certificate. */}
    <div class="preview__views" data-preview-views-strip hidden role="group" aria-label={ui.views}></div>

    <div class="preview__bar">
      <div class="preview__meta">
        <p class="preview__title" data-preview-title></p>
        <p class="preview__host" data-preview-host></p>
      </div>
      <a
        class="preview__visit"
        data-preview-visit
        href="#"
        target="_blank"
        rel="noopener noreferrer"
      >
        {ui.visit}
        <span class="sr-only"> ({ui.newTab})</span>
        <svg
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    </div>
  </div>
</dialog>

<style>
  .preview {
    /* A dialog is `position: fixed` and auto-sized by the UA; these reset it
       to "as big as it usefully gets".

       `margin: auto` is NOT redundant with the UA stylesheet, and leaving it
       out is what put this dialog in the top left corner. A modal dialog is
       centred by `inset: 0` plus auto margins — and Tailwind's preflight sets
       `margin: 0` on `*`, `::before`, `::after` and `::backdrop`, which beats
       the UA rule. With all four insets at 0 and no auto margin left, the box
       resolves against the start corner. Nothing errors; the dialog simply
       opens in the corner. Say it here, unlayered, where the preflight cannot
       reach it. */
    margin: auto;
    width: min(96vw, 78rem);
    max-width: none;
    max-height: 92vh;
    padding: 0;
    border: none;
    border-radius: 8px;
    /* One flat colour, image well and bar included (2026-09-21). */
    background: var(--color-paper);
    color: var(--color-black);
    overflow: hidden;
  }
  .preview::backdrop {
    /* ONE flat colour behind every modal (2026-09-21): the brand navy, dense
       enough that the page behind stops competing, in both themes. It fades
       in with the dialog and out while `lib/motion/dialog.ts` plays the exit. */
    background: var(--color-surface-navy);
    opacity: 0.9;
    transition: opacity 300ms var(--tds-ease-out);
  }
  .preview[data-closing]::backdrop {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .preview[open]::backdrop {
      animation: previewBackdropIn 220ms var(--tds-ease-out);
    }
  }
  @keyframes previewBackdropIn {
    from {
      opacity: 0;
    }
  }

  /* The cross sits in its own band above the capture, on the dialog's colour —
     a bare cross over a screenshot would have no contrast to rely on. */
  .preview__frame {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-top: 3.25rem;
  }

  .preview__close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: none;
    border-radius: 100px;
    /* A bare cross, no chip behind it (2026-09-21). The hover answers with
       colour and a quarter turn instead of a fill. */
    background: none;
    color: var(--color-black);
    cursor: pointer;
    transition:
      color 200ms var(--tds-ease-out),
      transform 260ms var(--tds-ease-out);
  }
  .preview__close:hover {
    color: var(--color-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .preview__close:hover {
      transform: rotate(90deg);
    }
  }
  .preview__close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .preview__well {
    background: var(--color-paper);
  }
  .preview__img {
    display: block;
    width: 100%;
    /* `contain`, not `cover`: this is the one place the capture is shown
       WHOLE. Cropping it here would defeat the only reason to open it. */
    object-fit: contain;
    /* The default box. Overridden per capture by `--preview-ratio`, which the
       script sets from the picture's own size — a certificate is 13:10 and a
       screenshot is 16:10, and a wrong box letterboxes one of them. */
    aspect-ratio: var(--preview-ratio, 16 / 10);
    max-height: 74vh;
    background: var(--color-paper);
  }

  /* TALL: a full-page capture. The well takes the height cap and scrolls; the
     picture drops its ratio and its own cap and is drawn at full width, so the
     visitor reads down the page instead of squinting at a strip. */
  .preview[data-fit="tall"] .preview__well {
    overflow-y: auto;
    max-height: 74vh;
    /* Momentum scrolling inside a modal, and no scroll chaining out to the
       page behind it once the end is reached. */
    overscroll-behavior: contain;
  }
  .preview[data-fit="tall"] .preview__img {
    aspect-ratio: auto;
    height: auto;
    max-height: none;
  }

  .preview__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1.25rem;
    background: var(--color-paper);
  }
  .preview__meta {
    min-width: 0;
  }
  .preview__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.2;
    color: var(--color-black);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .preview__host {
    margin: 0.15rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }
  .preview__visit {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    padding: 0.625rem 1.125rem;
    border-radius: 100px;
    background: var(--color-surface-navy);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 200ms var(--tds-ease-out);
  }
  .preview__visit:hover {
    background: var(--color-surface-accent);
  }
  .preview__visit:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (max-width: 32rem) {
    .preview__bar {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
    .preview__visit {
      justify-content: center;
    }
    .preview__title {
      white-space: normal;
    }
  }

</style>

<style is:global>
  /**
   * The view strip, GLOBAL on purpose.
   *
   * Its buttons are built by the script below at runtime, and an Astro scoped
   * style appends this component's id to every selector — which a node created
   * by script does not carry. Written scoped, these rules matched nothing at
   * all and the strip rendered as two words of unstyled body text. Every
   * selector is anchored on `.preview`, so nothing leaks past the dialog.
   * Same trap as the one `sections/Showcase.astro` documents for its slides.
   */
  .preview .preview__views {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem 0;
    background: var(--color-paper);
  }
  .preview .preview__views[hidden] {
    display: none;
  }
  .preview .preview__view {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: 100px;
    background: none;
    color: var(--color-muted);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition:
      color 200ms var(--tds-ease-out),
      border-color 200ms var(--tds-ease-out);
  }
  .preview .preview__view:hover {
    color: var(--color-black);
    border-color: var(--color-black);
  }
  .preview .preview__view[aria-pressed="true"] {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .preview .preview__view:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  @media (pointer: coarse) {
    .preview .preview__view {
      min-height: 2.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .preview .preview__view {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Wire every magnifier in a section to that section's one dialog.
   *
   * Scoped per section rather than per document so a second shelf on a future
   * page gets its own dialog instead of quietly driving the first one's.
   */
  import { animatedDialog } from "~/lib/motion/dialog";

  const dialogs = document.querySelectorAll<HTMLDialogElement>("[data-preview-dialog]");

  for (const dialog of dialogs) {
    // No dialog support means no enlarging. The buttons stay `hidden`, which
    // is the state they shipped in, so nothing has to be undone.
    if (typeof dialog.showModal !== "function") continue;

    const scope = dialog.closest("section") ?? document;
    const buttons = scope.querySelectorAll<HTMLButtonElement>("[data-preview-open]");
    if (buttons.length === 0) continue;

    const img = dialog.querySelector<HTMLImageElement>("[data-preview-img]");
    const well = dialog.querySelector<HTMLElement>("[data-preview-well]");
    const title = dialog.querySelector<HTMLElement>("[data-preview-title]");
    const host = dialog.querySelector<HTMLElement>("[data-preview-host]");
    const visit = dialog.querySelector<HTMLAnchorElement>("[data-preview-visit]");
    const strip = dialog.querySelector<HTMLElement>("[data-preview-views-strip]");
    const close = dialog.querySelector<HTMLButtonElement>("[data-preview-close]");
    if (!img || !well || !title || !host || !visit || !strip || !close) continue;

    /** One further capture of the same subject, as the card serialised it. */
    interface View {
      id: string;
      label: string;
      src: string;
      ratio: string;
    }

    /**
     * Put one capture in the well.
     *
     * `--preview-ratio` reserves the box before the file arrives, which is why
     * every caller sends the picture's own size: the dialog holds a
     * certificate (13:10), a screenshot (16:10) and a full page (1:3) from the
     * same markup, and a single hard-coded ratio letterboxes two of the three.
     */
    const show = (src: string, ratio: string | undefined, alt: string) => {
      img.src = src;
      img.alt = alt;
      if (ratio) img.style.setProperty("--preview-ratio", ratio);
      else img.style.removeProperty("--preview-ratio");
      well.scrollTop = 0;
    };

    // Bounces in and out (lib/motion/dialog.ts); Escape goes the same way.
    const modal = animatedDialog(dialog);

    /**
     * The control that opened the dialog, so focus can go back to it.
     *
     * `showModal()` moves focus into the dialog but nothing returns it, and a
     * keyboard user who lands back at the top of the document after closing an
     * overlay has lost their place in a horizontally scrolling shelf — which
     * is precisely the place that is hardest to find again.
     */
    let opener: HTMLElement | null = null;

    for (const button of buttons) {
      button.addEventListener("click", () => {
        const src = button.dataset.previewSrc;
        if (!src) return;

        const alt = button.dataset.previewAlt ?? "";
        show(src, button.dataset.previewRatio, alt);
        title.textContent = button.dataset.previewTitle ?? "";
        host.textContent = button.dataset.previewHost ?? "";

        // A full page scrolls, a screenshot does not. Set on the DIALOG so the
        // rule can reach both the well and the picture inside it.
        dialog.dataset.fit = button.dataset.previewFit ?? "cover";

        /* A subject with nothing to link to — a design study, a certificate —
           hides the call to action rather than pointing it at "#". The href is
           cleared as well: a hidden anchor still carries its target into the
           accessibility tree on some engines. */
        const href = button.dataset.previewHref;
        visit.hidden = !href;
        if (href) visit.href = href;
        else visit.removeAttribute("href");

        // The view strip, rebuilt per opening. Absent for everything but the
        // two design studies that have a second capture.
        strip.replaceChildren();
        let views: View[] = [];
        try {
          views = button.dataset.previewViews ? (JSON.parse(button.dataset.previewViews) as View[]) : [];
        } catch {
          // A malformed attribute costs the strip, never the dialog.
          views = [];
        }
        strip.hidden = views.length < 2;
        if (!strip.hidden) {
          for (const [index, view] of views.entries()) {
            const choice = document.createElement("button");
            choice.type = "button";
            choice.className = "preview__view";
            choice.textContent = view.label;
            choice.setAttribute("aria-pressed", index === 0 ? "true" : "false");
            choice.addEventListener("click", () => {
              show(view.src, view.ratio, `${alt} — ${view.label}`);
              for (const sibling of strip.querySelectorAll("[aria-pressed]")) {
                sibling.setAttribute("aria-pressed", sibling === choice ? "true" : "false");
              }
            });
            strip.append(choice);
          }
        }

        opener = button;
        modal.open();
      });

      // Revealed only now that there is something behind it.
      button.hidden = false;
    }

    close.addEventListener("click", () => modal.close());

    /**
     * Backdrop dismissal.
     *
     * A click on the backdrop reports the DIALOG as its target, because the
     * backdrop is a pseudo-element with no node of its own; a click on the
     * content reports something inside `.preview__frame`. So "the target is
     * the dialog itself" is exactly "the visitor clicked outside".
     */
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) modal.close();
    });

    // The resting source from the markup, restored on close.
    const blank = img.getAttribute("src") ?? "";

    dialog.addEventListener("close", () => {
      opener?.focus();
      opener = null;
      // Drop the source so a closed dialog is not holding a decoded 1440×900
      // bitmap for every screenshot the visitor happened to open.
      img.src = blank;
      // And the per-subject state with it: a 1×1 transparent GIF left in a
      // scrolling well at a full page's ratio is a tall empty box on the next
      // opening, before the new file has arrived.
      img.style.removeProperty("--preview-ratio");
      dialog.dataset.fit = "cover";
      strip.replaceChildren();
      strip.hidden = true;
    });
  }
</script>
