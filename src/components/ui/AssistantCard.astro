---
/**
 * The way into the Leistungsassistent: the last tile in the row of services,
 * with the same measurements and the same arrow. Its styles are the row's
 * (`sections/Services.astro`); only the compass field is its own.
 *
 * It ships `hidden` and `ServiceAssistant.astro` reveals it once the dialog
 * can open — a button that cannot open anything is never shown (the rule in
 * `a11yContract.test.ts`).
 */
import type { Lang } from "~/lib/i18n";
import { FINDER_SECTION } from "~/lib/serviceFinder";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = FINDER_SECTION[lang];
---

<button type="button" data-assistant-open hidden class="product-tile__link assistant-tile">
  <span class="product-tile__media assistant-tile__media" aria-hidden="true">
    <svg class="assistant-tile__needle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="9.5"></circle>
      <polygon points="15.5 8.5 13.4 13.4 8.5 15.5 10.6 10.6 15.5 8.5" fill="currentColor"></polygon>
    </svg>
  </span>
  <span class="product-tile__body">
    <span class="product-tile__go" aria-hidden="true">→</span>
    <span class="product-tile__kind">{copy.tileKind}</span>
    <span class="product-tile__title">{copy.tileTitle}</span>
  </span>
</button>

<style>
  .assistant-tile {
    width: 100%;
    border: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .assistant-tile[hidden] {
    display: none;
  }
  .assistant-tile__media {
    position: relative;
    background: var(--color-accent-pink);
    color: #050f68;
  }
  .assistant-tile__needle {
    position: absolute;
    inset: 18%;
    width: 64%;
    height: 64%;
    transition: rotate 500ms var(--lp-ease-bounce, var(--tds-ease-out));
  }
  .assistant-tile:is(:hover, :focus-visible) .assistant-tile__needle {
    rotate: 25deg;
  }
  @media (prefers-reduced-motion: reduce) {
    .assistant-tile__needle {
      transition: none;
    }
    .assistant-tile:is(:hover, :focus-visible) .assistant-tile__needle {
      rotate: none;
    }
  }
</style>
