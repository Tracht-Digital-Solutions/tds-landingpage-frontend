---
/**
 * The site's FAQ accordion: native `<details>` rows sharing one `name`, the
 * first one open. Used by the home page's FAQ section and by the platform
 * pages, so every question list on the site behaves the same way.
 *
 * The question is the `<summary>`, which browsers expose as a disclosure
 * control with its expanded/collapsed state — the `aria-expanded` a hand-built
 * accordion would have to keep in sync, for free and without JavaScript. The
 * shared `name` makes it exclusive where supported; where it is not, several
 * rows simply stay open.
 *
 * What it replaced, so nobody restores it: a desktop master–detail "tablist"
 * (`ul[role=tablist]` with `li` children, axe-critical) plus a second, hidden
 * copy of every question for phones.
 *
 * A collapsed answer is still in the document, which is what the FAQPage
 * JSON-LD comparison — and any crawler that does not click — reads.
 */
interface Props {
  items: readonly { q: string; a: string }[];
  /** The `name` that groups the rows; unique per list on a page. */
  name?: string;
}

const { items, name = "faq" } = Astro.props;
---

{items.map((item, i) => (
  <details name={name} open={i === 0} class="faq-item tds-disclosure" data-reveal>
    <summary class="faq-summary">
      <span class="faq-q">{item.q}</span>
      <span aria-hidden="true" class="faq-chevron">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 6 15 12 9 18" />
        </svg>
      </span>
    </summary>
    <p class="faq-a">{item.a}</p>
  </details>
))}

<style>
  /* ROUND rows (2026-09-22): each question is its own rounded card with the
     site's hard shadow (global.css) and a round chevron button; hovering a
     row lifts it. */
  .faq-item {
    border-radius: 1.5rem;
    overflow: hidden;
    background: var(--lp-surface-card);
    transition: translate 160ms var(--tds-ease-out);
  }
  @media (hover: hover) {
    .faq-item:has(> .faq-summary:hover) {
      translate: -2px -2px;
      box-shadow: var(--tds-shadow-hard-hover);
    }
  }
  .faq-item:has(> .faq-summary:focus-visible) {
    box-shadow: var(--tds-shadow-hard-hover);
  }
  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 1rem 1rem 1.5rem;
    cursor: pointer;
    list-style: none;
    border-radius: 1.5rem;
  }
  .faq-summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -4px;
  }
  .faq-summary::-webkit-details-marker {
    display: none;
  }
  .faq-q {
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.375;
    color: var(--color-black);
    transition: color 200ms var(--tds-ease-out);
  }
  @media (min-width: 768px) {
    .faq-q {
      font-size: 1.25rem;
    }
  }

  /* Open row: a filled summary + accent colour. The state never rests on
     colour alone — the fill and the rotated chevron carry it with it. */
  .faq-item[open] > .faq-summary {
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    border-radius: 1.5rem 1.5rem 0 0;
  }
  .faq-item[open] > .faq-summary .faq-q,
  .faq-summary:hover .faq-q {
    color: var(--color-accent);
  }

  .faq-chevron {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    /* The rotation springs; the colour beside it eases, because a colour that
       overshoots lands outside the palette. */
    transition:
      transform 320ms var(--lp-ease-bounce),
      color 200ms var(--tds-ease-out);
  }
  .faq-item[open] > .faq-summary .faq-chevron {
    background: var(--color-accent);
    color: var(--color-paper);
    transform: rotate(90deg);
  }

  .faq-a {
    margin: 0;
    max-width: 44rem;
    padding: 0.25rem 1.5rem 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  /* The answer grows open through tds-shared's `.tds-disclosure` (the
     `::details-content` + `interpolate-size` pair that used to live here),
     gated on support and on reduced motion there. */

  @media (prefers-reduced-motion: reduce) {
    .faq-item {
      transition: none;
      translate: none !important;
    }
    .faq-chevron {
      transition: none;
    }
  }
</style>
