---
import { mediaSrc } from "~/lib/mediaSrc";
/**
 * The digital business card, as a card on a shelf.
 *
 * Rendered in two places, both of which already carry work worth looking at:
 * the showcase carousel on the home page, after the demos, and the Webauftritt
 * service page beside the demo grid. The argument it makes there is the reason
 * it exists — a visitor sees that a card like this is something built here,
 * not just a contact detail of ours.
 *
 * ### Why this is not a demo
 *
 * `getDemos()` was the obvious place to put it and it would have been wrong.
 * That list decides the singular/plural of the demos heading through
 * `demosCopy()`, and `demos-sync` reports it as "N of M demo sites
 * presentable". A business card counted among them makes both statements
 * false. It is a third family instead, and it is deliberately the only member.
 *
 * ### Shape
 *
 * Band, sand fill, 6px radius and `height: 100%` are taken from `DemoCard` on
 * purpose: in the carousel this tile stands directly beside one, and the track
 * stretches every slide to the tallest card. A tile that measured its own
 * height differently would be the one visible seam in the row.
 *
 * ### Why this stopped being one wrapping `<a>`
 *
 * It was one, because the tile has one destination. It gained a second when
 * every card on the shelf gained a footer bar with a link to the service it is
 * evidence for — and a second anchor inside the first is invalid markup that
 * browsers recover from by closing the outer one early, silently dropping
 * everything after it out of the link.
 *
 * So the tile follows `DemoCard` exactly: a plain element, the call to action
 * in `ui/CardActions.astro` carrying a stretched `::after` over the whole
 * tile, the service link lifted above that layer. The full-tile hit area, the
 * hover response and the focus ring all survive; the anchor was only how they
 * used to be provided.
 */
import { resolveLang } from "~/lib/i18n";
import { DEMO_PREVIEW } from "~/lib/demoCatalog";
import {
  BUSINESS_CARD_PREVIEW,
  businessCardCopy,
  businessCardHref,
} from "~/lib/businessCard";
import type { CardAction } from "~/lib/cardActions";
import CardActions from "~/components/ui/CardActions.astro";

interface Props {
  /**
   * The service page this tile is evidence for, or `null`.
   *
   * `null` on the Webauftritt detail page, where the tile already sits on that
   * service and a link back to it is a dead end. See `DemoCard`, same rule.
   */
  serviceLink?: CardAction | null;
}

const { serviceLink = null } = Astro.props;
const lang = resolveLang(Astro.currentLocale);
const copy = businessCardCopy[lang];
const href = businessCardHref(lang);
---

<article class="bc-tile-slot" data-reveal>
  <div class="bc-tile" data-motion-tilt>
    <div class="bc-tile__shot">
      {/* Intrinsic size stated so the 16:10 box is reserved before the file
          arrives — the same reason `DemoCard` states it. Captured by
          `npm run businesscard:sync`; a missing file leaves an empty band
          rather than a collapsed card. */}
      <img
        src={mediaSrc(BUSINESS_CARD_PREVIEW)}
        alt={copy.previewAlt}
        width={DEMO_PREVIEW.width}
        height={DEMO_PREVIEW.height}
        loading="lazy"
        decoding="async"
      />
      <span class="bc-tile__origin">{copy.eyebrow}</span>
    </div>

    <div class="bc-tile__body">
      <p class="bc-tile__kind">{copy.kind}</p>
      <h3 class="bc-tile__title">{copy.title}</h3>
      <p class="bc-tile__text">{copy.text}</p>
    </div>

    <CardActions
      lang={lang}
      service={serviceLink}
      cta={{ href, label: copy.cta, detail: copy.title }}
    />
  </div>
</article>

<style>
  .bc-tile-slot {
    /* Same containment as `.demo-card-slot`, same reason: the showcase slide is
       a grid so this element's width is definite before containment is
       consulted. See the note in `Showcase.astro`. */
    container-type: inline-size;
  }

  .bc-tile {
    --bc-tile-bg: var(--color-soft);
    --bc-tile-bg-hover: color-mix(in srgb, var(--color-primary) 6%, var(--color-soft));

    position: relative;
    display: flex;
    flex-direction: column;
    /* Without it a card in a shorter row stops at its content and the row's
       cards end on different baselines. */
    height: 100%;
    background: var(--bc-tile-bg);
    border-radius: 6px;
    overflow: hidden;
    color: inherit;
    transition: background-color 200ms var(--tds-ease-out);
  }
  .bc-tile:hover,
  .bc-tile:focus-within {
    background: var(--bc-tile-bg-hover);
  }
  /* The focus ring is drawn for this tile from the bar's call to action — that
     link's stretched layer IS the tile's hit area. The rule lives in the one
     global block in `ui/CardActions.astro`, because it needs a class from each
     of the two components and an Astro scoped style can only name its own. */

  .bc-tile__shot {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-paper);
    /* A screenshot of a page has a page edge; without this it bleeds into the
       card's fill and reads as a broken layout rather than a picture of one. */
    border-bottom: 1px solid color-mix(in srgb, var(--color-black) 8%, transparent);
  }
  .bc-tile__shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .bc-tile__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    padding: 1.125rem 1.25rem 1rem;
  }

  .bc-tile__origin {
    position: absolute;
    top: 0.625rem;
    left: 0.625rem;
    z-index: 1;
    max-width: calc(100% - 4.5rem);
    padding: 0.25rem 0.625rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-card) 94%, transparent);
    color: var(--color-black);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    pointer-events: none;
  }
  .bc-tile__kind {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .bc-tile__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-black);
    margin: 0;
    transition: color 200ms var(--tds-ease-out);
  }
  .bc-tile:hover .bc-tile__title,
  .bc-tile:focus-within .bc-tile__title {
    color: var(--color-primary);
  }

  .bc-tile__text {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

</style>
