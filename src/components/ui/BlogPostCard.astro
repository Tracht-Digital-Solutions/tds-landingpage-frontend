---
import ImagePlaceholder from "./ImagePlaceholder.astro";

interface Props {
  category: string;
  title: string;
  excerpt: string;
  slug: string;
  formattedDate: string;
  readMore: string;
  placeholderLabel: string;
  imagePlaceholder: string;
}

const { category, title, excerpt, slug, formattedDate, readMore, placeholderLabel, imagePlaceholder } = Astro.props;

const blogBase = (import.meta.env.PUBLIC_BLOG_BASE_URL as string | undefined) ?? "https://blog.tracht-digital.de";

// When the post carries a real cover image — either a remote URL
// (coverHint set to an uploaded image) or a local landingpage-hosted
// placeholder (e.g. /journal/<slug>.webp) — render the photo; otherwise
// fall back to the labelled placeholder box describing the cover.
const coverUrl = /^(https?:\/\/|\/).+\.(webp|avif|png|jpe?g|svg)$/i.test(imagePlaceholder)
  ? imagePlaceholder
  : null;
---

<article class="group" data-journal-card>
  <a
    href={`${blogBase}/${slug}`}
    class="block rounded-[6px] transition-transform duration-300 ease-out group-hover:-translate-y-1.5 motion-reduce:transition-none motion-reduce:group-hover:translate-y-0"
  >
    {coverUrl ? (
      <div class="overflow-hidden rounded-[2px] border border-[var(--color-line)] bg-[var(--color-soft)] shadow-sm transition-shadow duration-300 group-hover:shadow-[0_18px_44px_-18px_rgba(5,15,104,0.4)]">
        <img
          src={coverUrl}
          alt={title}
          width="1200"
          height="900"
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
        />
      </div>
    ) : (
      <ImagePlaceholder aspect="aspect-[4/3]" label={placeholderLabel} description={imagePlaceholder} />
    )}
    <div class="pt-5">
      <p class="text-xs font-medium tracking-widest text-[var(--color-accent)] uppercase mb-3">
        {category}
      </p>
      <h3 class="text-lg font-[var(--font-display)] font-medium mb-2 group-hover:text-[var(--color-accent)] transition-colors">
        {title}
      </h3>
      <p class="text-sm text-[var(--color-muted)] leading-relaxed mb-3 line-clamp-3">
        {excerpt}
      </p>
      <div class="flex items-center justify-between">
        <span class="text-xs text-[var(--color-muted)]">{formattedDate}</span>
        <span class="inline-flex items-center gap-1 text-xs font-medium text-[var(--color-muted)] group-hover:text-[var(--color-accent)] transition-colors">
          {readMore}
          <span
            aria-hidden="true"
            class="inline-block transition-transform duration-200 ease-out group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
          >→</span>
        </span>
      </div>
    </div>
  </a>
</article>
