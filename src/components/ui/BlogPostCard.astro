---
import { AbstractCover, coverVariant, hasPhotoCover } from "@tracht-digital-solutions/tds-shared/components";

interface Props {
  category: string;
  title: string;
  excerpt: string;
  slug: string;
  formattedDate: string;
  readMore: string;
  /** Absolute (or site-local) cover image URL; null when the post has none. */
  coverHint?: string | null;
}

const { category, title, excerpt, slug, formattedDate, readMore, coverHint = null } = Astro.props;

const blogBase = (import.meta.env.PUBLIC_BLOG_BASE_URL as string | undefined) ?? "https://blog.tracht-digital.de";

/**
 * A post without an uploaded cover gets the SAME flat brand geometry the blog
 * draws for it — `AbstractCover`, keyed by a hash of the slug, from tds-shared.
 * It used to get a grey box captioned with a prose description of the picture
 * that was meant to go there (plus three hand-hosted stock photos for the
 * launch posts), so the same article looked like two different things on the
 * two properties. Rendered without a `client:` directive: this is static
 * markup, so the cover costs no JavaScript.
 */
const hasPhoto = hasPhotoCover(coverHint);
---

<article class="group" data-journal-card>
  <a
    href={`${blogBase}/${slug}`}
    class="block rounded-[6px] transition-transform duration-300 ease-out group-hover:-translate-y-1.5 motion-reduce:transition-none motion-reduce:group-hover:translate-y-0"
  >
    <div class="overflow-hidden rounded-[6px] bg-[var(--color-soft)] shadow-sm transition-shadow duration-300 group-hover:shadow-[0_18px_44px_-18px_rgba(5,15,104,0.4)]">
      {hasPhoto ? (
        <img
          src={coverHint}
          alt={title}
          width="1200"
          height="900"
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
        />
      ) : (
        <div class="aspect-[4/3] w-full transition-transform duration-700 ease-out group-hover:scale-[1.06] motion-reduce:transition-none motion-reduce:group-hover:scale-100">
          <AbstractCover variant={coverVariant(slug)} />
        </div>
      )}
    </div>
    <div class="pt-5">
      <p class="text-xs font-medium tracking-widest text-[var(--color-accent)] uppercase mb-3">
        {category}
      </p>
      <h3 class="text-lg font-[var(--font-display)] font-medium mb-2 group-hover:text-[var(--color-accent)] transition-colors">
        {title}
      </h3>
      <p class="text-sm text-[var(--color-muted)] leading-relaxed mb-3 line-clamp-3">
        {excerpt}
      </p>
      <div class="flex items-center justify-between">
        <span class="text-xs text-[var(--color-muted)]">{formattedDate}</span>
        <span class="inline-flex items-center gap-1 text-xs font-medium text-[var(--color-muted)] group-hover:text-[var(--color-accent)] transition-colors">
          {readMore}
          <span
            aria-hidden="true"
            class="inline-block transition-transform duration-200 ease-out group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
          >→</span>
        </span>
      </div>
    </div>
  </a>
</article>
