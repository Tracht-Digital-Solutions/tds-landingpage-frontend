---
import { AbstractCover, coverVariant, hasPhotoCover } from "@tracht-digital-solutions/tds-shared/components";

interface Props {
  category: string;
  title: string;
  excerpt: string;
  slug: string;
  formattedDate: string;
  readMore: string;
  /** Absolute (or site-local) cover image URL; null when the post has none. */
  coverHint?: string | null;
}

const { category, title, excerpt, slug, formattedDate, readMore, coverHint = null } = Astro.props;

const blogBase = (import.meta.env.PUBLIC_BLOG_BASE_URL as string | undefined) ?? "https://blog.tracht-digital.de";

/**
 * A post without an uploaded cover gets the SAME flat brand geometry the blog
 * draws for it — `AbstractCover`, keyed by a hash of the slug, from tds-shared.
 * It used to get a grey box captioned with a prose description of the picture
 * that was meant to go there (plus three hand-hosted stock photos for the
 * launch posts), so the same article looked like two different things on the
 * two properties. Rendered without a `client:` directive: this is static
 * markup, so the cover costs no JavaScript.
 */
const hasPhoto = hasPhotoCover(coverHint);
---

{/* The SLOT is the query container, never the card itself: a container
    cannot style itself, so `container-type` on `.post-card` would make the
    layout rule below match nothing. The slot must also stay a grid child —
    a flex item under size containment takes its base size from max-content,
    which containment reports as zero, and the card collapses to a sliver. */}
<article class="post-card-slot" data-reveal>
  <a class="post-card" href={`${blogBase}/${slug}`}>
    <div class="post-card__cover">
      <div class="post-card__art">
        {hasPhoto ? (
          <img
            src={coverHint}
            alt={title}
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <AbstractCover variant={coverVariant(slug)} />
        )}
      </div>
    </div>
    <div class="post-card__body">
      <div class="post-card__meta">
        <span class="eyebrow">{category}</span>
        <span class="post-card__date">{formattedDate}</span>
      </div>
      <h3 class="card-title">{title}</h3>
      <p class="post-card__excerpt">{excerpt}</p>
      <div class="post-card__foot">
        <span class="post-card__more">
          {readMore}
          <span aria-hidden="true">→</span>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  /* The blog's card, rebuilt for this surface.
     ─────────────────────────────────────────
     This used to be a marketing-surface card: 6px radius, a soft shadow
     that deepened on hover, a 1.5px lift and a 6% image zoom. The blog
     draws the same articles flat, with no lift and no shadow, and marks
     hover with a 2px accent bar growing down the leading edge. Two
     properties, two pictures of the same article.

     It is a LOCAL rebuild, not the blog's stylesheet: `.post-card` lives in
     tds-blog-frontend's own `global.css`, and its hover fill reads
     `--tds-flat-hover`, which is declared only under `[data-surface="blog"]`.
     On this surface that variable resolves to nothing at all, so the fills
     are stated here instead of referenced. If the blog's card is ever
     promoted into tds-shared, this file is what should be deleted. */
  .post-card-slot {
    container-type: inline-size;
  }

  .post-card {
    /* Not `--color-soft`: this section's own ground IS `--color-soft`
       (`.tds-tone-sand`), and a borderless card whose fill matches its
       section is not a card. Paper against sand is the same pairing the
       service grid uses one section earlier. */
    --lp-card-bg: var(--lp-surface-card);
    --lp-card-bg-hover: color-mix(in srgb, var(--color-primary) 5%, var(--color-card));

    position: relative;
    display: flex;
    flex-direction: column;
    /* Load-bearing: without it a card in a shorter grid row stops at its
       content and the row's cards end on different baselines. */
    height: 100%;
    background: var(--lp-card-bg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: background-color 200ms var(--tds-ease-out);
  }
  .post-card:hover,
  .post-card:focus-within {
    background: var(--lp-card-bg-hover);
  }

  /* The whole hover affordance. Grows from the top down on the leading
     edge — `:focus-within` as well, so it is reachable from the keyboard
     and not only from a pointer. */
  .post-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 320ms var(--lp-ease-bounce);
    z-index: 2;
  }
  .post-card:hover::before,
  .post-card:focus-within::before {
    transform: scaleY(1);
  }

  .post-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .post-card__cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-soft);
    /* The abstract cover's variant 4 paints with `--tds-flat-tint`, which
       only the blog surface declares. The shared component carries an
       inline fallback, but stating it here means this card looks the same
       whichever way that fallback moves. */
    --tds-flat-tint: color-mix(in srgb, var(--color-primary) 9%, var(--color-paper));
  }

  /* Scaled up at rest so the drift below never exposes an edge. */
  .post-card__art {
    position: absolute;
    inset: 0;
    transform: scale(1.1);
    transition: transform 700ms var(--lp-ease-soft);
  }
  .post-card__art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* THE DRIFT. Hovering a card sets the cover slowly moving rather than
     snapping it to a bigger scale, so a placeholder that is pure geometry
     still reads as alive. It starts from the resting transform — hence the
     identical `scale(1.1)` and a zero offset at `from` — so switching the
     animation on cannot produce a jump, and `alternate` walks it back and
     forth instead of restarting. Leaving the card removes the animation,
     and the transition above eases it home. */
  @keyframes journal-drift {
    from {
      transform: scale(1.1) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.1) translate3d(2.4%, 1.8%, 0);
    }
  }
  .post-card:hover .post-card__art,
  .post-card:focus-within .post-card__art {
    animation: journal-drift 14s ease-in-out infinite alternate;
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
    padding: 1rem 1.125rem 0.875rem;
  }
  .post-card__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .post-card__date {
    font-size: 0.75rem;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .post-card .card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-black);
    margin: 0;
    transition: color 200ms var(--tds-ease-out);
  }
  .post-card:hover .card-title,
  .post-card:focus-within .card-title {
    color: var(--color-primary);
  }
  .post-card__excerpt {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-card__foot {
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .post-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
    transition: color 200ms var(--tds-ease-out);
  }
  .post-card:hover .post-card__more,
  .post-card:focus-within .post-card__more {
    color: var(--color-accent);
  }
  .post-card__more span {
    transition: transform 280ms var(--lp-ease-bounce);
  }
  .post-card:hover .post-card__more span,
  .post-card:focus-within .post-card__more span {
    transform: translateX(3px);
  }

  /* Cover beside the text once the CARD is wide enough — measured on the
     slot, not the viewport, so one rule serves a three-up row on a laptop
     and a single wide card on a large screen. A media query cannot express
     that: the same viewport holds both. */
  @container (min-width: 34rem) {
    .post-card {
      flex-direction: row;
      align-items: stretch;
    }
    .post-card__cover {
      flex: 0 0 42%;
      aspect-ratio: auto;
    }
    .post-card__body {
      flex: 1 1 auto;
      min-width: 0;
      justify-content: center;
      padding: 1.375rem 1.5rem;
    }
    .post-card__excerpt {
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }
    .post-card .card-title {
      font-size: 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card,
    .post-card::before,
    .post-card__art,
    .post-card .card-title,
    .post-card__more,
    .post-card__more span {
      transition: none;
    }
    /* The drift is continuous motion; it does not get a shorter version. */
    .post-card:hover .post-card__art,
    .post-card:focus-within .post-card__art {
      animation: none;
    }
    /* END STATE — the shared reduced-motion block clamps duration only, so
       the bar still has to arrive at its full height. */
    .post-card:hover::before,
    .post-card:focus-within::before {
      transform: scaleY(1);
    }
  }
</style>
