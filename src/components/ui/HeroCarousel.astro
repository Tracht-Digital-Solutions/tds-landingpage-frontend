---
/**
 * The hero's carousel (2026-10-12): a random handful of our own examples —
 * demos and design studies — as cards on a wheel. The front card stands at
 * the top of the arc; its neighbours sit lower, smaller and more transparent;
 * every few seconds the wheel turns one card on, with a spring that carries
 * each card past its place and back.
 *
 * ### What it is, and what it must never become
 *
 * - **Plain Astro, no island.** The hero's copy must never wait on
 *   hydration (`motion.test.ts`); the wheel is markup the server lays out in
 *   its first pose, and a small script only turns it.
 * - **Never behind the copy.** It lives right of the slogan from 64rem and is
 *   absent below that: on a phone there is no free band large enough for a
 *   card.
 * - **No opacity start state.** The cards render where they rest; the wheel
 *   only fades what is moving to the back.
 * - **WCAG 2.2.2:** it turns only while on screen and in a visible tab, stops
 *   under the pointer and with focus inside, and never under reduced motion
 *   or the site's motion switch.
 * - **Never cut off** (2026-11-04). The hero clips at its box and the window
 *   at its width; a card fades out over the last 3rem before either edge and
 *   is invisible where it would be cut, so cards fade in and out as they turn.
 * - **Sampled per render.** The page cache keeps one sample per generation;
 *   the next rebuild draws a new one. That is the "Stichprobe": no favourite.
 *
 * ### How the wheel turns
 *
 * The wheel is one number, its position in cards (`lib/heroWheel.ts`). A small
 * script moves it, by hand or with a spring, and writes each card's `--slot`.
 * Position, scale and turn are trigonometry of that slot, so a card travels
 * along the arc. Only the fade is a CSS transition.
 *
 * Drag it and it turns with the hand; a short swipe is enough for one card and
 * a throw carries further (`lib/momentum.ts`). Pressing it mid-turn holds it
 * where it is. Clicking a neighbour brings it to the front. Only the front card
 * is a link a keyboard reaches; the others are `aria-hidden` and out of the
 * tab order, but stay clickable. Every card leads to the project overview.
 */
import { projectsHref } from "~/lib/projects";
import { getDemos } from "~/lib/demos";
import { DEMO_KINDS, DEMO_ORIGINS } from "~/lib/demoCatalog";
import { coverView, designStudies } from "~/lib/designStudies";
import type { Lang } from "~/lib/i18n";
import { PREVIEW_VARIANT_WIDTHS, srcsetFor } from "~/lib/imageVariants";
import { mediaSrc } from "~/lib/mediaSrc";
import { shuffled } from "~/lib/shuffle";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/** Seven slots: front, two pairs visible, one hidden pair to turn through. */
const COUNT = 7;

interface Example {
  key: string;
  title: string;
  kind: string;
  origin: string;
  src: string;
  srcset: string;
  width: number;
  height: number;
}

const demos = await getDemos();
const pool: Example[] = shuffled<Example>([
  ...demos.map((demo) => ({
    key: `demo-${demo.definition.id}`,
    title: demo.title,
    kind: DEMO_KINDS[demo.definition.kind][lang],
    origin: DEMO_ORIGINS[demo.definition.origin][lang],
    src: mediaSrc(demo.preview),
    srcset: srcsetFor(demo.preview, PREVIEW_VARIANT_WIDTHS, demo.previewWidth, mediaSrc),
    width: demo.previewWidth,
    height: demo.previewHeight,
  })),
  ...designStudies.map((study) => {
    const cover = coverView(study);
    return {
      key: `study-${study.id}`,
      title: study.title,
      kind: DEMO_KINDS[study.kind][lang],
      origin: DEMO_ORIGINS.study[lang],
      src: mediaSrc(cover.src),
      srcset: srcsetFor(cover.src, PREVIEW_VARIANT_WIDTHS, cover.width, mediaSrc),
      width: cover.width,
      height: cover.height,
    };
  }),
]);

// Shuffled, then the first COUNT. With fewer than COUNT the wheel shows what
// there is; below three it would not be a wheel, so it stays out.
const sample = pool.slice(0, COUNT);
const half = Math.floor(sample.length / 2);
/** Slot of card i, in list order around the rim: the first card in front,
    the next ones to its right, the last ones to its left. */
const slotOf = (index: number) => (((index + half) % sample.length) + sample.length) % sample.length - half;

const href = projectsHref(lang);
const ui =
  lang === "en"
    ? { label: "Examples of our work", roledescription: "carousel", open: "See the examples" }
    : { label: "Beispiele aus unserer Arbeit", roledescription: "Karussell", open: "Beispiele ansehen" };
---

{
  sample.length >= 3 && (
    <div
      class="hero-carousel"
      role="group"
      aria-roledescription={ui.roledescription}
      aria-label={ui.label}
      data-hero-carousel
    >
      <ul class="hero-carousel__wheel">
        {sample.map((example, index) => {
          const slot = slotOf(index);
          return (
            <li
              class="hero-carousel__card"
              style={`--slot: ${slot}`}
              data-depth={Math.min(Math.abs(slot), 3)}
              data-side={slot < 0 ? "left" : slot > 0 ? "right" : undefined}
              aria-hidden={slot !== 0 ? "true" : undefined}
              data-hero-card
            >
              <a
                class="hero-carousel__link"
                href={href}
                tabindex={slot !== 0 ? -1 : undefined}
                draggable="false"
                data-track="hero-carousel"
              >
                <span class="hero-carousel__shot">
                  <img
                    src={example.src}
                    srcset={example.srcset}
                    sizes="25rem"
                    draggable="false"
                    width={example.width}
                    height={example.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="hero-carousel__origin">{example.origin}</span>
                </span>
                <span class="hero-carousel__meta">
                  <span class="hero-carousel__title">{example.title}</span>
                  <span class="hero-carousel__kind">
                    {example.kind}
                    <span class="sr-only"> – {example.origin}. {ui.open}</span>
                  </span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  )
}

<script>
  import { lessMotion } from "~/lib/a11yPrefs";
  import { projectedDistance, velocityTracker } from "~/lib/momentum";
  import { releaseTarget, slotAt, stepSpring, HAND_SPRING, IDLE_SPRING } from "~/lib/heroWheel";

  /** How long the front card rests before the wheel turns on its own. */
  const REST_MS = 11000;
  /** Pointer travel before a press becomes a drag (a click stays a click). */
  const SLOP_PX = 6;
  /** Pixels over which a card fades out toward an edge: narrow, so the front
      card (about 3.5rem from the window at 1024 px) never dims. */
  const FADE_PX = 48;

  document.querySelectorAll<HTMLElement>("[data-hero-carousel]").forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>("[data-hero-card]")];
    const n = cards.length;
    if (n < 3) return;
    const half = Math.floor(n / 2);
    const homes = cards.map((card) => Number(card.style.getPropertyValue("--slot")) || 0);
    const wheel = root.querySelector<HTMLElement>(".hero-carousel__wheel")!;
    /** Pixels of drag per card: a fifth of the hero, at least 160. */
    const pxPerCard = () => Math.max(160, wheel.clientWidth * 0.2);

    // The ONE number the wheel is: its position in cards. Hand, spring and the
    // wheel's own turn all move this, so a press in mid-turn holds the wheel
    // where it is. It used to be CSS transitions on a slot, and taking the
    // transition away for a drag dropped every card onto its target at once.
    let position = 0;
    let target = 0;
    let velocity = 0;
    let spring = IDLE_SPRING;
    let frame = 0;
    let last = 0;

    let onScreen = false;
    let hovered = false;
    let focused = false;
    let dragging = false;
    let timer = 0;

    const hero = root.closest<HTMLElement>(".hero") ?? root.parentElement ?? root;
    const links = cards.map((card) => card.querySelector<HTMLElement>(".hero-carousel__link"));

    /** Never a card cut off by an edge (2026-11-04): the hero clips at its own
        box and the window at its width, so a card fades out as it nears
        either and is gone by the time it would touch it. All writes first,
        then all reads: one layout per frame, not one per card. */
    const fadeAtEdges = () => {
      const box = hero.getBoundingClientRect();
      const right = Math.min(box.right, document.documentElement.clientWidth);
      const left = Math.max(box.left, 0);
      const fades = cards.map((card) => {
        const rect = card.getBoundingClientRect();
        if (!rect.width) return 1;
        const inside = Math.min(rect.left - left, right - rect.right, rect.top - box.top, box.bottom - rect.bottom);
        return Math.max(0, Math.min(1, inside / FADE_PX));
      });
      fades.forEach((fade, i) => links[i]?.style.setProperty("--hc-fade", fade.toFixed(3)));
    };

    const paint = () => {
      cards.forEach((card, i) => {
        const slot = slotAt(homes[i]!, position, n);
        card.style.setProperty("--slot", slot.toFixed(4));
        const nearest = Math.round(slot);
        const depth = String(Math.min(Math.abs(nearest), 3));
        if (card.dataset.depth === depth && card.dataset.nearest === String(nearest)) return;
        card.dataset.depth = depth;
        card.dataset.nearest = String(nearest);
        if (nearest === 0) delete card.dataset.side;
        else card.dataset.side = nearest < 0 ? "left" : "right";
        const front = nearest === 0;
        card.querySelector("a")?.setAttribute("tabindex", front ? "0" : "-1");
        if (front) card.removeAttribute("aria-hidden");
        else card.setAttribute("aria-hidden", "true");
      });
      fadeAtEdges();
    };

    // The resting pose needs its fades too, and a resize or a scroll (the
    // carousel leaves with the copy) moves the cards against the edges.
    let refade = 0;
    const queueFade = () => {
      if (refade || !onScreen) return;
      refade = requestAnimationFrame(() => {
        refade = 0;
        fadeAtEdges();
      });
    };
    fadeAtEdges();
    window.addEventListener("resize", queueFade, { passive: true });
    window.addEventListener("scroll", queueFade, { passive: true });

    const tick = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      const next = stepSpring(position, velocity, target, spring, dt);
      position = next.position;
      velocity = next.velocity;
      paint();
      frame = next.settled ? 0 : requestAnimationFrame(tick);
    };
    const run = () => {
      if (lessMotion()) {
        position = target;
        velocity = 0;
        paint();
        return;
      }
      if (frame) return;
      last = performance.now();
      frame = requestAnimationFrame(tick);
    };
    const hold = () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      velocity = 0;
    };

    const running = () => onScreen && !hovered && !focused && !dragging && !document.hidden && !lessMotion();
    const schedule = () => {
      window.clearTimeout(timer);
      if (!running()) return;
      timer = window.setTimeout(() => {
        spring = IDLE_SPRING;
        target = Math.round(target) + 1;
        run();
        schedule();
      }, REST_MS);
    };

    // --- The pointer: drag to turn, click a neighbour to bring it forward.
    let press: { id: number; x: number; from: number; origin: number } | null = null;
    const tracker = velocityTracker();
    let swallowClick = false;

    wheel.addEventListener("pointerdown", (event) => {
      if (event.button !== 0 || !(event.target as Element).closest("[data-hero-card]")) return;
      // The wheel may still be moving: it stops where it is, under the hand.
      hold();
      swallowClick = false;
      press = { id: event.pointerId, x: event.clientX, from: position, origin: Math.round(position) };
      tracker.reset();
      tracker.push(event.clientX, event.timeStamp);
    });
    wheel.addEventListener("pointermove", (event) => {
      if (!press || event.pointerId !== press.id) return;
      const dx = event.clientX - press.x;
      if (!dragging) {
        if (Math.abs(dx) < SLOP_PX) return;
        // Capture only past the slop: captured from the press, a plain click
        // would never reach the card.
        dragging = true;
        wheel.setPointerCapture(event.pointerId);
        root.dataset.dragging = "";
        window.clearTimeout(timer);
      }
      position = press.from - dx / pxPerCard();
      paint();
      tracker.push(event.clientX, event.timeStamp);
    });
    const release = (event: PointerEvent, cancelled: boolean) => {
      if (!press || event.pointerId !== press.id) return;
      // A cancelled pointer reports no usable position, so the last move counts.
      const speed = cancelled ? 0 : tracker.release(event.timeStamp);
      const { origin } = press;
      press = null;
      spring = HAND_SPRING;
      if (!dragging) {
        run();
        return;
      }
      dragging = false;
      swallowClick = !cancelled;
      delete root.dataset.dragging;
      const coast = lessMotion() ? 0 : projectedDistance(speed);
      target = releaseTarget({ position, origin, coast: -coast / pxPerCard(), limit: half });
      // The hand's speed carries into the spring: no stop between the two.
      velocity = lessMotion() ? 0 : (-speed * 1000) / pxPerCard();
      run();
      schedule();
    };
    wheel.addEventListener("pointerup", (event) => release(event, false));
    wheel.addEventListener("pointercancel", (event) => release(event, true));

    wheel.addEventListener(
      "click",
      (event) => {
        if (swallowClick) {
          swallowClick = false;
          event.preventDefault();
          return;
        }
        const card = (event.target as Element).closest<HTMLElement>("[data-hero-card]");
        if (!card) return;
        const slot = Math.round(slotAt(homes[cards.indexOf(card)] ?? 0, position, n));
        if (slot === 0) return; // The front card is a link.
        event.preventDefault();
        spring = HAND_SPRING;
        target = Math.round(position) + slot;
        run();
        schedule();
      },
      true,
    );

    root.addEventListener("pointerenter", () => {
      hovered = true;
      schedule();
    });
    root.addEventListener("pointerleave", () => {
      hovered = false;
      schedule();
    });
    root.addEventListener("focusin", () => {
      focused = true;
      schedule();
    });
    root.addEventListener("focusout", (event) => {
      if (root.contains(event.relatedTarget as Node | null)) return;
      focused = false;
      schedule();
    });
    document.addEventListener("visibilitychange", schedule);
    new MutationObserver(schedule).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-a11y-motion"],
    });
    new IntersectionObserver((entries) => {
      onScreen = entries.some((entry) => entry.isIntersecting);
      schedule();
    }).observe(root);
  });
</script>

<style>
  /* The angle every card's pose is computed from. Registered, so a change of
     `--slot` interpolates it, and the card travels along the arc. */
  @property --hc-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  .hero-carousel {
    display: none;
  }

  @media (min-width: 64rem) and (min-height: 36rem) {
    .hero-carousel {
      /* The wheel's measurements: one card width, the step between two slots
         on the rim, and the rim's two radii (wider than tall: a flat arc). */
      /* Larger since 2026-10-12 (21vw → 24vw, front bump 0.18 → 0.2). */
      --hc-card: clamp(15rem, 24vw, 30rem);
      --hc-step: 34deg;
      /* A steep arc, as in the sketch: the neighbours drop far enough that
         the left one lies under the hero's buttons, never beside the slogan
         (measured at 1024, 1280, 1440 and 1920). The second pair is below
         the fold; it only shows while it swings in. */
      /* Flatter since 2026-10-12: a wider, shallower rim — and flatter again
         the same night (130svh → 80svh, the tilt from 22% to 10% of the
         angle): the neighbours sink less and lean less. */
      --hc-rx: 44vw;
      --hc-ry: 80svh;
      --hc-tilt: 0.1;
      /* The front card's extra size: a bump that is 1 + focus at the top of
         the wheel and has all but vanished one slot away (cos⁸ of 34° ≈ 0.22,
         so a neighbour gains under 5%). */
      --hc-focus: 0.2;
      /* Further right with the larger card, so it clears the slogan. */
      --hc-center: 80%;
      position: absolute;
      inset: 0;
      /* Behind the copy: a card swinging past the slogan's last letters
         passes under them. The copy's container lets the pointer through
         (`Hero.astro`), so the front card stays clickable. */
      display: block;
      pointer-events: none;
    }
  }

  .hero-carousel__wheel {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-carousel__card {
    --hc-angle: calc(var(--slot, 0) * var(--hc-step));
    --hc-cos: cos(var(--hc-angle));
    position: absolute;
    /* The top of the wheel: right of the slogan, its front card centred on the
       section's vertical middle (2026-10-12; it sat at 24 %, too high). The
       first `translate` lifts the card by half its own height. */
    left: calc(var(--hc-center, 70%) - var(--hc-card) / 2);
    top: var(--hc-top, 50%);
    width: var(--hc-card);
    transform-origin: 50% 50%;
    transform:
      translate(0, -50%)
      translate(
        calc(sin(var(--hc-angle)) * var(--hc-rx)),
        calc((1 - cos(var(--hc-angle))) * var(--hc-ry))
      )
      rotate(calc(var(--hc-angle) * var(--hc-tilt, 0.22)))
      scale(
        calc(
          (0.5 + 0.5 * var(--hc-cos)) *
            (1 + var(--hc-focus, 0) * pow(max(var(--hc-cos), 0), 8))
        )
      );
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 700ms var(--tds-ease-out),
      visibility 0s linear 520ms;
  }
  .hero-carousel__card[data-depth="0"] {
    z-index: 4;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 700ms var(--tds-ease-out),
      visibility 0s;
  }
  .hero-carousel__card[data-depth="1"] {
    z-index: 3;
    opacity: 0.5;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 700ms var(--tds-ease-out),
      visibility 0s;
  }
  /* On the flatter rim the left neighbour rises to the slogan's height and
     passes under its last words: fainter there, so the copy stays calm. */
  .hero-carousel__card[data-depth="1"][data-side="left"] {
    opacity: 0.3;
  }
  .hero-carousel__card[data-depth="2"] {
    z-index: 2;
    opacity: 0.18;
    visibility: visible;
    transition:
      opacity 700ms var(--tds-ease-out),
      visibility 0s;
  }
  .hero-carousel__wheel {
    touch-action: pan-y;
    user-select: none;
  }
  .hero-carousel__card[data-depth="1"] {
    cursor: pointer;
  }
  .hero-carousel[data-dragging],
  .hero-carousel[data-dragging] * {
    cursor: grabbing;
  }

  @media (min-width: 80rem) {
    .hero-carousel {
      --hc-center: 77%;
    }
  }

  .hero-carousel__link {
    display: flex;
    flex-direction: column;
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-soft);
    color: var(--color-black);
    text-decoration: none;
    box-shadow: var(--tds-shadow-hard);
    /* The edge fade (script): 1 well inside the hero, 0 where the card would
       be cut off. Multiplies with the card's own depth opacity. */
    opacity: var(--hc-fade, 1);
    transition:
      background-color 200ms var(--tds-ease-out),
      translate 160ms var(--tds-ease-out);
  }
  .hero-carousel__card[data-depth="0"] .hero-carousel__link:hover,
  .hero-carousel__link:focus-visible {
    background: color-mix(in srgb, var(--color-primary) 6%, var(--color-soft));
    box-shadow: var(--tds-shadow-hard-hover, var(--tds-shadow-hard));
    translate: -2px -2px;
  }
  .hero-carousel__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .hero-carousel__shot {
    position: relative;
    display: block;
    /* 16:10, the demos' own format (1440×900). The frame used to be 4:3.4
       with `object-fit: cover`, which cut a quarter off each wide screenshot
       and read as zoomed in. */
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-card);
  }
  /* Always the full width of the shot, never more: a tall full-page study
     shows its top, a wider image leaves a strip of card below — neither is
     enlarged beyond the frame. */
  .hero-carousel__shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-carousel__origin {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    padding: 0.25rem 0.625rem;
    border-radius: var(--tds-radius-pill, 100px);
    background: var(--color-surface-navy);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .hero-carousel__meta {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.875rem 1.125rem 1rem;
  }
  .hero-carousel__title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hero-carousel__kind {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-carousel__card,
    .hero-carousel__card[data-depth],
    .hero-carousel__link {
      transition: none;
    }
  }
</style>
