---
/**
 * The hero's carousel (2026-10-12): a random handful of our own examples —
 * demos and design studies — as cards on a wheel. The front card stands at
 * the top of the arc; its neighbours sit lower, smaller and more transparent;
 * every few seconds the wheel turns one card on, with a spring that carries
 * each card past its place and back.
 *
 * ### What it is, and what it must never become
 *
 * - **Plain Astro, no island.** The hero's copy must never wait on
 *   hydration (`motion.test.ts`); the wheel is markup the server lays out in
 *   its first pose, and a small script only turns it.
 * - **Never behind the copy.** It lives right of the slogan from 64rem and is
 *   absent below that: on a phone there is no free band large enough for a
 *   card.
 * - **No opacity start state.** The cards render where they rest; the wheel
 *   only fades what is moving to the back.
 * - **WCAG 2.2.2:** it turns only while on screen and in a visible tab, stops
 *   under the pointer and with focus inside, and never under reduced motion
 *   or the site's motion switch.
 * - **Sampled per render.** The page cache keeps one sample per generation;
 *   the next rebuild draws a new one. That is the "Stichprobe": no favourite.
 *
 * ### How the wheel turns
 *
 * Each card has a slot (`--slot`, …-1, 0, 1, …). Its angle on the wheel is a
 * registered `<angle>` property derived from the slot, so a slot change
 * TRANSITIONS the angle, and position, scale and turn are trigonometry of that
 * angle: the card travels along the arc, not across a chord. The transition
 * uses `--lp-ease-swing`, a well-damped sampled spring (since 2026-10-12 about
 * 1.5 % past, no swing back; it was two swings before) — the overshoot is
 * an angle, so a card eases onto the top and settles. The fade is a separate
 * property with a plain ease (never an overshoot on opacity).
 *
 * The wheel answers the pointer (2026-10-12): drag it and it turns with the
 * hand, let go and it springs onto the nearest card (a flick carries one
 * further); click a neighbour and it comes to the front. Only the front card
 * is a link a keyboard reaches; the others are `aria-hidden` and out of the
 * tab order, but stay clickable. Every card leads to the showcase section.
 */
import { getDemos } from "~/lib/demos";
import { DEMO_KINDS, DEMO_ORIGINS } from "~/lib/demoCatalog";
import { coverView, designStudies } from "~/lib/designStudies";
import type { Lang } from "~/lib/i18n";
import { localizePath } from "~/lib/i18n";
import { PREVIEW_VARIANT_WIDTHS, srcsetFor } from "~/lib/imageVariants";
import { mediaSrc } from "~/lib/mediaSrc";
import { shuffled } from "~/lib/shuffle";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/** Seven slots: front, two pairs visible, one hidden pair to turn through. */
const COUNT = 7;

interface Example {
  key: string;
  title: string;
  kind: string;
  origin: string;
  src: string;
  srcset: string;
  width: number;
  height: number;
}

const demos = await getDemos();
const pool: Example[] = shuffled<Example>([
  ...demos.map((demo) => ({
    key: `demo-${demo.definition.id}`,
    title: demo.title,
    kind: DEMO_KINDS[demo.definition.kind][lang],
    origin: DEMO_ORIGINS[demo.definition.origin][lang],
    src: mediaSrc(demo.preview),
    srcset: srcsetFor(demo.preview, PREVIEW_VARIANT_WIDTHS, demo.previewWidth, mediaSrc),
    width: demo.previewWidth,
    height: demo.previewHeight,
  })),
  ...designStudies.map((study) => {
    const cover = coverView(study);
    return {
      key: `study-${study.id}`,
      title: study.title,
      kind: DEMO_KINDS[study.kind][lang],
      origin: DEMO_ORIGINS.study[lang],
      src: mediaSrc(cover.src),
      srcset: srcsetFor(cover.src, PREVIEW_VARIANT_WIDTHS, cover.width, mediaSrc),
      width: cover.width,
      height: cover.height,
    };
  }),
]);

// Shuffled, then the first COUNT. With fewer than COUNT the wheel shows what
// there is; below three it would not be a wheel, so it stays out.
const sample = pool.slice(0, COUNT);
const half = Math.floor(sample.length / 2);
/** Slot of card i, in list order around the rim: the first card in front,
    the next ones to its right, the last ones to its left. */
const slotOf = (index: number) => (((index + half) % sample.length) + sample.length) % sample.length - half;

const href = `${localizePath("/", lang)}#showcase`;
const ui =
  lang === "en"
    ? { label: "Examples of our work", roledescription: "carousel", open: "See the examples" }
    : { label: "Beispiele aus unserer Arbeit", roledescription: "Karussell", open: "Beispiele ansehen" };
---

{
  sample.length >= 3 && (
    <div
      class="hero-carousel"
      role="group"
      aria-roledescription={ui.roledescription}
      aria-label={ui.label}
      data-hero-carousel
    >
      <ul class="hero-carousel__wheel">
        {sample.map((example, index) => {
          const slot = slotOf(index);
          return (
            <li
              class="hero-carousel__card"
              style={`--slot: ${slot}`}
              data-depth={Math.min(Math.abs(slot), 3)}
              data-side={slot < 0 ? "left" : slot > 0 ? "right" : undefined}
              aria-hidden={slot !== 0 ? "true" : undefined}
              data-hero-card
            >
              <a
                class="hero-carousel__link"
                href={href}
                tabindex={slot !== 0 ? -1 : undefined}
                draggable="false"
                data-track="hero-carousel"
              >
                <span class="hero-carousel__shot">
                  <img
                    src={example.src}
                    srcset={example.srcset}
                    sizes="25rem"
                    draggable="false"
                    width={example.width}
                    height={example.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="hero-carousel__origin">{example.origin}</span>
                </span>
                <span class="hero-carousel__meta">
                  <span class="hero-carousel__title">{example.title}</span>
                  <span class="hero-carousel__kind">
                    {example.kind}
                    <span class="sr-only"> – {example.origin}. {ui.open}</span>
                  </span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  )
}

<script>
  import { lessMotion } from "~/lib/a11yPrefs";

  /** How long the front card rests before the wheel turns on its own. */
  const REST_MS = 8000;
  /** The turn's own length — the same number as `--hc-turn` in the CSS. */
  const TURN_MS = 3000;
  /** Pointer travel before a press becomes a drag (a click stays a click). */
  const SLOP_PX = 6;

  document.querySelectorAll<HTMLElement>("[data-hero-carousel]").forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>("[data-hero-card]")];
    const n = cards.length;
    if (n < 3) return;
    const half = Math.floor(n / 2);
    let slots = cards.map((card) => Number(card.style.getPropertyValue("--slot")) || 0);
    const wheel = root.querySelector<HTMLElement>(".hero-carousel__wheel")!;
    /** The angle between two slots, read from the CSS (`--hc-step`). */
    const step = () => parseFloat(getComputedStyle(root).getPropertyValue("--hc-step")) || 34;
    /** Degrees of turn per pixel dragged: one card per fifth of the hero. */
    const degPerPx = () => step() / Math.max(160, wheel.clientWidth * 0.2);

    let onScreen = false;
    let hovered = false;
    let focused = false;
    let dragging = false;
    let timer = 0;

    const place = (card: HTMLElement, slot: number) => {
      card.style.setProperty("--slot", String(slot));
      card.dataset.depth = String(Math.min(Math.abs(slot), 3));
      if (slot === 0) delete card.dataset.side;
      else card.dataset.side = slot < 0 ? "left" : "right";
      const front = slot === 0;
      card.querySelector("a")?.setAttribute("tabindex", front ? "0" : "-1");
      if (front) card.removeAttribute("aria-hidden");
      else card.setAttribute("aria-hidden", "true");
    };

    /** Turn the wheel by `by` cards; positive brings the right-hand ones forward. */
    const turn = (by: number) => {
      if (by === 0) return;
      slots = slots.map((slot, i) => {
        const raw = slot - by;
        const next = ((((raw + half) % n) + n) % n) - half;
        const card = cards[i]!;
        if (next !== raw) {
          // Round the back of the wheel: a jump, made while the card is out
          // of sight, so without a transition.
          card.dataset.wrap = "";
          place(card, next);
          void card.offsetWidth;
          window.setTimeout(() => delete card.dataset.wrap, 32);
        } else {
          place(card, next);
        }
        return next;
      });
    };

    const running = () => onScreen && !hovered && !focused && !dragging && !document.hidden && !lessMotion();
    const schedule = () => {
      window.clearTimeout(timer);
      if (!running()) return;
      // The rest is counted from the end of the previous turn.
      timer = window.setTimeout(() => {
        turn(1);
        timer = window.setTimeout(schedule, TURN_MS);
      }, REST_MS);
    };

    // --- The pointer: drag to turn, click a neighbour to bring it forward.
    let press: { id: number; x: number; t: number; lastT: number } | null = null;
    let swallowClick = false;

    wheel.addEventListener("pointerdown", (event) => {
      if (event.button !== 0 || !(event.target as Element).closest("[data-hero-card]")) return;
      press = { id: event.pointerId, x: event.clientX, t: event.timeStamp, lastT: event.timeStamp };
    });
    wheel.addEventListener("pointermove", (event) => {
      if (!press || event.pointerId !== press.id) return;
      const dx = event.clientX - press.x;
      if (!dragging) {
        if (Math.abs(dx) < SLOP_PX) return;
        // Capture only past the slop: captured from the press, a plain click
        // would never reach the card.
        dragging = true;
        wheel.setPointerCapture(event.pointerId);
        root.dataset.dragging = "";
        window.clearTimeout(timer);
      }
      root.style.setProperty("--hc-drag", `${dx * degPerPx()}deg`);
      press.lastT = event.timeStamp;
    });
    const release = (event: PointerEvent) => {
      if (!press || event.pointerId !== press.id) return;
      const dx = event.clientX - press.x;
      const moving = event.timeStamp - press.lastT < 80;
      const velocity = moving ? dx / Math.max(1, event.timeStamp - press.t) : 0;
      press = null;
      if (!dragging) return;
      dragging = false;
      swallowClick = true;
      const turned = (dx * degPerPx()) / step();
      // The nearest card; a quick flick carries the wheel one further.
      let by = Math.round(Math.abs(velocity) > 0.6 ? turned + Math.sign(velocity) * 0.6 : turned);
      by = Math.max(-half, Math.min(half, by));
      // In one frame: the hand lets go and the slots move, so the spring
      // starts where the hand left the cards.
      delete root.dataset.dragging;
      root.style.setProperty("--hc-drag", "0deg");
      // Dragging right brings the left-hand cards forward.
      turn(-by);
      schedule();
    };
    wheel.addEventListener("pointerup", release);
    wheel.addEventListener("pointercancel", release);

    wheel.addEventListener(
      "click",
      (event) => {
        if (swallowClick) {
          swallowClick = false;
          event.preventDefault();
          return;
        }
        const card = (event.target as Element).closest<HTMLElement>("[data-hero-card]");
        if (!card) return;
        const slot = slots[cards.indexOf(card)] ?? 0;
        if (slot === 0) return; // The front card is a link.
        event.preventDefault();
        turn(slot);
        schedule();
      },
      true,
    );

    root.addEventListener("pointerenter", () => {
      hovered = true;
      schedule();
    });
    root.addEventListener("pointerleave", () => {
      hovered = false;
      schedule();
    });
    root.addEventListener("focusin", () => {
      focused = true;
      schedule();
    });
    root.addEventListener("focusout", (event) => {
      if (root.contains(event.relatedTarget as Node | null)) return;
      focused = false;
      schedule();
    });
    document.addEventListener("visibilitychange", schedule);
    new MutationObserver(schedule).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-a11y-motion"],
    });
    new IntersectionObserver((entries) => {
      onScreen = entries.some((entry) => entry.isIntersecting);
      schedule();
    }).observe(root);
  });
</script>

<style>
  /* The angle every card's pose is computed from. Registered, so a change of
     `--slot` interpolates it, and the card travels along the arc. */
  @property --hc-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  .hero-carousel {
    display: none;
  }

  @media (min-width: 64rem) and (min-height: 36rem) {
    .hero-carousel {
      /* The wheel's measurements: one card width, the step between two slots
         on the rim, and the rim's two radii (wider than tall: a flat arc). */
      --hc-card: clamp(15rem, 21vw, 25rem);
      --hc-step: 34deg;
      /* A steep arc, as in the sketch: the neighbours drop far enough that
         the left one lies under the hero's buttons, never beside the slogan
         (measured at 1024, 1280, 1440 and 1920). The second pair is below
         the fold; it only shows while it swings in. */
      /* Flatter since 2026-10-12: a wider, shallower rim — and flatter again
         the same night (130svh → 80svh, the tilt from 22% to 10% of the
         angle): the neighbours sink less and lean less. */
      --hc-rx: 44vw;
      --hc-ry: 80svh;
      --hc-tilt: 0.1;
      /* The front card's extra size: a bump that is 1 + focus at the top of
         the wheel and has all but vanished one slot away (cos⁸ of 34° ≈ 0.22,
         so a neighbour gains under 5%). */
      --hc-focus: 0.18;
      /* One turn, slower since 2026-10-12 (1.5 s → 2.1 s → 3 s, rest 8 s).
         TURN_MS in the script matches. */
      --hc-turn: 3000ms;
      --hc-center: 78%;
      position: absolute;
      inset: 0;
      /* Behind the copy: a card swinging past the slogan's last letters
         passes under them. The copy's container lets the pointer through
         (`Hero.astro`), so the front card stays clickable. */
      display: block;
      pointer-events: none;
    }
  }

  .hero-carousel__wheel {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-carousel__card {
    /* `--hc-drag` is the hand's share while the wheel is dragged. */
    --hc-angle: calc(var(--slot, 0) * var(--hc-step) + var(--hc-drag, 0deg));
    --hc-cos: cos(var(--hc-angle));
    position: absolute;
    /* The top of the wheel: right of the slogan, a little above the middle. */
    left: calc(var(--hc-center, 70%) - var(--hc-card) / 2);
    top: var(--hc-top, 24%);
    width: var(--hc-card);
    transform-origin: 50% 50%;
    transform:
      translate(
        calc(sin(var(--hc-angle)) * var(--hc-rx)),
        calc((1 - cos(var(--hc-angle))) * var(--hc-ry))
      )
      rotate(calc(var(--hc-angle) * var(--hc-tilt, 0.22)))
      scale(
        calc(
          (0.5 + 0.5 * var(--hc-cos)) *
            (1 + var(--hc-focus, 0) * pow(max(var(--hc-cos), 0), 8))
        )
      );
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      --hc-angle var(--hc-turn, 1500ms) var(--lp-ease-swing),
      opacity 700ms var(--tds-ease-out),
      visibility 0s linear 520ms;
  }
  .hero-carousel__card[data-depth="0"] {
    z-index: 4;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      --hc-angle var(--hc-turn, 1500ms) var(--lp-ease-swing),
      opacity 700ms var(--tds-ease-out),
      visibility 0s;
  }
  .hero-carousel__card[data-depth="1"] {
    z-index: 3;
    opacity: 0.5;
    visibility: visible;
    pointer-events: auto;
    transition:
      --hc-angle var(--hc-turn, 1500ms) var(--lp-ease-swing),
      opacity 700ms var(--tds-ease-out),
      visibility 0s;
  }
  /* On the flatter rim the left neighbour rises to the slogan's height and
     passes under its last words: fainter there, so the copy stays calm. */
  .hero-carousel__card[data-depth="1"][data-side="left"] {
    opacity: 0.3;
  }
  .hero-carousel__card[data-depth="2"] {
    z-index: 2;
    opacity: 0.18;
    visibility: visible;
    transition:
      --hc-angle var(--hc-turn, 1500ms) var(--lp-ease-swing),
      opacity 700ms var(--tds-ease-out),
      visibility 0s;
  }
  .hero-carousel__card[data-wrap] {
    transition: none;
  }
  /* The hand turns it: the cards follow the pointer without lag, and fade
     with their depth as usual. */
  .hero-carousel[data-dragging] .hero-carousel__card {
    transition:
      opacity 700ms var(--tds-ease-out),
      visibility 0s;
  }
  .hero-carousel__wheel {
    touch-action: pan-y;
    user-select: none;
  }
  .hero-carousel__card[data-depth="1"] {
    cursor: pointer;
  }
  .hero-carousel[data-dragging],
  .hero-carousel[data-dragging] * {
    cursor: grabbing;
  }

  @media (min-width: 80rem) {
    .hero-carousel {
      --hc-center: 74%;
    }
  }

  .hero-carousel__link {
    display: flex;
    flex-direction: column;
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-soft);
    color: var(--color-black);
    text-decoration: none;
    box-shadow: var(--tds-shadow-hard);
    transition:
      background-color 200ms var(--tds-ease-out),
      translate 160ms var(--tds-ease-out);
  }
  .hero-carousel__card[data-depth="0"] .hero-carousel__link:hover,
  .hero-carousel__link:focus-visible {
    background: color-mix(in srgb, var(--color-primary) 6%, var(--color-soft));
    box-shadow: var(--tds-shadow-hard-hover, var(--tds-shadow-hard));
    translate: -2px -2px;
  }
  .hero-carousel__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .hero-carousel__shot {
    position: relative;
    display: block;
    /* 16:10, the demos' own format (1440×900). The frame used to be 4:3.4
       with `object-fit: cover`, which cut a quarter off each wide screenshot
       and read as zoomed in. */
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-card);
  }
  /* Always the full width of the shot, never more: a tall full-page study
     shows its top, a wider image leaves a strip of card below — neither is
     enlarged beyond the frame. */
  .hero-carousel__shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-carousel__origin {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    padding: 0.25rem 0.625rem;
    border-radius: var(--tds-radius-pill, 100px);
    background: var(--color-surface-navy);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .hero-carousel__meta {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.875rem 1.125rem 1rem;
  }
  .hero-carousel__title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hero-carousel__kind {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-carousel__card,
    .hero-carousel__card[data-depth],
    .hero-carousel__link {
      transition: none;
    }
  }
</style>
