---
/**
 * Qualifikationen — every certificate, shown as the document it is.
 *
 * ### Why a page of its own
 *
 * Thirteen certificates do not fit in the "Wieso ich?" section without burying
 * it, and the home page's own rule is short copy. So that section names the
 * three closest to the work and links here, where the rest stand in four
 * groups. The page is indexable and pairs across the two trees
 * (`sitemap.ts`), which a dialog on the home page could not have been.
 *
 * ### No framing sentence
 *
 * The page carried one naming the platform and its partners and calling the
 * records what they are not. Removed on request (2026-09-29). Each certificate
 * still shows its own issuer on its own card, and the picture underneath is the
 * document itself — so what a reader can check has not changed, only the
 * paragraph that said it for them.
 *
 * ### Order
 *
 * Groups in `CREDENTIAL_GROUP_ORDER`, cards in catalog order inside each. Both
 * are decided once in `lib/credentials.ts`; nothing here sorts.
 */
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import AccentLetters from "~/components/ui/AccentLetters.astro";
import CredentialCard from "~/components/ui/CredentialCard.astro";
import PreviewLightbox from "~/components/ui/PreviewLightbox.astro";
import DetailMeta from "~/components/detail/DetailMeta.astro";
import {
  CREDENTIALS_UPDATED_AT,
  CREDENTIAL_GROUPS,
  CREDENTIAL_GROUP_ORDER,
  credentials,
  credentialsHref,
  credentialsInGroup,
} from "~/lib/credentials";
import { localizePath, type Lang } from "~/lib/i18n";
import { asGraph, breadcrumbNode, organizationSchema, personSchema, webPageNode } from "~/lib/jsonld";
import { siteConfig } from "~/lib/seo";
import { absolute } from "~/lib/sitemap";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Both wrappers are three-line files around this component, so the meta
// descriptions live here. The NAME is load-bearing: `seo.test.ts` reads this
// literal off disk to hold every indexable page inside one length budget.
const pageDescriptions = {
  de: "Die Qualifikationen von Julian Tracht: abgeschlossene Weiterbildungen zu SEO, Projekten, Technik und Daten — jedes Zertifikat im Original zum Nachlesen.",
  en: "The qualifications of Julian Tracht: completed training in SEO, project management, engineering and data — every certificate shown in full, to read yourself.",
};

const ui =
  lang === "de"
    ? {
        back: "Zurück zur Startseite",
        backNav: "Seitenpfad",
        title: "Qualifikationen",
        headline: "Was ich",
        headlineAccent: "gelernt habe.",
        lead: `${credentials.length} Nachweise aus abgeschlossenen Weiterbildungen — von der Arbeit an Suchmaschinen bis zur Absicherung einer Seite. Jedes Zertifikat steht hier im Original.`,
        // Answer first: who, what, for whom, where — before the evidence.
        answer:
          "Julian Tracht, Inhaber von Tracht Digital Solutions in Schwarzenbek bei Hamburg, führt hier jede abgeschlossene Weiterbildung mit dem zugehörigen Zertifikat auf. Es sind Nachweise aus Kursen zu Suchmaschinen, Projektarbeit, Technik und Daten – keine Hochschulabschlüsse. Wer prüfen will, worauf eine Empfehlung beruht, kann jedes Dokument hier im Original ansehen.",
        ctaLead: "Du willst wissen, was davon deine Seite weiterbringt?",
        cta: "Erstgespräch vereinbaren",
      }
    : {
        back: "Back to the home page",
        backNav: "Breadcrumb",
        title: "Qualifications",
        headline: "What I have",
        headlineAccent: "learned.",
        lead: `${credentials.length} records of completed training — from working with search engines to securing a site. Every certificate is shown here in full.`,
        answer:
          "Julian Tracht, owner of Tracht Digital Solutions in Schwarzenbek near Hamburg, lists every completed course here together with its certificate. They are records from training in search engines, project work, engineering and data – not university degrees. Anyone who wants to check what a recommendation rests on can read each document here in full.",
        ctaLead: "Want to know what any of it does for your site?",
        cta: "Book a first conversation",
      };

const homeHref = localizePath("/", lang);
const contactHref = `${homeHref}#contact`;

/**
 * The credentials as structured data, on the Person the whole site already
 * names as its author.
 *
 * `EducationalOccupationalCredential` is the schema.org type for exactly this,
 * and `credentialCategory: "certificate"` is what keeps it from reading as a
 * degree — the same distinction the disclaimer makes in words. `url` points at
 * the picture, because the picture is what a reader can check.
 */
const person = {
  ...personSchema(),
  hasCredential: credentials.map((entry) => ({
    "@type": "EducationalOccupationalCredential",
    name: entry.title,
    credentialCategory: "certificate",
    dateCreated: entry.completedAt,
    identifier: entry.certificateId,
    recognizedBy: { "@type": "Organization", name: entry.issuer },
    url: `${siteConfig.url}/zertifikate/${entry.id}.webp`,
  })),
};

// The page as an entity, dated and authored, the way the service and platform
// pages do it. `dateModified` is the value the "Stand" line below shows.
const pageUrl = absolute(credentialsHref(lang));
const breadcrumbId = `${pageUrl}#breadcrumb`;
const graph = asGraph(
  webPageNode({
    url: pageUrl,
    name: ui.title,
    description: pageDescriptions[lang],
    lang,
    dateModified: CREDENTIALS_UPDATED_AT,
    breadcrumbId,
  }),
  breadcrumbNode(breadcrumbId, [
    { name: lang === "de" ? "Startseite" : "Home", url: absolute(homeHref) },
    { name: ui.title, url: pageUrl },
  ]),
  person,
  organizationSchema(),
);
---

<Layout
  title={`${lang === "de" ? "Qualifikationen" : "Qualifications"} — ${siteConfig.name}`}
  description={pageDescriptions[lang]}
  lang={lang}
  alternates={{ de: credentialsHref("de"), en: credentialsHref("en") }}
  jsonLd={graph}
>
  <Header />

  <main id="main">
    <section class="relative pt-36 pb-12 md:pt-44 md:pb-16" aria-labelledby="credentials-title">
      {/* The page has ONE ground (`.page-ground` in `Layout.astro`); this is
          only the constructed geometry the detail pages open with. */}
      <div class="tds-decor" aria-hidden="true">
        <span
          class="tds-shape tds-shape--quarter-tl tds-shape--bordeaux"
          style="right: -8rem; bottom: -11rem; width: 29rem; height: 29rem; --tds-decor-shape-alpha: 0.13;"
        ></span>
        <span
          class="tds-shape tds-shape--rect tds-shape--outline tds-shape--navy hidden lg:block"
          style="right: 9%; top: 8rem; width: 11rem; height: 16rem; --tds-decor-shape-alpha: 0.2;"
        ></span>
      </div>

      <div class="relative lp-container">
        <nav aria-label={ui.backNav} class="mb-10">
          <a
            href={homeHref}
            class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-[var(--color-primary)] transition-colors group [@media(pointer:coarse)]:min-h-11"
          >
            <svg
              aria-hidden="true"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform group-hover:-translate-x-0.5"
            >
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            {ui.back}
          </a>
        </nav>

        <div class="max-w-3xl">
          <h1
            id="credentials-title"
            class="display text-4xl sm:text-5xl md:text-6xl text-[var(--color-black)] leading-[1.04] mb-6"
          >
            {ui.headline}{" "}
            <AccentLetters text={ui.headlineAccent} />
          </h1>
          <span aria-hidden="true" class="tds-brandbar mb-8"></span>
          {/* Answer first: what these are and how many, before any framing. */}
          <p class="lead text-[var(--color-muted)] mb-5">{ui.lead}</p>
          {/* Who, what, for whom, where — and what these records are NOT. */}
          <p class="text-[var(--color-muted)] leading-relaxed">{ui.answer}</p>
          <DetailMeta lang={lang} updatedAt={CREDENTIALS_UPDATED_AT} />
        </div>
      </div>
    </section>

    {
      CREDENTIAL_GROUP_ORDER.map((group) => {
        const entries = credentialsInGroup(group);
        const heading = CREDENTIAL_GROUPS[group][lang];
        return (
          <section class="pb-14 md:pb-20" aria-labelledby={`credentials-${group}`}>
            <div class="lp-container">
              <div class="mb-8 max-w-2xl">
                <h2
                  id={`credentials-${group}`}
                  class="display text-2xl md:text-3xl text-[var(--color-black)] mb-2"
                >
                  {heading.title}
                </h2>
                <p class="text-[var(--color-muted)] leading-relaxed">{heading.lead}</p>
              </div>

              {/* `auto-fit` with a floor, capped by the number of cards, so a
                  group of one does not stretch a certificate across the whole
                  container. Same arrangement as `.demo-grid`. */}
              <div class="credential-grid" style={`--credential-count: ${entries.length}`}>
                {entries.map((credential) => (
                  <CredentialCard credential={credential} lang={lang} />
                ))}
              </div>
            </div>
          </section>
        );
      })
    }

    <section class="pb-24 md:pb-32" aria-labelledby="credentials-cta">
      <div class="lp-container">
        <div class="credential-cta">
          <h2 id="credentials-cta" class="display text-2xl md:text-3xl text-[var(--color-black)]">
            {ui.ctaLead}
          </h2>
          <a href={contactHref} class="credential-cta__link" data-cta data-track="credentials-cta">
            {ui.cta}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    {/* One dialog for every certificate on the page. It sits outside the
        groups on purpose: the lightbox binds to `closest("section")`, and from
        here that is `null`, so it wires every card rather than one group's. */}
    <PreviewLightbox lang={lang} />
  </main>

  <Footer />
</Layout>

<style>
  .credential-grid {
    display: grid;
    --credential-gap: 1rem;
    gap: var(--credential-gap);
    align-items: stretch;
    grid-auto-rows: 1fr;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    max-width: calc(
      var(--credential-count, 3) * 26rem + (var(--credential-count, 3) - 1) * var(--credential-gap)
    );
  }
  @media (min-width: 768px) {
    .credential-grid {
      --credential-gap: 1.5rem;
    }
  }

  .credential-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.75rem;
    border-radius: 6px;
    background: var(--color-soft);
  }
  /* NO `.btn` — unlayered tds-shared beats every Tailwind utility, so a custom
     fill on `.btn btn-primary` would not apply. Same note as the FAQ's pill. */
  .credential-cta__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
    padding: 0.875rem 1.5rem;
    border-radius: 100px;
    background: var(--color-accent);
    /* The paper colour, not `#fff`: white fails contrast on this fill in dark
       mode, where the accent lightens. */
    color: var(--color-paper);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 200ms var(--tds-ease-out);
  }
  .credential-cta__link:hover {
    background: var(--color-surface-navy);
  }
  .credential-cta__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
