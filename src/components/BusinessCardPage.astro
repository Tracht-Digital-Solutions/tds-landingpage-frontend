---
/**
 * The digital business card — one STANDALONE page, both languages.
 *
 * ### Why it stands alone
 *
 * This is the one route on the site that is not arrived at by browsing. It is
 * reached by a camera pointed at a printed code, or by a link pasted into a
 * chat, and the visitor is holding a phone with a single question: how do I
 * reach this person. The site's own chrome answers a different question. A
 * sticky header offering "Wieso ich? / Leistungen / Vorgehen", a floating
 * "Unverbindlich anfragen" nub over the bottom of the screen and a four-column
 * footer are all navigation into a marketing site — on this page they sit
 * between a scanned code and a phone number, and the floating CTA literally
 * covers the first link.
 *
 * So the page renders `bare` (see `Layout.astro`): no Header, no Footer, no
 * FloatingCta, no custom cursor, no scroll-progress bar, no smooth-scroll
 * hijack, no live-chat widget. What is left is the link hub itself — the
 * portrait, the actions, the QR code — plus the three things a standalone page
 * still owes the visitor: a language switch, a theme switch, and the legal
 * links a public German page must carry. Those are rebuilt here in their
 * smallest honest form rather than imported, which is the ONE deliberate
 * exception to "never fork base UI": a footer strip of three legal links is
 * not the site footer with pieces removed.
 *
 * The cookie notice goes with the rest of the chrome, and that is safe rather
 * than convenient: it is admin-toggleable, it is informational (its own copy
 * says the site sets no tracking cookies), and this page loads no third-party
 * anything. The Datenschutz link below is what it pointed at.
 *
 * ### Why a page and not just the .vcf
 *
 * `/kontakt.vcf` already existed and is still the thing a phone saves; this
 * page is what a person can be SHOWN. That difference is the whole point of
 * the route: a downloadable file cannot be put on a reference shelf, cannot be
 * scanned off a screen, and cannot demonstrate that this is something built
 * for customers too. The page is linked from the contact aside, from the
 * showcase on the home page and from the Webauftritt service page for exactly
 * that reason.
 *
 * ### One source for the data
 *
 * Every value comes from `siteConfig` — the same object the vCard endpoint and
 * the LocalBusiness JSON-LD read — through `businessCardLinks()`, which owns
 * the rows and their order. Nothing here is typed out a second time, so the
 * card cannot drift from the Impressum. The postal address is deliberately
 * ABSENT, matching `kontakt.vcf.ts`: it is a private home address.
 *
 * ### The QR code
 *
 * Drawn at BUILD time by a prerendered endpoint and referenced as a plain
 * image — see `lib/businessCardQr.ts` for why it is not generated here. The
 * short version: encoding it in this frontmatter shipped `qrcode` into the
 * server bundle and answered both card pages with a 500 on the host.
 */
import Arrow from "~/components/ui/Arrow.astro";
import Layout from "~/layouts/Layout.astro";
import { themeToggleMarkup } from "@tracht-digital-solutions/tds-shared/dom";
import { asGraph, personSchema } from "~/lib/jsonld";
import { tFor, type Lang } from "~/lib/i18n";
import { legalCopy } from "~/lib/legal";
import { siteConfig } from "~/lib/seo";
import {
  BUSINESS_CARD_QR_PATH,
  businessCardHref,
  businessCardLinks,
} from "~/lib/businessCard";
import { LOGO, PORTRAIT_SIZE, logoSrc, logoSrcset, portraitSrc, portraitSrcset } from "~/lib/imageVariants";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Both wrappers are five-line files around this component, so the meta
// descriptions live here. The NAME is load-bearing: `seo.test.ts` reads this
// literal off disk to hold every indexable page inside one length budget.
const pageDescriptions = {
  de: "Die digitale Visitenkarte von Julian Tracht: anrufen, schreiben, Kontakt speichern oder den QR-Code scannen — und ein Beispiel dafür, was ich für Kunden baue.",
  en: "The digital business card of Julian Tracht: call, write, save the contact or scan the QR code — and an example of what I build for customers.",
};

const { founder, name, address } = siteConfig;
const t = tFor(lang);
const links = businessCardLinks(lang);
const groups = [
  { id: "contact", items: links.filter((link) => link.group === "contact") },
  { id: "more", items: links.filter((link) => link.group === "more") },
];

const ui =
  lang === "de"
    ? {
        eyebrow: "Digitale Visitenkarte",
        bio: "Digitale Lösungen für Unternehmen: Kundenportale, digitale Abläufe, individuelle Software und Websites. Ein fester Ansprechpartner von der ersten Idee bis zur Wartung.",
        save: "Kontakt speichern",
        saveMeta: "Telefon, Mobil, E-Mail und Profile als vCard",
        groupContact: "Direkt erreichbar",
        groupMore: "Mehr ansehen",
        qrTitle: "Zum Weitergeben",
        qrText:
          "Diese Seite als QR-Code — abfotografieren lassen, statt Kontaktdaten zu diktieren.",
        qrAlt: "QR-Code, der auf diese Visitenkarte führt",
        share: "Link teilen",
        shareDone: "Link kopiert",
        newTab: "öffnet in neuem Tab",
        controls: "Sprache und Darstellung",
        langOther: "English",
        toDark: "Auf Dunkel umschalten",
        toLight: "Auf Hell umschalten",
        pitchTitle: "So eine Karte fürs eigene Unternehmen?",
        pitchText:
          "Diese Karte gehört zum Webauftritt: eine Adresse, die auf jedem Handy funktioniert und sich jederzeit ändern lässt.",
        pitchCta: "Zum Webauftritt",
      }
    : {
        eyebrow: "Digital business card",
        bio: "Digital solutions for businesses: customer portals, digital workflows, custom software and websites. One steady point of contact from the first idea to maintenance.",
        save: "Save contact",
        saveMeta: "Phone, mobile, email and profiles as a vCard",
        groupContact: "Reach me directly",
        groupMore: "See more",
        qrTitle: "To pass on",
        qrText:
          "This page as a QR code — let people photograph it instead of dictating contact details.",
        qrAlt: "QR code leading to this business card",
        share: "Share link",
        shareDone: "Link copied",
        newTab: "opens in a new tab",
        controls: "Language and appearance",
        langOther: "Deutsch",
        toDark: "Switch to dark mode",
        toLight: "Switch to light mode",
        pitchTitle: "A card like this for the business?",
        pitchText:
          "This card is part of a web presence: one address that works on every phone and can be changed at any time.",
        pitchCta: "To web presence",
      };

const groupHeadings: Record<string, string> = {
  contact: ui.groupContact,
  more: ui.groupMore,
};

const webPresencePath =
  lang === "de" ? "/leistungen/webauftritt" : "/en/services/web-presence";
const agbPath = lang === "de" ? "/legal/agb" : "/en/legal/agb";
const otherLang: Lang = lang === "de" ? "en" : "de";
const cardUrl = `${siteConfig.url}${businessCardHref(lang)}`;

/**
 * The row icons, as bare path data.
 *
 * One `<svg>` element in the markup carries the shared attributes and only the
 * geometry varies, so the stroke width, the cap style and the 24-unit box
 * cannot drift row to row. Keyed by `BusinessCardLink.id`, which is exactly
 * why that id may never carry copy. Line icons in the same voice as the ones
 * already drawn by hand elsewhere on this site.
 */
const ICONS: Record<string, string> = {
  save: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" />',
  phone:
    '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />',
  mobile: '<rect x="6" y="2" width="12" height="20" rx="2.5" /><path d="M11 18h2" />',
  whatsapp:
    '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />',
  website:
    '<circle cx="12" cy="12" r="10" /><line x1="2" y1="12" x2="22" y2="12" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />',
  services:
    '<rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />',
  shop:
    '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 0 1-8 0" />',
  projects:
    '<rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" />',
  freelance:
    '<circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />',
  journal:
    '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /><line x1="9" y1="7" x2="16" y2="7" /><line x1="9" y1="11" x2="16" y2="11" />',
  linkedin:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" />',
  github:
    '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />',
  share:
    '<circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />',
};

/**
 * The schema.org type for exactly this: a page that IS a person's public
 * profile, rather than a page that happens to mention one. `mainEntity` points
 * at the same `#person` node the rest of the site publishes, so the card joins
 * the existing entity instead of declaring a second Julian Tracht.
 */
const profileSchema = {
  "@type": "ProfilePage",
  "@id": `${cardUrl}#profile`,
  url: cardUrl,
  name: `${founder.name} — ${ui.eyebrow}`,
  inLanguage: lang === "de" ? "de-DE" : "en-GB",
  mainEntity: { "@id": `${siteConfig.url}/#person` },
};
---

<Layout
  title={`${founder.name} — ${ui.eyebrow} | ${name}`}
  description={pageDescriptions[lang]}
  lang={lang}
  alternates={{ de: businessCardHref("de"), en: businessCardHref("en") }}
  jsonLd={asGraph(personSchema(), profileSchema)}
  ogType="profile"
  bare
>
  {/* `.tds-wash` paints the shared brand fields at the EDGES of this element,
      behind the flow — the same warm ground every section of the site sits on.
      It goes here and not on `body`, per the library's own rule: on the body
      the fields stretch across the whole document and flatten into one tint. */}
  <main id="main" class="card tds-wash">
    <div class="card__inner">
      {/* The two controls the site chrome would otherwise have carried. They
          come FIRST in the DOM rather than last because a keyboard user
          reaching a page with no navigation should meet them before a stack of
          links, and the language switch in particular is what a visitor
          served the wrong locale is looking for. A plain link, not the
          header's dropdown island: both card routes are known here, so the
          switch needs no JavaScript at all. */}
      <nav class="card__top" aria-label={ui.controls}>
        <a
          class="card__lang"
          href={businessCardHref(otherLang)}
          hreflang={otherLang}
          lang={otherLang}
        >
          {ui.langOther}
        </a>
        <Fragment set:html={themeToggleMarkup({ labelToDark: ui.toDark, labelToLight: ui.toLight })} />
      </nav>

      <div class="card__layout">
        <div class="card__aside">
          {/* The card as an object (2026-11-04): a navy plate in the 85 × 55 mm
              proportion of a printed business card, so the page reads as the
              card itself rather than as a profile. It carries the identity;
              everything a thumb presses is below it. */}
          <header class="card__plate">
            <div class="card__plate-top">
              <span class="card__brand">
                <img
                  class="card__brand-mark"
                  src={logoSrc("mark", LOGO.mark.widths[1])}
                  srcset={logoSrcset("mark")}
                  sizes="2.5rem"
                  width={LOGO.mark.width}
                  height={LOGO.mark.height}
                  alt={lang === "en" ? "Tracht Digital Solutions logo mark" : "Bildmarke von Tracht Digital Solutions"}
                  decoding="async"
                />
                <span class="card__brand-name">{name}</span>
              </span>
              <p class="card__eyebrow">{ui.eyebrow}</p>
            </div>
            <div class="card__plate-body">
              <div class="card__plate-id">
                <h1 class="card__name">{founder.name}</h1>
                <p class="card__role">{founder.jobTitles[lang]}</p>
              </div>
              {/* The same pre-sized copies `About.astro` uses
                  (`lib/imageVariants.ts`). It is this page's largest image,
                  hence eager and high priority. NOT `assets/portrait-vcard.jpg`
                  — that one is the square crop the vCard embeds. */}
              <img
                src={portraitSrc(360)}
                srcset={portraitSrcset()}
                sizes="6.5rem"
                width={PORTRAIT_SIZE.width}
                height={PORTRAIT_SIZE.height}
                alt={founder.name}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="card__portrait"
              />
            </div>
            <div class="card__plate-foot">
              <span aria-hidden="true" class="tds-brandbar tds-brandbar--sm card__bar"></span>
              {/* Postal code + locality only, exactly as the site footer
                  publishes them: the local-search signal without the street. */}
              <span class="card__place">{address.postalCode} {address.addressLocality}</span>
            </div>
          </header>

          <p class="card__bio">{ui.bio}</p>

          {/* No `download` attribute, deliberately — the same call the contact
              aside makes: with the `text/vcard` MIME (public/.htaccess in
              production) a phone opens its "add contact" flow while a desktop
              browser saves the file. `download` would force the save on both. */}
          <a class="card__save" href="/kontakt.vcf">
            <svg
              class="card__save-icon"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={ICONS.save}
            />
            <span>
              {ui.save}
              <span class="card__save-meta">{ui.saveMeta}</span>
            </span>
          </a>

        </div>

        <div class="card__main">
          {groups.map((group) => (
            <section class={`card__group card__group--${group.id}`} aria-labelledby={`card-group-${group.id}`}>
              <h2 id={`card-group-${group.id}`} class="eyebrow card__group-title">
                {groupHeadings[group.id]}
              </h2>
              {/* A real list, so a screen reader announces the count before
                  reading it out — on a page that is nothing BUT links, that
                  count is the page's structure. No `data-reveal`: nothing a
                  visitor reads may wait on a scroll to appear. */}
              <ul class="card__list">
                {group.items.map((link) => (
                  <li>
                    <a
                      class="card__row"
                      href={link.href}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noopener noreferrer" : undefined}
                    >
                      <span class="card__row-icon" aria-hidden="true">
                        <svg
                          width="20"
                          height="20"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          set:html={ICONS[link.id]}
                        />
                      </span>
                      <span class="card__row-text">
                        <span class="card__row-label">
                          {link.label}
                          {link.external && <span class="sr-only"> ({ui.newTab})</span>}
                        </span>
                        <span class="card__row-meta">{link.meta}</span>
                      </span>
                      {/* Decoration: the row's accessible name is already the
                          label plus, on an external row, the spoken hint. */}
                      <span class="card__row-mark" aria-hidden="true">
                        <Arrow dir={link.external ? "up-right" : "right"} />
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}

          {/* The card is a work sample as much as it is a contact detail — this
              says so once, in words, and sends the reader to the service it
              belongs to. */}
          <aside class="card__pitch">
            <h2 class="card__pitch-title">{ui.pitchTitle}</h2>
            <p class="card__pitch-text">{ui.pitchText}</p>
            <a href={webPresencePath} class="card__pitch-cta">
              {ui.pitchCta}
              <span aria-hidden="true"><Arrow dir="right" /></span>
            </a>
          </aside>
        </div>

        {/* After the rows in the DOM: someone holding a phone wants to call
            first and pass the card on second. On the wide layout it moves
            under the card. */}
        <section class="card__qr" aria-labelledby="card-qr-title">
          {/* A plain <img>, not an inlined SVG: the file is prerendered, so
              inlining it would mean reading it back at request time — which
              is the runtime dependency this whole route exists to avoid. It
              is a picture with a meaning, so it carries a real alt. */}
          <img
            class="card__qr-code"
            src={BUSINESS_CARD_QR_PATH[lang]}
            alt={ui.qrAlt}
            width="120"
            height="120"
            decoding="async"
          />
          <div class="card__qr-body">
            <h2 id="card-qr-title" class="card__qr-title">{ui.qrTitle}</h2>
            <p class="card__qr-text">{ui.qrText}</p>
            {/* Hidden until the script confirms the browser can actually
                share or copy. A button that silently does nothing is worse
                than no button; the QR code beside it already is the offline
                way to pass the page on. */}
            <button
              type="button"
              class="card__share"
              data-card-share
              data-label-done={ui.shareDone}
              hidden
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={ICONS.share}
              />
              <span data-card-share-label>{ui.share}</span>
            </button>
          </div>
        </section>
      </div>

      {/* The legal strip. Not the site footer and not a fork of it: three
          links and a copyright line, which is the minimum a public German
          page owes its visitor once the real footer is gone. The labels come
          through `tFor()` / `legalCopy` like everywhere else, so they cannot
          drift from the footer's wording. */}
      <footer class="card__legal">
        <p class="card__legal-copy">{t.footer.copyright}</p>
        <ul class="card__legal-links">
          <li><a href="/legal/impressum">{t.footer.impressum}</a></li>
          <li><a href="/legal/datenschutz">{t.footer.datenschutz}</a></li>
          <li><a href={agbPath}>{legalCopy[lang].agbShort}</a></li>
        </ul>
      </footer>
    </div>
  </main>
</Layout>

<script>
  /**
   * The share button.
   *
   * Progressive enhancement in the strict sense the rest of this site uses:
   * the button ships `hidden` and only this script can unhide it, so a browser
   * with neither the Web Share API nor an async clipboard never renders a
   * control that would do nothing. Nothing is opened on failure — a denied
   * clipboard permission and a dismissed share sheet are both "the visitor
   * changed their mind", and a dialog on a contact card is worse than silence.
   */
  const button = document.querySelector<HTMLButtonElement>("[data-card-share]");

  if (button) {
    const label = button.querySelector<HTMLElement>("[data-card-share-label]");
    const idleText = label?.textContent ?? "";
    const doneText = button.dataset.labelDone ?? idleText;
    const canShare = typeof navigator.share === "function";
    const canCopy = typeof navigator.clipboard?.writeText === "function";

    if (canShare || canCopy) {
      button.hidden = false;

      let restore: ReturnType<typeof setTimeout> | undefined;
      button.addEventListener("click", async () => {
        const url = window.location.href;
        try {
          if (canShare) {
            await navigator.share({ title: document.title, url });
            return;
          }
          await navigator.clipboard.writeText(url);
          if (label) {
            label.textContent = doneText;
            clearTimeout(restore);
            restore = setTimeout(() => {
              label.textContent = idleText;
            }, 2400);
          }
        } catch {
          // Cancelled sheet or refused clipboard — nothing to report.
        }
      });
    }
  }
</script>

<style>
  /* The page IS the card. One column on a phone; from 60rem the card, the
     save action and the QR code stand left (and stay in view) and the rows
     run beside them (2026-11-04). `100svh` (not `100vh`) because this page is
     opened on a phone more than anywhere else. */
  .card {
    min-height: 100svh;
    background: var(--color-paper);
    padding: 1.25rem 1rem 3rem;
  }
  .card__inner {
    width: 100%;
    max-width: 32rem;
    margin: 0 auto;
  }
  .card__layout {
    display: grid;
    gap: 2.5rem;
    margin-top: 0.75rem;
  }
  .card__aside,
  .card__main {
    min-width: 0;
  }
  @media (min-width: 60rem) {
    .card__layout > .card__qr {
      margin-top: 1.5rem;
    }
    .card {
      padding: 2.5rem 2rem 4rem;
    }
    .card__inner {
      max-width: 64rem;
    }
    .card__layout {
      grid-template-columns: minmax(0, 27rem) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: 3.5rem;
      row-gap: 0;
      align-items: start;
    }
    .card__aside {
      grid-column: 1;
      grid-row: 1;
    }
    .card__main {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .card__layout > .card__qr {
      grid-column: 1;
      grid-row: 2;
    }
  }

  .card__top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    min-height: 2.75rem;
  }
  .card__lang {
    display: inline-flex;
    align-items: center;
    /* 44px touch target, the floor the shared mobile rules set for every
       other interactive chip on this site. */
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border-radius: var(--tds-radius-pill);
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
