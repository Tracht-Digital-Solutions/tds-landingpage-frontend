---
/**
 * The digital business card — one page, both languages.
 *
 * ### Why a page and not just the .vcf
 *
 * `/kontakt.vcf` already existed and is still the thing a phone saves; this
 * page is what a person can be SHOWN. That difference is the whole point of
 * the route: a downloadable file cannot be put on a reference shelf, cannot be
 * scanned off a screen, and cannot demonstrate that this is something built
 * for customers too. The page is linked from the contact aside, from the
 * showcase on the home page and from the Webauftritt service page for exactly
 * that reason.
 *
 * ### One source for the data
 *
 * Every value comes from `siteConfig` — the same object the vCard endpoint and
 * the LocalBusiness JSON-LD read. Nothing here is typed out a second time, so
 * the card cannot drift from the Impressum. The postal address is deliberately
 * ABSENT, matching `kontakt.vcf.ts`: it is a private home address.
 *
 * ### The QR code
 *
 * Rendered at BUILD time into inline SVG. `qrcode` never reaches the browser,
 * there is no canvas, no client island and no layout shift — the markup ships
 * with the code already drawn. It encodes this page's own URL rather than the
 * .vcf: a scan should land somewhere a human can read, with the save action
 * one tap away, and a phone camera that downloads a file unannounced is a
 * worse first impression than one that opens a page.
 */
import QRCode from "qrcode";
import { Image } from "astro:assets";
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import { personSchema } from "~/lib/jsonld";
import { localizePath, type Lang } from "~/lib/i18n";
import { siteConfig } from "~/lib/seo";
import { businessCardHref } from "~/lib/businessCard";
import portrait from "~/assets/portrait.webp";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Both wrappers are five-line files around this component, so the meta
// descriptions live here. The NAME is load-bearing: `seo.test.ts` reads this
// literal off disk to hold every indexable page inside one length budget.
const pageDescriptions = {
  de: "Die digitale Visitenkarte von Julian Tracht: anrufen, schreiben, Kontakt speichern oder den QR-Code scannen — und ein Beispiel dafür, was ich für Kunden baue.",
  en: "The digital business card of Julian Tracht: call, write, save the contact or scan the QR code — and an example of what I build for customers.",
};

const { founder, email, telephone, socials, name } = siteConfig;
// → E.164 for `tel:` and `wa.me`, exactly as the contact aside derives it.
const phoneHref = telephone.replace(/\s/g, "");
const whatsappHref = `https://wa.me/${phoneHref.replace(/^\+/, "")}`;

const cardPath = businessCardHref(lang);
const cardUrl = new URL(cardPath, Astro.site?.origin ?? siteConfig.url).toString();

/**
 * `margin: 0` because the card draws its own padding, and `errorCorrectionLevel:
 * "M"` because the payload is a short URL — "H" would only make the modules
 * smaller for no gain at this length. Colours are literals, not CSS variables:
 * this SVG is generated as a string at build time, where no custom property
 * has resolved yet, so the theme handling happens in CSS below instead.
 */
const qrSvg = await QRCode.toString(cardUrl, {
  type: "svg",
  margin: 0,
  errorCorrectionLevel: "M",
  color: { dark: "#000000", light: "#0000" },
});

const ui =
  lang === "de"
    ? {
        eyebrow: "Digitale Visitenkarte",
        call: "Anrufen",
        mail: "E-Mail schreiben",
        whatsapp: "WhatsApp",
        save: "Kontakt speichern",
        qrTitle: "Zum Weitergeben",
        qrText:
          "Diese Seite als QR-Code — abfotografieren lassen, statt Kontaktdaten zu diktieren.",
        qrAlt: "QR-Code, der auf diese Visitenkarte führt",
        back: "Zur Startseite",
        newTab: "öffnet in neuem Tab",
        pitchTitle: "So eine Karte für Ihr Unternehmen?",
        pitchText:
          "Diese Seite ist kein Sonderfall, sondern Teil des Webauftritts: eine Adresse, die Sie weitergeben, die auf jedem Telefon funktioniert und die sich ändern lässt, ohne dass gedruckte Karten wertlos werden.",
        pitchCta: "Zum Webauftritt",
      }
    : {
        eyebrow: "Digital business card",
        call: "Call",
        mail: "Write an email",
        whatsapp: "WhatsApp",
        save: "Save contact",
        qrTitle: "To pass on",
        qrText:
          "This page as a QR code — let people photograph it instead of dictating contact details.",
        qrAlt: "QR code leading to this business card",
        back: "To the homepage",
        newTab: "opens in a new tab",
        pitchTitle: "A card like this for your business?",
        pitchText:
          "This page is not a special case but part of a web presence: one address you hand out, working on every phone, and changeable without making printed cards worthless.",
        pitchCta: "To web presence",
      };

const webPresencePath =
  lang === "de" ? "/leistungen/webauftritt" : "/en/services/web-presence";
---

<Layout
  title={`${founder.name} — ${ui.eyebrow} | ${name}`}
  description={pageDescriptions[lang]}
  lang={lang}
  alternates={{ de: businessCardHref("de"), en: businessCardHref("en") }}
  jsonLd={personSchema()}
>
  <Header lang={lang} />

  <main id="main" class="min-h-screen bg-[var(--color-paper)]">
    <div class="max-w-3xl mx-auto px-6 md:px-8 py-24 md:py-32">
      <a
        href={localizePath("/", lang)}
        class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors mb-12 inline-block"
      >
        ← {ui.back}
      </a>

      <article class="vcard">
        <p class="eyebrow text-[var(--color-accent)] mb-6">{ui.eyebrow}</p>

        <div class="vcard__head">
          {/* The same source `About.astro` uses, through the same pipeline.
              NOT `assets/portrait-vcard.jpg` — that one is a 400×400 crop the
              vCard endpoint reads at build time and embeds as base64; it has
              no business being fetched over HTTP. */}
          <Image
            src={portrait}
            alt={founder.name}
            widths={[160, 260]}
            sizes="(min-width: 768px) 6.5rem, 5rem"
            loading="eager"
            class="vcard__portrait"
          />
          <div>
            <h1 class="vcard__name">{founder.name}</h1>
            <p class="vcard__role">{founder.jobTitle}</p>
            <p class="vcard__org">{name}</p>
          </div>
        </div>

        <div class="vcard__actions">
          <a class="vcard__action" href={`tel:${phoneHref}`}>
            <span class="vcard__action-label">{ui.call}</span>
            <span class="vcard__action-value">{telephone}</span>
          </a>
          <a class="vcard__action" href={`mailto:${email}`}>
            <span class="vcard__action-label">{ui.mail}</span>
            <span class="vcard__action-value">{email}</span>
          </a>
          <a
            class="vcard__action"
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="vcard__action-label">
              {ui.whatsapp}
              <span class="sr-only"> ({ui.newTab})</span>
            </span>
            <span class="vcard__action-value">{telephone}</span>
          </a>
          {socials.linkedin && (
            <a
              class="vcard__action"
              href={socials.linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="vcard__action-label">
                LinkedIn
                <span class="sr-only"> ({ui.newTab})</span>
              </span>
              <span class="vcard__action-value">/in/julian-tracht</span>
            </a>
          )}
        </div>

        {/* No `download` attribute, deliberately — the same call the contact
            aside makes: with the `text/vcard` MIME (public/.htaccess in
            production) a phone opens its "add contact" flow while a desktop
            browser saves the file. `download` would force the save on both. */}
        <a class="vcard__save" href="/kontakt.vcf">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <line x1="19" y1="8" x2="19" y2="14" />
            <line x1="22" y1="11" x2="16" y2="11" />
          </svg>
          {ui.save}
        </a>

        <div class="vcard__qr">
          <div class="vcard__qr-code" role="img" aria-label={ui.qrAlt} set:html={qrSvg} />
          <div>
            <p class="vcard__qr-title">{ui.qrTitle}</p>
            <p class="vcard__qr-text">{ui.qrText}</p>
          </div>
        </div>
      </article>

      {/* The card is a work sample as much as it is a contact detail — this
          says so once, in words, and sends the reader to the service it
          belongs to. Without it the page answers "who is this" and never
          "can I have one". */}
      <aside class="vcard-pitch">
        <h2 class="vcard-pitch__title">{ui.pitchTitle}</h2>
        <p class="vcard-pitch__text">{ui.pitchText}</p>
        <a href={webPresencePath} class="link-underline text-[var(--color-accent)]">
          {ui.pitchCta}
          <span aria-hidden="true"> →</span>
        </a>
      </aside>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .vcard {
    background: var(--color-soft);
    border-radius: 6px;
    padding: 2rem 1.75rem;
  }

  .vcard__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }
  .vcard__portrait {
    flex: none;
    width: 5rem;
    height: 5rem;
    border-radius: var(--tds-radius-pill);
    object-fit: cover;
  }
  .vcard__name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-black);
    margin: 0;
  }
  .vcard__role {
    margin: 0.5rem 0 0;
    color: var(--color-accent);
  }
  .vcard__org {
    margin: 0.15rem 0 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  /* `auto-fit` with a floor, not a fixed column count: the LinkedIn tile is
     conditional, so the row has either three or four cards and a hard
     `grid-cols-2` would strand one of them. */
  .vcard__actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .vcard__action {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.875rem 1rem;
    border-radius: 6px;
    background: var(--color-paper);
    text-decoration: none;
    transition:
      background-color 200ms var(--tds-ease-out),
      transform 200ms var(--tds-ease-out);
  }
  .vcard__action:hover {
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-paper));
    transform: translateY(-2px);
  }
  .vcard__action-label {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .vcard__action-value {
    color: var(--color-black);
    /* A phone number and an email address both have to survive a 320px
       column without pushing the card wider than the page. */
    overflow-wrap: anywhere;
  }

  .vcard__save {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding: 0.85rem 1.5rem;
    border-radius: var(--tds-radius-pill);
    background: var(--color-black);
    color: var(--color-paper);
    text-decoration: none;
    transition:
      transform 200ms var(--tds-ease-out),
      opacity 200ms var(--tds-ease-out);
  }
  .vcard__save:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  .vcard__qr {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-black) 10%, transparent);
  }
  /* The generated SVG paints pure black on a transparent ground, so in dark
     mode it would be a black square on a dark card. `currentColor` cannot
     reach it — the fill is written into the markup — so the whole code is
     inverted instead, which is safe precisely BECAUSE it is two-tone. */
  .vcard__qr-code {
    flex: none;
    width: 7.5rem;
    height: 7.5rem;
    padding: 0.625rem;
    border-radius: 6px;
    background: #ffffff;
  }
  .vcard__qr-code :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .vcard__qr-title {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-black);
  }
  .vcard__qr-text {
    margin: 0;
    max-width: 26rem;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .vcard-pitch {
    margin-top: 3rem;
  }
  .vcard-pitch__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--color-black);
    margin: 0 0 0.75rem;
  }
  .vcard-pitch__text {
    margin: 0 0 1rem;
    max-width: 40rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  @media (min-width: 768px) {
    .vcard {
      padding: 2.5rem;
    }
    .vcard__portrait {
      width: 6.5rem;
      height: 6.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vcard__action:hover,
    .vcard__save:hover {
      transform: none;
    }
  }
</style>
