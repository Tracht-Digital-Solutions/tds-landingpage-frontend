---
/**
 * A service's detail page, composed from the shared detail bands in
 * `components/detail/` — the same bands the platform pages use, so a service
 * page and a platform page cannot drift apart in geometry.
 */
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import WebsiteDemos from "~/components/sections/WebsiteDemos.astro";
import BusinessCardTile from "~/components/ui/BusinessCardTile.astro";
import DetailHero from "~/components/detail/DetailHero.astro";
import DetailIntro from "~/components/detail/DetailIntro.astro";
import DetailLists from "~/components/detail/DetailLists.astro";
import DetailOutcomes from "~/components/detail/DetailOutcomes.astro";
import DetailProcess from "~/components/detail/DetailProcess.astro";
import DetailReferences from "~/components/detail/DetailReferences.astro";
import DetailCta from "~/components/detail/DetailCta.astro";
import { breadcrumbSchema } from "~/lib/jsonld";
import { localizePath, type Lang } from "~/lib/i18n";
import { siteConfig } from "~/lib/seo";
import { getPricingContent, getServiceRate } from "~/lib/pricing";
import { businessCardCopy } from "~/lib/businessCard";
import {
  serviceHref,
  type ServiceContent,
  type ServiceDefinition,
} from "~/lib/services";

interface Props {
  service: ServiceDefinition;
  content: ServiceContent;
  lang: Lang;
}

const { service, content, lang } = Astro.props;
const path = serviceHref(service, lang);
const canonical = `${siteConfig.url}${path}`;
const homeHref = localizePath("/", lang);
const servicesHref = `${homeHref}#services`;
const contactHref = `${homeHref}#contact`;
const alternatePaths = {
  de: serviceHref(service, "de"),
  en: serviceHref(service, "en"),
};
const pricing = await getPricingContent(lang);
const serviceRate = getServiceRate(pricing, service.id);
const breadcrumbLabel = lang === "de" ? "Brotkrümelnavigation" : "Breadcrumb";

// Every service carries a rate now — Complete IT was the one that did not,
// and `getServiceRate` is total since it went. No conditional left to write.
const offer = {
      "@type": "Offer",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: serviceRate,
        priceCurrency: "EUR",
        unitCode: "HUR",
        referenceQuantity: {
          "@type": "QuantitativeValue",
          value: 1,
          unitCode: "HUR",
        },
        valueAddedTaxIncluded: false,
      },
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${canonical}#service`,
  url: canonical,
  name: content.title,
  description: content.summary,
  serviceType: content.title,
  provider: { "@id": `${siteConfig.url}/#organization` },
  areaServed: siteConfig.areaServed.map((name) => ({
    "@type": "Place",
    name,
  })),
  inLanguage: lang === "de" ? "de-DE" : "en-GB",
  serviceOutput: content.outcomes,
  offers: offer,
};

const jsonLd = [
  serviceSchema,
  breadcrumbSchema([
    { name: "Home", url: `${siteConfig.url}${homeHref}` },
    { name: content.title, url: canonical },
  ]),
];
---

<Layout
  title={`${content.title} — Tracht Digital Solutions`}
  description={content.summary}
  lang={lang}
  canonical={canonical}
  alternates={alternatePaths}
  jsonLd={jsonLd}
>
  <Header />

  <main id="main" class="bg-[var(--color-paper)]">
    <DetailHero
      backHref={servicesHref}
      backLabel={content.label}
      navLabel={breadcrumbLabel}
      title={content.title}
      lead={content.summary}
      ctaHref={contactHref}
      ctaLabel={content.ctaButton}
      image={service.image}
    />

    <DetailIntro text={content.intro} />

    <DetailLists
      situationsTitle={content.situationsTitle}
      situations={content.situations}
      responsibilitiesTitle={content.responsibilitiesTitle}
      responsibilities={content.responsibilities}
    />

    <DetailOutcomes
      outcomesTitle={content.outcomesTitle}
      outcomes={content.outcomes}
      boundariesTitle={content.boundariesTitle}
      boundaries={content.boundaries}
    />

    <DetailProcess
      processTitle={content.processTitle}
      process={content.process}
      priceLabel={content.priceLabel}
      priceText={content.priceText}
    />

    {content.references.length > 0 && (
      <DetailReferences
        headline={content.referencesHeadline}
        label={content.referencesLabel}
        references={content.references}
        lang={lang}
      />
    )}

    {/* Demo websites belong to exactly one service. The home page shows them
        to everyone; here they sit with the service they are evidence for. The
        component renders nothing when no demo is available. */}
    {service.id === "web-presence" && <WebsiteDemos variant="service" />}

    {/* A digital business card IS web presence, and this is the page where a
        reader is already asking what that includes. A single tile rather than
        a section: the page has made its argument by here. */}
    {service.id === "web-presence" && (
      <section class="section-spacing" aria-labelledby="service-business-card-title">
        <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
          <h2 id="service-business-card-title" class="sr-only">
            {businessCardCopy[lang].title}
          </h2>
          <div class="business-card-slot">
            <BusinessCardTile />
          </div>
        </div>
      </section>
    )}

    <DetailCta
      title={content.ctaTitle}
      text={content.ctaText}
      buttonLabel={content.ctaButton}
      href={contactHref}
    />
  </main>

  <Footer />
</Layout>

<style>
  /* One tile, not a stretched banner: it stands under the demo grid, whose
     columns floor at 17rem, so it is capped near one column's width rather
     than running the full 7xl container. */
  .business-card-slot {
    max-width: 24rem;
  }
</style>
