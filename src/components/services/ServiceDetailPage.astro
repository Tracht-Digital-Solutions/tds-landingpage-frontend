---
/**
 * A service's detail page, composed from the shared detail bands in
 * `components/detail/` — the same bands the platform pages use, so a service
 * page and a platform page cannot drift apart in geometry.
 *
 * The `<title>` and the "Stand" date are code-owned (`seoTitle`, `updatedAt` in
 * `lib/services.ts`), everything the page says is the resolved CMS content. The
 * JSON-LD is one graph: the page (dated, authored, published), the service with
 * its real hourly rate, and the breadcrumb.
 */
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import WebsiteDemos from "~/components/sections/WebsiteDemos.astro";
import BusinessCardTile from "~/components/ui/BusinessCardTile.astro";
import ServiceCard from "~/components/ui/ServiceCard.astro";
import DetailHero from "~/components/detail/DetailHero.astro";
import DetailMeta from "~/components/detail/DetailMeta.astro";
import DetailIntro from "~/components/detail/DetailIntro.astro";
import DetailLists from "~/components/detail/DetailLists.astro";
import DetailOutcomes from "~/components/detail/DetailOutcomes.astro";
import DetailProcess from "~/components/detail/DetailProcess.astro";
import DetailReferences from "~/components/detail/DetailReferences.astro";
import DetailCta from "~/components/detail/DetailCta.astro";
import { asGraph, breadcrumbNode, serviceNode, webPageNode } from "~/lib/jsonld";
import { localizePath, type Lang } from "~/lib/i18n";
import { siteConfig } from "~/lib/seo";
import { getPricingContent, getServiceRate } from "~/lib/pricing";
import { businessCardCopy } from "~/lib/businessCard";
import { platformDefinitions, platformHref } from "~/lib/platforms";
import {
  serviceHref,
  type ServiceContent,
  type ServiceDefinition,
} from "~/lib/services";

interface Props {
  service: ServiceDefinition;
  content: ServiceContent;
  lang: Lang;
}

const { service, content, lang } = Astro.props;
const path = serviceHref(service, lang);
const canonical = `${siteConfig.url}${path}`;
const homeHref = localizePath("/", lang);
const servicesHref = `${homeHref}#services`;
const contactHref = `${homeHref}#contact`;
const alternatePaths = {
  de: serviceHref(service, "de"),
  en: serviceHref(service, "en"),
};
const pricing = await getPricingContent(lang);
const serviceRate = getServiceRate(pricing, service.id);
const ui =
  lang === "de"
    ? { breadcrumb: "Brotkrümelnavigation", home: "Startseite" }
    : { breadcrumb: "Breadcrumb", home: "Home" };

/**
 * The Webauftritt page is the hub of the shop system and CMS pages: one tile
 * per system, plus a sixth for everyone whose system is not among them — it
 * also keeps the 1px-seam mosaic free of an empty cell at two and three
 * columns. Code-owned chrome, like the tiles' own labels.
 */
const platformHub =
  lang === "de"
    ? {
        title: "Shopsysteme und CMS",
        intro:
          "Du nutzt schon ein System? Für diese gibt es eine eigene Seite – mit typischen Problemen, dem, was ich übernehme, und Antworten auf häufige Fragen.",
        otherTitle: "Anderes System?",
        otherProblem: "Du nutzt Jimdo, Wix, IONOS, Shopify oder eine eigene Lösung.",
        otherResult: "Ich schaue es mir an und sage dir ehrlich, ob ich helfen kann.",
        otherMore: "Kurz schreiben",
      }
    : {
        title: "Shop systems and CMS",
        intro:
          "Already running a system? Each of these has its own page – with typical problems, what I take care of and answers to common questions.",
        otherTitle: "Another system?",
        otherProblem: "You use Jimdo, Wix, IONOS, Shopify or something custom.",
        otherResult: "I take a look and tell you honestly whether I can help.",
        otherMore: "Send a short note",
      };

// Every service carries a rate — `getServiceRate` is total — so every service
// page states an `Offer`. The platform pages name no amount and carry none.
const breadcrumbId = `${canonical}#breadcrumb`;
const jsonLd = asGraph(
  webPageNode({
    url: canonical,
    name: service.seoTitle[lang],
    description: content.summary,
    lang,
    dateModified: service.updatedAt,
    breadcrumbId,
  }),
  serviceNode({
    url: canonical,
    name: content.title,
    description: content.summary,
    lang,
    serviceType: content.title,
    outputs: content.outcomes,
    rate: serviceRate,
  }),
  breadcrumbNode(breadcrumbId, [
    { name: ui.home, url: `${siteConfig.url}${homeHref}` },
    { name: content.title, url: canonical },
  ]),
);
---

<Layout
  title={service.seoTitle[lang]}
  description={content.summary}
  lang={lang}
  canonical={canonical}
  alternates={alternatePaths}
  ogImage={`/og/${lang}/${service.slug[lang]}.png`}
  jsonLd={jsonLd}
>
  <Header />

  <main id="main" class="bg-[var(--color-paper)]">
    <DetailHero
      backHref={servicesHref}
      backLabel={content.label}
      navLabel={ui.breadcrumb}
      title={content.title}
      lead={content.summary}
      ctaHref={contactHref}
      ctaLabel={content.ctaButton}
      image={service.image}
    >
      <DetailMeta lang={lang} updatedAt={service.updatedAt} />
    </DetailHero>

    <DetailIntro text={content.intro} />

    <DetailLists
      situationsTitle={content.situationsTitle}
      situations={content.situations}
      responsibilitiesTitle={content.responsibilitiesTitle}
      responsibilities={content.responsibilities}
    />

    <DetailOutcomes
      outcomesTitle={content.outcomesTitle}
      outcomes={content.outcomes}
      boundariesTitle={content.boundariesTitle}
      boundaries={content.boundaries}
    />

    <DetailProcess
      processTitle={content.processTitle}
      process={content.process}
      priceLabel={content.priceLabel}
      priceText={content.priceText}
    />

    {content.references.length > 0 && (
      <DetailReferences
        headline={content.referencesHeadline}
        label={content.referencesLabel}
        references={content.references}
        lang={lang}
      />
    )}

    {service.id === "web-presence" && (
      <section class="section-spacing tds-tone-sand" aria-labelledby="service-platforms-title">
        <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
          <h2
            id="service-platforms-title"
            class="display text-4xl md:text-5xl text-[var(--color-black)] mb-5"
          >
            {platformHub.title}
          </h2>
          <p class="text-[var(--color-muted)] max-w-2xl mb-12">{platformHub.intro}</p>
          <div class="-mx-6 md:mx-0 overflow-hidden rounded-none md:rounded-[6px] bg-[var(--color-line)] grid gap-px sm:grid-cols-2 lg:grid-cols-3">
            {platformDefinitions.map((platform) => (
              <ServiceCard
                href={platformHref(platform, lang)}
                title={platform.name}
                problem={platform.content[lang].situations[0] ?? ""}
                result={platform.content[lang].outcomes[0] ?? ""}
                keywords={platform.keywords[lang]}
                lang={lang}
              />
            ))}
            <ServiceCard
              href={contactHref}
              title={platformHub.otherTitle}
              problem={platformHub.otherProblem}
              result={platformHub.otherResult}
              keywords={[]}
              lang={lang}
              moreLabel={platformHub.otherMore}
            />
          </div>
        </div>
      </section>
    )}

    {/* Demo websites belong to exactly one service. The home page shows them
        to everyone; here they sit with the service they are evidence for. The
        component renders nothing when no demo is available. */}
    {service.id === "web-presence" && <WebsiteDemos variant="service" />}

    {/* A digital business card IS web presence, and this is the page where a
        reader is already asking what that includes. A single tile rather than
        a section: the page has made its argument by here. */}
    {service.id === "web-presence" && (
      <section class="section-spacing" aria-labelledby="service-business-card-title">
        <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
          <h2 id="service-business-card-title" class="sr-only">
            {businessCardCopy[lang].title}
          </h2>
          <div class="business-card-slot">
            <BusinessCardTile />
          </div>
        </div>
      </section>
    )}

    <DetailCta
      title={content.ctaTitle}
      text={content.ctaText}
      buttonLabel={content.ctaButton}
      href={contactHref}
    />
  </main>

  <Footer />
</Layout>

<style>
  /* One tile, not a stretched banner: it stands under the demo grid, whose
     columns floor at 17rem, so it is capped near one column's width rather
     than running the full 7xl container. */
  .business-card-slot {
    max-width: 24rem;
  }
</style>
