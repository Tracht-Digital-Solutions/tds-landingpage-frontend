---
/**
 * The home page, for both language trees.
 *
 * `pages/index.astro` and `pages/en/index.astro` are three-line wrappers, like
 * the business card routes, and everything a home page is lives here.
 *
 * ### The order (2026-09-15)
 *
 * Promise → offer → proof → how it works → examples → knowledge → the person →
 * cost → objections → action:
 *
 * Hero → Leistungen (Webauftritt first, the systems, the assistant's button) →
 * Kundenprojekte → Vorgehen → Beispielseiten → Journal → Wieso ich? → Preise
 * (with the assistant's second button) → FAQ → Kontakt.
 *
 * Each section answers the question a visitor has at that point. Paper and
 * sand alternate down the page (the showcase keeps sand on both sides, the FAQ
 * stays directly above the navy contact block); the one paper-on-paper seam is
 * "Wieso ich?" — photo and wash — above the prices.
 *
 * The service finder is no longer a section: it waits behind two buttons and
 * opens as a dialog (`ServiceAssistant.astro`). The positioning band, the price
 * drawer and the hero slider are gone for good.
 */
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import Hero from "~/components/sections/Hero.astro";
import About from "~/components/sections/About.astro";
import Services from "~/components/sections/Services.astro";
import CustomerCases from "~/components/sections/CustomerCases.astro";
import Process from "~/components/sections/Process.astro";
import Showcase from "~/components/sections/Showcase.astro";
import Journal from "~/components/sections/Journal.astro";
import Pricing from "~/components/sections/Pricing.astro";
import FAQ from "~/components/sections/FAQ.astro";
import Contact from "~/components/sections/Contact.astro";
import ServiceAssistant from "~/components/ServiceAssistant.astro";
import {
  asGraph,
  faqPageSchema,
  organizationSchema,
  personSchema,
  pricingSchema,
  speakableSchema,
  websiteSchema,
} from "~/lib/jsonld";
import { siteConfig } from "~/lib/seo";
import type { Lang } from "~/lib/i18n";
import { getFaqContent } from "~/lib/faq";
import { cmsFor } from "~/lib/cms";
import { getHomeContent } from "~/lib/homeContent";
import { tFor } from "~/lib/i18n";
import { getPricingContent, getServiceRate } from "~/lib/pricing";
import { resolveServiceContent, serviceDefinitions } from "~/lib/services";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const home = getHomeContent(lang);

// The hero is the brand slogan and two buttons. The slogan comes from the
// `footer` block — the same field the footer prints — so it has one source;
// the button labels stay in `home_hero`.
const hero = await cmsFor("home_hero", lang, home.hero);
const footer = await cmsFor("footer", lang, tFor(lang).footer);
const pricing = await getPricingContent(lang);
// Resolved here too so the FAQPage JSON-LD stays 1:1 with the (possibly
// admin-edited) answers FAQ.astro renders. cms.ts memoises the fetch.
const faq = await cmsFor("faq_v2", lang, getFaqContent(lang));

const pricedServices = await Promise.all(
  serviceDefinitions.map(async (definition) => ({
    definition,
    content: await resolveServiceContent(definition, lang),
  })),
);

// The home page carries the canonical entity graph — Organization, Person and
// WebSite live here; subpages reference them by @id. The four rates are an
// `OfferCatalog` on the page that shows them. No `HowTo`: Google retired those
// rich results, and the process is not a set of instructions.
const jsonLd = asGraph(
  organizationSchema(),
  personSchema(),
  websiteSchema(lang),
  pricingSchema(
    pricedServices.map(({ definition, content }) => ({
      name: content.title,
      description: content.summary,
      rate: getServiceRate(pricing, definition.id),
    })),
    // Fixed prices go in as their own offers, without an hourly unit. Empty
    // until real figures exist, and an empty list adds nothing to the graph.
    pricing.packages.map((pkg) => ({
      name: pkg.title,
      description: pkg.description,
      price: pkg.price,
    })),
  ),
  faqPageSchema(faq.items),
  {
    "@type": "WebPage",
    "@id": `${siteConfig.url}/#webpage-${lang}`,
    url: lang === "de" ? `${siteConfig.url}/` : `${siteConfig.url}/en/`,
    inLanguage: lang === "de" ? "de-DE" : "en-GB",
    isPartOf: { "@id": `${siteConfig.url}/#website` },
    publisher: { "@id": `${siteConfig.url}/#organization` },
    author: { "@id": `${siteConfig.url}/#person` },
    primaryImageOfPage: `${siteConfig.url}/og/default.png`,
    // The slogan and the FAQ — what a voice assistant should read if it
    // reads anything. (`#hero-sub` went with the hero's reduction to the
    // slogan.)
    speakable: speakableSchema(["#hero-heading", "#faq"]),
  },
);

// The search term first, then the brand. At most 60 characters; the local
// qualifier lives in the description, the schema's address and the footer.
//
// "übernehmen" leads since the page was sharpened to businesses that already
// HAVE a site — that is the search someone in this situation actually types.
// "Digitalisierung" stays in the same line because it is the Germany-wide
// keyword target named in the root CLAUDE.md, and `seo.test.ts` holds it in
// the description.
const titles = {
  de: "Website übernehmen & Digitalisierung — Tracht Digital",
  en: "Website takeover & digitalization — Tracht Digital",
};
---

<Layout
  title={titles[lang]}
  description={siteConfig.description[lang]}
  lang={lang}
  jsonLd={jsonLd}
>
  <Header />
  <main id="main">
    <Hero lang={lang} slogan={footer.slogan} cta1={hero.cta1} cta2={hero.cta2} />
    <Services />
    <CustomerCases />
    <Process />
    <Showcase />
    <Journal />
    <About />
    <Pricing />
    <FAQ />
    <Contact />
    <ServiceAssistant />
  </main>
  <Footer />
</Layout>
