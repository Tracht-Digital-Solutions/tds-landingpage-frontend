---
/**
 * The home page, for both language trees.
 *
 * `pages/index.astro` and `pages/en/index.astro` are three-line wrappers, like
 * the business card routes, and everything a home page is lives here.
 *
 * ### The order (2026-09-15)
 *
 * Promise → offer → proof → how it works → examples → knowledge → the person →
 * cost → objections → action:
 *
 * Hero → Leistungen (Webauftritt first, the systems, the assistant's button) →
 * Kundenprojekte → Vorgehen → Beispielseiten → Journal → Wieso ich? → Preise
 * (with the assistant's second button) → FAQ → Kontakt.
 *
 * Each section answers the question a visitor has at that point. Paper and
 * sand alternate down the page (the showcase keeps sand on both sides, the FAQ
 * stays directly above the navy contact block); the one paper-on-paper seam is
 * "Wieso ich?" — photo and wash — above the prices.
 *
 * The service finder is no longer a section: it waits behind two buttons and
 * opens as a dialog (`ServiceAssistant.astro`). The positioning band, the price
 * drawer and the hero slider are gone for good.
 */
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import Hero from "~/components/sections/Hero.astro";
import About from "~/components/sections/About.astro";
import Services from "~/components/sections/Services.astro";
import CustomerCases from "~/components/sections/CustomerCases.astro";
import Process from "~/components/sections/Process.astro";
import Showcase from "~/components/sections/Showcase.astro";
import Journal from "~/components/sections/Journal.astro";
import Pricing from "~/components/sections/Pricing.astro";
import FAQ from "~/components/sections/FAQ.astro";
import Contact from "~/components/sections/Contact.astro";
import ServiceAssistant from "~/components/ServiceAssistant.astro";
import {
  asGraph,
  faqPageSchema,
  organizationSchema,
  personSchema,
  pricingSchema,
  speakableSchema,
  websiteSchema,
} from "~/lib/jsonld";
import { siteConfig } from "~/lib/seo";
import type { Lang } from "~/lib/i18n";
import { getFaqContent, homeFaqItems } from "~/lib/faq";
import { cmsFor } from "~/lib/cms";
import { getHomeContent } from "~/lib/homeContent";
import { tFor } from "~/lib/i18n";
import { getPricingContent } from "~/lib/pricing";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const home = getHomeContent(lang);

// The hero is the brand slogan and two buttons. The slogan comes from the
// `footer` block — the same field the footer prints — so it has one source;
// the button labels stay in `home_hero`.
const hero = await cmsFor("home_hero", lang, home.hero);
const footer = await cmsFor("footer", lang, tFor(lang).footer);
const pricing = await getPricingContent(lang);
// Resolved here too so the FAQPage JSON-LD stays 1:1 with the (possibly
// admin-edited) answers FAQ.astro renders. cms.ts memoises the fetch.
const faq = await cmsFor("faq_v2", lang, getFaqContent(lang));
// The SIX this page prints, not all twelve. `FAQ.astro` slices the same way, and
// marking up an answer the page does not show is the one thing Google's FAQPage
// guidance rules out. The other six are marked up on `/fragen`, where they are
// visible.
const shownFaq = homeFaqItems(faq);

// The home page carries the canonical entity graph — Organization, Person and
// WebSite live here; subpages reference them by @id. The fixed-price packages
// are an `OfferCatalog` on the page that shows them. No `HowTo`: Google retired those
// rich results, and the process is not a set of instructions.
const jsonLd = asGraph(
  organizationSchema(),
  personSchema(),
  websiteSchema(lang),
  pricingSchema(
    pricing.packages.map((pkg) => ({
      name: pkg.title,
      description: pkg.description,
      price: pkg.price,
    })),
  ),
  faqPageSchema(shownFaq),
  {
    "@type": "WebPage",
    "@id": `${siteConfig.url}/#webpage-${lang}`,
    url: lang === "de" ? `${siteConfig.url}/` : `${siteConfig.url}/en/`,
    inLanguage: lang === "de" ? "de-DE" : "en-GB",
    isPartOf: { "@id": `${siteConfig.url}/#website` },
    publisher: { "@id": `${siteConfig.url}/#organization` },
    author: { "@id": `${siteConfig.url}/#person` },
    primaryImageOfPage: `${siteConfig.url}/og/default.png`,
    // The slogan and the FAQ — what a voice assistant should read if it
    // reads anything. (`#hero-sub` went with the hero's reduction to the
    // slogan.)
    speakable: speakableSchema(["#hero-heading", "#faq"]),
  },
);

// The search term first, then the brand. At most 60 characters; the local
// qualifier lives in the description, the schema's address and the footer.
//
// "übernehmen" leads since the page was sharpened to businesses that already
// HAVE a site — that is the search someone in this situation actually types.
// "Digitalisierung" stays in the same line because it is the Germany-wide
// keyword target named in the root CLAUDE.md, and `seo.test.ts` holds it in
// the description.
const titles = {
  de: "Website übernehmen & Digitalisierung — Tracht Digital",
  en: "Website takeover & digitalization — Tracht Digital",
};
---

<Layout
  title={titles[lang]}
  description={siteConfig.description[lang]}
  lang={lang}
  jsonLd={jsonLd}
>
  <Header />
  <main id="main">
    <Hero lang={lang} slogan={footer.slogan} cta1={hero.cta1} cta2={hero.cta2} />
    <Services />
    <CustomerCases />
    <Process />
    <Showcase />
    <Journal />
    <About />
    <Pricing />
    <FAQ />
    <Contact />
    <ServiceAssistant />
  </main>
  <Footer />
</Layout>

{/* The page's vertical rhythm, in one place.

    Each section renders `.section-spacing` (tds-shared: clamp(3.25rem, 6.5vw,
    6.5rem) on both edges), which made every boundary identical — one endless
    ladder, and the complaint that the gaps "passen noch nicht ganz"
    (2026-09-29). The three steps are `--lp-rhythm-*` in `global.css`; WHICH
    boundary gets which one is decided here, because a section cannot know what
    follows it. Read the pairs below as boundaries, not as sections.

    `is:global` because the sections are separate components and a scoped rule
    would never reach them. ID selectors, so nothing needs `!important` against
    the unlayered class from tds-shared — and NOT `:is(:global(…))`, which
    scopes the wrong half of the selector. */}
<style is:global>
  /* hero → services: WIDE, and the whole gap is on services. The hero is
     `min-h-svh` with no bottom padding of its own, so there is no upper half to
     add — this is the one boundary where one side carries all of it. */
  #services {
    padding-block-start: calc(var(--lp-rhythm-wide) * 2);
  }

  /* services → cases: TIGHT. The five services and the client projects that
     came out of them are one statement; the cases are the evidence for the
     list above, not a new subject. */
  #services {
    padding-block-end: var(--lp-rhythm-tight);
  }
  #cases {
    padding-block-start: var(--lp-rhythm-tight);
  }

  /* cases → process: NORMAL. */
  #cases {
    padding-block-end: var(--lp-rhythm-normal);
  }
  #process {
    padding-block-start: var(--lp-rhythm-normal);
  }

  /* process → showcase: WIDE. "How we work" ends the argument about working
     together; the shelf below it is a different kind of thing entirely. */
  #process {
    padding-block-end: var(--lp-rhythm-wide);
  }
  #showcase {
    padding-block-start: var(--lp-rhythm-wide);
  }

  /* showcase → blog → about: NORMAL throughout. `#blog` is the one section
     that never used `.section-spacing` (it had a hand-written `py-16 md:py-24`),
     which is why both of its edges are set here rather than overridden. */
  #showcase {
    padding-block-end: var(--lp-rhythm-normal);
  }
  #blog {
    padding-block: var(--lp-rhythm-normal);
  }
  #about {
    padding-block-start: var(--lp-rhythm-normal);
  }

  /* about → preise: WIDE. Between the person and the money is the biggest
     break on the page. */
  #about {
    padding-block-end: var(--lp-rhythm-wide);
  }
  #preise {
    padding-block-start: var(--lp-rhythm-wide);
  }

  /* preise → faq: NORMAL. The questions are mostly about the prices above. */
  #preise {
    padding-block-end: var(--lp-rhythm-normal);
  }
  #faq {
    padding-block-start: var(--lp-rhythm-normal);
  }

  /* faq → contact: WIDE. The navy block is the end of the page; it gets air
     in front of it so it arrives rather than continues. Its own lower edge
     keeps `.section-spacing` — below it is the footer, not another section. */
  #faq {
    padding-block-end: var(--lp-rhythm-wide);
  }
  #contact {
    padding-block-start: var(--lp-rhythm-wide);
  }

  /* ── The seams ───────────────────────────────────────────────────────────

     A hairline at each boundary, requested 2026-10-02. The page is ONE ground
     (`.page-ground` in `Layout.astro`), so until now the only thing marking a
     boundary was the gap itself — and the gap comes in three sizes, which
     reads as rhythm to whoever designed it and as "where does this end" to a
     reader scrolling past.

     `border-block-start` and not a `::before`: the rule has to sit at the
     MIDPOINT of the gap, and the midpoint is the border-box edge, because the
     pairs above split every gap between the two sections. A `::before` renders
     inside the padding and would hang under the gap instead of in it. A border
     also needs no `position: relative`, which several of these sections would
     have to grow — and they carry absolutely positioned `.tds-decor` children
     that are placed against the page, not against the section.

     Full bleed, like the 1px seams the service catalogue and the journal's
     colour bands already use. `--color-line` carries both themes.

     Two boundaries are deliberately NOT seamed:

     - hero → services. The hero is `min-h-svh` and ends with its own device;
       a line directly under it would read as part of the hero rather than as
       a separator, and the whole gap sits on the services side anyway.
     - faq → contact. The contact block is navy. Where the ground changes
       colour the colour change IS the seam, and a light hairline inside the
       navy would be a second, competing one. */
  #cases,
  #process,
  #showcase,
  #blog,
  #about,
  #preise,
  #faq {
    border-block-start: 1px solid var(--color-line);
  }
</style>
