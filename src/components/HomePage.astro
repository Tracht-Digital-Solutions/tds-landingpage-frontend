---
/**
 * The home page, for both language trees.
 *
 * `pages/index.astro` and `pages/en/index.astro` are three-line wrappers, like
 * the business card routes, and everything a home page is lives here.
 *
 * ### The order (2026-09-15)
 *
 * Promise → offer → proof and examples → how it works → knowledge → the person →
 * cost → objections → action:
 *
 * Hero → Leistungen (products, the assistant's button, the systems) →
 * Projekte und Referenzen → Zeitersparnis (calculator) → Vorgehen → Journal → Wieso ich? → FAQ → Kontakt.
 *
 * Every masthead is left-aligned from `md` (2026-11-03, asked for; an
 * alternating left/right order was tried the same day and dropped).
 * Prices live in the shop, not here.
 *
 * Each section answers the question a visitor has at that point. Paper and
 * sand alternate down the page (the FAQ stays directly above the navy contact
 * block); the one paper-on-paper seam is
 * "Wieso ich?" — photo and wash — above the prices.
 *
 * The service finder is no longer a section: it waits behind two buttons and
 * opens as a dialog (`ServiceAssistant.astro`). The positioning band, the price
 * drawer and the hero slider are gone for good.
 */
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import Hero from "~/components/sections/Hero.astro";
import About from "~/components/sections/About.astro";
import Services from "~/components/sections/Services.astro";
import ProjectReferences from "~/components/sections/ProjectReferences.astro";
import Process from "~/components/sections/Process.astro";
import TimeSavings from "~/components/sections/TimeSavings.astro";
import Journal from "~/components/sections/Journal.astro";
import FAQ from "~/components/sections/FAQ.astro";
import Contact from "~/components/sections/Contact.astro";
import ServiceAssistant from "~/components/ServiceAssistant.astro";
import SectionSeam from "~/components/ui/SectionSeam.astro";
import {
  asGraph,
  faqPageSchema,
  organizationSchema,
  personSchema,
  speakableSchema,
  websiteSchema,
} from "~/lib/jsonld";
import { siteConfig } from "~/lib/seo";
import type { Lang } from "~/lib/i18n";
import { getFaqContent, homeFaqItems } from "~/lib/faq";
import { cmsFor } from "~/lib/cms";
import { getHomeContent } from "~/lib/homeContent";
import { tFor } from "~/lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const home = getHomeContent(lang);

// The hero is the brand slogan and two buttons. The slogan comes from the
// `footer` block — the same field the footer prints — so it has one source;
// the button labels stay in `home_hero`.
const hero = await cmsFor("home_hero", lang, home.hero);
const footer = await cmsFor("footer", lang, tFor(lang).footer);
// Resolved here too so the FAQPage JSON-LD stays 1:1 with the (possibly
// admin-edited) answers FAQ.astro renders. cms.ts memoises the fetch.
const faq = await cmsFor("faq_v2", lang, getFaqContent(lang));
// The SIX this page prints, not all twelve. `FAQ.astro` slices the same way, and
// marking up an answer the page does not show is the one thing Google's FAQPage
// guidance rules out. The other six are marked up on `/fragen`, where they are
// visible.
const shownFaq = homeFaqItems(faq);

// The search term first, then the brand. At most 60 characters; the local
// qualifier lives in the description, the schema's address and the footer.
//
// Since 2026-10-12 the title follows the hero and the service order: the own
// portal first, digitalization second, websites third. "Digitalisierung" is
// the Germany-wide keyword target named in the root CLAUDE.md, and
// `seo.test.ts` holds the full phrase in the description.
const titles = {
  de: "Kundenportale, Digitalisierung, Websites — Tracht Digital",
  en: "Customer portals, digitalization, websites — Tracht Digital",
};

// The home page carries the canonical entity graph — Organization, Person and
// WebSite live here; subpages reference them by @id. No `HowTo`: Google retired those
// rich results, and the process is not a set of instructions.
const jsonLd = asGraph(
  organizationSchema(),
  personSchema(),
  websiteSchema(lang),
  faqPageSchema(shownFaq),
  {
    "@type": "WebPage",
    "@id": `${siteConfig.url}/#webpage-${lang}`,
    url: lang === "de" ? `${siteConfig.url}/` : `${siteConfig.url}/en/`,
    // The same title and description the head carries (2026-11-11); every
    // subpage's WebPage node already named itself.
    name: titles[lang],
    description: siteConfig.description[lang],
    inLanguage: lang === "de" ? "de-DE" : "en-GB",
    isPartOf: { "@id": `${siteConfig.url}/#website` },
    publisher: { "@id": `${siteConfig.url}/#organization` },
    author: { "@id": `${siteConfig.url}/#person` },
    primaryImageOfPage: `${siteConfig.url}/og/default.png`,
    // The slogan and the FAQ — what a voice assistant should read if it
    // reads anything. (`#hero-sub` went with the hero's reduction to the
    // slogan.)
    speakable: speakableSchema(["#hero-heading", "#hero-lead", "#faq"]),
  },
);
---

<Layout
  title={titles[lang]}
  description={siteConfig.description[lang]}
  lang={lang}
  jsonLd={jsonLd}
>
  <Header />
  <main id="main">
    <Hero
      lang={lang}
      title={home.hero.title}
      lead={home.hero.lead}
      slogan={footer.slogan}
      cta1={hero.cta1}
      cta2={hero.cta2}
    />
    <Services />
    <SectionSeam />
    <ProjectReferences />
    <SectionSeam />
    <TimeSavings />
    <SectionSeam />
    <Process />
    <SectionSeam />
    <Journal />
    <SectionSeam />
    <About />
    <SectionSeam />
    <FAQ />
    <Contact />
    <ServiceAssistant />
  </main>
  <Footer />
</Layout>

{/* The page's vertical rhythm, in one place.

    Each section renders `.section-spacing` (tds-shared: clamp(3.25rem, 6.5vw,
    6.5rem) on both edges), which made every boundary identical — one endless
    ladder, and the complaint that the gaps "passen noch nicht ganz"
    (2026-09-29). The three steps are `--lp-rhythm-*` in `global.css`; WHICH
    boundary gets which one is decided here, because a section cannot know what
    follows it. Read the pairs below as boundaries, not as sections.

    `is:global` because the sections are separate components and a scoped rule
    would never reach them. ID selectors, so nothing needs `!important` against
    the unlayered class from tds-shared — and NOT `:is(:global(…))`, which
    scopes the wrong half of the selector. */}
<style is:global>
  /* Every section's upper padding is at least `--lp-section-top` (global.css,
     2026-10-12): a section lands with its edge on the top of the screen, so
     its heading has to clear the floating header by itself. */

  /* hero → services: NORMAL. A jump lands a little above the section's edge, so
     the smaller padding still clears the floating header. */
  #services {
    padding-block-start: var(--lp-rhythm-normal);
    scroll-margin-top: calc(-1 * var(--lp-header-clearance) + max(0px, var(--lp-section-top) - var(--lp-rhythm-normal)));
  }

  /* services → cases: TIGHT. The five services and the client projects that
     came out of them are one statement; the cases are the evidence for the
     list above, not a new subject. */
  #services {
    padding-block-end: var(--lp-rhythm-tight);
  }
  #cases {
    padding-block-start: max(var(--lp-rhythm-tight), var(--lp-section-top));
  }

  /* cases → savings → process: NORMAL. */
  #cases {
    padding-block-end: var(--lp-rhythm-normal);
  }
  #savings {
    padding-block: max(var(--lp-rhythm-normal), var(--lp-section-top)) var(--lp-rhythm-normal);
  }
  #process {
    padding-block-start: max(var(--lp-rhythm-normal), var(--lp-section-top));
  }

  /* process → blog → about: NORMAL throughout. `#blog` is the one section
     that never used `.section-spacing` (it had a hand-written `py-16 md:py-24`),
     which is why both of its edges are set here rather than overridden. */
  #process {
    padding-block-end: var(--lp-rhythm-normal);
  }
  #blog {
    padding-block: max(var(--lp-rhythm-normal), var(--lp-section-top)) var(--lp-rhythm-normal);
  }
  #about {
    padding-block-start: max(var(--lp-rhythm-normal), var(--lp-section-top));
  }

  /* about → faq: WIDE. */
  #about {
    padding-block-end: var(--lp-rhythm-wide);
  }
  #faq {
    padding-block-start: max(var(--lp-rhythm-normal), var(--lp-section-top));
  }

  /* faq → contact: WIDE. The navy block is the end of the page; it gets air
     in front of it so it arrives rather than continues. Its own lower edge
     keeps `.section-spacing` — below it is the footer, not another section. */
  #faq {
    padding-block-end: var(--lp-rhythm-wide);
  }
  #contact {
    padding-block-start: max(var(--lp-rhythm-wide), var(--lp-section-top));
  }

  /* ── The seams ───────────────────────────────────────────────────────────

     Drawn by `ui/SectionSeam.astro` between the sections above (2026-10-11),
     no longer as a full-bleed border on each section: inside the content
     width, fading at both ends, with the brand bar in the middle. The seam
     sits at the boundary, i.e. the midpoint of the gap the pairs above split.
     Hero → services and faq → contact stay unseamed: the hero ends with its
     own device, and the navy block's colour change is its own seam. */
</style>
