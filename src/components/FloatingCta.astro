---
import { tFor, resolveLang, localizePath } from "~/lib/i18n";

/**
 * Persistent bottom-right control. Idle: just the "book a call" CTA
 * (links to the contact section). Once the visitor scrolls ~one viewport
 * down, a small arrow-sized scroll-to-top button rises out of the CTA and
 * fuses with it — same navy fill, its base tucked behind the CTA so the
 * two read as one merged shape. The whole control flips to white when it
 * floats over a dark section so it never disappears.
 */
const lang = resolveLang(Astro.currentLocale);
const t = tFor(Astro.currentLocale);

const home = localizePath("/", lang);
const href = `${home === "/" ? "" : home.replace(/\/$/, "")}/#contact`;
const label = t.nav.cta;
const topLabel = lang === "en" ? "Back to top" : "Nach oben";
---

<div
  class="floating-cta-group"
  data-scrolled-down="false"
  data-near="false"
  data-on-dark="false"
>
  <button type="button" class="floating-cta-top" aria-label={topLabel}>
    <svg
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="floating-cta-top__icon"
    >
      <line x1="12" y1="19" x2="12" y2="5" />
      <polyline points="5 12 12 5 19 12" />
    </svg>
  </button>

  <a href={href} class="floating-cta" aria-label={label}>
    <svg
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="floating-cta__icon"
    >
      <rect x="3" y="4" width="18" height="18" rx="2" />
      <line x1="16" y1="2" x2="16" y2="6" />
      <line x1="8" y1="2" x2="8" y2="6" />
      <line x1="3" y1="10" x2="21" y2="10" />
    </svg>
    <span class="floating-cta__label">{label}</span>
  </a>
</div>

<style>
  /* Positioning wrapper only — no background of its own. The arrow nub is
     centred over the CTA pill below it. */
  .floating-cta-group {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 35;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Lifts as one unit when the CTA is hovered (see :has rule below). */
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (min-width: 768px) {
    .floating-cta-group {
      right: 1.5rem;
      bottom: 1.5rem;
    }
  }

  /* --- Scroll-to-top (small arrow nub, merges into the CTA) --------- */
  .floating-cta-top {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Arrow-sized but a touch bigger so it reads clearly; fully round. */
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 9999px;
    color: #fff;
    background-color: var(--color-surface-navy);
    /* Overlap the CTA so the two navy shapes fuse into one rounded
       component; the ::after neck (below) keeps them connected as the
       nub slides up. */
    margin-bottom: -0.85rem;
    position: relative;
    z-index: 0;
    cursor: pointer;
    /* Collapsed: tucked down inside the CTA, invisible + click-through. */
    opacity: 0;
    transform: translateY(1.1rem) scale(0.4);
    transform-origin: center bottom;
    pointer-events: none;
    transition:
      opacity 220ms ease,
      transform 380ms cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 220ms ease,
      color 220ms ease;
  }
  /* Fluid neck: a narrower navy stem dropping from the nub down behind the
     CTA pill, so a droplet-like pinch connects them. Inherits the nub's
     background-color, so it recolours with every state (navy / accent /
     white-on-dark). Sits behind the pill (pill is z-index 1). */
  .floating-cta-top::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 55%;
    width: 1.15rem;
    height: 1.7rem;
    transform: translateX(-50%);
    background-color: inherit;
    border-radius: 0 0 0.7rem 0.7rem;
    z-index: -1;
  }
  /* Revealed and resting — already peeks clearly above the CTA. */
  .floating-cta-group[data-scrolled-down="true"] .floating-cta-top {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }
  /* Cursor nearby — slides up so it reads more clearly. */
  .floating-cta-group[data-scrolled-down="true"][data-near="true"] .floating-cta-top {
    transform: translateY(-0.4rem) scale(1.02);
  }
  /* Hovering the control — slides up the most. */
  .floating-cta-group[data-scrolled-down="true"]:hover .floating-cta-top {
    transform: translateY(-0.8rem) scale(1.06);
  }
  .floating-cta-top__icon {
    transition: transform 220ms ease;
  }
  .floating-cta-group:hover .floating-cta-top__icon {
    transform: translateY(-2px);
  }

  /* --- CTA pill ----------------------------------------------------- */
  .floating-cta {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    /* Phones: a compact icon-only tap target. */
    padding: 0.85rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #fff;
    background-color: var(--color-surface-navy);
    border-radius: 9999px;
    box-shadow:
      0 14px 34px -12px rgba(5, 15, 104, 0.55),
      0 4px 10px -4px rgba(5, 15, 104, 0.3);
    cursor: pointer;
    transition:
      background-color 220ms ease,
      color 220ms ease,
      box-shadow 220ms ease;
    animation: floating-cta-in 500ms cubic-bezier(0.22, 1, 0.36, 1) 600ms both;
  }
  @media (min-width: 640px) {
    .floating-cta {
      padding: 0.85rem 1.25rem;
    }
  }
  .floating-cta__label {
    display: none;
  }
  @media (min-width: 640px) {
    .floating-cta__label {
      display: inline;
    }
  }
  .floating-cta__icon {
    transition: transform 220ms ease;
    animation: floating-cta-bob 3s ease-in-out 1.2s infinite;
  }
  .floating-cta:hover .floating-cta__icon {
    transform: scale(1.1) rotate(-6deg);
  }

  /* Hover either piece: the whole merged control lifts and warms to
     burgundy with white text — applies in both the navy and inverted
     states (the :has selector out-specifies the [data-on-dark] rules),
     and recolours both pieces so the fused shape stays one colour.
     Hovering the arrow nub yields the identical look to hovering the CTA. */
  .floating-cta-group:has(.floating-cta:hover),
  .floating-cta-group:has(.floating-cta-top:hover) {
    transform: translateY(-2px);
  }
  .floating-cta-group:has(.floating-cta:hover) .floating-cta,
  .floating-cta-group:has(.floating-cta:hover) .floating-cta-top,
  .floating-cta-group:has(.floating-cta-top:hover) .floating-cta,
  .floating-cta-group:has(.floating-cta-top:hover) .floating-cta-top {
    background-color: var(--color-surface-accent);
    color: #fff;
  }
  .floating-cta-group:has(.floating-cta:hover) .floating-cta,
  .floating-cta-group:has(.floating-cta-top:hover) .floating-cta {
    box-shadow:
      0 22px 48px -14px rgba(5, 15, 104, 0.55),
      0 8px 18px -6px rgba(5, 15, 104, 0.4);
  }

  /* Over a dark section both pieces flip to white (toggled in script). */
  .floating-cta-group[data-on-dark="true"] .floating-cta,
  .floating-cta-group[data-on-dark="true"] .floating-cta-top {
    background-color: #fff;
    color: var(--color-surface-navy);
  }
  .floating-cta-group[data-on-dark="true"] .floating-cta {
    box-shadow:
      0 14px 34px -12px rgba(0, 0, 0, 0.45),
      0 4px 10px -4px rgba(0, 0, 0, 0.3);
  }

  @keyframes floating-cta-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.92);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes floating-cta-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-cta,
    .floating-cta__icon {
      animation: none;
    }
    .floating-cta-top {
      transition:
        opacity 200ms ease,
        background-color 220ms ease,
        color 220ms ease;
      transform: none;
    }
    .floating-cta-group[data-scrolled-down="true"] .floating-cta-top {
      transform: none;
    }
    .floating-cta-group:has(.floating-cta:hover) {
      transform: none;
    }
  }
</style>

<script>
  type LenisLike = {
    scrollTo: (target: number, options?: { immediate?: boolean }) => void;
  };

  const group = document.querySelector<HTMLElement>(".floating-cta-group");
  const topBtn = group?.querySelector<HTMLElement>(".floating-cta-top");

  if (group) {
    // Parse a computed `rgb(...)` / `rgba(...)` string into [r,g,b,a].
    const parseRgb = (
      value: string,
    ): [number, number, number, number] | null => {
      const match = value.match(/rgba?\(([^)]+)\)/);
      if (!match) return null;
      const [r, g, b, a = 1] = match[1]
        .split(",")
        .map((part) => parseFloat(part.trim()));
      return [r, g, b, a];
    };

    // Walk up from the element under the group until an opaque background
    // is found; falls back to the document background.
    const backgroundUnder = (
      start: Element | null,
    ): [number, number, number] | null => {
      let node: Element | null = start;
      while (node) {
        const rgb = parseRgb(getComputedStyle(node).backgroundColor);
        if (rgb && rgb[3] > 0.5) return [rgb[0], rgb[1], rgb[2]];
        node = node.parentElement;
      }
      const doc = parseRgb(getComputedStyle(document.body).backgroundColor);
      return doc ? [doc[0], doc[1], doc[2]] : null;
    };

    const isDark = ([r, g, b]: [number, number, number]) =>
      0.2126 * r + 0.7152 * g + 0.0722 * b < 115;

    let frame = 0;
    const update = () => {
      frame = 0;
      // Reveal the scroll-to-top nub after ~one viewport of scroll.
      group.dataset.scrolledDown =
        window.scrollY > window.innerHeight * 0.8 ? "true" : "false";

      // Invert over dark sections — sample the background behind the group.
      const rect = group.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const behind = document
        .elementsFromPoint(x, y)
        .find((el) => el !== group && !group.contains(el));
      const rgb = backgroundUnder(behind ?? null);
      group.dataset.onDark = rgb && isDark(rgb) ? "true" : "false";
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);

    // Proximity: as the pointer nears the control, slide the scroll-to-top
    // arrow up (the CSS slides it further again on hover). Hover-capable
    // pointers only — touch has no "near" state.
    if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      const NEAR = 150;
      let near = false;
      let px = 0;
      let py = 0;
      let pframe = 0;
      const evalNear = () => {
        pframe = 0;
        const r = group.getBoundingClientRect();
        const dx = Math.max(r.left - px, 0, px - r.right);
        const dy = Math.max(r.top - py, 0, py - r.bottom);
        const next = Math.hypot(dx, dy) < NEAR;
        if (next !== near) {
          near = next;
          group.dataset.near = next ? "true" : "false";
        }
      };
      window.addEventListener(
        "pointermove",
        (event) => {
          px = event.clientX;
          py = event.clientY;
          if (!pframe) pframe = requestAnimationFrame(evalNear);
        },
        { passive: true },
      );
    }

    topBtn?.addEventListener("click", () => {
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const lenis = (window as unknown as { lenis?: LenisLike }).lenis;
      if (lenis) {
        lenis.scrollTo(0, { immediate: reduce });
      } else {
        window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      }
    });
  }
</script>
