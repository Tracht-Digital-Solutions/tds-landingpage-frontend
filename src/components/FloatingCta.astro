---
import { tFor, resolveLang, localizePath } from "~/lib/i18n";

/**
 * Persistent bottom-right control. Idle: just the "book a call" CTA
 * (links to the contact section). Once the visitor scrolls ~one viewport
 * down, a scroll-to-top button reveals itself attached on top of the CTA,
 * separated by a divider line, so the two read as one connected pill.
 * The whole group flips to white when it floats over a dark section so it
 * never disappears into the background.
 */
const lang = resolveLang(Astro.currentLocale);
const t = tFor(Astro.currentLocale);

const home = localizePath("/", lang);
const href = `${home === "/" ? "" : home.replace(/\/$/, "")}/#contact`;
const label = t.nav.cta;
const topLabel = lang === "en" ? "Back to top" : "Nach oben";
---

<div class="floating-cta-group" data-scrolled-down="false" data-on-dark="false">
  <button type="button" class="floating-cta-top" aria-label={topLabel}>
    <svg
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="floating-cta-top__icon"
    >
      <line x1="12" y1="19" x2="12" y2="5" />
      <polyline points="5 12 12 5 19 12" />
    </svg>
  </button>

  <a href={href} class="floating-cta" aria-label={label}>
    <svg
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="floating-cta__icon"
    >
      <rect x="3" y="4" width="18" height="18" rx="2" />
      <line x1="16" y1="2" x2="16" y2="6" />
      <line x1="8" y1="2" x2="8" y2="6" />
      <line x1="3" y1="10" x2="21" y2="10" />
    </svg>
    <span class="floating-cta__label">{label}</span>
  </a>
</div>

<style>
  .floating-cta-group {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 35;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    overflow: hidden;
    border-radius: 9999px;
    color: #fff;
    background-color: var(--color-surface-navy);
    box-shadow:
      0 14px 34px -12px rgba(5, 15, 104, 0.55),
      0 4px 10px -4px rgba(5, 15, 104, 0.3);
    transition:
      background-color 220ms ease,
      color 220ms ease,
      box-shadow 220ms ease,
      border-radius 280ms cubic-bezier(0.22, 1, 0.36, 1);
    animation: floating-cta-in 500ms cubic-bezier(0.22, 1, 0.36, 1) 600ms both;
  }

  /* Expanded (scrolled down): the group grew a top button + divider, so
     relax the pill radius into a rounded card. */
  .floating-cta-group[data-scrolled-down="true"] {
    border-radius: 1.6rem;
  }

  /* Over a dark section the whole group flips to a white pill (toggled
     from the luminance check in the script). */
  .floating-cta-group[data-on-dark="true"] {
    background-color: #fff;
    color: var(--color-surface-navy);
    box-shadow:
      0 14px 34px -12px rgba(0, 0, 0, 0.45),
      0 4px 10px -4px rgba(0, 0, 0, 0.3);
  }

  @media (min-width: 768px) {
    .floating-cta-group {
      right: 1.5rem;
      bottom: 1.5rem;
    }
  }

  /* --- CTA (bottom) -------------------------------------------------- */
  .floating-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    /* Phones: a compact icon-only tap target. */
    padding: 0.85rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: inherit;
    cursor: pointer;
    transition: background-color 200ms ease;
  }
  /* currentColor-based wash so the hover reads on both the navy and the
     inverted-white states. */
  .floating-cta:hover {
    background-color: color-mix(in srgb, currentColor 12%, transparent);
  }
  .floating-cta:active {
    background-color: color-mix(in srgb, currentColor 18%, transparent);
  }
  .floating-cta__label {
    display: none;
  }
  @media (min-width: 640px) {
    .floating-cta {
      padding: 0.85rem 1.25rem;
    }
    .floating-cta__label {
      display: inline;
    }
  }

  /* Idle bob on the calendar icon so the control reads as "alive". */
  .floating-cta__icon {
    transition: transform 220ms ease;
    animation: floating-cta-bob 3s ease-in-out 1.2s infinite;
  }
  .floating-cta:hover .floating-cta__icon {
    transform: scale(1.1) rotate(-6deg);
  }

  /* --- Scroll-to-top (top, revealed on scroll) ---------------------- */
  .floating-cta-top {
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    cursor: pointer;
    /* Collapsed by default — zero height, faded, click-through, divider
       hidden. */
    height: 0;
    opacity: 0;
    pointer-events: none;
    border-bottom: 1px solid transparent;
    transition:
      height 280ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 200ms ease,
      background-color 200ms ease,
      border-color 220ms ease;
  }
  .floating-cta-group[data-scrolled-down="true"] .floating-cta-top {
    height: 2.6rem;
    opacity: 1;
    pointer-events: auto;
    /* Trennlinie above the CTA. */
    border-bottom-color: rgb(255 255 255 / 0.22);
  }
  /* Inverted group → dark divider on the white pill. */
  .floating-cta-group[data-on-dark="true"][data-scrolled-down="true"]
    .floating-cta-top {
    border-bottom-color: rgb(5 15 104 / 0.16);
  }
  .floating-cta-top:hover {
    background-color: color-mix(in srgb, currentColor 12%, transparent);
  }
  .floating-cta-top__icon {
    transition: transform 220ms ease;
  }
  .floating-cta-top:hover .floating-cta-top__icon {
    transform: translateY(-2px);
  }

  @keyframes floating-cta-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.92);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes floating-cta-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-cta-group,
    .floating-cta__icon {
      animation: none;
    }
    /* Reveal instantly, keep the colour/divider fades. */
    .floating-cta-top {
      transition:
        height 0ms,
        opacity 200ms ease,
        background-color 200ms ease,
        border-color 220ms ease;
    }
  }
</style>

<script>
  type LenisLike = {
    scrollTo: (target: number, options?: { immediate?: boolean }) => void;
  };

  const group = document.querySelector<HTMLElement>(".floating-cta-group");
  const topBtn = group?.querySelector<HTMLElement>(".floating-cta-top");

  if (group) {
    // Parse a computed `rgb(...)` / `rgba(...)` string into [r,g,b,a].
    const parseRgb = (
      value: string,
    ): [number, number, number, number] | null => {
      const match = value.match(/rgba?\(([^)]+)\)/);
      if (!match) return null;
      const [r, g, b, a = 1] = match[1]
        .split(",")
        .map((part) => parseFloat(part.trim()));
      return [r, g, b, a];
    };

    // Walk up from the element under the group until an opaque background
    // is found; falls back to the document background.
    const backgroundUnder = (
      start: Element | null,
    ): [number, number, number] | null => {
      let node: Element | null = start;
      while (node) {
        const rgb = parseRgb(getComputedStyle(node).backgroundColor);
        if (rgb && rgb[3] > 0.5) return [rgb[0], rgb[1], rgb[2]];
        node = node.parentElement;
      }
      const doc = parseRgb(getComputedStyle(document.body).backgroundColor);
      return doc ? [doc[0], doc[1], doc[2]] : null;
    };

    const isDark = ([r, g, b]: [number, number, number]) =>
      0.2126 * r + 0.7152 * g + 0.0722 * b < 115;

    let frame = 0;
    const update = () => {
      frame = 0;
      // Reveal the scroll-to-top button after ~one viewport of scroll.
      group.dataset.scrolledDown =
        window.scrollY > window.innerHeight * 0.8 ? "true" : "false";

      // Invert over dark sections — sample the background behind the group.
      const rect = group.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const behind = document
        .elementsFromPoint(x, y)
        .find((el) => el !== group && !group.contains(el));
      const rgb = backgroundUnder(behind ?? null);
      group.dataset.onDark = rgb && isDark(rgb) ? "true" : "false";
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);

    topBtn?.addEventListener("click", () => {
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const lenis = (window as unknown as { lenis?: LenisLike }).lenis;
      if (lenis) {
        lenis.scrollTo(0, { immediate: reduce });
      } else {
        window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      }
    });
  }
</script>
