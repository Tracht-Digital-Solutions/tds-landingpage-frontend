---
import { resolveLang, localizePath } from "~/lib/i18n";

/**
 * Persistent bottom-corner control, in two shapes.
 *
 * **Fine pointer.** Idle: just the "book a call" CTA (links to the contact
 * section). Once the visitor scrolls ~one viewport down, a small arrow-sized
 * scroll-to-top button rises out of the CTA and fuses with it — same navy
 * fill, its base tucked behind the CTA so the two read as one merged shape.
 *
 * **Coarse pointer.** The fused shape is a mouse idea: it announces itself by
 * growing as the cursor approaches, and it shrinks to an unlabelled 44px
 * circle on a phone — the single most important call to action on the site,
 * reduced to a calendar glyph with no word next to it. On touch it is a
 * labelled bar across the bottom instead, and the scroll-to-top button sits
 * above it as its own round target rather than fusing with it.
 *
 * The whole control flips to white when it floats over a dark section so it
 * never disappears.
 */
const lang = resolveLang(Astro.currentLocale);
const home = localizePath("/", lang);
const href = `${home === "/" ? "" : home.replace(/\/$/, "")}/#contact`;
const label = lang === "de" ? "Erstgespräch vereinbaren" : "Arrange an initial consultation";
const topLabel = lang === "en" ? "Back to top" : "Nach oben";
---

<div
  class="floating-cta-group"
  data-scrolled-down="false"
  data-near="false"
  data-on-dark="false"
>
  <button type="button" class="floating-cta-top" aria-label={topLabel}>
    <svg
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="floating-cta-top__icon"
    >
      <line x1="12" y1="19" x2="12" y2="5" />
      <polyline points="5 12 12 5 19 12" />
    </svg>
  </button>

  <a href={href} class="floating-cta" aria-label={label}>
    <svg
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="floating-cta__icon"
    >
      <rect x="3" y="4" width="18" height="18" rx="2" />
      <line x1="16" y1="2" x2="16" y2="6" />
      <line x1="8" y1="2" x2="8" y2="6" />
      <line x1="3" y1="10" x2="21" y2="10" />
    </svg>
    <span class="floating-cta__label">{label}</span>
    <span aria-hidden="true" class="floating-cta__arrow">→</span>
  </a>
</div>

<style>
  /* Positioning wrapper only — no background of its own. The arrow nub is
     centred over the CTA pill below it. */
  .floating-cta-group {
    position: fixed;
    right: 1rem;
    /* Stack above whatever else already occupies this corner, rather than
       underneath it. Two lanes, both published by tds-shared components that
       measure themselves (the same mechanism the toast stack has always used):

       - `--tds-right-lane` is the live-chat launcher's height. That widget is
         fixed in THIS corner at `z-index: 95` — twelve layers above this
         control — so with it switched on for the landingpage it covered the
         CTA completely. It renders nothing until an admin enables it per
         frontend, which is the only reason this was not already visible.
       - `--tds-bottom-lane` is the cookie notice's height. That notice spans
         the FULL width on a phone, so it occupies this corner too.

       Both fall back to `0px`, so with neither component on screen this is the
       plain 1rem it has always been. `env()` last — it clears the home
       indicator on a notched phone and resolves to 0px everywhere else; this
       control never had that and sat under the gesture bar. */
    bottom: calc(
      var(--tds-right-lane, 0px) + var(--tds-bottom-lane, 0px) + 1rem +
        env(safe-area-inset-bottom, 0px)
    );
    z-index: 35;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Lifts as one unit when the CTA is hovered (see :has rule below). */
    transition: transform 220ms var(--lp-ease-soft);
  }
  @media (min-width: 768px) {
    .floating-cta-group {
      right: 1.5rem;
      bottom: calc(
        var(--tds-right-lane, 0px) + var(--tds-bottom-lane, 0px) + 1.5rem +
          env(safe-area-inset-bottom, 0px)
      );
    }
  }

  /* --- Scroll-to-top (small arrow nub, merges into the CTA) --------- */
  .floating-cta-top {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Arrow-sized but a touch bigger so it reads clearly; fully round. */
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 9999px;
    color: #fff;
    background-color: var(--color-surface-navy);
    /* Overlap the CTA so the two navy shapes fuse into one rounded
       component; the ::after neck (below) keeps them connected as the
       nub slides up. */
    margin-bottom: -0.85rem;
    position: relative;
    z-index: 0;
    cursor: pointer;
    /* Collapsed: tucked down inside the CTA, invisible + click-through. */
    opacity: 0;
    transform: translateY(1.1rem) scale(0.4);
    transform-origin: center bottom;
    pointer-events: none;
    transition:
      opacity 220ms ease,
      transform 380ms var(--lp-ease-bounce),
      background-color 220ms ease,
      color 220ms ease;
  }
  /* Fluid neck: a narrower navy stem dropping from the nub down behind the
     CTA pill, so a droplet-like pinch connects them. Inherits the nub's
     background-color, so it recolours with every state (navy / accent /
     white-on-dark). Sits behind the pill (pill is z-index 1). */
  .floating-cta-top::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 55%;
    width: 1.15rem;
    height: 1.7rem;
    transform: translateX(-50%);
    background-color: inherit;
    border-radius: 0 0 0.7rem 0.7rem;
    z-index: -1;
  }
  /* Revealed and resting — already peeks clearly above the CTA. */
  .floating-cta-group[data-scrolled-down="true"] .floating-cta-top {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }
  .floating-cta-top__icon {
    transition: transform 220ms ease;
  }

  /* --- CTA pill ----------------------------------------------------- */
  .floating-cta {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    /* Fine-pointer phones (a small desktop window): a compact icon-only
       tap target. The touch block at the bottom of this file replaces it
       with a labelled bar wherever there is no hover. */
    padding: 0.85rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #fff;
    background-color: var(--color-surface-navy);
    border-radius: 9999px;
    box-shadow:
      0 14px 34px -12px rgba(5, 15, 104, 0.55),
      0 4px 10px -4px rgba(5, 15, 104, 0.3);
    cursor: pointer;
    transition:
      background-color 220ms ease,
      color 220ms ease,
      box-shadow 220ms ease;
    animation: floating-cta-in 500ms var(--lp-ease-bounce) 600ms both;
  }
  @media (min-width: 640px) {
    .floating-cta {
      padding: 0.85rem 1.25rem;
    }
  }
  .floating-cta__label {
    display: none;
  }
  @media (min-width: 640px) {
    .floating-cta__label {
      display: inline;
    }
  }
  /* Only the touch bar shows the arrow — on the round pill it would be a
     third glyph competing with the icon inside a 44px circle. */
  .floating-cta__arrow {
    display: none;
  }
  .floating-cta__icon {
    transition: transform 220ms ease;
    animation: floating-cta-bob 3s ease-in-out 1.2s infinite;
  }

  /* --- Hover states, fine pointers only ----------------------------- */

  /* All of this is behind `(hover: hover)` on purpose. `:hover` on a touch
     screen is a STICKY state: the browser applies it on tap and leaves it
     applied until the next tap elsewhere, so the "lift + warm to burgundy"
     read as the control changing colour permanently after being used once. */
  @media (hover: hover) {
    .floating-cta-group:hover .floating-cta-top__icon {
      transform: translateY(-2px);
    }
    /* Cursor nearby — slides up so it reads more clearly. */
    .floating-cta-group[data-scrolled-down="true"][data-near="true"] .floating-cta-top {
      transform: translateY(-0.4rem) scale(1.02);
    }
    /* Hovering the control — slides up the most. */
    .floating-cta-group[data-scrolled-down="true"]:hover .floating-cta-top {
      transform: translateY(-0.8rem) scale(1.06);
    }
    .floating-cta:hover .floating-cta__icon {
      transform: scale(1.1) rotate(-6deg);
    }

    /* Hover either piece: the whole merged control lifts and warms to
       burgundy with white text — applies in both the navy and inverted
       states (the :has selector out-specifies the [data-on-dark] rules),
       and recolours both pieces so the fused shape stays one colour.
       Hovering the arrow nub yields the identical look to hovering the CTA. */
    .floating-cta-group:has(.floating-cta:hover),
    .floating-cta-group:has(.floating-cta-top:hover) {
      transform: translateY(-2px);
    }
    .floating-cta-group:has(.floating-cta:hover) .floating-cta,
    .floating-cta-group:has(.floating-cta:hover) .floating-cta-top,
    .floating-cta-group:has(.floating-cta-top:hover) .floating-cta,
    .floating-cta-group:has(.floating-cta-top:hover) .floating-cta-top {
      background-color: var(--color-surface-accent);
      color: #fff;
    }
    .floating-cta-group:has(.floating-cta:hover) .floating-cta,
    .floating-cta-group:has(.floating-cta-top:hover) .floating-cta {
      box-shadow:
        0 22px 48px -14px rgba(5, 15, 104, 0.55),
        0 8px 18px -6px rgba(5, 15, 104, 0.4);
    }
  }

  /* Over a dark section both pieces flip to white (toggled in script). */
  .floating-cta-group[data-on-dark="true"] .floating-cta,
  .floating-cta-group[data-on-dark="true"] .floating-cta-top {
    background-color: #fff;
    color: var(--color-surface-navy);
  }
  .floating-cta-group[data-on-dark="true"] .floating-cta {
    box-shadow:
      0 14px 34px -12px rgba(0, 0, 0, 0.45),
      0 4px 10px -4px rgba(0, 0, 0, 0.3);
  }

  /* --- Touch: a labelled bar, not a glyph --------------------------- */

  /* Keyed on `(hover: none)` rather than a width, because the problem is
     the input device: a 44px unlabelled circle is fine next to a cursor
     that can hover it for a tooltip, and useless under a thumb. Placed
     LAST so it wins over the `min-width: 640px` rules above without
     needing a specificity bump. */
  @media (hover: none) {
    .floating-cta-group {
      left: 1rem;
      right: 1rem;
      align-items: flex-end;
    }
    @media (min-width: 768px) {
      .floating-cta-group {
        left: 1.5rem;
        right: 1.5rem;
      }
    }

    .floating-cta {
      width: 100%;
      /* 56px, comfortably past the 44px floor the shared `.btn` uses —
         this is a primary action a thumb reaches for at the bottom of the
         screen, where accuracy is worst. */
      min-height: 3.5rem;
      padding: 0.75rem 1.5rem;
      gap: 0.625rem;
    }
    .floating-cta__label {
      display: inline;
    }
    .floating-cta__arrow {
      display: inline;
      margin-left: auto;
      /* Pushed to the trailing edge with the icon at the leading one, so
         the bar reads as a row rather than as a centred blob. */
      padding-left: 0.5rem;
    }
    .floating-cta__icon {
      /* The bob loop is a "look at me" idle for a small distant circle; in
         a full-width bar it just wobbles the row's leading glyph. */
      animation: none;
      flex-shrink: 0;
    }

    /* No fusion on touch. The nub grew out of the pill because a cursor
       approached it; a thumb does not approach, it arrives — so this is
       its own round target above the bar, at a size a thumb can hit. */
    .floating-cta-top {
      width: 2.75rem;
      height: 2.75rem;
      margin-bottom: 0.625rem;
      transform: translateY(0.75rem) scale(0.6);
    }
    .floating-cta-top::after {
      display: none;
    }

    /* The bar is fixed over the end of the document, so the last thing on
       every page (the footer's bottom row) sat underneath it. The lanes in
       `bottom` keep the bar clear of the cookie notice; this keeps the
       PAGE clear of the bar. */
    :global(body) {
      padding-bottom: calc(4.75rem + env(safe-area-inset-bottom, 0px));
    }
  }

  @keyframes floating-cta-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.92);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes floating-cta-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-cta,
    .floating-cta__icon {
      animation: none;
    }
    .floating-cta-top {
      transition:
        opacity 200ms ease,
        background-color 220ms ease,
        color 220ms ease;
      transform: none;
    }
    .floating-cta-group[data-scrolled-down="true"] .floating-cta-top {
      transform: none;
    }
    .floating-cta-group:has(.floating-cta:hover) {
      transform: none;
    }
  }
</style>

<script>
  const group = document.querySelector<HTMLElement>(".floating-cta-group");
  const topBtn = group?.querySelector<HTMLElement>(".floating-cta-top");

  if (group) {
    /**
     * Which parts of the DOCUMENT are a dark ground, in absolute page
     * coordinates, measured once and re-measured only when the page's own
     * geometry changes.
     *
     * This replaces a per-frame `elementsFromPoint()` + a `getComputedStyle()`
     * walk up the ancestor chain, which ran inside the scroll rAF: three
     * forced synchronous layouts, sixty times a second, for the whole life of
     * the page, to answer a question whose answer changes about four times per
     * visit. It was the single largest source of scroll jank on a phone, and
     * because a `data-theme` MutationObserver also scheduled it, it ran in the
     * middle of the theme transition as well.
     *
     * The dark grounds are the two shared tone primitives — `.tds-tone-navy`
     * (contact, both navy callouts, the pricing highlight card, the service
     * price aside and CTA panel) and `.tds-tone-ink` (the footer). Those are
     * CLASSES, so unlike a sampled colour they do not change with the theme,
     * which is what lets the answer be cached at all.
     */
    let darkRanges: Array<[number, number]> = [];

    /** The control's own centre, as a distance up from the viewport bottom. */
    let anchorFromBottom = 0;

    const measure = () => {
      const offset = window.scrollY;
      darkRanges = Array.from(
        document.querySelectorAll<HTMLElement>(".tds-tone-navy, .tds-tone-ink"),
      ).map((element) => {
        const rect = element.getBoundingClientRect();
        return [rect.top + offset, rect.bottom + offset] as [number, number];
      });

      const rect = group.getBoundingClientRect();
      anchorFromBottom = window.innerHeight - (rect.top + rect.height / 2);
    };

    // In dark mode every ground is dark, including the paper between the
    // navy blocks — so the inverted (white) control is correct everywhere and
    // the ranges do not need consulting at all.
    const documentIsDark = () =>
      document.documentElement.getAttribute("data-theme") === "dark";

    let frame = 0;
    // Both flags are re-derived on every frame of every scroll, but they
    // only CHANGE a handful of times per page. Writing a data-attribute
    // costs the same whether or not the value differs: it invalidates style
    // for this element and, because the control is styled through several
    // `:has()` and attribute selectors, for the pieces inside it — sixty
    // times a second, to arrive at the markup that was already there.
    // Comparing first is free.
    const setFlag = (key: "scrolledDown" | "onDark", on: boolean) => {
      const value = on ? "true" : "false";
      if (group.dataset[key] !== value) group.dataset[key] = value;
    };

    const update = () => {
      frame = 0;
      // Reveal the scroll-to-top nub after ~one viewport of scroll.
      setFlag("scrolledDown", window.scrollY > window.innerHeight * 0.8);

      // Pure arithmetic from here down — no layout is read during a scroll.
      const centre = window.scrollY + window.innerHeight - anchorFromBottom;
      setFlag(
        "onDark",
        documentIsDark() ||
          darkRanges.some(([top, bottom]) => centre >= top && centre <= bottom),
      );
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    const remeasure = () => {
      measure();
      update();
    };

    measure();
    update();
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", remeasure);

    // Anything that changes the page's height moves every range below it:
    // late-loading images and web fonts, an opened FAQ row, the cookie
    // notice appearing. A ResizeObserver on the document element catches
    // all of them and fires only when the height actually changes — which
    // is the whole point of not doing this per frame.
    new ResizeObserver(remeasure).observe(document.documentElement);

    // Re-evaluate when the colour theme flips. This no longer measures
    // anything; it only re-reads the attribute the scroll handler consults.
    new MutationObserver(update).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });

    // Proximity: as the pointer nears the control, slide the scroll-to-top
    // arrow up (the CSS slides it further again on hover). Hover-capable
    // pointers only — touch has no "near" state.
    if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      const NEAR = 150;
      let near = false;
      let px = 0;
      let py = 0;
      let pframe = 0;
      const evalNear = () => {
        pframe = 0;
        const r = group.getBoundingClientRect();
        const dx = Math.max(r.left - px, 0, px - r.right);
        const dy = Math.max(r.top - py, 0, py - r.bottom);
        const next = Math.hypot(dx, dy) < NEAR;
        if (next !== near) {
          near = next;
          group.dataset.near = next ? "true" : "false";
        }
      };
      window.addEventListener(
        "pointermove",
        (event) => {
          px = event.clientX;
          py = event.clientY;
          if (!pframe) pframe = requestAnimationFrame(evalNear);
        },
        { passive: true },
      );
    }

    topBtn?.addEventListener("click", () => {
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const bounceScroll = (window as unknown as {
        tdsScrollTo?: (target: number, opts?: { immediate?: boolean }) => void;
      }).tdsScrollTo;
      if (bounceScroll) {
        bounceScroll(0, { immediate: reduce });
      } else {
        window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      }
    });
  }
</script>
