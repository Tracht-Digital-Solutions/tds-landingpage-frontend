---
import { resolveLang, localizePath } from "~/lib/i18n";
import A11yTools from "~/components/A11yTools.astro";

/**
 * Persistent bottom-corner control — ONE shape (2026-09-22).
 *
 * The first tree (three separate circles joined by necks) did not read as a
 * whole. Now the group itself is the shape: one navy pill with a hard 2D
 * shadow, and inside it, stacked, three transparent round buttons —
 *
 * - "Nach oben", which folds out once the visitor has scrolled about a
 *   viewport;
 * - the accessibility tools, always there;
 * - the telephone receiver, which leads ONLY to the contact form
 *   (`/#contact`, no `tel:`) — its accessible name says so, because the
 *   receiver alone could be read as "call".
 *
 * Each button sits in a SLOT that folds open and shut
 * (`grid-template-rows: 1fr ↔ 0fr`), so the pill grows and shrinks upwards
 * from its bottom anchor instead of parts appearing on their own. The trunk
 * folds away while the hero or the contact form is on screen (one primary
 * action per view); the two other slots are not part of that. Motion
 * (`lib/motion/floatingCta.ts`) pops the icon of a slot that opens.
 *
 * One colour for the whole shape: navy, bordeaux while any part is hovered,
 * white over a dark ground.
 */
const lang = resolveLang(Astro.currentLocale);
const home = localizePath("/", lang);
const href = `${home === "/" ? "" : home.replace(/\/$/, "")}/#contact`;
const label = lang === "de" ? "Zum Kontaktformular" : "Go to the contact form";
const hint = lang === "de" ? "Kontakt" : "Contact";
const topLabel = lang === "en" ? "Back to top" : "Nach oben";
// A landmark of its own: it floats outside `<main>` and the footer, and axe
// reported it as content outside every region (`region`).
const regionLabel = lang === "en" ? "Quick access" : "Schnellzugriff";
---

{/* No `data-suppressed` in the markup on purpose — see the rules below: on a
    page with a hero the trunk starts folded until the script has measured
    that the hero is gone, so it never flashes over the hero's own button. */}
<aside
  class="floating-cta-group"
  aria-label={regionLabel}
  data-scrolled-down="false"
>
  <div class="tree-slot tree-slot--top">
    <div class="tree-slot__inner">
      <button type="button" class="floating-cta-top" aria-label={topLabel}>
        <svg
          aria-hidden="true"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="tree-icon"
        >
          <line x1="12" y1="19" x2="12" y2="5" />
          <polyline points="5 12 12 5 19 12" />
        </svg>
      </button>
    </div>
  </div>

  {/* Accessibility tools (2026-09-21). Never folded: they stay reachable on
      every screen, including over the hero and the form. */}
  <div class="tree-slot tree-slot--a11y">
    <div class="tree-slot__inner">
      <A11yTools />
    </div>
  </div>

  <div class="tree-slot tree-slot--trunk">
    <div class="tree-slot__inner">
      <a href={href} class="floating-cta" aria-label={label}>
        {/* The telephone receiver. */}
        <svg
          aria-hidden="true"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="tree-icon floating-cta__icon"
        >
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
      </a>
    </div>
  </div>

  {/* A visible word beside the receiver on hover for a mouse. Outside the
      slots, whose `overflow: hidden` would cut it off; the accessible name is
      the trunk's label, so this one is hidden from assistive tech. */}
  <span aria-hidden="true" class="floating-cta__hint">{hint}</span>
</aside>

<style>
  /* The pill. */
  .floating-cta-group {
    position: fixed;
    right: 1rem;
    /* Stack above whatever else already occupies this corner: the live-chat
       launcher (`--tds-right-lane`, z-index 95, same corner) and the cookie
       notice (`--tds-bottom-lane`, full width on a phone). Both fall back to
       `0px`; `env()` clears the home indicator on a notched phone. */
    bottom: calc(
      var(--tds-right-lane, 0px) + 1rem +
        env(safe-area-inset-bottom, 0px)
    );
    /* The cookie notice's lane moves the pill with `translate`, not with
       `bottom`: the notice appears after the first paint, and a change of
       `bottom` is a layout shift (measured 0.033 CLS on a phone). */
    translate: 0 calc(-1 * var(--tds-bottom-lane, 0px));
    z-index: 35;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.25rem;
    border-radius: 9999px;
    background-color: var(--color-surface-navy);
    color: #fff;
    box-shadow: var(--tds-shadow-hard);
    /* Only the buttons take pointer events: the pill's padding ring never
       swallows a click meant for the page underneath. */
    pointer-events: none;
    transition:
      background-color 220ms ease,
      color 220ms ease,
      translate 300ms var(--tds-ease-out);
  }
  @media (min-width: 768px) {
    .floating-cta-group {
      right: 1.5rem;
      bottom: calc(
        var(--tds-right-lane, 0px) + 1.5rem +
          env(safe-area-inset-bottom, 0px)
      );
    }
  }

  .floating-cta-group > :global(*) {
    pointer-events: auto;
  }

  /* --- Slots: fold open and shut ------------------------------------ */
  .tree-slot {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 320ms var(--tds-ease-out);
  }
  .tree-slot__inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    justify-content: center;
  }
  .tree-slot__inner > :global(*) {
    transition:
      opacity 200ms ease,
      visibility 0s linear 0s,
      background-color 200ms ease;
  }
  /* A folded slot takes its button out of the tab order and away from
     assistive tech (`visibility`), after the fold has played. */
  .floating-cta-group[data-scrolled-down="false"] .tree-slot--top,
  .floating-cta-group[data-suppressed="true"] .tree-slot--trunk,
  :global(body:has(#hero)) .floating-cta-group:not([data-suppressed]) .tree-slot--trunk {
    grid-template-rows: 0fr;
  }
  .floating-cta-group[data-scrolled-down="false"] .tree-slot--top .tree-slot__inner > :global(*),
  .floating-cta-group[data-suppressed="true"] .tree-slot--trunk .tree-slot__inner > :global(*),
  :global(body:has(#hero)) .floating-cta-group:not([data-suppressed]) .tree-slot--trunk .tree-slot__inner > :global(*) {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 160ms ease,
      visibility 0s linear 320ms;
  }
  /* Short screens with the cookie notice open: header, notice and this
     control together covered most of a 320×568 phone. Until the notice is
     dismissed, only the accessibility tools stay. */
  @media (max-height: 44rem) {
    :global(:root:has(.cookie-notice)) .floating-cta-group .tree-slot:not(.tree-slot--a11y) {
      grid-template-rows: 0fr;
    }
    :global(:root:has(.cookie-notice)) .floating-cta-group .tree-slot:not(.tree-slot--a11y) .tree-slot__inner > :global(*) {
      visibility: hidden;
    }
  }

  /* The height this control reserves at the bottom edge, for
     `scroll-padding-bottom` in global.css: a focused link must scroll above
     it, not behind it. Cleared while the trunk is folded away. */
  :global(:root) {
    --lp-floating-lane: 4.75rem;
  }
  @media (min-width: 768px) {
    :global(:root) {
      --lp-floating-lane: 5.25rem;
    }
  }
  :global(:root:has(.floating-cta-group[data-suppressed="true"])) {
    --lp-floating-lane: 0px;
  }
  @media (max-height: 44rem) {
    :global(:root:has(.cookie-notice)) {
      --lp-floating-lane: 0px;
    }
  }

  /* --- The buttons: transparent round hit areas ---------------------- */
  .floating-cta-top,
  .floating-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: none;
    border-radius: 9999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .floating-cta-top:hover,
  .floating-cta:hover {
    background: rgb(255 255 255 / 0.14);
  }
  .floating-cta-top:focus-visible,
  .floating-cta:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
  }
  /* The word beside the receiver, sliding out to the left on hover. */
  .floating-cta__hint {
    position: absolute;
    right: calc(100% + 0.75rem);
    bottom: 1rem;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    background: inherit;
    color: inherit;
    box-shadow: var(--tds-shadow-hard-sm);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    translate: 0.5rem 0;
    pointer-events: none;
    transition:
      opacity 200ms var(--tds-ease-out),
      translate 320ms var(--lp-ease-bounce, var(--tds-ease-out));
  }

  @media (hover: hover) {
    /* Any part hovered: the whole shape turns bordeaux. */
    .floating-cta-group:hover {
      background-color: var(--color-surface-accent);
      color: #fff;
    }
    .floating-cta-group:has(.floating-cta:hover) .floating-cta__hint,
    .floating-cta-group:has(.floating-cta:focus-visible) .floating-cta__hint {
      opacity: 1;
      translate: 0 0;
    }
    .floating-cta:hover .floating-cta__icon {
      /* The receiver rings: a short wobble. */
      animation: floating-cta-ring 520ms ease-in-out;
    }
    .floating-cta-top:hover .tree-icon {
      translate: 0 -2px;
    }
  }
  .tree-icon {
    transition: translate 200ms ease;
    transform-origin: 60% 40%;
  }

  /* Pressed: the whole shape moves into its own shadow. */
  .floating-cta-group:has(:is(.floating-cta, .floating-cta-top):active) {
    translate: 2px calc(2px - var(--tds-bottom-lane, 0px));
    box-shadow: var(--tds-shadow-hard-press);
  }

  /* The receiver is the CONTACT action and the button the shape exists for:
     a pink disc with a navy receiver (2026-09-22, "hervorgehoben"), in both
     layers. Hovering it turns the disc navy. */
  .floating-cta,
  .floating-cta-group--twin .floating-cta {
    background: var(--color-accent-pink);
    color: var(--color-surface-navy);
  }
  .floating-cta:is(:hover, :focus-visible),
  .floating-cta-group:has(.floating-cta:hover) + .floating-cta-group--twin .floating-cta {
    background: var(--color-surface-navy);
    color: #fff;
  }

  /* === The inverted twin: a colour change exactly at the section line ===
     The script clones the pill into `.floating-cta-group--twin`, laid exactly
     over it in the inverted colours (white, navy icons, black shadow ink), and
     clips BOTH layers per scroll frame: the twin to the part of the pill that
     lies over a dark band, the original to the rest. So the colour changes at
     the line itself, part of the pill already white while the rest is still
     navy — entering and leaving alike. The twin is `aria-hidden` and `inert`,
     carries no ids, no popover and no links, and takes no pointer. */
  .floating-cta-group--twin {
    --tds-shadow-ink: rgb(0 0 0 / 0.55);
    --tds-shadow-hard: 6px 6px 0 0 var(--tds-shadow-ink);
    --tds-shadow-hard-sm: 3px 3px 0 0 var(--tds-shadow-ink);
    --tds-shadow-hard-press: 1px 1px 0 0 var(--tds-shadow-ink);
    --tds-shadow-hard-sm-hover: 5px 5px 0 0 var(--tds-shadow-ink);
    background-color: #fff;
    color: var(--color-surface-navy);
    pointer-events: none;
    clip-path: inset(100% 0 0 0);
  }
  .floating-cta-group--twin * {
    pointer-events: none !important;
  }
  /* The twin follows the original's hover and press, which it cannot have
     itself. */
  @media (hover: hover) {
    .floating-cta-group:hover + .floating-cta-group--twin {
      background-color: var(--color-surface-accent);
      color: #fff;
    }
    .floating-cta-group:has(.floating-cta:hover) + .floating-cta-group--twin .floating-cta__hint,
    .floating-cta-group:has(.floating-cta:focus-visible) + .floating-cta-group--twin .floating-cta__hint {
      opacity: 1;
      translate: 0 0;
    }
  }
  .floating-cta-group:has(:is(.floating-cta, .floating-cta-top):active) + .floating-cta-group--twin {
    translate: 2px calc(2px - var(--tds-bottom-lane, 0px));
    box-shadow: var(--tds-shadow-hard-press);
  }
  @media (prefers-reduced-motion: reduce) {
    .floating-cta-group:has(:is(.floating-cta, .floating-cta-top):active) + .floating-cta-group--twin {
      translate: 0 calc(-1 * var(--tds-bottom-lane, 0px));
    }
  }

  /* Touch: the page keeps clear of the pill at the end of the document. */
  @media (hover: none) {
    :global(body) {
      padding-bottom: calc(4.75rem + env(safe-area-inset-bottom, 0px));
    }
  }

  @keyframes floating-cta-ring {
    0%,
    100% {
      transform: rotate(0);
    }
    20% {
      transform: rotate(-14deg);
    }
    40% {
      transform: rotate(12deg);
    }
    60% {
      transform: rotate(-8deg);
    }
    80% {
      transform: rotate(4deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tree-slot,
    .floating-cta-group {
      transition: none;
    }
    .floating-cta__icon {
      animation: none !important;
    }
    .floating-cta-group:has(:is(.floating-cta, .floating-cta-top):active) {
      translate: 0 calc(-1 * var(--tds-bottom-lane, 0px));
    }
  }
</style>

<script>
  import { makeTwin, measureDarkRanges, splitClip, type Range } from "~/lib/darkSplit";

  const group = document.querySelector<HTMLElement>(".floating-cta-group");
  const topBtn = group?.querySelector<HTMLElement>(".floating-cta-top");

  if (group) {
    /**
     * The inverted twin (see the CSS and `lib/darkSplit.ts`): laid exactly
     * over the pill and clipped, with the original, at the line of every dark
     * band — the colour changes AT the section edge, part of the pill already
     * white while the rest is still navy.
     */
    const twin = makeTwin(group, "floating-cta-group--twin");
    group.after(twin);
    const twinA11y = twin.querySelector<HTMLElement>(".a11y-toggle");
    const a11y = group.querySelector<HTMLElement>(".a11y-toggle");
    // Mirror the states that change the pill's layout, so both fold alike.
    const mirror = () => {
      for (const key of ["suppressed", "scrolledDown"] as const) {
        const value = group.dataset[key];
        if (value === undefined) delete twin.dataset[key];
        else if (twin.dataset[key] !== value) twin.dataset[key] = value;
      }
      if (twinA11y && a11y) twinA11y.hidden = a11y.hidden;
    };
    new MutationObserver(mirror).observe(group, { attributes: true, subtree: true, attributeFilter: ["data-suppressed", "data-scrolled-down", "hidden"] });

    /** Dark bands in page coordinates; measured, never read per frame. */
    let darkRanges: Range[] = [];
    /** The pill's box in the viewport — fixed, so it moves only on resize. */
    let box = { top: 0, bottom: 0 };

    const measure = () => {
      darkRanges = measureDarkRanges();
      const rect = group.getBoundingClientRect();
      box = { top: rect.top, bottom: rect.bottom };
    };

    // In dark mode every ground is dark, so the twin covers the whole pill.
    const documentIsDark = () =>
      document.documentElement.getAttribute("data-theme") === "dark";

    let frame = 0;
    // Compare before writing: a data-attribute write invalidates style for
    // the whole control, sixty times a second.
    const setFlag = (key: "scrolledDown" | "suppressed", on: boolean) => {
      const value = on ? "true" : "false";
      if (group.dataset[key] !== value) group.dataset[key] = value;
    };

    let lastTwin = "";
    let lastOriginal = "";
    const update = () => {
      frame = 0;
      // Fold out "Nach oben" after ~one viewport of scroll.
      setFlag("scrolledDown", window.scrollY > window.innerHeight * 0.8);

      // Pure arithmetic from here down — no layout is read during a scroll.
      const y = window.scrollY;
      const clip = splitClip(y + box.top, y + box.bottom, darkRanges, documentIsDark());
      if (clip.twin !== lastTwin) twin.style.clipPath = lastTwin = clip.twin;
      if (clip.original !== lastOriginal) group.style.clipPath = lastOriginal = clip.original;
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    const remeasure = () => {
      measure();
      update();
    };

    measure();
    update();
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", remeasure);
    // The pill grows and shrinks as its slots fold: follow its box.
    new ResizeObserver(remeasure).observe(group);

    /**
     * Fold the trunk away while the page already shows the same action: the
     * hero while it still reaches into the upper half of the viewport, the
     * contact section as soon as any of it is visible. No IntersectionObserver
     * (or neither section on this page) means nothing to wait for.
     */
    const hero = document.getElementById("hero");
    const contact = document.getElementById("contact");
    if ((hero || contact) && "IntersectionObserver" in window) {
      const onScreen = new Set<Element>();
      const record = (entries: IntersectionObserverEntry[]) => {
        for (const entry of entries) {
          if (entry.isIntersecting) onScreen.add(entry.target);
          else onScreen.delete(entry.target);
        }
        setFlag("suppressed", onScreen.size > 0);
      };
      if (hero) {
        new IntersectionObserver(record, { rootMargin: "0px 0px -50% 0px" }).observe(hero);
      }
      if (contact) {
        new IntersectionObserver(record).observe(contact);
      }
    } else {
      setFlag("suppressed", false);
    }

    // Anything that changes the page's height moves every range below it.
    new ResizeObserver(remeasure).observe(document.documentElement);

    // Re-evaluate when the colour theme flips.
    new MutationObserver(update).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });

    topBtn?.addEventListener("click", () => {
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const bounceScroll = (window as unknown as {
        tdsScrollTo?: (target: number, opts?: { immediate?: boolean }) => void;
      }).tdsScrollTo;
      if (bounceScroll) {
        bounceScroll(0, { immediate: reduce });
      } else {
        window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      }
    });
  }
</script>
