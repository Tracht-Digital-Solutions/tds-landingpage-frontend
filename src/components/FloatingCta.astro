---
import { resolveLang, localizePath } from "~/lib/i18n";
import A11yTools from "~/components/A11yTools.astro";

/**
 * Persistent bottom-corner control — a small TREE since 2026-09-22.
 *
 * - **The trunk** is a round button with a telephone receiver. It leads to
 *   the contact FORM (`/#contact`) and nowhere else — no `tel:` link, no
 *   menu. Its accessible name says so, because the receiver alone could be
 *   read as "call". It replaced the calendar pill labelled "Erstgespräch
 *   vereinbaren" and, on touch, the full-width bar.
 * - **Two branches** sit above it: the accessibility tools and "Nach oben"
 *   (which grows out of the stem once the visitor has scrolled about a
 *   viewport). Each branch hangs from a NECK — its `::after`, drawn in its own
 *   background colour — reaching down behind the element under it, so the
 *   three read as one shape.
 * - **It spreads out** when the pointer comes near, on hover and on keyboard
 *   focus inside it: the branches move apart and the necks stretch with them.
 *   One unitless custom property, `--tree-spread` (0 → 1), drives every part,
 *   so they can never disagree. CSS transitions it (it is a registered
 *   `@property`); with Motion running, `lib/motion/floatingCta.ts` drives it
 *   on a spring instead.
 * - **One colour.** Hovering any part turns every part bordeaux; over a dark
 *   ground every part turns white.
 * - **The trunk stands down** over the hero and the contact section (one
 *   primary action per view — see the rules below) and comes back with a
 *   Motion spring. The two branches are NOT part of that: the accessibility
 *   tools stay reachable on every screen, and "Nach oben" follows the scroll.
 */
const lang = resolveLang(Astro.currentLocale);
const home = localizePath("/", lang);
const href = `${home === "/" ? "" : home.replace(/\/$/, "")}/#contact`;
const label = lang === "de" ? "Zum Kontaktformular" : "Go to the contact form";
const hint = lang === "de" ? "Kontakt" : "Contact";
const topLabel = lang === "en" ? "Back to top" : "Nach oben";
// A landmark of its own: it floats outside `<main>` and the footer, and axe
// reported it as content outside every region (`region`).
const regionLabel = lang === "en" ? "Quick access" : "Schnellzugriff";
---

{/* No `data-suppressed` in the markup on purpose — see the rules below: on a
    page with a hero the trunk starts hidden until the script has measured
    that the hero is gone, so it never flashes over the hero's own button. */}
<aside
  class="floating-cta-group"
  aria-label={regionLabel}
  data-scrolled-down="false"
  data-near="false"
  data-on-dark="false"
>
  <button type="button" class="floating-cta-top" aria-label={topLabel}>
    <svg
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="floating-cta-top__icon"
    >
      <line x1="12" y1="19" x2="12" y2="5" />
      <polyline points="5 12 12 5 19 12" />
    </svg>
  </button>

  {/* Accessibility tools (2026-09-21). They stay reachable while the trunk
      below stands down over the hero and the form — see the rules below. */}
  <A11yTools />

  <a href={href} class="floating-cta" aria-label={label}>
    {/* The telephone receiver. */}
    <svg
      aria-hidden="true"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.9"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="floating-cta__icon"
    >
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
    </svg>
    {/* A visible word on hover for a mouse; the accessible name is the
        label above, so this one is hidden from assistive tech. */}
    <span aria-hidden="true" class="floating-cta__hint">{hint}</span>
  </a>
</aside>

<style>
  /* The spread of the tree, 0 (resting) → 1 (spread out). Registered so a
     CSS transition can interpolate it; Motion animates the same property. */
  @property --tree-spread {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  /* Positioning wrapper only — no background of its own. */
  .floating-cta-group {
    /* Geometry of the tree. The neck of a branch reaches from its lower edge
       across the gap and `--tree-overlap` behind the element below it. */
    --tree-gap: 0.5rem;
    --tree-overlap: 0.5rem;
    /* How much further apart the parts move when the tree spreads. */
    --tree-reach: 0.625rem;
    --tree-branch: 2.75rem;
    --tree-trunk: 3.5rem;

    position: fixed;
    right: 1rem;
    /* Stack above whatever else already occupies this corner, rather than
       underneath it. Two lanes, both published by tds-shared components that
       measure themselves (the same mechanism the toast stack has always used):

       - `--tds-right-lane` is the live-chat launcher's height. That widget is
         fixed in THIS corner at `z-index: 95` — twelve layers above this
         control — so with it switched on for the landingpage it covered the
         CTA completely.
       - `--tds-bottom-lane` is the cookie notice's height. That notice spans
         the FULL width on a phone, so it occupies this corner too.

       Both fall back to `0px`. `env()` last — it clears the home indicator on
       a notched phone and resolves to 0px everywhere else. */
    bottom: calc(
      var(--tds-right-lane, 0px) + 1rem +
        env(safe-area-inset-bottom, 0px)
    );
    /* The cookie notice's lane moves the group with `translate`, not with
       `bottom`: the notice appears after the first paint, and a change of
       `bottom` is a layout shift — measured 0.033 CLS on a phone once the
       accessibility button made the group visible over the hero. A transform
       is not. `translate` is its own property, so the hover lift on
       `transform` still composes with it. */
    translate: 0 calc(-1 * var(--tds-bottom-lane, 0px));
    /* The group is only a positioning box. Since the trunk stands down
       individually (the branches stay), the box itself stays on screen — and
       without this it swallowed clicks on whatever lay under its invisible
       area (measured: the footer's "Cookie-Einstellungen"). Only the children
       take pointer events; the suppression rules switch them off. */
    pointer-events: none;
    z-index: 35;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--tree-gap);
    transition:
      transform 220ms var(--lp-ease-soft),
      translate 300ms var(--tds-ease-out),
      --tree-spread 520ms var(--lp-ease-bounce, var(--tds-ease-out));
  }
  @media (min-width: 768px) {
    .floating-cta-group {
      right: 1.5rem;
      bottom: calc(
        var(--tds-right-lane, 0px) + 1.5rem +
          env(safe-area-inset-bottom, 0px)
      );
    }
  }

  .floating-cta-group > :global(*) {
    pointer-events: auto;
  }

  /* --- Spread ------------------------------------------------------- */

  /* Pointer near, pointer on it, or keyboard focus inside: spread out. With
     Motion running the property is written inline on a spring, and this rule
     only matters as the resting fallback. */
  .floating-cta-group[data-near="true"],
  .floating-cta-group:hover,
  .floating-cta-group:focus-within {
    --tree-spread: 1;
  }
  :global(:root[data-motion="on"]) .floating-cta-group {
    transition:
      transform 220ms var(--lp-ease-soft),
      translate 300ms var(--tds-ease-out);
  }

  /* Each branch moves up by its distance from the trunk. `translate`, so the
     transforms written by Motion and the hover rules stay free. */
  .floating-cta-group > :global(.a11y-toggle) {
    translate: 0 calc(var(--tree-spread) * -1 * var(--tree-reach));
  }
  .floating-cta-top {
    translate: 0 calc(var(--tree-spread) * -2 * var(--tree-reach));
  }

  /* The neck: a narrower stem hanging from a branch down behind the element
     under it. Same colour as its branch (`inherit`), so it follows every
     state. It stretches by exactly the distance the branches move apart:
     rest length gap + overlap, spread length that plus the reach. */
  .floating-cta-top::after,
  .floating-cta-group > :global(.a11y-toggle)::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 100%;
    width: 1.1rem;
    height: calc(var(--tree-gap) + var(--tree-overlap));
    margin-left: -0.55rem;
    background-color: inherit;
    border-radius: 0 0 0.6rem 0.6rem;
    transform-origin: top center;
    transform: scaleY(
      calc(1 + var(--tree-spread) * 0.625)
    );
    z-index: -1;
    pointer-events: none;
  }
  /* The a11y branch's neck joins the trunk; while the trunk stands down it
     has nothing to join and folds up. */
  .floating-cta-group[data-suppressed="true"] > :global(.a11y-toggle)::after,
  :global(body:has(#hero)) .floating-cta-group:not([data-suppressed]) > :global(.a11y-toggle)::after {
    transform: scaleY(0);
  }
  .floating-cta-group > :global(.a11y-toggle)::after {
    transition: transform 280ms var(--tds-ease-out);
  }

  /* --- Out of the way ------------------------------------------------- */

  /* ONE primary call to action per view. The trunk repeats the hero's button
     and the contact form's purpose, so it stands down while either of them
     is on screen (the script below writes `data-suppressed`).

     Two states needed CSS on top of that:

     - BEFORE the script has run. On a page with a hero the trunk starts
       hidden, rather than appearing over the hero's own button and vanishing
       a moment later. A page without a hero (a service page) has nothing to
       wait for and shows it straight away.
     - SHORT screens with the cookie notice open. Header, notice and this
       button together covered most of a 320×568 phone. Until the notice is
       dismissed, the trunk waits.

     The branches are not in these rules: `:not(.a11y-toggle)` keeps the
     accessibility tools reachable on the first screen, and "Nach oben" has
     its own scroll rule below. */
  .floating-cta-group[data-suppressed="true"] > .floating-cta,
  :global(body:has(#hero)) .floating-cta-group:not([data-suppressed]) > .floating-cta {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  @media (max-height: 44rem) {
    :global(:root:has(.cookie-notice)) .floating-cta-group > :global(:not(.a11y-toggle):not(.a11y-panel)) {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }
  /* With Motion running, the trunk's opacity and scale are Motion's spring
     (lib/motion/floatingCta.ts); CSS only withholds `visibility` until the
     exit has played, so the trunk does not vanish before it has shrunk. */
  :global(:root[data-motion="on"]) .floating-cta {
    transition:
      background-color 220ms ease,
      color 220ms ease,
      box-shadow 220ms ease,
      visibility 0s linear 0s;
  }
  :global(:root[data-motion="on"]) .floating-cta-group[data-suppressed="true"] > .floating-cta {
    transition:
      background-color 220ms ease,
      color 220ms ease,
      box-shadow 220ms ease,
      visibility 0s linear 360ms;
  }

  /* The height this control reserves at the bottom edge, for
     `scroll-padding-bottom` in global.css: a focused link must scroll above
     it, not behind it. Published here because only this component knows its
     own geometry, and cleared while the trunk is out of the way. */
  :global(:root) {
    --lp-floating-lane: 4.5rem;
  }
  @media (min-width: 768px) {
    :global(:root) {
      --lp-floating-lane: 5rem;
    }
  }
  :global(:root:has(.floating-cta-group[data-suppressed="true"])) {
    --lp-floating-lane: 0px;
  }
  /* Short screens hide the trunk while the cookie notice is open (above), so
     nothing may reserve its lane either. */
  @media (max-height: 44rem) {
    :global(:root:has(.cookie-notice)) {
      --lp-floating-lane: 0px;
    }
  }

  /* --- "Nach oben" (upper branch) ---------------------------------- */
  .floating-cta-top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tree-branch);
    height: var(--tree-branch);
    padding: 0;
    border: none;
    border-radius: 9999px;
    color: #fff;
    background-color: var(--color-surface-navy);
    cursor: pointer;
    /* Collapsed: folded down into the branch below, invisible and
       click-through, until the visitor has scrolled about a viewport. */
    opacity: 0;
    transform: translateY(1.5rem) scale(0.3);
    transform-origin: center bottom;
    pointer-events: none;
    transition:
      opacity 220ms ease,
      transform 420ms var(--lp-ease-bounce),
      background-color 220ms ease,
      color 220ms ease;
  }
  .floating-cta-group[data-scrolled-down="true"] .floating-cta-top {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }
  .floating-cta-top__icon {
    transition: transform 220ms ease;
  }
  .floating-cta-top:focus-visible,
  .floating-cta:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* --- Trunk: the receiver ------------------------------------------- */
  .floating-cta {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tree-trunk);
    height: var(--tree-trunk);
    color: #fff;
    background-color: var(--color-surface-navy);
    border-radius: 9999px;
    box-shadow:
      0 14px 34px -12px rgba(5, 15, 104, 0.55),
      0 4px 10px -4px rgba(5, 15, 104, 0.3);
    cursor: pointer;
    transition:
      background-color 220ms ease,
      color 220ms ease,
      box-shadow 220ms ease;
  }
  .floating-cta__icon {
    transition: transform 220ms ease;
    transform-origin: 60% 40%;
  }
  /* The word beside the trunk, sliding out to the left on hover. */
  .floating-cta__hint {
    position: absolute;
    right: calc(100% + 0.625rem);
    top: 50%;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    background: inherit;
    color: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    translate: 0.5rem -50%;
    pointer-events: none;
    transition:
      opacity 200ms var(--tds-ease-out),
      translate 320ms var(--lp-ease-bounce, var(--tds-ease-out));
  }

  /* --- Hover states, fine pointers only ----------------------------- */

  /* All of this is behind `(hover: hover)` on purpose. `:hover` on a touch
     screen is a STICKY state: the browser applies it on tap and leaves it
     applied until the next tap elsewhere. */
  @media (hover: hover) {
    .floating-cta-top:hover .floating-cta-top__icon {
      transform: translateY(-2px);
    }
    .floating-cta:hover .floating-cta__icon {
      /* The receiver rings: a short wobble. */
      animation: floating-cta-ring 520ms ease-in-out;
    }
    .floating-cta:hover .floating-cta__hint,
    .floating-cta:focus-visible .floating-cta__hint {
      opacity: 1;
      translate: 0 -50%;
    }

    /* Hover ANY part: the whole tree lifts and warms to bordeaux with white
       text — in the navy and in the inverted state (the :has selector
       out-specifies the [data-on-dark] rules). Every part recolours, necks
       included, so the fused shape stays one colour. */
    :global(.floating-cta-group:has(> :is(.floating-cta, .floating-cta-top, .a11y-toggle):hover)) {
      transform: translateY(-2px);
    }
    :global(.floating-cta-group:has(> :is(.floating-cta, .floating-cta-top, .a11y-toggle):hover)
      > :is(.floating-cta, .floating-cta-top, .a11y-toggle)) {
      background-color: var(--color-surface-accent);
      color: #fff;
    }
    :global(.floating-cta-group:has(> :is(.floating-cta, .floating-cta-top, .a11y-toggle):hover) > .floating-cta) {
      box-shadow:
        0 22px 48px -14px rgba(5, 15, 104, 0.55),
        0 8px 18px -6px rgba(5, 15, 104, 0.4);
    }
  }

  /* Over a dark section every part flips to white (toggled in script). */
  :global(.floating-cta-group[data-on-dark="true"] > :is(.floating-cta, .floating-cta-top, .a11y-toggle)) {
    background-color: #fff;
    color: var(--color-surface-navy);
  }
  .floating-cta-group[data-on-dark="true"] > .floating-cta {
    box-shadow:
      0 14px 34px -12px rgba(0, 0, 0, 0.45),
      0 4px 10px -4px rgba(0, 0, 0, 0.3);
  }

  /* --- Touch --------------------------------------------------------- */

  /* A thumb does not approach, it arrives: no spread, and the page keeps
     clear of the round trunk at the end of the document. */
  @media (hover: none) {
    .floating-cta-group {
      --tree-trunk: 3.5rem;
    }
    :global(body) {
      padding-bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
    }
  }

  @keyframes floating-cta-ring {
    0%,
    100% {
      transform: rotate(0);
    }
    20% {
      transform: rotate(-14deg);
    }
    40% {
      transform: rotate(12deg);
    }
    60% {
      transform: rotate(-8deg);
    }
    80% {
      transform: rotate(4deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-cta-group {
      transition: none;
    }
    .floating-cta__icon {
      animation: none !important;
    }
    .floating-cta-top {
      transition:
        opacity 200ms ease,
        background-color 220ms ease,
        color 220ms ease;
      transform: none;
    }
    :global(.floating-cta-group:has(> :is(.floating-cta, .floating-cta-top, .a11y-toggle):hover)) {
      transform: none;
    }
  }
</style>

<script>
  const group = document.querySelector<HTMLElement>(".floating-cta-group");
  const topBtn = group?.querySelector<HTMLElement>(".floating-cta-top");

  if (group) {
    /**
     * Which parts of the DOCUMENT are a dark ground, in absolute page
     * coordinates, measured once and re-measured only when the page's own
     * geometry changes — never per scroll frame (that was the largest source
     * of scroll jank on a phone).
     *
     * The dark grounds are the two shared tone primitives — `.tds-tone-navy`
     * and `.tds-tone-ink` (the footer). Those are CLASSES, so unlike a sampled
     * colour they do not change with the theme.
     */
    let darkRanges: Array<[number, number]> = [];

    /** The control's own centre, as a distance up from the viewport bottom. */
    let anchorFromBottom = 0;

    const trunk = group.querySelector<HTMLElement>(".floating-cta");
    const measure = () => {
      const offset = window.scrollY;
      darkRanges = Array.from(
        document.querySelectorAll<HTMLElement>(".tds-tone-navy, .tds-tone-ink"),
      ).map((element) => {
        const rect = element.getBoundingClientRect();
        return [rect.top + offset, rect.bottom + offset] as [number, number];
      });

      // The trunk is the lowest, largest part; its centre decides the colour.
      const rect = (trunk ?? group).getBoundingClientRect();
      anchorFromBottom = window.innerHeight - (rect.top + rect.height / 2);
    };

    // In dark mode every ground is dark, so the inverted (white) control is
    // correct everywhere and the ranges do not need consulting at all.
    const documentIsDark = () =>
      document.documentElement.getAttribute("data-theme") === "dark";

    let frame = 0;
    // Compare before writing: a data-attribute write invalidates style for
    // the whole control (several `:has()` rules), sixty times a second.
    const setFlag = (key: "scrolledDown" | "onDark" | "suppressed", on: boolean) => {
      const value = on ? "true" : "false";
      if (group.dataset[key] !== value) group.dataset[key] = value;
    };

    const update = () => {
      frame = 0;
      // Grow the "Nach oben" branch after ~one viewport of scroll.
      setFlag("scrolledDown", window.scrollY > window.innerHeight * 0.8);

      // Pure arithmetic from here down — no layout is read during a scroll.
      const centre = window.scrollY + window.innerHeight - anchorFromBottom;
      setFlag(
        "onDark",
        documentIsDark() ||
          darkRanges.some(([top, bottom]) => centre >= top && centre <= bottom),
      );
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    const remeasure = () => {
      measure();
      update();
    };

    measure();
    update();
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", remeasure);

    /**
     * Stand down while the page already shows the same action.
     *
     * The hero counts as "on screen" while it still reaches into the upper
     * half of the viewport. The contact section counts as soon as any of it
     * is visible: the form IS the destination.
     *
     * No IntersectionObserver (or no hero and no contact section on this page)
     * means nothing to wait for, so the trunk simply shows.
     */
    const hero = document.getElementById("hero");
    const contact = document.getElementById("contact");
    if ((hero || contact) && "IntersectionObserver" in window) {
      const onScreen = new Set<Element>();
      const record = (entries: IntersectionObserverEntry[]) => {
        for (const entry of entries) {
          if (entry.isIntersecting) onScreen.add(entry.target);
          else onScreen.delete(entry.target);
        }
        setFlag("suppressed", onScreen.size > 0);
      };
      if (hero) {
        new IntersectionObserver(record, { rootMargin: "0px 0px -50% 0px" }).observe(hero);
      }
      if (contact) {
        new IntersectionObserver(record).observe(contact);
      }
    } else {
      setFlag("suppressed", false);
    }

    // Anything that changes the page's height moves every range below it.
    new ResizeObserver(remeasure).observe(document.documentElement);

    // Re-evaluate when the colour theme flips.
    new MutationObserver(update).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });

    // Proximity: as the pointer nears the control, the tree spreads out.
    // Hover-capable pointers only — touch has no "near" state.
    if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      const NEAR = 120;
      let near = false;
      let px = 0;
      let py = 0;
      let pframe = 0;
      const evalNear = () => {
        pframe = 0;
        const r = group.getBoundingClientRect();
        const dx = Math.max(r.left - px, 0, px - r.right);
        const dy = Math.max(r.top - py, 0, py - r.bottom);
        const next = Math.hypot(dx, dy) < NEAR;
        if (next !== near) {
          near = next;
          group.dataset.near = next ? "true" : "false";
        }
      };
      window.addEventListener(
        "pointermove",
        (event) => {
          px = event.clientX;
          py = event.clientY;
          if (!pframe) pframe = requestAnimationFrame(evalNear);
        },
        { passive: true },
      );
    }

    topBtn?.addEventListener("click", () => {
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const bounceScroll = (window as unknown as {
        tdsScrollTo?: (target: number, opts?: { immediate?: boolean }) => void;
      }).tdsScrollTo;
      if (bounceScroll) {
        bounceScroll(0, { immediate: reduce });
      } else {
        window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      }
    });
  }
</script>
