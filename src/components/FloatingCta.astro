---
import { tFor, resolveLang, localizePath } from "~/lib/i18n";

/**
 * Persistent "book a call" CTA that hovers in the bottom-right corner
 * on every page. Links to the contact section on the homepage (the
 * sections only exist there, so from a subpage it navigates home then
 * scrolls). Idle bob + hover lift give it a bit of life; both are
 * dropped under prefers-reduced-motion.
 */
const lang = resolveLang(Astro.currentLocale);
const t = tFor(Astro.currentLocale);

const home = localizePath("/", lang);
const href = `${home === "/" ? "" : home.replace(/\/$/, "")}/#contact`;
const label = t.nav.cta;
---

<a href={href} class="floating-cta group" aria-label={label}>
  <svg
    aria-hidden="true"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="floating-cta__icon"
  >
    <rect x="3" y="4" width="18" height="18" rx="2" />
    <line x1="16" y1="2" x2="16" y2="6" />
    <line x1="8" y1="2" x2="8" y2="6" />
    <line x1="3" y1="10" x2="21" y2="10" />
  </svg>
  <span class="floating-cta__label">{label}</span>
</a>

<style>
  .floating-cta {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 35;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    /* Phones: collapse to a compact icon-only circle so the persistent
       CTA doesn't eat half the viewport width or crowd the bottom edge.
       The aria-label still announces the action. Equal padding around
       the 18px icon keeps it a clean circle under border-radius. */
    padding: 0.85rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: #fff;
    background-color: var(--color-surface-navy);
    box-shadow:
      0 14px 34px -12px rgba(5, 15, 104, 0.55),
      0 4px 10px -4px rgba(5, 15, 104, 0.3);
    transition:
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 220ms ease,
      color 220ms ease,
      box-shadow 220ms ease;
    animation: floating-cta-in 500ms cubic-bezier(0.22, 1, 0.36, 1) 600ms both;
  }

  /* When the button floats over a section whose background is the same
     navy as the button itself (Tech, Contact), it disappears into the
     section. Flip it to a white pill with navy text so it stays legible.
     `data-on-dark` is toggled from the script below as the user scrolls. */
  .floating-cta[data-on-dark="true"] {
    background-color: #fff;
    color: var(--color-surface-navy);
    box-shadow:
      0 14px 34px -12px rgba(0, 0, 0, 0.45),
      0 4px 10px -4px rgba(0, 0, 0, 0.3);
  }

  .floating-cta__label {
    display: none;
  }

  /* Small screens and up: expand into the full labelled pill. */
  @media (min-width: 640px) {
    .floating-cta {
      padding: 0.85rem 1.25rem;
    }
    .floating-cta__label {
      display: inline;
    }
  }

  @media (min-width: 768px) {
    .floating-cta {
      right: 1.5rem;
      bottom: 1.5rem;
    }
  }

  /* Idle bob so the button reads as "hovering". Layered after the
     entrance via a second animation on the inner icon keeps the
     entrance and the loop from fighting over `transform`. */
  .floating-cta__icon {
    transition: transform 220ms ease;
    animation: floating-cta-bob 3s ease-in-out 1.2s infinite;
  }

  .floating-cta:hover {
    transform: translateY(-3px);
    background-color: var(--color-surface-accent);
    box-shadow:
      0 22px 48px -14px rgba(5, 15, 104, 0.6),
      0 8px 18px -6px rgba(5, 15, 104, 0.35);
  }
  .floating-cta:active {
    transform: translateY(-1px) scale(0.98);
  }
  .floating-cta:hover .floating-cta__icon {
    transform: scale(1.1) rotate(-6deg);
  }

  /* Inverted hover: stay white, shift the text/icon to the burgundy
     accent instead of the navy→burgundy fill that would blend back in. */
  .floating-cta[data-on-dark="true"]:hover {
    background-color: #fff;
    color: var(--color-surface-accent);
    box-shadow:
      0 22px 48px -14px rgba(0, 0, 0, 0.5),
      0 8px 18px -6px rgba(0, 0, 0, 0.35);
  }

  @keyframes floating-cta-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.92);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes floating-cta-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-cta,
    .floating-cta__icon {
      animation: none;
    }
    .floating-cta {
      transition:
        background-color 220ms ease,
        color 220ms ease;
    }
    .floating-cta:hover {
      transform: none;
    }
  }
</style>

<script>
  // Invert the floating CTA to a white pill whenever it overlaps a section
  // whose background is the same navy as the button (Tech, Contact) —
  // otherwise it disappears into the section. Those sections are tagged by
  // their `bg-[var(--color-surface-navy)]` class, so we match on it rather
  // than hard-coding ids. rAF-throttled on scroll/resize.
  const cta = document.querySelector<HTMLElement>(".floating-cta");
  const darkSections = Array.from(
    document.querySelectorAll<HTMLElement>('section[class*="surface-navy"]'),
  );

  if (cta && darkSections.length) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const rect = cta.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const onDark = darkSections.some((section) => {
        const r = section.getBoundingClientRect();
        return y >= r.top && y <= r.bottom && x >= r.left && x <= r.right;
      });
      cta.dataset.onDark = onDark ? "true" : "false";
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
  }
</script>
