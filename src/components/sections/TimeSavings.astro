---
/**
 * Zeitersparnis: a short questionnaire about one recurring task.
 *
 * Three questions with fixed answers (native radios inside their labels, no
 * number fields, nothing numbered). Once all three are answered, the plain script below shows
 * the estimate and hands the answers to the contact form as a draft
 * (`lib/contactDraft.ts`). It sends nothing. Without JavaScript the questions
 * stay usable and the button still leads to the contact form.
 *
 * Questions, answer values and copy live in `lib/savingsCalculator.ts`. No
 * measured figure, no promise: the note calls the result a rough estimate.
 */
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { localizePath, resolveLang } from "~/lib/i18n";
import { SAVINGS_QUESTIONS, getSavingsCopy } from "~/lib/savingsCalculator";

const lang = resolveLang(Astro.currentLocale);
const copy = getSavingsCopy(lang);
const contactHref = `${localizePath("/", lang)}#contact`;

/** One brand colour and one icon per question; nothing is numbered. */
const TONES: Record<string, string> = { minutes: "coral", perWeek: "gold", share: "periwinkle" };
const ICONS: Record<string, string> = {
  // A clock: how long.
  minutes: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  // A repeat: how often.
  perWeek: '<path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>',
  // Stacked layers: how much is routine.
  share: '<path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/>',
};
---

<section id="savings" class="section-spacing" aria-labelledby="savings-heading">
  <div class="lp-container">
    <SectionHeader
      headline={copy.headline}
      headlineAccent={copy.headlineAccent}
      id="savings-heading"
      headingClass="mb-10 md:mb-12"
    />

    {/* Redesigned 2026-11-03 (asked for): no lead sentence, no numbers. Each
        question carries an icon in one of the brand colours; an unanswered
        option is pressed into the navy like the contact form's fields, the
        chosen one is FILLED in its question's colour. The result plate is
        bordeaux, so the card holds the whole brand palette. */}
    <div class="savings-card" data-reveal>
      <form class="savings-form" data-savings data-lang={lang} data-draft={copy.draft}>
        {
          SAVINGS_QUESTIONS.map((question) => (
            <fieldset class="savings-question" data-tone={TONES[question.id]}>
              <legend>
                <span class="savings-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[question.id]} />
                </span>
                {question.question[lang]}
              </legend>
              <div class="savings-answers">
                {question.answers.map((answer) => (
                  <label class="savings-answer">
                    <input type="radio" name={question.id} value={answer.value} />
                    <span>{answer.label[lang]}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))
        }
      </form>

      <div class="savings-result" aria-live="polite">
        <p class="savings-pending" data-savings-pending>{copy.pending}</p>
        <div class="savings-figures" data-savings-figures hidden>
          <p class="savings-figure savings-figure--year">
            <span class="savings-prefix">{copy.resultPrefix}</span>
            <output data-savings-result="year"></output>
            <span>{copy.year}</span>
          </p>
          <p class="savings-figure">
            <output data-savings-result="days"></output>
            <span>{copy.days}</span>
          </p>
        </div>
        <p class="savings-small">{copy.note}</p>
        <a href={contactHref} class="savings-cta" data-cta data-savings-cta data-track="savings-first-call">
          {copy.cta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .savings-card {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-radius: 6px;
    background: var(--color-surface-navy);
    color: #fff;
    box-shadow: 8px 8px 0 0 var(--color-accent-pink);
  }
  @media (min-width: 64rem) {
    .savings-card {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 3rem);
    }
  }

  .savings-form {
    display: grid;
    gap: 1.5rem;
  }
  /* Each question's colour: coral, gold and periwinkle, all light enough for
     navy type when filled. Fixed values: the card is fixed navy in both themes. */
  .savings-question {
    --savings-tone: #ff7a9c;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .savings-question[data-tone="gold"] {
    --savings-tone: #f5c04a;
  }
  .savings-question[data-tone="periwinkle"] {
    --savings-tone: #b9c3ff;
  }
  .savings-question legend {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    padding: 0;
    font-size: 1.0625rem;
    font-weight: 700;
  }
  .savings-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background: var(--savings-tone);
    color: #050f68;
  }
  .savings-answers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  .savings-answer {
    position: relative;
    display: inline-flex;
  }
  .savings-answer input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  /* Unchosen: pressed into the navy, the same well as the contact form's
     fields. Chosen: filled in the question's colour, no inset. */
  .savings-answer span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1.125rem;
    border-radius: 100px;
    background: rgb(0 0 0 / 0.2);
    box-shadow: inset 2px 2px 0 0 rgb(0 0 0 / 0.32);
    color: rgb(255 255 255 / 0.88);
    font-size: 0.9375rem;
    font-weight: 600;
    transition:
      background-color 160ms var(--tds-ease-out),
      color 160ms var(--tds-ease-out);
  }
  .savings-answer:hover span {
    background: rgb(0 0 0 / 0.3);
    color: #fff;
  }
  .savings-answer input:checked + span {
    background: var(--savings-tone);
    box-shadow: none;
    color: #050f68;
  }
  .savings-answer input:focus-visible + span {
    outline: 2px solid var(--savings-tone);
    outline-offset: 3px;
  }

  /* The result plate: bordeaux in both themes, on the fixed navy. */
  .savings-result {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.875rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border-radius: 6px;
    background: #820933;
    color: #fff;
  }
  .savings-pending {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    color: #fff;
  }
  .savings-figures {
    display: grid;
    gap: 0.5rem;
  }
  .savings-figure {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.625rem;
    margin: 0;
    font-weight: 600;
  }
  .savings-figure output {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #f5c04a;
    font-variant-numeric: tabular-nums;
  }
  .savings-figure--year output {
    font-size: clamp(3rem, 7vw, 4.5rem);
    color: #ffa6c0;
  }
  .savings-small {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgb(255 255 255 / 0.8);
  }
  .savings-cta {
    --lp-fill: var(--color-accent-pink);
    --lp-shade: initial;
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin-top: 0.25rem;
    padding: 0.75rem 1.75rem;
    border-radius: 100px;
    background: var(--lp-fill);
    color: #050f68;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 200ms var(--tds-ease-out);
  }
  .savings-cta:hover {
    --lp-fill: #fff;
  }
  .savings-cta:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
</style>

<script>
  import { handOffContactDraft } from "~/lib/contactDraft";
  import { formatSavings, savings, savingsDraft, type SavingsInput } from "~/lib/savingsCalculator";

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-savings]")) {
    const section = form.closest("section");
    const lang = form.dataset.lang === "en" ? "en" : "de";
    const read = (): SavingsInput | null => {
      const data = new FormData(form);
      const value = (name: string) => (data.has(name) ? Number(data.get(name)) : Number.NaN);
      const input = { minutes: value("minutes"), perWeek: value("perWeek"), share: value("share") };
      return Object.values(input).every(Number.isFinite) ? input : null;
    };
    const update = () => {
      const input = read();
      const figures = section?.querySelector<HTMLElement>("[data-savings-figures]");
      const pending = section?.querySelector<HTMLElement>("[data-savings-pending]");
      if (figures) figures.hidden = !input;
      if (pending) pending.hidden = !!input;
      if (!input) return;
      const result = savings(input);
      for (const key of ["year", "days"] as const) {
        const output = section?.querySelector<HTMLOutputElement>(`[data-savings-result="${key}"]`);
        if (output) output.textContent = formatSavings(result[key], lang);
      }
    };
    form.addEventListener("change", update);
    form.addEventListener("submit", (event) => event.preventDefault());
    section?.querySelector("[data-savings-cta]")?.addEventListener("click", () => {
      const input = read();
      if (input) handOffContactDraft({ message: savingsDraft(form.dataset.draft ?? "", input, lang), service: "process" });
    });
    update();
  }
</script>
