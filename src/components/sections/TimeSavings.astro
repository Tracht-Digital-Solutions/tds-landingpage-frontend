---
/**
 * Zeitersparnis: a short questionnaire about one recurring task.
 *
 * Three questions with fixed answers (native radios inside their labels, no
 * number fields, nothing numbered). Once all three are answered, the plain script below shows
 * the estimate and hands the answers to the contact form as a draft
 * (`lib/contactDraft.ts`). It sends nothing. Without JavaScript the questions
 * stay usable and the button still leads to the contact form.
 *
 * Questions, answer values and copy live in `lib/savingsCalculator.ts`. No
 * measured figure, no promise: the note calls the result a rough estimate.
 *
 * Light since 2026-11-03 (asked for: friendlier, brighter, easier to read):
 * the card is the page's card fill, each question a tinted row, and the result
 * a donut chart of the task's year: the routine slice software can take over
 * against what stays manual. The ring is drawn with `stroke-dasharray` (no
 * gradients); its numbers also stand in the legend, so nothing depends on
 * telling two colours apart.
 */
import Arrow from "~/components/ui/Arrow.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { localizePath, resolveLang } from "~/lib/i18n";
import { SAVINGS_QUESTIONS, getSavingsCopy } from "~/lib/savingsCalculator";

const lang = resolveLang(Astro.currentLocale);
const copy = getSavingsCopy(lang);
const contactHref = `${localizePath("/", lang)}#contact`;
/** Circumference of the donut ring (r = 48). */
const RING = 2 * Math.PI * 48;

/** One brand colour and one icon per question; nothing is numbered. */
const TONES: Record<string, string> = { minutes: "coral", perWeek: "gold", share: "periwinkle" };
const ICONS: Record<string, string> = {
  // A clock: how long.
  minutes: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  // A repeat: how often.
  perWeek: '<path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>',
  // Stacked layers: how much is routine.
  share: '<path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/>',
};
---

<section id="savings" class="section-spacing" aria-labelledby="savings-heading">
  <div class="lp-container">
    <SectionHeader
      headline={copy.headline}
      headlineAccent={copy.headlineAccent}
      id="savings-heading"
      headingClass="mb-10 md:mb-12"
    />

    <div class="savings-card" data-reveal>
      <form class="savings-form" data-savings data-lang={lang} data-draft={copy.draft} data-chart-label={copy.chartLabel}>
        {
          SAVINGS_QUESTIONS.map((question) => (
            <fieldset class="savings-question" data-tone={TONES[question.id]}>
              <legend>
                <span class="savings-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[question.id]} />
                </span>
                {question.question[lang]}
              </legend>
              <div class="savings-answers">
                {question.answers.map((answer) => (
                  <label class="savings-answer">
                    <input type="radio" name={question.id} value={answer.value} />
                    <span>{answer.label[lang]}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))
        }
      </form>

      <div class="savings-result" aria-live="polite">
        <div class="savings-chart-row">
          <figure class="savings-chart">
            <svg viewBox="0 0 120 120" role="img" aria-labelledby="savings-chart-label">
              <title id="savings-chart-label" data-savings-chart-label>{copy.pending}</title>
              <circle class="savings-ring savings-ring--rest" cx="60" cy="60" r="48" />
              <circle
                class="savings-ring savings-ring--saved"
                cx="60"
                cy="60"
                r="48"
                stroke-dasharray={`0 ${RING}`}
                data-ring={RING}
                data-savings-arc
              />
            </svg>
            <span class="savings-chart__centre" aria-hidden="true" data-savings-share>–</span>
          </figure>

          <div class="savings-summary">
            <p class="savings-pending" data-savings-pending>{copy.pending}</p>
            <div class="savings-figures" data-savings-figures hidden>
              <p class="savings-figure savings-figure--year">
                <span class="savings-prefix">{copy.resultPrefix}</span>
                <output data-savings-result="year"></output>
                <span>{copy.year}</span>
              </p>
              <p class="savings-figure">
                <output data-savings-result="days"></output>
                <span>{copy.days}</span>
              </p>
            </div>
          </div>
        </div>

        <dl class="savings-legend" data-savings-legend hidden>
          <div>
            <dt><span class="savings-swatch savings-swatch--saved" aria-hidden="true"></span>{copy.sliceSaved}</dt>
            <dd><output data-savings-result="year"></output> h</dd>
          </div>
          <div>
            <dt><span class="savings-swatch savings-swatch--rest" aria-hidden="true"></span>{copy.sliceRest}</dt>
            <dd><output data-savings-result="rest"></output> h</dd>
          </div>
        </dl>

        <p class="savings-small">{copy.note}</p>
        <a href={contactHref} class="savings-cta" data-cta data-savings-cta data-track="savings-first-call">
          {copy.cta}
          <span aria-hidden="true"><Arrow dir="right" /></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* The page's own card: light in the light theme, lifted in the dark one. */
  .savings-card {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-radius: 6px;
    background: var(--lp-surface-card);
    color: var(--color-black);
    box-shadow: var(--tds-shadow-hard);
  }
  /* A phone: the rows and the result plate reach almost to the card's edge,
     and the answers take a smaller pill, so two fit per line. */
  @media (max-width: 40rem) {
    .savings-card {
      gap: 1rem;
      padding: 0.625rem;
    }
    .savings-question {
      padding: 0.875rem 0.875rem 1rem;
    }
    .savings-question legend {
      font-size: 1rem;
    }
    .savings-answer span {
      padding: 0.5rem 0.875rem;
      font-size: 0.875rem;
    }
    .savings-result {
      padding: 1.125rem;
    }
    .savings-cta {
      align-self: stretch;
      justify-content: center;
      padding-inline: 1.25rem;
    }
  }
  @media (min-width: 64rem) {
    .savings-card {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 3rem);
      align-items: stretch;
    }
  }

  .savings-form {
    display: grid;
    gap: 0.875rem;
  }
  /* Each question is a tinted row in its brand colour: coral, gold,
     periwinkle. The tints mix into the card, so they follow the theme; a
     chosen answer takes the full colour with navy type in both themes. */
  .savings-question {
    --savings-tone: #ff7a9c;
    margin: 0;
    padding: 1rem 1.125rem 1.125rem;
    border: 0;
    border-radius: 6px;
    min-width: 0;
    background: color-mix(in srgb, var(--savings-tone) 14%, var(--lp-surface-card));
  }
  .savings-question[data-tone="gold"] {
    --savings-tone: #f5c04a;
  }
  .savings-question[data-tone="periwinkle"] {
    --savings-tone: #b9c3ff;
  }
  .savings-question legend {
    float: left;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    margin-bottom: 0.75rem;
    padding: 0;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-black);
  }
  .savings-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background: var(--savings-tone);
    color: #050f68;
  }
  .savings-answers {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .savings-answer {
    position: relative;
    display: inline-flex;
  }
  .savings-answer input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  /* Unchosen: a light well pressed into the row (form controls press in,
     design.md). Chosen: filled in the question's colour, no inset. */
  .savings-answer span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1.125rem;
    border-radius: 100px;
    background: var(--color-paper);
    box-shadow: var(--tds-shadow-inset);
    color: var(--color-black);
    font-size: 0.9375rem;
    font-weight: 600;
    transition:
      background-color 160ms var(--tds-ease-out),
      color 160ms var(--tds-ease-out);
  }
  .savings-answer:hover span {
    background: color-mix(in srgb, var(--savings-tone) 30%, var(--color-paper));
  }
  .savings-answer input:checked + span {
    background: var(--savings-tone);
    box-shadow: none;
    color: #050f68;
  }
  .savings-answer input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* The result: a soft rosé plate with the chart, the figures and the way on. */
  .savings-result {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-accent-pink) 12%, var(--color-paper));
  }
  .savings-chart-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .savings-chart {
    position: relative;
    flex: none;
    width: clamp(7.5rem, 22vw, 9.5rem);
    aspect-ratio: 1;
    margin: 0;
  }
  .savings-chart svg {
    display: block;
    width: 100%;
    height: 100%;
    rotate: -90deg;
  }
  .savings-ring {
    fill: none;
    stroke-width: 18;
  }
  .savings-ring--rest {
    stroke: color-mix(in srgb, var(--color-primary) 18%, var(--color-paper));
  }
  .savings-ring--saved {
    stroke: var(--color-accent);
    transition: stroke-dasharray 480ms var(--tds-ease-out);
  }
  @media (prefers-reduced-motion: reduce) {
    .savings-ring--saved {
      transition: none;
    }
  }
  .savings-chart__centre {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-black);
    font-variant-numeric: tabular-nums;
  }
  .savings-summary {
    flex: 1 1 11rem;
    min-width: 0;
  }
  .savings-pending {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-black);
  }
  .savings-figures {
    display: grid;
    gap: 0.375rem;
  }
  .savings-figure {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
    margin: 0;
    font-weight: 600;
    color: var(--color-black);
  }
  .savings-figure output {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .savings-figure--year output {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    color: var(--color-accent);
  }

  .savings-legend {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0.875rem 0 0;
    border-top: 1px solid var(--color-line);
  }
  .savings-legend[hidden] {
    display: none;
  }
  .savings-legend div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.9375rem;
  }
  .savings-legend dt {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-black);
  }
  .savings-legend dd {
    margin: 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-black);
  }
  .savings-swatch {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 9999px;
  }
  .savings-swatch--saved {
    background: var(--color-accent);
  }
  .savings-swatch--rest {
    background: color-mix(in srgb, var(--color-primary) 18%, var(--color-paper));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-primary) 35%, transparent);
  }
  .savings-small {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
  /* The site's pill CTA, like "Mehr Projekte". */
  .savings-cta {
    --lp-fill: var(--color-accent);
    --lp-shade: initial;
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin-top: 0.25rem;
    padding: 0.75rem 1.75rem;
    border-radius: 100px;
    background: var(--lp-fill);
    color: var(--color-paper);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 200ms var(--tds-ease-out);
  }
  .savings-cta:hover {
    --lp-fill: var(--color-surface-navy);
    --lp-shade: var(--color-accent-pink);
    color: #fff;
  }
  .savings-cta:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>

<script>
  import { handOffContactDraft } from "~/lib/contactDraft";
  import { formatSavings, savings, savingsDraft, type SavingsInput } from "~/lib/savingsCalculator";

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-savings]")) {
    const section = form.closest("section");
    const lang = form.dataset.lang === "en" ? "en" : "de";
    const read = (): SavingsInput | null => {
      const data = new FormData(form);
      const value = (name: string) => (data.has(name) ? Number(data.get(name)) : Number.NaN);
      const input = { minutes: value("minutes"), perWeek: value("perWeek"), share: value("share") };
      return Object.values(input).every(Number.isFinite) ? input : null;
    };
    const update = () => {
      const input = read();
      const figures = section?.querySelector<HTMLElement>("[data-savings-figures]");
      const pending = section?.querySelector<HTMLElement>("[data-savings-pending]");
      const legend = section?.querySelector<HTMLElement>("[data-savings-legend]");
      const arc = section?.querySelector<SVGCircleElement>("[data-savings-arc]");
      const centre = section?.querySelector<HTMLElement>("[data-savings-share]");
      const label = section?.querySelector<SVGTitleElement>("[data-savings-chart-label]");
      if (figures) figures.hidden = !input;
      if (legend) legend.hidden = !input;
      if (pending) pending.hidden = !!input;
      const ring = Number(arc?.dataset.ring ?? 0);
      if (!input) {
        arc?.setAttribute("stroke-dasharray", `0 ${ring}`);
        if (centre) centre.textContent = "–";
        return;
      }
      const result = savings(input);
      for (const key of ["year", "days", "rest"] as const) {
        for (const output of section?.querySelectorAll<HTMLOutputElement>(`[data-savings-result="${key}"]`) ?? []) {
          output.textContent = formatSavings(result[key], lang);
        }
      }
      arc?.setAttribute("stroke-dasharray", `${(ring * result.share).toFixed(2)} ${ring}`);
      if (centre) centre.textContent = `${Math.round(result.share * 100)} %`;
      if (label) {
        label.textContent = (form.dataset.chartLabel ?? "")
          .replace("{total}", formatSavings(result.total, lang))
          .replace("{year}", formatSavings(result.year, lang));
      }
    };
    form.addEventListener("change", update);
    form.addEventListener("submit", (event) => event.preventDefault());
    section?.querySelector("[data-savings-cta]")?.addEventListener("click", () => {
      const input = read();
      if (input) handOffContactDraft({ message: savingsDraft(form.dataset.draft ?? "", input, lang), service: "process" });
    });
    update();
  }
</script>
