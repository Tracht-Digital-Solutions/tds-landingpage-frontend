---
/**
 * Vorgehen — how a working relationship runs, and what the first step is.
 *
 * Two columns from `lg`: the four steps on the left, and beside them the card
 * that answers what the FIRST of them actually is (`ui/FirstCall.astro`),
 * carrying the section's one primary call to action. Stacked below `lg`.
 *
 * What it replaced: a sticky detail panel that swapped its content as the
 * pointer hovered a step, or when a step's `<li>` took keyboard focus — each
 * one carried `tabindex="0"` with no role, i.e. a focus stop that announced
 * nothing — and the panel itself was `aria-hidden`, so its text never reached
 * a screen reader. Its one piece of real content, each step's outcome, is part
 * of the step now (`ui/ProcessStep.astro`).
 *
 * The home page's process is the one place on the site that still numbers its
 * steps, deliberately (see AGENTS.md).
 */
import { resolveLang } from "~/lib/i18n";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import ProcessStep from "~/components/ui/ProcessStep.astro";
import FirstCall from "~/components/ui/FirstCall.astro";
import { getProcessContent } from "~/lib/processContent";
import { cmsFor } from "~/lib/cms";

const lang = resolveLang(Astro.currentLocale);

// Default = the local process copy (`lib/processContent.ts`; it came from
// tds-shared's `translations.process` until the site switched to "du"). An
// admin-edited "process" block overrides it (cmsFor); the shape is unchanged,
// so the rendering below is source-agnostic.
const process = await cmsFor("process", lang, getProcessContent(lang));
const steps = process.steps;
---

{/* Ground: `.page-ground` in the layout, once for the whole page. */}
<section
  id="process"
  class="section-spacing"
  aria-labelledby="process-heading"
>
  <div class="lp-container">
    <SectionHeader
      headline={process.headline}
      headlineAccent={process.headlineAccent}
      id="process-heading"
      headingClass="mb-6"
      bar
    />
    <p class="max-w-2xl text-[var(--color-muted)] leading-relaxed mb-12 text-center md:text-left mx-auto md:mx-0">
      {process.body}
    </p>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-x-14 lg:items-start">
      <div class="relative">
        <span
          aria-hidden="true"
          class="absolute left-[1.375rem] md:left-6 top-6 bottom-6 w-px bg-gradient-to-b from-[var(--color-accent)]/40 via-[var(--color-line)] to-[var(--color-accent)]/20"
        ></span>

        {/* Start cap — small accent dot anchoring the top of the spine. */}
        <span
          aria-hidden="true"
          class="absolute left-[1.375rem] md:left-6 -translate-x-1/2 top-5 w-2.5 h-2.5 rounded-full bg-[var(--color-accent)] ring-4 ring-[var(--color-paper)]"
        ></span>

        <ol class="relative pt-6 pb-6">
          {
            steps.map((step) => (
              <li>
                <ProcessStep
                  number={step.number}
                  title={step.title}
                  duration={step.duration}
                  description={step.description}
                  outcome={step.outcome}
                />
              </li>
            ))
          }
        </ol>

        {/* End cap — primary-filled dot signalling the arc terminates. */}
        <span
          aria-hidden="true"
          class="absolute left-[1.375rem] md:left-6 -translate-x-1/2 bottom-5 w-2.5 h-2.5 rounded-full bg-[var(--color-primary)] ring-4 ring-[var(--color-paper)]"
        ></span>
      </div>

      <div class="lg:sticky lg:top-28">
        <FirstCall variant="process" />
      </div>
    </div>
  </div>
</section>
