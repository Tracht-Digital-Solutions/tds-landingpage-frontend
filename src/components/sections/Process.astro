---
/**
 * So arbeiten wir zusammen: four steps.
 *
 * From 40rem every step is open side by side. On a phone the steps are an
 * accordion: the step's head (number, icon, title) is a button, and opening
 * one closes the others. Without JavaScript every step stays open: `hidden`
 * is only ever set by the script below.
 *
 * Each step is a card in the site's language: a navy band, the hard offset
 * shadow, a pink marker. Under a mouse the card leans toward the pointer and its
 * shadow plate slides against the lean (`lib/motion/tilt.ts`, as on the project
 * cards); the card lifts and its band turns bordeaux. Nothing has to be opened.
 *
 * Each card opens with a small drawn scene (`ui/ProcessScene.astro`). The
 * four play once, in order, as the row scrolls in, and then rest; on a phone a
 * step's scene plays when the step is opened.
 *
 * The copy is code-owned (`lib/processContent.ts`). The `<ol>` carries the order
 * for assistive technology. `data-reveal` and the tilt sit on two elements, so
 * their transforms never meet.
 */
import Arrow from "~/components/ui/Arrow.astro";
import { localizePath, resolveLang } from "~/lib/i18n";
import ProcessIcon from "~/components/ui/ProcessIcon.astro";
import ProcessScene from "~/components/ui/ProcessScene.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { getProcessContent } from "~/lib/processContent";
import { getHomeContent } from "~/lib/homeContent";
import { cmsFor } from "~/lib/cms";

const lang = resolveLang(Astro.currentLocale);
const process = getProcessContent(lang);
const firstCall = await cmsFor("first_call", lang, getHomeContent(lang).firstCall);
const contactHref = `${localizePath("/", lang)}#contact`;
const resultLabel = lang === "en" ? "Result" : "Ergebnis";
---

<section id="process" class="section-spacing" aria-labelledby="process-heading">
  <div class="lp-container">
    <SectionHeader
      headline={process.headline}
      headlineAccent={process.headlineAccent}
      id="process-heading"
      headingClass="mb-10 md:mb-14"
      bar
    />

    <ol class="process-steps">
      {
        process.steps.map((step, index) => (
          <li class="process-step" data-reveal>
            <div class="process-step__tilt" data-motion-tilt>
              <span class="process-step__shade" aria-hidden="true"></span>
              <div class="process-step__card">
                <h3 class="process-step__head">
                  <button
                    type="button"
                    class="process-step__band"
                    data-process-toggle
                    aria-controls={`process-step-${step.number}`}
                  >
                    <span aria-hidden="true" class="process-step__icon">
                      <ProcessIcon number={step.number} />
                    </span>
                    <span class="process-step__title">{step.title}</span>
                    <span class="process-step__chevron" aria-hidden="true"></span>
                  </button>
                </h3>
                <div class="process-step__body" id={`process-step-${step.number}`}>
                  <ProcessScene number={step.number} />
                  <ul class="process-step__actions">
                    {step.actions.map((action) => <li>{action}</li>)}
                  </ul>
                  {/* The card's footer, behind a 1px rule. */}
                  <p class="process-step__result">
                    <span class="process-step__result-label">{resultLabel}:</span>{" "}
                    {step.outcome}
                  </p>
                </div>
              </div>
            </div>
            {/* From one step to the next: right beside the cards in a row,
                down between them when they stack. */}
            {index < process.steps.length - 1 && (
              <span class="process-step__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m9 6 6 6-6 6" />
                </svg>
              </span>
            )}
          </li>
        ))
      }
    </ol>

    <div class="process-cta">
      <a href={contactHref} class="process-cta__link lp-ink" data-cta data-track="process-first-call">
        {firstCall.cta}
        <span aria-hidden="true"><Arrow dir="right" /></span>
      </a>
    </div>
  </div>
</section>

<style>
  .process-steps {
    --process-gap: 2.75rem;
    display: grid;
    gap: var(--process-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) and (max-width: 71.99rem) {
    .process-steps {
      max-width: 40rem;
      margin-inline: auto;
    }
  }
  @media (min-width: 72rem) {
    .process-steps {
      --process-gap: 3rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .process-step {
    position: relative;
    min-width: 0;
  }
  /* The arrow sits in the gap: centred below a stacked card, pointing down;
     centred beside a card in the row, pointing right. */
  .process-step__arrow {
    position: absolute;
    top: 100%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--process-gap);
    height: var(--process-gap);
    translate: -50% 0;
    rotate: 90deg;
    color: var(--color-accent);
    pointer-events: none;
  }
  @media (min-width: 72rem) {
    .process-step__arrow {
      top: 50%;
      left: 100%;
      translate: 0 -50%;
      rotate: none;
    }
  }

  .process-step__tilt {
    --tilt-shade-x: 0px;
    --tilt-shade-y: 0px;
    position: relative;
    height: 100%;
    transform: perspective(900px);
    transform-style: preserve-3d;
  }
  /* The hard shadow, as a plate behind the card (see `ui/ProjectCard.astro`). */
  .process-step__shade {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    background: var(--tds-shadow-ink, rgb(0 0 0 / 0.22));
    transform: translate3d(calc(8px + var(--tilt-shade-x)), calc(8px + var(--tilt-shade-y)), -28px) scale(1.031);
    transition: transform 220ms var(--tds-ease-out);
    pointer-events: none;
  }
  .process-step__card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 6px;
    background: var(--color-soft);
    transform: translateZ(0);
    transition: transform 220ms var(--tds-ease-out);
  }

  .process-step__head {
    margin: 0;
  }
  .process-step__band {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    width: 100%;
    padding: 0.875rem 1.25rem;
    border: 0;
    background: var(--color-surface-navy);
    color: #fff;
    font: inherit;
    text-align: left;
    cursor: default;
    transition: background-color 200ms var(--tds-ease-out);
  }
  .process-step__band[aria-expanded] {
    cursor: pointer;
  }
  .process-step__band:disabled {
    opacity: 1;
    color: #fff;
  }
  .process-step__band:focus-visible {
    outline: 2px solid var(--color-accent-pink);
    outline-offset: -4px;
  }
  .process-step__chevron {
    display: none;
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    margin-left: auto;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    rotate: 45deg;
    translate: 0 -25%;
    transition: rotate 200ms var(--tds-ease-out);
  }
  .process-step__band[aria-expanded] .process-step__chevron {
    display: block;
  }
  .process-step__band[aria-expanded="true"] .process-step__chevron {
    rotate: 225deg;
    translate: 0 25%;
  }
  .process-step__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--tds-radius-pill, 100px);
    background: var(--color-accent-pink);
    color: #050f68;
    transition: rotate 420ms var(--lp-ease-bounce, var(--tds-ease-out));
  }

  .process-step__body {
    display: flex;
    flex: 1;
    flex-direction: column;
  }
  .process-step__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: #fff;
  }
  .process-step__body[hidden] {
    display: none;
  }
  .process-step__actions {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 1.25rem 1.25rem 1.25rem 2.25rem;
    list-style: disc;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-black);
  }
  .process-step__actions li::marker {
    color: var(--color-accent);
  }
  .process-step__result {
    margin: auto 0 0;
    padding: 0.875rem 1.25rem 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-black) 12%, transparent);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-black);
  }
  .process-step__result-label {
    font-weight: 500;
    color: color-mix(in srgb, var(--color-muted) 82%, var(--color-black));
  }

  /* Only under a mouse: a finger has no hover. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .process-step__tilt:hover .process-step__card {
      transform: translateZ(10px);
    }
    .process-step__tilt:hover .process-step__band {
      background: var(--color-surface-accent);
    }
    .process-step__tilt:hover .process-step__icon {
      rotate: -8deg;
    }
  }

  .process-cta {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }
  .process-cta__link {
    --lp-fill: var(--color-accent);
    --lp-shade: initial;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.75rem 1.75rem;
    border-radius: 100px;
    background: var(--lp-fill);
    color: var(--color-paper);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 200ms var(--tds-ease-out);
  }
  .process-cta__link:hover {
    --lp-fill: var(--color-surface-navy);
    --lp-shade: var(--color-accent-pink);
  }
  .process-cta__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>

<script>
  import { lessMotion } from "~/lib/a11yPrefs";

  /* The scenes (`ui/ProcessScene.astro`). Their markup is the finished picture;
     `data-scene` adds the motion. `armed` holds the first frame and is only ever
     written while the row is off screen, so nothing visible is reset. `play`
     runs once, the cards one after another; afterwards the attribute goes and
     the picture stays as it is. */
  const SCENE_STEP_MS = 420;
  const SCENE_LONGEST_MS = 2700;
  const shown = (el: HTMLElement) => el.getClientRects().length > 0;
  const playScene = (scene: HTMLElement, delay = 0) => {
    if (lessMotion()) return;
    window.clearTimeout(Number(scene.dataset.sceneTimer ?? 0));
    scene.style.setProperty("--ps-delay", `${delay}ms`);
    if (scene.dataset.scene !== "armed") {
      scene.dataset.scene = "armed";
      void scene.getBoundingClientRect();
    }
    scene.dataset.scene = "play";
    scene.dataset.sceneTimer = String(
      window.setTimeout(() => {
        delete scene.dataset.scene;
        delete scene.dataset.sceneTimer;
        scene.style.removeProperty("--ps-delay");
      }, delay + SCENE_LONGEST_MS),
    );
  };

  for (const list of document.querySelectorAll<HTMLElement>(".process-steps")) {
    if (lessMotion()) break;
    const scenes = [...list.querySelectorAll<HTMLElement>("[data-process-scene]")];
    const box = list.getBoundingClientRect();
    if (box.bottom <= 0 || box.top >= window.innerHeight) {
      for (const scene of scenes) scene.dataset.scene = "armed";
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          let order = 0;
          for (const scene of scenes) {
            if (shown(scene)) playScene(scene, order++ * SCENE_STEP_MS);
            else delete scene.dataset.scene;
          }
        },
        { rootMargin: "0px 0px -25% 0px" },
      );
      observer.observe(list);
    }
  }

  /* Phone accordion: one step open at a time. From 40rem every step shows and
     the heads are plain headings again: disabled, no aria-expanded, no tab stop. */
  const phone = matchMedia("(max-width: 39.99rem)");
  for (const list of document.querySelectorAll<HTMLElement>(".process-steps")) {
    const toggles = [...list.querySelectorAll<HTMLButtonElement>("[data-process-toggle]")];
    const panel = (toggle: HTMLButtonElement) => document.getElementById(toggle.getAttribute("aria-controls") ?? "");
    let open = 0;
    const apply = () => {
      toggles.forEach((toggle, index) => {
        const body = panel(toggle);
        if (phone.matches) {
          toggle.disabled = false;
          toggle.setAttribute("aria-expanded", String(index === open));
          if (body) body.hidden = index !== open;
        } else {
          toggle.disabled = true;
          toggle.removeAttribute("aria-expanded");
          if (body) body.hidden = false;
        }
      });
    };
    toggles.forEach((toggle, index) => {
      toggle.addEventListener("click", () => {
        if (!phone.matches) return;
        open = open === index ? -1 : index;
        apply();
        const scene = panel(toggle)?.querySelector<HTMLElement>("[data-process-scene]");
        if (open === index && scene) playScene(scene);
      });
    });
    phone.addEventListener("change", apply);
    apply();
  }
</script>
