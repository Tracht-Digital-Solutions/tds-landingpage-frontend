---
import { tFor } from "~/lib/i18n";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import ProcessStep from "~/components/ui/ProcessStep.astro";

const t = tFor(Astro.currentLocale);
---

<section id="process" class="section-spacing bg-[var(--color-soft)]" aria-labelledby="process-heading">
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <SectionHeader
      label={t.process.label}
      headline={t.process.headline}
      headlineAccent={t.process.headlineAccent}
      id="process-heading"
    />

    <div class="max-w-2xl">
      {t.process.steps.map((step, i) => (
        <ProcessStep
          number={step.number}
          title={step.title}
          duration={step.duration}
          description={step.description}
          isLast={i === t.process.steps.length - 1}
        />
      ))}
    </div>
  </div>
</section>
