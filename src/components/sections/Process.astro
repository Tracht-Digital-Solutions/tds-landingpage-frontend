---
/**
 * So arbeiten wir zusammen: four steps on one rail, all readable at once.
 *
 * Each step lists what happens in plain sentences and names what exists at its
 * end. No hover, no panel, no script: a visitor comparing the steps should not
 * have to open them one at a time. The rail runs across from 64rem and down the
 * left edge below that.
 *
 * The copy is code-owned (`lib/processContent.ts`). A stored `process` block
 * still holds the older wording, so it no longer applies.
 *
 * The `<ol>` carries the order for assistive technology.
 */
import { localizePath, resolveLang } from "~/lib/i18n";
import ProcessIcon from "~/components/ui/ProcessIcon.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import { getProcessContent } from "~/lib/processContent";
import { getHomeContent } from "~/lib/homeContent";
import { cmsFor } from "~/lib/cms";

const lang = resolveLang(Astro.currentLocale);
const process = getProcessContent(lang);
const firstCall = await cmsFor("first_call", lang, getHomeContent(lang).firstCall);
const contactHref = `${localizePath("/", lang)}#contact`;
const resultLabel = lang === "en" ? "At the end" : "Am Ende steht";
---

<section id="process" class="section-spacing" aria-labelledby="process-heading">
  <div class="lp-container">
    <SectionHeader
      headline={process.headline}
      headlineAccent={process.headlineAccent}
      id="process-heading"
      headingClass="mb-10 md:mb-14"
      bar
    />

    <ol class="process-rail">
      {
        process.steps.map((step) => (
          <li class="process-step" data-reveal>
            <span aria-hidden="true" class="process-step__dot">
              <ProcessIcon number={step.number} />
            </span>
            <div class="process-step__card">
              <p class="process-step__when">{step.duration}</p>
              <h3 class="process-step__title">{step.title}</h3>
              <ul class="process-step__actions">
                {step.actions.map((action) => <li>{action}</li>)}
              </ul>
              <p class="process-step__result">
                <span class="process-step__result-label">{resultLabel}</span>
                {step.outcome}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="process-cta">
      <a href={contactHref} class="process-cta__link lp-ink" data-cta data-track="process-first-call">
        {firstCall.cta}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .process-rail {
    --dot: 3rem;
    position: relative;
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .process-step {
    position: relative;
    display: grid;
    grid-template-columns: var(--dot) minmax(0, 1fr);
    gap: 1rem;
  }
  /* The rail, drawn per step so it ends at the last dot. */
  .process-step:not(:last-child)::before {
    content: "";
    position: absolute;
    top: var(--dot);
    bottom: -1.25rem;
    left: calc(var(--dot) / 2 - 1px);
    width: 2px;
    background: color-mix(in srgb, var(--color-accent) 35%, transparent);
  }
  .process-step__dot {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--dot);
    height: var(--dot);
    border-radius: 100px;
    background: var(--color-surface-navy);
    color: #fff;
  }
  .process-step__card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    height: 100%;
    padding: 1.25rem;
    border-radius: 6px;
    background: var(--color-soft);
  }
  .process-step__when {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .process-step__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-black);
  }
  .process-step__actions {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0 0 0 1rem;
    list-style: disc;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-black);
  }
  .process-step__actions li::marker {
    color: var(--color-accent);
  }
  .process-step__result {
    margin: auto 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--color-black) 10%, transparent);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-black);
  }
  .process-step__result-label {
    display: block;
    margin-bottom: 0.125rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  @media (min-width: 64rem) {
    .process-rail {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .process-step {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: var(--dot) 1fr;
    }
    .process-step:not(:last-child)::before {
      top: calc(var(--dot) / 2 - 1px);
      right: -1.25rem;
      bottom: auto;
      left: var(--dot);
      width: auto;
      height: 2px;
    }
  }

  .process-cta {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }
  .process-cta__link {
    --lp-fill: var(--color-accent);
    --lp-shade: initial;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.75rem 1.75rem;
    border-radius: 100px;
    background: var(--lp-fill);
    color: var(--color-paper);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 200ms var(--tds-ease-out);
  }
  .process-cta__link:hover {
    --lp-fill: var(--color-surface-navy);
    --lp-shade: var(--color-accent-pink);
  }
  .process-cta__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
