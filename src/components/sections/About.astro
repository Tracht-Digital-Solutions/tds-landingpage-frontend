---
/**
 * Wieso ich? — the person behind the page: portrait, the motivation, and in
 * plain words what working with one person means.
 *
 * ### Why the right column looks the way it does (2026-09-29)
 *
 * It used to print ONE sentence (`p2`) and the certificates teaser, beside a
 * 3:4 portrait, in a grid with `items-center` and a 6rem column gap. That is
 * where the "so many gaps" reading came from: not a spacing bug, but two
 * columns of wildly different height, the short one centred so its slack fell
 * both above and below.
 *
 * Three things fixed it, and only the third is about spacing:
 *
 * 1. The column has CONTENT now — `motivation`, the one block on this page
 *    that can only come from Julian, plus three of the four `reasons`.
 * 2. `items-start`, so the short column stops floating in the middle of the
 *    tall one.
 * 3. The blocks are separated by the 1px seam `.credentials-teaser` already
 *    drew, not by a gap. Three stacked lists separated by air read as three
 *    things that fell apart; separated by a line they read as one panel.
 *
 * `lead` and `p1` are still NOT rendered, and that is unchanged: the first is a
 * comparison with suppliers nobody named, the second repeats the hero word for
 * word one screen further down. The fourth reason ("Verständlich erklärt") is
 * out for the same reason the tiles were — it is the one claim a visitor cannot
 * check. All of them stay in the content shape so a stored `why_me` block keeps
 * loading; that is why this is a render-side choice rather than an edit to the
 * strings.
 *
 * The portrait is a pre-sized static copy (`lib/imageVariants.ts`), loaded
 * lazily — it sits below the fold. It used to be `<Image loading="eager">`,
 * i.e. an on-request resize in the Node process for every uncached view, with a
 * 1500 × 2100 fallback source.
 */
import { resolveLang } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
import {
  credentials,
  credentialsHref,
  featuredCredentials,
  shortTitle,
} from "~/lib/credentials";
import { getHomeContent } from "~/lib/homeContent";
import { PORTRAIT_SIZE, portraitSrc, portraitSrcset } from "~/lib/imageVariants";
import { siteConfig } from "~/lib/seo";
import AccentLetters from "~/components/ui/AccentLetters.astro";

const lang = resolveLang(Astro.currentLocale);
const about = await cmsFor("why_me", lang, getHomeContent(lang).whyMe);

/**
 * Three of the four reasons. Index 2 is the committed "Verständlich erklärt" /
 * "Explained plainly" — the one entry a visitor has no way to check, and the
 * two motivation paragraphs above are the demonstration of it anyway.
 *
 * By POSITION, not by matching the title: the titles are CMS-editable, so a
 * text match would silently start rendering four again the first time somebody
 * rephrases one. An editor who replaces the whole list gets their own third
 * entry dropped instead, which is visible in the editor and theirs to fix. The
 * cap is what keeps a longer stored list from stretching the column.
 */
const renderedReasons = about.reasons.filter((_, index) => index !== 2).slice(0, 3);

/**
 * The certificates, teased where the person is introduced.
 *
 * Deliberately NOT part of `about` and therefore not CMS-overridable: the
 * three names below are the titles printed on three documents, and an editor
 * who could retype them could publish a qualification that does not exist. The
 * paragraphs above stay editable; this block is code.
 *
 * Three, and the first three of the catalog — the order is decided once in
 * `lib/credentials.ts` and the page this links to renders the same order. A
 * teaser with a list of its own drifts from the page it teases the first time
 * somebody reorders one of them.
 */
const featured = featuredCredentials();
const credentialsUi =
  lang === "de"
    ? { label: "Nachweise", all: `Alle ${credentials.length} Nachweise ansehen` }
    : { label: "Credentials", all: `See all ${credentials.length} credentials` };
---

{/* Kein eigener Grund mehr: die Markenfelder liegen seitenweit in
    `.page-ground` (siehe `layouts/Layout.astro`). Hier bleibt nur der sehr
    leise Fotogrund (siehe IMAGES.md). Gestapelt wird Seitengrund (fixiert,
    z -1) → Foto (`.tds-decor`, z 0) → Inhalt (z 1).

    `relative` ist Voraussetzung, nicht Kosmetik: `.tds-decor` ist
    `position: absolute; inset: 0` und braucht diesen Abschnitt als
    Bezugsrahmen. Es kam bis hierher von `.tds-wash` mit; ohne die Klasse
    würde das Foto sonst am nächsten positionierten Vorfahren hängen. */}
<section
  id="about"
  class="relative section-spacing"
  aria-labelledby="about-heading"
>
  {/* Fotogrund unter dem Wash, in der geteilten `.tds-decor`-Ebene, weil deren
      Regel `.tds-decor ~ *` jedes folgende Geschwister automatisch auf
      z-index 1 hebt. `object-left`, weil das Motiv seine Gegenstände unten
      links hat; der Scrim läuft von rechts, wo die Textspalte steht. */}
  <span class="tds-decor" aria-hidden="true">
    <img
      src="/images/sections/why-me.webp"
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      class="about-photo absolute inset-0 h-full w-full object-cover object-left"
      data-motion-image
    />
    <span class="about-photo-scrim absolute inset-0"></span>
  </span>
  <div class="lp-container">
    {/* `items-start`, not `items-center`: the columns are deliberately unequal
        (a 3:4 portrait against a text column) and centring the shorter one
        splits its slack above AND below it. See the note at the top. */}
    <div class="grid md:grid-cols-2 gap-12 md:gap-16 lg:gap-20 items-start">
      <div class="max-w-sm mx-auto md:mx-0 w-full">
        {/* A CARD, like every other box on this site since 0.42 (2026-09-28).
            It used to be a masked cut-out dissolving into a coral rectangle
            that dissolved with it — the last piece of the old soft language,
            sitting one screen below a row of hard-edged 6px cards.

            The coral stays, as an offset plate behind the card rather than a
            frame bleeding through the photo: geometry, not a glow. The card
            itself takes the section's card fill and the shared hard shadow
            (`.about-portrait` is in the `:where()` list in `global.css`), and
            the photo now ends on its own edge instead of fading out. */}
        {/* Two boxes, and they have to stay two. The CARD clips (its picture
            and its caption round off against `overflow: hidden`); the PLATE
            has to escape that clip to be seen at all. Putting both on one
            element is what made the coral invisible the first time. */}
        <div class="about-portrait">
          <span aria-hidden="true" class="about-portrait__plate tds-shape tds-shape--coral"></span>
          <div class="about-portrait__card">
          <img
            src={portraitSrc(720)}
            srcset={portraitSrcset()}
            sizes="(min-width: 768px) 24rem, 60vw"
            width={PORTRAIT_SIZE.width}
            height={PORTRAIT_SIZE.height}
            alt={siteConfig.founder.name}
            loading="lazy"
            decoding="async"
            class="about-portrait__img"
          />
          {/* The caption the card earns by being a card: who this is. It was
              only in the photo's `alt` before, i.e. invisible to everyone who
              can see. */}
          <p class="about-portrait__caption">
            <span class="about-portrait__name">{siteConfig.founder.name}</span>
            <span class="about-portrait__role">{siteConfig.founder.jobTitle}</span>
          </p>
          </div>
        </div>
      </div>

      <div class="text-center md:text-left">
        <h2
          id="about-heading"
          class="display text-4xl md:text-5xl lg:text-6xl text-[var(--color-black)] mb-8"
        >
          {about.headline}{" "}
          <AccentLetters text={about.headlineAccent} />
        </h2>

        {/* See the note at the top for what is NOT rendered here and why. */}
        <p class="text-lg font-medium text-[var(--color-black)] leading-relaxed">{about.p2}</p>

        {/* The motivation. First person, and the only block on this page a
            competitor could not write — which is why it stands above the
            reasons rather than after them. */}
        <div class="about-block">
          <p class="eyebrow about-block__label">{about.motivation.title}</p>
          {
            about.motivation.body.map((paragraph) => (
              <p class="about-motivation__text">{paragraph}</p>
            ))
          }
        </div>

        {/* Three of four (see the top). Same drawn marker as the certificates
            below, so the column does not carry two bullet styles. */}
        <div class="about-block">
          <ul class="about-reasons">
            {
              renderedReasons.map((reason) => (
                <li>
                  <span class="about-reasons__title">{reason.title}</span>
                  <span class="about-reasons__text">{reason.description}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="about-block credentials-teaser">
          <p class="eyebrow credentials-teaser__label">{credentialsUi.label}</p>
          <ul class="credentials-teaser__list">
            {
              featured.map((entry) => (
                <li>
                  <span class="credentials-teaser__name">{shortTitle(entry)}</span>
                  <span class="credentials-teaser__issuer">{entry.issuer}</span>
                </li>
              ))
            }
          </ul>
          <a class="credentials-teaser__link" href={credentialsHref(lang)}>
            {credentialsUi.all}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ein GRUND, keine Abbildung — dieser Abschnitt ist der ruhigste der Seite.
     Spiegelverkehrt per CSS statt durch ein zweites WebP. `scaleX(-1)` greift
     NACH `object-fit`/`object-position`; das ist gewollt, nicht ein Versehen. */
  .about-photo {
    opacity: 0.35;
    transform: scaleX(-1);
  }
  :global(:root[data-theme="dark"]) .about-photo {
    opacity: 0.22;
  }
  /* Die PAPIERFARBE des Abschnitts, von rechts auslaufend — kein grauer
     Schleier, damit die Fläche ihren Farbton behält. */
  .about-photo-scrim {
    background: linear-gradient(
      to left,
      var(--color-paper) 24%,
      color-mix(in srgb, var(--color-paper) 74%, transparent) 66%,
      color-mix(in srgb, var(--color-paper) 46%, transparent) 100%
    );
  }

  /* --- The portrait, as a card ------------------------------------------
     Radius, fill and shadow are the site's card language (6px, sand on paper,
     the hard 2D offset from `global.css`). Nothing here is decorative for its
     own sake: the plate behind is the brand's coral, offset like the shadow
     is, so the card reads as constructed rather than floating. */
  /* The frame: positions the plate, clips nothing. */
  .about-portrait {
    position: relative;
  }
  .about-portrait__card {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-soft);
  }
  /* The coral plate, offset UP-LEFT — the opposite corner from the hard
     shadow, which falls down-right. Two offsets in the same direction read as
     a smudge; opposite corners read as a card held between two constructed
     edges. Bottom and right stay inside the card, so the plate is only ever
     visible as two bands. */
  .about-portrait__plate {
    position: absolute;
    inset: -0.75rem 1.5rem 1.5rem -0.75rem;
    border-radius: 6px;
    --tds-decor-shape-alpha: 1;
  }
  .about-portrait__img {
    display: block;
    width: 100%;
    /* The photo's own frame. It ends on its edge now — the mask that dissolved
       the bottom and the right is gone with the shape it was hiding from. */
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top center;
    background: var(--color-paper);
  }
  .about-portrait__caption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0;
    padding: 0.875rem 1.125rem 1rem;
    /* The same seam every card on this site draws under a picture. */
    border-top: 1px solid color-mix(in srgb, var(--color-black) 8%, transparent);
    text-align: left;
  }
  .about-portrait__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.2;
    color: var(--color-black);
  }
  .about-portrait__role {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--color-muted);
  }

  /* --- The three blocks under the paragraph ------------------------------
     Motivation, reasons, certificates. A SEAM between them, not a gap: three
     stacked lists separated by air read as three things that came apart, and
     that was most of the "so many gaps" reading this section earned. One line
     and they read as one panel — the same borderless card language the rest of
     the page uses, without a fill that would make the portrait compete with a
     box.

     The rule came out of `.credentials-teaser`, which owned it alone while it
     was the only block here. */
  .about-block {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .about-block__label {
    margin: 0 0 0.75rem;
  }
  .about-motivation__text {
    margin: 0 0 0.625rem;
    line-height: 1.6;
    color: var(--color-ink);
  }
  .about-motivation__text:last-child {
    margin-bottom: 0;
  }

  /* The reasons. Title and line stacked per row, same drawn marker as the
     certificates below — a second bullet style in one column is the kind of
     detail that reads as carelessness without anyone being able to name it. */
  .about-reasons {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .about-reasons li {
    position: relative;
    padding-left: 1.125rem;
    text-align: left;
  }
  .about-reasons li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 100px;
    background: var(--color-accent);
  }
  .about-reasons__title {
    display: block;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--color-black);
  }
  .about-reasons__text {
    display: block;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-muted);
  }

  /* The certificates, as a caption under the prose rather than as a fourth
     paragraph. It is a LIST of documents: three names, the issuer under each,
     and one way to all of them. Its seam and top spacing now come from
     `.about-block`. */
  .credentials-teaser__label {
    margin: 0 0 0.75rem;
  }
  .credentials-teaser__list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }
  .credentials-teaser__list li {
    /* The marker is drawn rather than listed: a real `list-style` marker sits
       outside the box and would hang into the gutter on the centred phone
       layout. */
    position: relative;
    padding-left: 1.125rem;
    line-height: 1.35;
    /* The column is centred below `md` (the whole text block is), so the
       hanging marker has to come back inside. */
    text-align: left;
  }
  .credentials-teaser__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 100px;
    background: var(--color-accent);
  }
  .credentials-teaser__name {
    display: block;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-black);
  }
  .credentials-teaser__issuer {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .credentials-teaser__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }
  .credentials-teaser__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .credentials-teaser__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 3px;
  }
  .credentials-teaser__link span {
    transition: transform 200ms var(--tds-ease-out);
  }
  .credentials-teaser__link:hover span {
    transform: translateX(2px);
  }
  @media (pointer: coarse) {
    .credentials-teaser__link {
      min-height: 2.75rem;
    }
  }

  /* On a phone the whole column is centred; every list keeps its own left edge
     so the bullets do not zig-zag down the middle. */
  @media (max-width: 47.99rem) {
    .about-block {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .credentials-teaser__list,
    .about-reasons {
      align-self: center;
    }
    /* Prose stays centred with the rest of the column — it has no marker to
       hang, so a left edge of its own would look like a mistake. */
    .about-motivation__text {
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .credentials-teaser__link span {
      transition: none;
    }
  }
</style>
