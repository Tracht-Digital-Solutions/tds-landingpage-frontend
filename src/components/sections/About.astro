---
import { Image } from "astro:assets";
import { resolveLang } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
import { getHomeContent } from "~/lib/homeContent";
import AccentLetters from "~/components/ui/AccentLetters.astro";
import Emphasis from "~/components/ui/Emphasis.astro";
import portrait from "~/assets/portrait.webp";

const lang = resolveLang(Astro.currentLocale);
const about = await cmsFor("why_me", lang, getHomeContent(lang).whyMe);

// The list is a list of GAINS, so the marker says so. It is decorative —
// each item's own heading carries the meaning — hence `aria-hidden`.
const gainLabel = lang === "de" ? "Vorteil" : "Benefit";
---

{/* Warmweiß mit weichen Markenfeldern an den Außenrändern — the first
    paper section after the hero, so it sets the ground for everything
    that follows. The fields come from the shared `.tds-wash`; they are
    dialled down on phones and in dark mode by the decor tokens. Seit dem
    Bild-Pass liegt darunter zusätzlich ein sehr leiser Fotogrund (siehe
    IMAGES.md). Gestapelt wird Fläche → Wash-Felder (z -1) → Foto
    (`.tds-decor`, z 0) → Inhalt (z 1). */}
<section
  id="about"
  class="tds-wash section-spacing"
  aria-labelledby="about-heading"
>
  {/* Fotogrund unter dem Wash. Er kommt in die geteilte `.tds-decor`-
      Ebene, weil deren Regel `.tds-decor ~ *` jedes folgende Geschwister
      automatisch auf z-index 1 hebt — der Inhalt liegt darüber, ohne dass
      hier ein einziges `relative z-10` von Hand gesetzt werden muss.

      `object-left`, weil das Motiv seine Gegenstände unten links hat und
      die rechten zwei Drittel bewusst leerer Tisch sind: bei `object-cover`
      in einem hohen Abschnitt wird waagerecht beschnitten, zentriert bliebe
      genau die leere Fläche übrig. Der Scrim läuft von rechts, wo die
      Textspalte steht; links darf der Grund unter dem Portrait stehen
      bleiben, das ihn ohnehin überdeckt. */}
  <span class="tds-decor" aria-hidden="true">
    <img
      src="/images/sections/why-me.webp"
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      class="about-photo absolute inset-0 h-full w-full object-cover object-left"
    />
    <span class="about-photo-scrim absolute inset-0"></span>
  </span>
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <div class="grid md:grid-cols-2 gap-16 lg:gap-24 items-start">
      <div class="md:sticky md:top-28 max-w-sm mx-auto md:mx-0">
        <div class="relative">
          {/* The portrait is framed by CONSTRUCTED geometry, not by a
              glow: one strongly-rounded rectangle, offset behind the
              cut-out. The blurred pink radial that used to sit here read
              as the same soft haze the hero has now dropped — "keine
              starken Glow-Effekte" — and it framed nothing, because a
              blur has no edge to frame with.

              ONE shape, not two. A second quarter-circle catching the
              lower left was tried and removed: at this size it read as a
              stray grey block behind the shoulder rather than as a cut
              corner, which is the failure mode of small geometry — it
              needs enough length for the arc to be legible as an arc.

              It now runs down to the image's own bottom edge and fades
              there (`.portrait-shape`, global.css) instead of stopping
              short and showing through the portrait's faded torso. */}
          <span
            aria-hidden="true"
            class="portrait-shape tds-shape tds-shape--rect tds-shape--coral -z-10"
            style="inset: -1.25rem -2rem 0 -1.25rem;"></span>
          <Image
            src={portrait}
            alt="Julian Tracht"
            widths={[300, 450, 600, 900]}
            sizes="(min-width: 768px) 24rem, 60vw"
            loading="eager"
            class="portrait-fade rounded-[2px] aspect-[3/4] object-cover object-top w-full"
          />
        </div>
      </div>

      <div class="text-center md:text-left">
        <h2
          id="about-heading"
          class="display text-4xl md:text-5xl lg:text-6xl text-[var(--color-black)] mb-8"
        >
          {about.headline}{" "}
          <AccentLetters text={about.headlineAccent} />
        </h2>

        <p class="text-lg font-medium text-[var(--color-black)] mb-6 leading-relaxed">
          <Emphasis text={about.lead} />
        </p>
        <p class="text-[var(--color-muted)] mb-4 leading-relaxed">{about.p1}</p>
        <p class="text-[var(--color-muted)] mb-12 leading-relaxed">{about.p2}</p>

        {/* Each tile used to open with a counter — 01, 02, 03, 04 — which
            says "there are four of these" and nothing else. These are the
            reasons to hire someone, so the marker is a PLUS in a filled
            accent disc: the same chip geometry the service pages use for
            their checkmarks, read as a gain rather than as an index. */}
        <ul class="grid sm:grid-cols-2 gap-4 pt-8">
          {about.reasons.map((reason) => (
            <li
              class="rounded-[6px] bg-[var(--color-soft)] p-5 text-left"
              data-reveal
            >
              <span
                aria-hidden="true"
                title={gainLabel}
                class="mb-3 inline-flex h-7 w-7 items-center justify-center rounded-full bg-[color-mix(in_srgb,var(--color-accent)_12%,var(--color-paper))] text-[var(--color-accent)]"
              >
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                >
                  <line x1="12" y1="5" x2="12" y2="19" />
                  <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
              </span>
              <h3 class="font-[var(--font-display)] text-lg text-[var(--color-black)] mb-2 leading-tight">
                {reason.title}
              </h3>
              <p class="text-sm text-[var(--color-muted)] leading-relaxed">
                {reason.description}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ein GRUND, keine Abbildung — dieselbe Regel wie bei
     `.service-card__photo`, nur noch leiser: dieser Abschnitt ist der
     ruhigste der Seite und trägt vier Textkacheln plus das Portrait.
     Dark Mode geht weiter herunter, wie die geteilten Decor-Tokens. */
  .about-photo {
    opacity: 0.27;
  }
  :global(:root[data-theme="dark"]) .about-photo {
    opacity: 0.17;
  }
  /* Die PAPIERFARBE des Abschnitts, von rechts auslaufend — kein grauer
     Schleier, damit die Fläche ihren Farbton behält. Rechts steht die
     Textspalte, dort deckt er fast ganz. */
  .about-photo-scrim {
    background: linear-gradient(
      to left,
      var(--color-paper) 24%,
      color-mix(in srgb, var(--color-paper) 74%, transparent) 66%,
      color-mix(in srgb, var(--color-paper) 46%, transparent) 100%
    );
  }
</style>
