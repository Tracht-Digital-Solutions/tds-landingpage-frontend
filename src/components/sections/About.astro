---
import { Image } from "astro:assets";
import { tFor, resolveLang } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
import AccentLetters from "~/components/ui/AccentLetters.astro";
import portrait from "~/assets/portrait.webp";

const t = tFor(Astro.currentLocale);
const lang = resolveLang(Astro.currentLocale);

// Editable about copy — admin block overrides the tds-shared default at
// build time. portraitPlaceholder is excluded (the portrait is a real
// asset now), so the editable shape matches the API validator.
const about = await cmsFor("about", lang, {
  label: t.about.label,
  headline: t.about.headline,
  headlineAccent: t.about.headlineAccent,
  lead: t.about.lead,
  p1: t.about.p1,
  p2: t.about.p2,
  stat1Value: t.about.stat1Value,
  stat1Label: t.about.stat1Label,
  stat2Value: t.about.stat2Value,
  stat2Label: t.about.stat2Label,
  stat3Value: t.about.stat3Value,
  stat3Label: t.about.stat3Label,
});

const stats = [
  { value: about.stat1Value, label: about.stat1Label },
  { value: about.stat2Value, label: about.stat2Label },
  { value: about.stat3Value, label: about.stat3Label },
];
---

{/* Warmweiß mit weichen Markenfeldern an den Außenrändern — the first
    paper section after the hero, so it sets the ground for everything
    that follows. The fields come from the shared `.tds-wash`; they are
    dialled down on phones and in dark mode by the decor tokens. */}
<section
  id="about"
  class="tds-wash section-spacing"
  aria-labelledby="about-heading"
>
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <div class="grid md:grid-cols-2 gap-16 lg:gap-24 items-start">
      <div class="md:sticky md:top-28 max-w-sm mx-auto md:mx-0">
        <div class="relative">
          {/* The portrait is framed by CONSTRUCTED geometry, not by a
              glow: one strongly-rounded rectangle, offset behind the
              cut-out. The blurred pink radial that used to sit here read
              as the same soft haze the hero has now dropped — "keine
              starken Glow-Effekte" — and it framed nothing, because a
              blur has no edge to frame with.

              ONE shape, not two. A second quarter-circle catching the
              lower left was tried and removed: at this size it read as a
              stray grey block behind the shoulder rather than as a cut
              corner, which is the failure mode of small geometry — it
              needs enough length for the arc to be legible as an arc. */}
          <span
            aria-hidden="true"
            class="tds-shape tds-shape--rect tds-shape--coral -z-10"
            style="inset: -1.25rem -2rem 2.5rem -1.25rem;"></span>
          <Image
            src={portrait}
            alt="Julian Tracht"
            widths={[300, 450, 600, 900]}
            sizes="(min-width: 768px) 24rem, 60vw"
            loading="eager"
            class="portrait-fade rounded-[2px] aspect-[3/4] object-cover object-top w-full"
          />
        </div>
      </div>

      <div class="text-center md:text-left">
        <h2
          id="about-heading"
          class="display text-4xl md:text-5xl lg:text-6xl text-[var(--color-black)] mb-8"
        >
          {about.headline}{" "}
          <AccentLetters text={about.headlineAccent} />
        </h2>

        <p class="text-lg font-medium text-[var(--color-black)] mb-6 leading-relaxed">
          {about.lead}
        </p>
        <p class="text-[var(--color-muted)] mb-4 leading-relaxed">{about.p1}</p>
        <p class="text-[var(--color-muted)] mb-12 leading-relaxed">{about.p2}</p>

        <div class="grid grid-cols-3 gap-4 pt-12">
          {stats.map(({ value, label }) => (
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-[var(--font-display)] font-medium text-[var(--color-primary)] mb-1">
                {value}
              </div>
              <div class="text-xs text-[var(--color-muted)] leading-tight">{label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
