---
/**
 * Hero — the page's first answer to "is this for me, and what do I get?"
 *
 * Left: who it is for (eyebrow), the benefit (H1), the problems and the
 * outcome (sub), and two actions — one primary. Right from `lg`, below the
 * actions on smaller screens: three facts a visitor can check, each linking to
 * the section that proves it.
 *
 * ### What replaced what, so nobody restores it
 *
 * - **The COPY is `.astro`, not a React island.** The island rendered its
 *   eyebrow, headline, sub and buttons as motion elements, and their
 *   server-rendered markup carried the entrance's start state:
 *   `style="opacity:0"`. Until React hydrated, the most important screen of the
 *   site was blank — and on a phone the largest thing to paint first was the
 *   cookie notice, which became the page's LCP element at 4.1 s. The copy is
 *   plain HTML and paints with the first frame; its entrance is a
 *   transform-only CSS rise, off under reduced motion.
 *
 *   The decorative geometry is a different question and is a `motion` island
 *   (`islands/HeroDecor.tsx`, `client:idle`): those shapes are `aria-hidden`
 *   decoration, so nothing a visitor reads waits on them. The photo stays
 *   here, in plain markup, for the same reason the copy does.
 * - **No showcase slider.** It rotated every 6 s through six slides, put a demo
 *   site's name in the page's first `<h2>`, and gave a real customer case and a
 *   fictional demo the identical card. Customer cases and example sites have
 *   their own, clearly labelled sections now (`CustomerCases`, `Showcase`).
 * - **No brand motto above the H1.** "Digitale Lösungen, die wirklich passen."
 *   said nothing a visitor could check; the eyebrow names the audience instead.
 * - **No scroll hint.** The trust card is the reason to look further.
 *
 * ### Decoration
 *
 * Only in the hero's true negative space: below the actions on the left and in
 * the lower right corner, both cut by the section's edge. Nothing sits behind
 * the eyebrow, the headline, the sub, the buttons, the trust card or the fixed
 * navigation — the diagonal that crossed the header and the capsule behind the
 * eyebrow were removed for that reason, and `scripts/ux-audit.mjs` measures the
 * overlap. The capsule and the quarter circle still start at `xl`: at 768 and
 * 1024 px the actions and the trust card reach down into exactly that space
 * (measured, twice). Since 2026-09-21 the small gold NODE renders below that
 * too, in the free band above the eyebrow — before, a phone had no motion in
 * the hero at all. The conduit (`CircuitRun`) stays `xl`.
 *
 * The photo is a `<picture>` whose source applies from `48rem`; below that the
 * `<img>` holds a 1×1 inline GIF. It used to be a plain `<img class="hidden
 * md:block">`, which every phone downloaded (60 KB) and never showed.
 */
import type { Lang } from "~/lib/i18n";
import type { HomeHeroContent, ResolvedTrustFact } from "~/lib/homeContent";
import Emphasis from "~/components/ui/Emphasis.astro";
import CircuitRun from "~/components/ui/CircuitRun.astro";
import HeroDecor from "~/components/islands/HeroDecor.tsx";

interface Props {
  lang: Lang;
  hero: HomeHeroContent;
  trust: { title: string; facts: ResolvedTrustFact[] };
}

const { lang, hero, trust } = Astro.props;

---

<section
  id="hero"
  class="hero relative min-h-svh flex flex-col justify-center overflow-hidden"
  aria-labelledby="hero-heading"
  lang={lang === "en" ? "en" : undefined}
>
  <div class="tds-decor" aria-hidden="true">
    <picture>
      <source media="(min-width: 48rem)" srcset="/images/sections/hero.webp" type="image/webp" />
      <img
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
        alt=""
        width="1642"
        height="958"
        decoding="async"
        class="hero-photo absolute inset-0 h-full w-full object-cover object-right"
      />
    </picture>
    <span class="hero-photo-scrim hidden md:block absolute inset-0"></span>

    {/* Die konstruierte Geometrie — große Kapsel links unten angeschnitten,
        Viertelkreis unten rechts über beide Ränder hinaus, ein einzelner
        Ocker-Knoten als Akzent. Sie liegen alle in der echten Negativfläche
        des Heros, nie hinter der Copy.

        `client:idle`, und seit 2026-09-21 auf jeder Breite. Vorher lud die
        Island erst ab 64rem, weil ALLE Formen darunter ausgeblendet waren —
        ein Telefon hatte damit gar keine Bewegung im Hero. Jetzt laeuft dort
        wenigstens der Knoten. Das kostet
        gemessen ~129 KB JS dort; bezahlt wird es aus den Einsparungen
        derselben Änderung, und `npm run audit:perf` bewacht die Grenze.

        AUSSCHLIESSLICH diese drei Formen: das Foto oben und jeder Textknoten
        unten bleiben statisches Astro-Markup, damit nichts Sichtbares auf
        Hydration wartet. Die Begründung steht in `islands/HeroDecor.tsx`,
        die Regel in `__tests__/motion.test.ts`. */}
    <HeroDecor client:idle />
    {/* Cut by the section's lower edge, with its box inside the bottom padding:
        since the note under the actions the copy column reaches down to where
        the conduit used to start (overlap measured at 1280 and 1440). */}
    <CircuitRun class="hidden xl:block -bottom-14 left-[20%] w-[15rem] h-[8rem]" />
  </div>

  <div class="hero-body relative max-w-7xl mx-auto px-6 md:px-8 lg:px-12 w-full">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="hero-eyebrow hero-rise">{hero.eyebrow}</p>

        {/* The headline rises as ONE block, and that was measured, not
            assumed.

            It was briefly split into per-word spans for a staggered entrance.
            Two things broke, neither of them visible:

            1. **It stopped being the LCP element.** A transform does nothing
               to a non-replaced inline box, so each word had to be
               `inline-block` — which turned one text block of 37,898 px² into
               nine candidates of a few hundred each. None beat the paragraph
               below, so `p#hero-sub` became the largest paint and the
               headline dropped out of the metric entirely. `audit:perf`
               pins the element for exactly this reason.
            2. **It stopped being hyphenatable.** An `inline-block` never
               breaks inside itself, so `hyphens: auto` and
               `overflow-wrap: break-word` below — which exist because one
               15-letter German word at 34 px on a 320 px screen is already
               close — would have had nothing to act on. A longer word from
               the CMS would simply have run off the screen.

            The stagger lives in the elements AROUND it instead: eyebrow,
            headline, sub, actions, note, trust card, each on its own delay.
            That reads as a page assembling itself and costs the headline
            nothing. */}
        <h1 id="hero-heading" class="hero-title hero-rise">
          {hero.headline}
          {/* A real break, not a hope: `text-wrap: balance` would otherwise
              pull the accent word up onto line one. */}
          <br />
          <span class="hero-accent">{hero.headlineAccent}</span>{" "}{hero.headlineSuffix}
        </h1>

        <p id="hero-sub" class="hero-sub hero-rise">
          <Emphasis text={hero.sub} />
        </p>

        {/* Real anchors: they work before JavaScript, open in a new tab, and
            `SmoothScroll` gives them the site's jump when it is there. */}
        <div class="hero-actions hero-rise">
          <a href="#contact" class="hero-cta hero-cta--primary">{hero.cta1}</a>
          <a href="#services" class="hero-cta hero-cta--secondary">{hero.cta2}</a>
        </div>
        {/* The risk taken off the primary action, in the two sentences the site
            is allowed to say about it: when costs arise, and how soon an answer
            comes. No "free", no minutes (homeContent.test.ts). */}
        {hero.ctaNote && <p class="hero-note hero-rise">{hero.ctaNote}</p>}
      </div>

      {
        trust.facts.length > 0 && (
          <div class="hero-trust hero-rise">
            <h2 class="hero-trust__title">{trust.title}</h2>
            <ul class="hero-trust__list">
              {trust.facts.map((fact) => (
                <li class="hero-trust__fact">
                  <span class="hero-trust__mark" aria-hidden="true">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  </span>
                  <div>
                    <p class="hero-trust__name">{fact.title}</p>
                    <p class="hero-trust__text">{fact.text}</p>
                    <a class="hero-trust__link" href={fact.href}>
                      {fact.linkLabel}
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 6.25rem;
    padding-bottom: 3.5rem;
  }
  @media (min-width: 768px) {
    .hero {
      padding-top: 7rem;
      padding-bottom: 5rem;
    }
  }
  /* Landscape phones: the viewport is too short to hold the hero, so it
     releases its minimum height rather than pushing everything below it. */
  @media (max-height: 40rem) and (orientation: landscape) {
    .hero {
      min-height: auto;
    }
  }

  /* Hero-Fotogrund. Ein GRUND, keine Abbildung: niedrige Deckkraft, und im
     Dark Mode noch einmal tiefer. Der Scrim ist die PAPIERFARBE, die nach
     rechts ausläuft — die linke Bildhälfte bleibt so ruhig wie die Fläche. */
  .hero-photo {
    opacity: 0.32;
  }
  :global(:root[data-theme="dark"]) .hero-photo {
    opacity: 0.2;
  }
  .hero-photo-scrim {
    background: linear-gradient(
      to right,
      var(--color-paper) 20%,
      color-mix(in srgb, var(--color-paper) 72%, transparent) 62%,
      color-mix(in srgb, var(--color-paper) 42%, transparent) 100%
    );
  }

  /* === Die Formen der Dekorationsebene =============================

     Position und Groesse stehen HIER, nicht in `islands/HeroDecor.tsx`, und
     zwar `:global()`, weil das DOM einer React-Island Astros
     Scoped-Style-Attribut nie bekommt. Die Trennung ist nicht nur Ordnung:
     so schreibt die Island ausschliesslich Transforms, und genau die kann
     der Compositor bewegen, ohne Layout anzufassen.

     Bis 2026-09-21 waren die Formen unter 64rem ausgeblendet. Sie sind
     jetzt ueberall da, auf dem Telefon kleiner und weiter aussen, damit sie
     in der echten Negativflaeche bleiben und nie hinter der Copy landen. */
  :global(.hero-shape) {
    position: absolute;
    pointer-events: none;
    /* Eigene Ebene, damit Drift und Parallaxe nicht jedes Frame neu rastern. */
    will-change: transform;
  }
  /* Below 80rem the two LARGE shapes are not drawn, and that is measured
     rather than taste. At 390 px the hero's content runs from y=100 to
     y=1054 and spans the full width between the gutters; the only empty
     bands are 100 px at the top and 56 px at the bottom. A capsule or a
     quarter circle put anywhere else lands on the trust card — which
     `npm run audit:ux` reports as "decoration over content", sixteen hard
     failures the first time this was tried. The limit is 80rem and not
     64rem for the same reason the original code gave: at 1024 px the
     buttons and the note reach down into exactly that corner.

     The NODE does fit, and it is the liveliest of the three anyway
     (measured ~49 px/s against the capsule's 9): it sits in the top band
     and walks across it. So a phone gets motion in the hero, in the one
     place the layout actually leaves free. */
  :global(.hero-shape--capsule),
  :global(.hero-shape--quarter) {
    display: none;
  }
  :global(.hero-shape--node) {
    /* The BOTTOM band, not the top one. The top looked free — the copy does
       not start until y=100 on a phone — but the fixed header floats from
       y=12 to roughly y=88, so a node up there sits on the navigation, which
       `audit:ux` reports as decoration over content. Measured, the free band
       below the content is 56 px at 390 px and 122 px at 1024 px, and the
       floating CTA stands down while the hero is on screen. */
    bottom: 1.25rem;
    left: 5%;
    width: 0.5rem;
    height: 0.5rem;
  }
  @media (min-width: 80rem) {
    :global(.hero-shape--capsule),
    :global(.hero-shape--quarter) {
      display: block;
    }
    :global(.hero-shape--capsule) {
      bottom: -7rem;
      left: -16rem;
      width: 32rem;
      height: 13rem;
    }
    :global(.hero-shape--quarter) {
      bottom: -15rem;
      right: -11rem;
      width: 26rem;
      height: 26rem;
    }
    :global(.hero-shape--node) {
      top: auto;
      bottom: 7%;
      left: 44%;
    }
  }

  /* Die scrollgesteuerte Szene. CSS, kein JavaScript: `animation-timeline`
     laeuft auf dem Compositor, braucht keinen Scroll-Listener und keinen
     Hook aus einer Bibliothek, die die geteilte Motion-Schicht gar nicht
     re-exportiert. Wo es fehlt (Safari heute), passiert einfach nichts —
     die Formen behalten ihre Drift und ihre Parallaxe.

     `animation-composition: add` ist das Entscheidende: ohne sie wuerde
     diese Animation die Transforms der Island ERSETZEN statt sich zu ihnen
     zu addieren, und Drift wie Parallaxe waeren beim Scrollen tot. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* The NODE is deliberately not in this list. It already walks its own
         path, and adding the scroll drift on top moved it up to 56 px further
         down — straight onto the eyebrow, which `audit:ux` caught as
         decoration over content at every width. Two travels on one axis also
         read as one confused wobble rather than two ideas. */
      :global(.hero-shape--capsule),
      :global(.hero-shape--quarter) {
        animation: hero-scroll-drift linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
        animation-composition: add;
      }
      :global(.hero-shape--quarter) {
        animation-name: hero-scroll-drift-reverse;
      }
    }
  }
  @keyframes hero-scroll-drift {
    from {
      transform: translateY(-3.5rem);
    }
    to {
      transform: translateY(3.5rem);
    }
  }
  @keyframes hero-scroll-drift-reverse {
    from {
      transform: translateY(3rem);
    }
    to {
      transform: translateY(-3rem);
    }
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  /* `minmax(0, 1fr)`, not `1fr`: a grid track's automatic minimum is its
     min-content, and a large headline would widen the track past the viewport. */
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(19rem, 25rem);
      gap: 3.5rem;
    }
  }

  .hero-copy {
    min-width: 0;
    text-align: center;
  }
  @media (min-width: 768px) {
    .hero-copy {
      text-align: left;
    }
  }

  .hero-eyebrow {
    max-width: 40rem;
    margin: 0 auto 1.25rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.0625rem, 0.95rem + 0.55vw, 1.5rem);
    line-height: 1.35;
    color: var(--color-accent);
  }

  .hero-title {
    max-width: 50rem;
    margin: 0 auto 1.25rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.125rem, 1.35rem + 3.4vw, 4.25rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--color-black);
    font-variation-settings: "opsz" 144;
    /* "Ansprechpartner" is one 15-letter word at 34px on a 320px phone. It
       fits today; a longer CMS word must break at a syllable, not overflow. */
    hyphens: auto;
    overflow-wrap: break-word;
  }
  .hero-accent {
    font-style: italic;
    color: var(--color-accent);
  }

  .hero-sub {
    max-width: 40rem;
    margin: 0 auto 2rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-muted);
  }
  @media (min-width: 768px) {
    .hero-eyebrow,
    .hero-title,
    .hero-sub {
      margin-inline: 0;
    }
    .hero-sub {
      font-size: 1.125rem;
    }
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 1rem;
    }
  }
  @media (min-width: 768px) {
    .hero-actions {
      justify-content: flex-start;
    }
  }

  .hero-note {
    max-width: 40rem;
    margin: 1rem auto 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
  @media (min-width: 768px) {
    .hero-note {
      margin-inline: 0;
    }
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0.875rem 1.75rem;
    border-radius: var(--tds-radius-pill, 100px);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 200ms var(--tds-ease-out),
      color 200ms var(--tds-ease-out),
      transform 200ms var(--tds-ease-out);
  }
  /* The primary action is the one filled, dark shape in the hero — clear
     without a glow, a pulse or a countdown. */
  .hero-cta--primary {
    background: var(--color-surface-navy);
    color: #fff;
  }
  .hero-cta--primary:hover {
    background: var(--color-surface-accent);
    transform: translateY(-2px);
  }
  .hero-cta--secondary {
    background: color-mix(in srgb, var(--color-card) 88%, transparent);
    color: var(--color-black);
  }
  .hero-cta--secondary:hover {
    background: color-mix(in srgb, var(--color-primary) 10%, var(--color-card));
    color: var(--color-primary);
  }

  .hero-trust {
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    padding: 1.5rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-card) 94%, transparent);
    text-align: left;
  }
  /* The copy turns left-aligned at 768px, so the card follows it there — a
     centred card under a left-aligned column sat 112px off its edge. */
  @media (min-width: 48rem) {
    .hero-trust {
      margin-inline: 0;
    }
  }
  .hero-trust__title {
    margin: 0 0 1.125rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--color-black);
  }
  .hero-trust__list {
    display: grid;
    gap: 1.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero-trust__fact {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.75rem;
  }
  .hero-trust__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 0.05rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-accent) 16%, var(--color-card));
    color: var(--color-accent);
  }
  .hero-trust__name {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-black);
  }
  .hero-trust__text {
    margin: 0.2rem 0 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .hero-trust__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }
  .hero-trust__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (pointer: coarse) {
    .hero-trust__link {
      min-height: 2.75rem;
    }
  }

  /* The entrance: a short rise, TRANSFORM ONLY. An opacity fade would hide the
     headline for its first frames — exactly the late paint this component
     stopped doing — and a transform shifts nothing around it. Opt-in, so the
     reduced-motion default is the resting state. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-rise {
      animation: hero-rise 560ms var(--lp-ease-soft) both;
    }
    .hero-title.hero-rise {
      animation-delay: 90ms;
    }
    .hero-sub.hero-rise {
      animation-delay: 220ms;
    }
    .hero-actions.hero-rise {
      animation-delay: 300ms;
    }
    .hero-note.hero-rise {
      animation-delay: 360ms;
    }
    .hero-trust.hero-rise {
      animation-delay: 420ms;
    }
    .hero-cta--primary:hover {
      transform: translateY(-2px);
    }
  }
  @keyframes hero-rise {
    from {
      transform: translateY(1.5rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-cta,
    .hero-cta--primary:hover {
      transition: none;
      transform: none;
    }
  }
</style>
