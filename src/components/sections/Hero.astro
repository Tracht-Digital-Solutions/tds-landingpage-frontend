---
/**
 * Hero — what the business does, the slogan and two actions (2026-11-13;
 * before that the slogan alone was the H1, decided 2026-09-21): the eyebrow, the benefit sub, the note under the buttons and the
 * trust card are gone. Who it is for and what it costs are answered by the
 * sections below and by the meta description; the first screen says the one
 * sentence the brand stands for and offers the two ways on.
 *
 * The H1 IS the slogan, read from the same `footer` block the footer prints
 * (tds-shared `footer.slogan`, panel-editable), so there is one source.
 *
 * ### What must not come back
 *
 * - **No React island for the copy.** The old island server-rendered Motion's
 *   `opacity:0` start state, the hero was blank until hydration and the
 *   cookie notice became the mobile LCP at 4.1 s. The H1 is plain Astro and
 *   paints with the first frame; its entrance is a transform-only CSS rise.
 * - **No scroll hint.** The showcase slider that once stood here was a
 *   React island; its successor (2026-10-12) is `ui/HeroCarousel.astro`, plain
 *   markup that renders in its resting pose, right of the slogan from 64rem.
 *
 * ### Background
 *
 * None of its own since 2026-11-03: no photo, no capsule, no quarter, no
 * conduit. The hero lies on the page ground (`components/PageGround.astro`),
 * whose generated 3D shapes turn toward the pointer while the hero is on
 * screen and move with the scroll (`lib/motion/groundScroll.ts`).
 */
import Arrow from "~/components/ui/Arrow.astro";
import type { Lang } from "~/lib/i18n";
import HeroCarousel from "~/components/ui/HeroCarousel.astro";

interface Props {
  lang: Lang;
  /** The H1: services in the words a search uses. */
  title: string;
  /** One sentence under the H1: who, where, what follows. */
  lead: string;
  /** The brand slogan, the small line above the H1. */
  slogan: string;
  cta1: string;
  cta2: string;
}

const { lang, title, lead, slogan, cta1, cta2 } = Astro.props;

---

<section
  id="hero"
  class="hero relative flex flex-col justify-center overflow-clip"
  aria-labelledby="hero-heading"
  lang={lang === "en" ? "en" : undefined}
>
  {/* A random handful of our own examples on a turning wheel, right of the
      slogan from 64rem. Plain Astro: it paints in its resting pose. */}
  <HeroCarousel lang={lang} />

  <div class="hero-body relative lp-container">
    <div class="hero-copy">
      {/* One text block, and the LCP element. It rises as ONE block: a
          per-word split made every word an inline-block, which fragmented the
          H1 into small LCP candidates and removed every chance for
          `hyphens: auto` to break a long word. */}
      <p class="hero-slogan hero-rise">{slogan}</p>
      <h1 id="hero-heading" class="hero-title hero-rise">{title}</h1>
      <p id="hero-lead" class="hero-lead hero-rise">{lead}</p>
      {/* The brand's three-part bar, drawn out from the left once the slogan
          has landed (2026-09-22). Decoration: `aria-hidden`, uncovered by a
          round clip (never scaled, so the segments stay pills), and at rest
          without motion. */}
      <span aria-hidden="true" class="tds-brandbar hero-brandbar"></span>

      {/* Real anchors: they work before JavaScript, and `lib/smoothScroll.ts` gives
          them the site's jump when it is there. The primary one is Motion's
          CTA (`data-cta`, lib/motion/cta.ts). */}
      <div class="hero-actions hero-rise">
        <a href="#contact" class="hero-cta hero-cta--primary" data-cta data-track="hero-primary">
          {cta1}
          <span aria-hidden="true" class="hero-cta__arrow"><Arrow dir="right" /></span>
        </a>
        <a href="#services" class="hero-cta hero-cta--secondary" data-track="hero-secondary">{cta2}</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Not a full screen: the next section's heading stays close below the actions. */
  .hero {
    min-height: min(82svh, 46rem);
    padding-top: 6.25rem;
    padding-bottom: 3.5rem;
  }
  @media (min-width: 768px) {
    .hero {
      padding-top: 7rem;
      padding-bottom: 5rem;
    }
  }
  /* Landscape phones: the viewport is too short to hold the hero, so it
     releases its minimum height rather than pushing everything below it. */
  @media (max-height: 40rem) and (orientation: landscape) {
    .hero {
      min-height: auto;
    }
  }

  /* The copy's container spans the hero's full width over the carousel
     (`ui/HeroCarousel.astro`), and the H1's box (18ch of a 7.5rem face)
     reaches far past its last letter. Only the two actions take the
     pointer, so the carousel's front card stays reachable beside them. */
  .hero-body {
    pointer-events: none;
  }
  .hero-body a {
    pointer-events: auto;
  }

  .hero-copy {
    min-width: 0;
    max-width: 72rem;
    text-align: center;
  }
  @media (min-width: 768px) {
    .hero-copy {
      text-align: left;
    }
  }

  /* The slogan is the only text on the screen, so it carries the size the
     eyebrow, sub and card used to share. */
  .hero-slogan {
    margin: 0 auto 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 600;
    color: var(--color-primary);
  }
  .hero-lead {
    max-width: 40rem;
    margin: 0 auto 2rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-black);
  }
  @media (min-width: 768px) {
    .hero-slogan,
    .hero-lead {
      margin-inline: 0;
    }
  }

  .hero-title {
    max-width: 20ch;
    margin: 0 auto 1.5rem;
    font-family: var(--font-display);
    font-weight: 500;
    /* 3rem floor since 2026-09-22: at 2.5rem the slogan was a small island in
       the middle of an empty phone screen. */
    font-size: clamp(2.375rem, 1rem + 4.2vw, 5.25rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--color-black);
    font-variation-settings: "opsz" 144;
    text-wrap: balance;
    /* A long word from the panel must break at a syllable, not overflow a
       320 px phone. */
    hyphens: auto;
    /* …but only a LONG word. `text-wrap: balance` prefers a hyphen to two
       uneven lines, so at 48px it set "Digitale Lösun- / gen, die passen."
       on every phone. Under 12 characters a word is never split. */
    hyphenate-limit-chars: 12 5 5;
    overflow-wrap: break-word;
  }
  @media (min-width: 768px) {
    .hero-title {
      margin-inline: 0;
    }
  }

  .hero-brandbar {
    --tds-brandbar-height: 0.3rem;
    margin: 0 auto 2.25rem;
  }
  @media (min-width: 768px) {
    .hero-brandbar {
      margin-inline: 0;
      --tds-brandbar-1: 4rem;
      --tds-brandbar-2: 1.75rem;
      --tds-brandbar-3: 0.875rem;
    }
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 1rem;
    }
  }
  @media (min-width: 768px) {
    .hero-actions {
      justify-content: flex-start;
    }
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0.875rem 1.75rem;
    border-radius: var(--tds-radius-pill, 100px);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 200ms var(--tds-ease-out),
      color 200ms var(--tds-ease-out),
      translate 160ms var(--tds-ease-out);
    /* No `transform` transition: Motion writes the transform every frame,
       and a CSS transition on top would smear each of those writes. */
  }
  /* The primary action is the one filled, dark shape in the hero — clear
     without a glow, a pulse or a countdown. */
  .hero-cta--primary {
    /* Glass (2026-09-29): 88%, with the blur coming from the shared CTA rule in
       global.css. It carries white type over the hero PHOTO, which is the
       worst backdrop on the site — `npm run audit:contrast` measures this one
       from rendered pixels, because axe cannot resolve a translucent fill and
       files it as "incomplete" rather than as a violation. */
    --lp-fill: color-mix(in oklab, var(--color-surface-navy) 88%, transparent);
    --lp-shade: var(--color-accent-pink);
    background: var(--lp-fill);
    color: #fff;
  }
  /* No hover transform here: the button's movement is Motion's (magnetic
     pull and press, lib/motion/cta.ts), and a CSS transform would fight the
     inline one it writes. */
  .hero-cta--primary:hover {
    --lp-fill: color-mix(in oklab, var(--color-surface-accent) 88%, transparent);
    --lp-shade: initial;
  }
  .hero-cta__arrow {
    margin-left: 0.5rem;
    transition: transform 200ms var(--tds-ease-out);
  }
  .hero-cta--primary:hover .hero-cta__arrow {
    transform: translateX(3px);
  }
  .hero-cta--secondary {
    --lp-fill: color-mix(in srgb, var(--color-card) 88%, transparent);
    --lp-shade: initial;
    background: var(--lp-fill);
    color: var(--color-black);
  }
  .hero-cta--secondary:hover {
    --lp-fill: color-mix(in srgb, var(--color-primary) 10%, var(--color-card));
    --lp-shade: var(--color-accent-pink);
    color: var(--color-primary);
  }
  /* Dark mode (2026-10-05): navy on the near-black ground measured 1.3–1.6:1
     against it — the button was barely there. The CTA takes the dark
     theme's pastel pair instead: periwinkle `--color-primary` with dark
     `--color-on-primary`, coral `--color-accent` on hover. In the light theme
     nothing here applies. */
  :global(:is(:root, .tds-theme-preview__page)[data-theme="dark"]) .hero-cta--primary:not(:where([data-theme="dark"] [data-theme="light"] *)) {
    --lp-fill: color-mix(in oklab, var(--color-primary) 92%, transparent);
    --lp-shade: var(--color-accent-pink);
    color: var(--color-on-primary);
  }
  :global(:is(:root, .tds-theme-preview__page)[data-theme="dark"]) .hero-cta--primary:hover:not(:where([data-theme="dark"] [data-theme="light"] *)) {
    --lp-fill: color-mix(in oklab, var(--color-accent) 92%, transparent);
    --lp-shade: initial;
    color: var(--color-on-accent);
  }
  /* The second button: a surface tinted toward the primary, so it separates
     from the ground (it measured 1.17:1) without competing with the first. */
  :global(:is(:root, .tds-theme-preview__page)[data-theme="dark"]) .hero-cta--secondary:not(:where([data-theme="dark"] [data-theme="light"] *)) {
    --lp-fill: color-mix(in srgb, var(--color-primary) 22%, var(--color-card));
    --lp-shade: var(--color-accent-pink);
    color: var(--color-black);
  }
  :global(:is(:root, .tds-theme-preview__page)[data-theme="dark"]) .hero-cta--secondary:hover:not(:where([data-theme="dark"] [data-theme="light"] *)) {
    --lp-fill: color-mix(in srgb, var(--color-primary) 34%, var(--color-card));
    --lp-shade: var(--color-accent-pink);
    color: var(--color-black);
  }

  /* The entrance: a short rise, TRANSFORM ONLY. An opacity fade would hide the
     headline for its first frames — exactly the late paint this component
     stopped doing — and a transform shifts nothing around it. Opt-in, so the
     reduced-motion default is the resting state. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-rise {
      animation: hero-rise 560ms var(--lp-ease-soft) both;
    }
    .hero-actions.hero-rise {
      animation-delay: 160ms;
    }
    /* The bar draws itself once the slogan has landed, with a small
       overshoot — the one flourish on the first screen. */
    .hero-brandbar {
      animation: hero-bar-draw 900ms var(--lp-ease-soft, var(--tds-ease-out)) 380ms backwards;
    }

    /* Scrolling away, the copy drifts up a little faster than the page and
       the bar stretches — transform only, on the compositor, and nothing at
       all where scroll timelines are missing. */
    /* Live since 2026-10-12. Until then none of the hero's scroll timelines
       ever ran: the section was `overflow: hidden`, which makes it a SCROLL
       CONTAINER, so every `view()` inside it measured the hero itself — a box
       that never scrolls — and stayed at progress 0. `overflow: clip` clips
       the same way without becoming a scroll container.

       ONE timeline for the copy AND the carousel: the copy's box names it, the
       section shares it (`timeline-scope`), so the cards leave by exactly the
       copy's amount and the slogan never slides across them. */
    @supports (animation-timeline: view()) {
      .hero {
        timeline-scope: --hero-copy;
      }
      .hero-body {
        view-timeline-name: --hero-copy;
      }
      .hero-body,
      :global(.hero-carousel) {
        animation: hero-copy-leave linear both;
        animation-timeline: --hero-copy;
        animation-range: exit 0% exit 100%;
      }
    }
  }
  @keyframes hero-rise {
    from {
      transform: translateY(1.5rem);
    }
  }
  /* Drawn by uncovering, not by scaling (2026-10-11): a `scaleX` squashed the
     segments' round ends into slivers while it ran. The clip has round
     corners of its own, so the leading edge is a pill end too. `backwards`,
     not `both`: once drawn the bar carries no clip, so its keys can hop above
     it. */
  @keyframes hero-bar-draw {
    from {
      clip-path: inset(0 100% 0 0 round var(--tds-radius-pill));
    }
    to {
      clip-path: inset(0 0 0 0 round var(--tds-radius-pill));
    }
  }
  @keyframes hero-copy-leave {
    to {
      transform: translateY(-4.5rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-cta,
    .hero-cta__arrow {
      transition: none;
      transform: none;
    }
  }
</style>
