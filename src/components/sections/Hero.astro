---
/**
 * Hero — the brand's slogan and two actions. Nothing else (decided
 * 2026-09-21): the eyebrow, the benefit sub, the note under the buttons and the
 * trust card are gone. Who it is for and what it costs are answered by the
 * sections below and by the meta description; the first screen says the one
 * sentence the brand stands for and offers the two ways on.
 *
 * The H1 IS the slogan, read from the same `footer` block the footer prints
 * (tds-shared `footer.slogan`, panel-editable), so there is one source.
 *
 * ### What must not come back
 *
 * - **No React island for the copy.** The old island server-rendered Motion's
 *   `opacity:0` start state, the hero was blank until hydration and the
 *   cookie notice became the mobile LCP at 4.1 s. The H1 is plain Astro and
 *   paints with the first frame; its entrance is a transform-only CSS rise.
 * - **No showcase slider, no scroll hint.**
 *
 * ### Decoration
 *
 * Only in the negative space, never behind the copy or the fixed header —
 * `scripts/ux-audit.mjs` measures the overlap. `HeroDecor` is the one island
 * (`client:idle`): the capsule and the quarter render
 * in the free bands on every width (the gold node and the "fit" motif went
 * on 2026-09-22).
 *
 * The photo is a `<picture>` whose source applies from `48rem`; a phone gets a
 * 1×1 GIF and downloads nothing. It carries `data-motion-image`: Motion
 * (`lib/motion/images.ts`) settles and drifts it — transform only, never an
 * opacity start state.
 */
import type { Lang } from "~/lib/i18n";
import CircuitRun from "~/components/ui/CircuitRun.astro";
import HeroDecor from "~/components/islands/HeroDecor.tsx";

interface Props {
  lang: Lang;
  /** The brand slogan — the page's H1. */
  slogan: string;
  cta1: string;
  cta2: string;
}

const { lang, slogan, cta1, cta2 } = Astro.props;
---

<section
  id="hero"
  class="hero relative min-h-svh flex flex-col justify-center overflow-hidden"
  aria-labelledby="hero-heading"
  lang={lang === "en" ? "en" : undefined}
>
  <div class="tds-decor" aria-hidden="true">
    <picture>
      <source media="(min-width: 48rem)" srcset="/images/sections/hero.webp" type="image/webp" />
      <img
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
        alt=""
        width="1642"
        height="958"
        decoding="async"
        class="hero-photo absolute inset-0 h-full w-full object-cover object-right"
        data-motion-image
      />
    </picture>
    <span class="hero-photo-scrim hidden md:block absolute inset-0"></span>

    {/* Die konstruierte Geometrie — große Kapsel links unten angeschnitten,
        Viertelkreis unten rechts über beide Ränder hinaus. Sie liegen alle
        in der echten Negativfläche
        des Heros, nie hinter der Copy.

        `client:idle`, und seit 2026-09-21 auf jeder Breite. Vorher lud die
        Island erst ab 64rem, weil ALLE Formen darunter ausgeblendet waren —
        ein Telefon hatte damit gar keine Bewegung im Hero. Jetzt bewegen sich
        dort Kapsel und Viertelkreis. Das kostet
        gemessen ~129 KB JS dort; bezahlt wird es aus den Einsparungen
        derselben Änderung, und `npm run audit:perf` bewacht die Grenze.

        AUSSCHLIESSLICH diese Formen: das Foto oben und jeder Textknoten
        unten bleiben statisches Astro-Markup, damit nichts Sichtbares auf
        Hydration wartet. Die Begründung steht in `islands/HeroDecor.tsx`,
        die Regel in `__tests__/motion.test.ts`. */}
    <HeroDecor client:idle />
    {/* Cut by the section's lower edge, with its box inside the bottom padding:
        since the note under the actions the copy column reaches down to where
        the conduit used to start (overlap measured at 1280 and 1440). */}
    <CircuitRun class="hidden xl:block -bottom-14 left-[20%] w-[15rem] h-[8rem]" />
  </div>

  <div class="hero-body relative lp-container">
    <div class="hero-copy">
      {/* One text block, and the LCP element. It rises as ONE block: a
          per-word split made every word an inline-block, which fragmented the
          H1 into small LCP candidates and removed every chance for
          `hyphens: auto` to break a long word. */}
      <h1 id="hero-heading" class="hero-title hero-rise">{slogan}</h1>
      {/* The brand's three-part bar, drawn out from the left once the slogan
          has landed (2026-09-22). Decoration: `aria-hidden`, transform only,
          and at rest without motion. */}
      <span aria-hidden="true" class="tds-brandbar hero-brandbar"></span>

      {/* Real anchors: they work before JavaScript, and `SmoothScroll` gives
          them the site's jump when it is there. The primary one is Motion's
          CTA (`data-cta`, lib/motion/cta.ts). */}
      <div class="hero-actions hero-rise">
        <a href="#contact" class="hero-cta hero-cta--primary" data-cta>
          {cta1}
          <span aria-hidden="true" class="hero-cta__arrow">→</span>
        </a>
        <a href="#services" class="hero-cta hero-cta--secondary">{cta2}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 6.25rem;
    padding-bottom: 3.5rem;
  }
  @media (min-width: 768px) {
    .hero {
      padding-top: 7rem;
      padding-bottom: 5rem;
    }
  }
  /* Landscape phones: the viewport is too short to hold the hero, so it
     releases its minimum height rather than pushing everything below it. */
  @media (max-height: 40rem) and (orientation: landscape) {
    .hero {
      min-height: auto;
    }
  }

  /* Hero-Fotogrund. Ein GRUND, keine Abbildung: niedrige Deckkraft, und im
     Dark Mode noch einmal tiefer. Der Scrim ist die PAPIERFARBE, die nach
     rechts ausläuft — die linke Bildhälfte bleibt so ruhig wie die Fläche. */
  .hero-photo {
    opacity: 0.32;
  }
  :global(:root[data-theme="dark"]) .hero-photo {
    opacity: 0.2;
  }
  .hero-photo-scrim {
    background: linear-gradient(
      to right,
      var(--color-paper) 20%,
      color-mix(in srgb, var(--color-paper) 72%, transparent) 62%,
      color-mix(in srgb, var(--color-paper) 42%, transparent) 100%
    );
  }

  /* === Die Formen der Dekorationsebene =============================

     Position und Groesse stehen HIER, nicht in `islands/HeroDecor.tsx`, und
     zwar `:global()`, weil das DOM einer React-Island Astros
     Scoped-Style-Attribut nie bekommt. Die Trennung ist nicht nur Ordnung:
     so schreibt die Island ausschliesslich Transforms, und genau die kann
     der Compositor bewegen, ohne Layout anzufassen.

     Bis 2026-09-21 waren die Formen unter 64rem ausgeblendet. Sie sind
     jetzt ueberall da, auf dem Telefon kleiner und weiter aussen, damit sie
     in der echten Negativflaeche bleiben und nie hinter der Copy landen. */
  :global(.hero-shape) {
    position: absolute;
    pointer-events: none;
    /* Eigene Ebene, damit Drift und Parallaxe nicht jedes Frame neu rastern. */
    will-change: transform;
  }
  /* Until 2026-09-22 the two large shapes were not drawn below 80rem: with
     the trust card in the hero, the only free bands on a phone were 100 px
     at the top and 56 px at the bottom, and `audit:ux` reported sixteen
     "decoration over content" failures the first time they were tried. */
  /* 2026-09-22: the measurement above is from the hero WITH its trust card.
     Since the hero is the slogan and two buttons, a 390 px phone has about
     250 px free between the header (ends y=76) and the slogan (y≈320), and
     about 280 px below the buttons (y≈565 to 844). So the phone gets the
     whole scene again, smaller and at the edges: the quarter in the top band
     under the header's right end, the capsule in the bottom band from the
     left edge. Each stays in its band;
     `audit:ux` measures it. */
  :global(.hero-shape--quarter) {
    top: 5.75rem;
    right: calc(min(9rem, 14svh) * -0.5);
    /* Tied to the height: on a 740 px phone the slogan starts ~220 px down. */
    width: min(9rem, 14svh);
    height: min(9rem, 14svh);
  }
  :global(.hero-shape--capsule) {
    /* Low in the band: its drift lifts it, and on a 360×740 phone the
       buttons end about 180 px above the bottom edge (`audit:ux`). On a
       first visit the cookie notice covers it, which is the lesser evil. */
    bottom: 1.5rem;
    left: -4.5rem;
    width: 12rem;
    height: 4.75rem;
  }
  @media (max-width: 79.999rem) and (max-height: 46rem) {
    /* Short screens (an SE, a landscape phone, a window zoomed to 400 %): the
       copy fills the hero and there is no free band left, so the scene stays
       out — `audit:ux` measured the quarter on the slogan at 720×450. */
    :global(.hero-shape--capsule),
    :global(.hero-shape--quarter) {
      display: none;
    }
  }
  @media (min-width: 48rem) {
    :global(.hero-shape--quarter) {
      top: 7rem;
      right: -5rem;
      width: 13rem;
      height: 13rem;
    }
    :global(.hero-shape--capsule) {
      bottom: 3rem;
      left: -6rem;
      width: 18rem;
      height: 7rem;
    }
  }
  @media (min-width: 80rem) {
    :global(.hero-shape--capsule) {
      bottom: -7rem;
      left: -16rem;
      width: 32rem;
      height: 13rem;
    }
    :global(.hero-shape--quarter) {
      top: auto;
      bottom: -15rem;
      right: -11rem;
      width: 26rem;
      height: 26rem;
    }
  }

  /* Die scrollgesteuerte Szene. CSS, kein JavaScript: `animation-timeline`
     laeuft auf dem Compositor, braucht keinen Scroll-Listener und keinen
     Hook aus einer Bibliothek, die die geteilte Motion-Schicht gar nicht
     re-exportiert. Wo es fehlt (Safari heute), passiert einfach nichts —
     die Formen behalten ihre Drift und ihre Parallaxe.

     `animation-composition: add` ist das Entscheidende: ohne sie wuerde
     diese Animation die Transforms der Island ERSETZEN statt sich zu ihnen
     zu addieren, und Drift wie Parallaxe waeren beim Scrollen tot. */
  /* From 80rem only: on a phone the shapes sit in tight bands under the
     header, and a 3 rem drift carried the quarter onto it (`audit:ux`). */
  @media (prefers-reduced-motion: no-preference) and (min-width: 80rem) {
    @supports (animation-timeline: view()) {
      :global(.hero-shape--capsule),
      :global(.hero-shape--quarter) {
        animation: hero-scroll-drift linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
        animation-composition: add;
      }
      :global(.hero-shape--quarter) {
        animation-name: hero-scroll-drift-reverse;
      }
    }
  }
  @keyframes hero-scroll-drift {
    from {
      transform: translateY(-3.5rem);
    }
    to {
      transform: translateY(3.5rem);
    }
  }
  @keyframes hero-scroll-drift-reverse {
    from {
      transform: translateY(3rem);
    }
    to {
      transform: translateY(-3rem);
    }
  }

  .hero-copy {
    min-width: 0;
    max-width: 72rem;
    text-align: center;
  }
  @media (min-width: 768px) {
    .hero-copy {
      text-align: left;
    }
  }

  /* The slogan is the only text on the screen, so it carries the size the
     eyebrow, sub and card used to share. */
  .hero-title {
    max-width: 18ch;
    margin: 0 auto 1.5rem;
    font-family: var(--font-display);
    font-weight: 500;
    /* 3rem floor since 2026-09-22: at 2.5rem the slogan was a small island in
       the middle of an empty phone screen. */
    font-size: clamp(3rem, 1.2rem + 6vw, 7.5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-black);
    font-variation-settings: "opsz" 144;
    text-wrap: balance;
    /* A long word from the panel must break at a syllable, not overflow a
       320 px phone. */
    hyphens: auto;
    overflow-wrap: break-word;
  }
  @media (min-width: 768px) {
    .hero-title {
      margin-inline: 0;
    }
  }

  .hero-brandbar {
    --tds-brandbar-height: 0.3rem;
    margin: 0 auto 2.25rem;
    transform-origin: left center;
  }
  @media (min-width: 768px) {
    .hero-brandbar {
      margin-inline: 0;
      --tds-brandbar-1: 4rem;
      --tds-brandbar-2: 1.75rem;
      --tds-brandbar-3: 0.875rem;
    }
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 1rem;
    }
  }
  @media (min-width: 768px) {
    .hero-actions {
      justify-content: flex-start;
    }
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0.875rem 1.75rem;
    border-radius: var(--tds-radius-pill, 100px);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 200ms var(--tds-ease-out),
      color 200ms var(--tds-ease-out),
      translate 160ms var(--tds-ease-out);
    /* No `transform` transition: Motion writes the transform every frame,
       and a CSS transition on top would smear each of those writes. */
  }
  /* The primary action is the one filled, dark shape in the hero — clear
     without a glow, a pulse or a countdown. */
  .hero-cta--primary {
    background: var(--color-surface-navy);
    color: #fff;
  }
  /* No hover transform here: the button's movement is Motion's (magnetic
     pull and press, lib/motion/cta.ts), and a CSS transform would fight the
     inline one it writes. */
  .hero-cta--primary:hover {
    background: var(--color-surface-accent);
  }
  .hero-cta__arrow {
    margin-left: 0.5rem;
    transition: transform 200ms var(--tds-ease-out);
  }
  .hero-cta--primary:hover .hero-cta__arrow {
    transform: translateX(3px);
  }
  .hero-cta--secondary {
    background: color-mix(in srgb, var(--color-card) 88%, transparent);
    color: var(--color-black);
  }
  .hero-cta--secondary:hover {
    background: color-mix(in srgb, var(--color-primary) 10%, var(--color-card));
    color: var(--color-primary);
  }

  /* The entrance: a short rise, TRANSFORM ONLY. An opacity fade would hide the
     headline for its first frames — exactly the late paint this component
     stopped doing — and a transform shifts nothing around it. Opt-in, so the
     reduced-motion default is the resting state. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-rise {
      animation: hero-rise 560ms var(--lp-ease-soft) both;
    }
    .hero-actions.hero-rise {
      animation-delay: 160ms;
    }
    /* The bar draws itself once the slogan has landed, with a small
       overshoot — the one flourish on the first screen. */
    .hero-brandbar {
      animation: hero-bar-draw 900ms var(--lp-ease-bounce, var(--tds-ease-out)) 380ms both;
    }

    /* Scrolling away, the copy drifts up a little faster than the page and
       the bar stretches — transform only, on the compositor, and nothing at
       all where scroll timelines are missing. */
    @supports (animation-timeline: view()) {
      .hero-body {
        animation: hero-copy-leave linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }
  @keyframes hero-rise {
    from {
      transform: translateY(1.5rem);
    }
  }
  @keyframes hero-bar-draw {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes hero-copy-leave {
    to {
      transform: translateY(-4.5rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-cta,
    .hero-cta__arrow {
      transition: none;
      transform: none;
    }
  }
</style>
