---
import { tFor, resolveLang } from "~/lib/i18n";
import { fetchTopics, fetchPostsBySlug, type ContentPost } from "~/lib/content";
import { fetchBlocks } from "~/lib/cms";
import BlogPostCard from "~/components/ui/BlogPostCard.astro";
import AccentLetters from "~/components/ui/AccentLetters.astro";

const t = tFor(Astro.currentLocale);
const lang = resolveLang(Astro.currentLocale);

/**
 * Build-time fetch of the posts shown in the Journal row. The admin can
 * curate an ordered list of up to 3 posts via the content-API's `journal`
 * landing block (edited in tds-admin). That selection is language-agnostic
 * (stored under `lang=de`) but each post is rendered in the current page's
 * language. When no selection is saved, we fall back to the 3 most recent
 * published posts, and if the API is unreachable, to the local i18n
 * placeholders — so the build never breaks on a content hiccup.
 */
const blocks = await fetchBlocks("de");
const curatedSlugs =
  (blocks.journal as { slugs?: string[] } | undefined)?.slugs ?? [];

let livePosts: ContentPost[] = [];
if (curatedSlugs.length > 0) {
  livePosts = await fetchPostsBySlug(curatedSlugs.slice(0, 3), lang);
} else {
  livePosts = await fetchTopics(lang, 3);
}

const formatter = new Intl.DateTimeFormat(lang === "de" ? "de-DE" : "en-IE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

/**
 * A post with no uploaded cover now renders the shared abstract brand cover —
 * the same drawing the blog gives it, because the variant is a hash of the
 * slug (see `BlogPostCard.astro`). What that replaced was three stock photos
 * hosted here under `/journal/`, which the blog never showed, plus a grey box
 * captioned with a prose description of the intended picture. Two surfaces,
 * two pictures of the same article. `coverHint` from the API still wins.
 */
const posts =
  livePosts.length > 0
    ? livePosts.map((p) => ({
        slug: p.slug,
        category: p.category,
        title: p.title,
        excerpt: p.excerpt,
        formattedDate: p.publishedAt ? formatter.format(new Date(p.publishedAt)) : "",
        coverHint: p.coverHint,
      }))
    : t.blog.posts.slice(0, 3).map((p) => ({
        slug: p.slug,
        category: p.category,
        title: p.title,
        excerpt: p.excerpt,
        formattedDate: formatter.format(new Date(p.date)),
        // `p.imagePlaceholder` is a German sentence describing the cover, not
        // a URL — it must never reach an <img src>.
        coverHint: null,
      }));

// Lay the cards out in a single flexible row (max 3), collapsing to one
// column on mobile. Static class strings so Tailwind's JIT keeps them.
const colClass: Record<number, string> = {
  1: "sm:grid-cols-1",
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-3",
};
const gridCols = colClass[Math.min(posts.length, 3)] ?? "sm:grid-cols-3";
---

<section id="blog" class="py-16 md:py-24 tds-tone-sand" aria-labelledby="journal-heading">
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <div class="flex items-end justify-between mb-10">
      <h2
        id="journal-heading"
        class="display text-4xl md:text-5xl lg:text-6xl text-[var(--color-black)]"
      >
        {t.blog.headline}{" "}
        <AccentLetters text={t.blog.headlineAccent} />
      </h2>
      <a
        href="https://blog.tracht-digital.de"
        class="hidden sm:flex items-center gap-2 text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors group"
      >
        {t.blog.allPosts}
        <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform duration-200">→</span>
      </a>
    </div>

    {/* Grid, not flex — every card is a `container-type: inline-size` slot,
        and a contained flex item reports a max-content size of zero and
        collapses. See the note in BlogPostCard.astro. */}
    <div class:list={["grid gap-6", gridCols]}>
      {posts.map((post) => (
        <BlogPostCard
          slug={post.slug}
          category={post.category}
          title={post.title}
          excerpt={post.excerpt}
          formattedDate={post.formattedDate}
          readMore={t.blog.readMore}
          coverHint={post.coverHint}
        />
      ))}
    </div>

    <a
      href="https://blog.tracht-digital.de"
      class="sm:hidden mt-8 inline-flex items-center gap-2 rounded-full bg-[var(--color-paper)] px-5 py-2.5 text-sm font-medium text-[var(--color-primary)]"
    >
      {t.blog.allPosts}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

{/* The staggered scroll-reveal that used to live here as an inline script —
    hand-written durations, its own easing, its own stagger, applied to
    `[data-journal-card]` — is now `src/lib/reveal.ts`, mounted once in the
    layout and driven by the `data-reveal` attribute on the card itself. It
    was the only reveal on the site, which is precisely why every other
    section arrived with no motion at all. */}
