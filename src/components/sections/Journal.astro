---
import { tFor, resolveLang } from "~/lib/i18n";
import { fetchTopics, fetchPostsBySlug, type ContentPost } from "~/lib/content";
import { fetchBlocks } from "~/lib/cms";
import BlogPostCard from "~/components/ui/BlogPostCard.astro";
import AccentLetters from "~/components/ui/AccentLetters.astro";

const t = tFor(Astro.currentLocale);
const lang = resolveLang(Astro.currentLocale);

/**
 * Build-time fetch of the posts shown in the Journal row. The admin can
 * curate an ordered list of up to 4 posts via the content-API's `journal`
 * landing block (edited in tds-admin). That selection is language-agnostic
 * (stored under `lang=de`) but each post is rendered in the current page's
 * language. When no selection is saved, we fall back to the 3 most recent
 * published posts, and if the API is unreachable, to the local i18n
 * placeholders — so the build never breaks on a content hiccup.
 */
const blocks = await fetchBlocks("de");
const curatedSlugs =
  (blocks.journal as { slugs?: string[] } | undefined)?.slugs ?? [];

let livePosts: ContentPost[] = [];
if (curatedSlugs.length > 0) {
  livePosts = await fetchPostsBySlug(curatedSlugs.slice(0, 4), lang);
} else {
  livePosts = await fetchTopics(lang, 3);
}

const formatter = new Intl.DateTimeFormat(lang === "de" ? "de-DE" : "en-IE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

/**
 * A post with no uploaded cover now renders the shared abstract brand cover —
 * the same drawing the blog gives it, because the variant is a hash of the
 * slug (see `BlogPostCard.astro`). What that replaced was three stock photos
 * hosted here under `/journal/`, which the blog never showed, plus a grey box
 * captioned with a prose description of the intended picture. Two surfaces,
 * two pictures of the same article. `coverHint` from the API still wins.
 */
const posts =
  livePosts.length > 0
    ? livePosts.map((p) => ({
        slug: p.slug,
        category: p.category,
        title: p.title,
        excerpt: p.excerpt,
        formattedDate: p.publishedAt ? formatter.format(new Date(p.publishedAt)) : "",
        coverHint: p.coverHint,
      }))
    : t.blog.posts.map((p) => ({
        slug: p.slug,
        category: p.category,
        title: p.title,
        excerpt: p.excerpt,
        formattedDate: formatter.format(new Date(p.date)),
        // `p.imagePlaceholder` is a German sentence describing the cover, not
        // a URL — it must never reach an <img src>.
        coverHint: null,
      }));

// Lay the cards out in a single flexible row (max 4), collapsing to one
// column on mobile. Static class strings so Tailwind's JIT keeps them.
const colClass: Record<number, string> = {
  1: "sm:grid-cols-1",
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-3",
  4: "sm:grid-cols-2 lg:grid-cols-4",
};
const gridCols = colClass[Math.min(posts.length, 4)] ?? "sm:grid-cols-3";
---

<section id="blog" class="section-spacing tds-tone-sand" aria-labelledby="journal-heading">
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <div class="flex items-end justify-between mb-16">
      <h2
        id="journal-heading"
        class="display text-4xl md:text-5xl lg:text-6xl text-[var(--color-black)]"
      >
        {t.blog.headline}{" "}
        <AccentLetters text={t.blog.headlineAccent} />
      </h2>
      <a
        href="https://blog.tracht-digital.de"
        class="hidden sm:flex items-center gap-2 text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors group"
      >
        {t.blog.allPosts}
        <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform duration-200">→</span>
      </a>
    </div>

    <div class:list={["grid gap-6", gridCols]}>
      {posts.map((post) => (
        <BlogPostCard
          slug={post.slug}
          category={post.category}
          title={post.title}
          excerpt={post.excerpt}
          formattedDate={post.formattedDate}
          readMore={t.blog.readMore}
          coverHint={post.coverHint}
        />
      ))}
    </div>

    <a
      href="https://blog.tracht-digital.de"
      class="group mt-16 block rounded-[6px] bg-[var(--color-paper)] hover:bg-[color-mix(in_srgb,var(--color-primary)_8%,var(--color-paper))] transition-all duration-200 p-8 md:p-10"
    >
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="max-w-xl">
          <p class="eyebrow mb-3 text-[var(--color-accent)]">blog.tracht-digital.de</p>
          <h3 class="text-2xl md:text-3xl font-[var(--font-display)] text-[var(--color-black)] mb-2 leading-tight">
            {t.blog.headline}{" "}
            <AccentLetters text={t.blog.headlineAccent} />
          </h3>
          <p class="text-sm text-[var(--color-muted)] leading-relaxed">
            {t.blog.allPosts} — {Astro.currentLocale === "en" ? "deep dives, field notes, and the occasional rant." : "Tiefenrecherchen, Notizen aus der Praxis und gelegentliche Rants."}
          </p>
        </div>
        <span class="inline-flex shrink-0 items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--color-surface-navy)] text-white text-sm font-medium group-hover:bg-[var(--color-surface-accent)] group-hover:gap-3 transition-all duration-200">
          {t.blog.allPosts}
          <span aria-hidden="true" class="group-hover:rotate-45 transition-transform duration-200">↗</span>
        </span>
      </div>
    </a>
  </div>
</section>

<script>
  // Staggered scroll-reveal for the journal cards. Progressive
  // enhancement: the hidden state is applied by JS, so without JS the
  // cards stay visible. Skipped under prefers-reduced-motion.
  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const cards = document.querySelectorAll<HTMLElement>("[data-journal-card]");

  if (cards.length > 0 && !prefersReduced) {
    cards.forEach((card, i) => {
      card.style.opacity = "0";
      card.style.transform = "translateY(28px)";
      card.style.transition =
        `opacity 600ms ease ${i * 110}ms,` +
        `transform 700ms cubic-bezier(0.22, 1, 0.36, 1) ${i * 110}ms`;
    });

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          el.style.opacity = "1";
          el.style.transform = "none";
          observer.unobserve(el);
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
    );

    cards.forEach((card) => observer.observe(card));
  }
</script>
