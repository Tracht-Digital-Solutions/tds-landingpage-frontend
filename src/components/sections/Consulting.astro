---
import { resolveLang, localizePath } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
import { getHomeContent } from "~/lib/homeContent";
import AccentLetters from "~/components/ui/AccentLetters.astro";
import Emphasis from "~/components/ui/Emphasis.astro";

const lang = resolveLang(Astro.currentLocale);
const consulting = await cmsFor(
  "digital_responsibility",
  lang,
  getHomeContent(lang).digitalResponsibility,
);

const pricingHref = localizePath("/preise", lang);
const homePrefix = lang === "de" ? "" : "/en";
---

<section
  id="digital-responsibility"
  class="section-spacing"
  aria-labelledby="digital-responsibility-heading"
>
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    {/* The second navy focus surface. It pairs with the PricingTeaser as
        a system — same tone, same geometry family — but the composition
        is MIRRORED (the quarter circle cuts the bottom-left corner, not
        the top-right) so the two read as two members of one family
        rather than as the same card twice. See the note in
        PricingTeaser.astro for what this replaced. */}
    <div
      class="relative overflow-hidden -mx-6 px-6 py-10 rounded-none md:mx-0 md:rounded-[6px] md:p-12 lg:p-16 tds-tone-navy"
    >
      <span
        aria-hidden="true"
        class="tds-shape tds-shape--quarter-tr tds-shape--coral"
        style="bottom: -6rem; left: -6rem; width: 18rem; height: 18rem; --tds-decor-shape-alpha: 0.2;"
      ></span>
      <span
        aria-hidden="true"
        class="tds-shape tds-shape--rect tds-shape--outline tds-shape--coral hidden md:block"
        style="top: -5rem; right: 8%; width: 15rem; height: 16rem; --tds-decor-line-opacity: 0.28;"
      ></span>

      <div class="relative max-w-3xl">
        <h2
          id="digital-responsibility-heading"
          class="display text-4xl md:text-5xl lg:text-6xl text-white mb-6"
        >
          {consulting.headline}{" "}
          <AccentLetters text={consulting.headlineAccent} tone="dark" />
        </h2>
        <p class="text-base md:text-lg text-white/80 leading-relaxed mb-8 max-w-2xl">
          <Emphasis text={consulting.body} />
        </p>

        <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3 mb-9 max-w-3xl">
          {consulting.points.map((point) => (
            <li class="flex gap-3 text-sm leading-relaxed text-white/85" data-reveal>
              <span aria-hidden="true" class="text-[var(--color-accent-pink)]">✓</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href={`${homePrefix}/#contact`}
            class="group inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-sm font-medium bg-white text-[var(--color-surface-navy)] hover:bg-white/85 hover:-translate-y-0.5 hover:shadow-[0_14px_36px_rgba(0,0,0,0.25)] transition-all duration-200"
          >
            {consulting.primaryCta}
            <span
              aria-hidden="true"
              class="group-hover:translate-x-0.5 transition-transform"
              >→</span
            >
          </a>
          <a
            href={pricingHref}
            class="group inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-sm font-medium bg-white/10 text-white hover:bg-white/20 hover:-translate-y-0.5 transition-all duration-200"
          >
            {consulting.secondaryCta}
            <span
              aria-hidden="true"
              class="group-hover:translate-x-0.5 transition-transform"
              >↗</span
            >
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
