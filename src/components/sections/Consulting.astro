---
/**
 * Consulting / "Beratung" call-to-action. Sits between Journal and
 * Contact in the narrative arc — a soft landing for visitors who
 * are interested but not ready to fill out the contact form yet.
 *
 * Two CTAs:
 *   - Primary: jumps to #contact (discovery call)
 *   - Secondary: jumps to /preise (rate transparency)
 *
 * Copy lives in tds-shared under `translations.consulting`.
 */
import { tFor, resolveLang, localizePath } from "~/lib/i18n";
import AccentLetters from "~/components/ui/AccentLetters.astro";

const lang = resolveLang(Astro.currentLocale);
const t = tFor(Astro.currentLocale);

const pricingHref = localizePath("/preise", lang);
const homePrefix = lang === "de" ? "" : "/en";
---

<section
  id="consulting"
  class="section-spacing"
  aria-labelledby="consulting-heading"
>
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <div
      class="relative overflow-hidden rounded-[6px] p-8 md:p-12 lg:p-16 bg-[linear-gradient(135deg,var(--color-surface-navy)_0%,var(--color-surface-accent)_100%)] text-white shadow-[0_24px_60px_-20px_rgba(5,15,104,0.45)]"
    >
      {/* Decorative pink glow upper-right to match the PricingTeaser
          card so the two callouts visually pair as a system. */}
      <span
        aria-hidden="true"
        class="absolute -top-32 -right-32 w-96 h-96 rounded-full pointer-events-none opacity-50"
        style="background: radial-gradient(circle, rgba(255,122,156,0.55) 0%, transparent 70%);"
      ></span>

      <div class="relative max-w-3xl">
        <p class="eyebrow text-white/70 mb-4">{t.consulting.label}</p>
        <h2
          id="consulting-heading"
          class="display text-4xl md:text-5xl lg:text-6xl text-white mb-6"
        >
          {t.consulting.headline}{" "}
          <AccentLetters text={t.consulting.headlineAccent} tone="dark" />
        </h2>
        <p class="text-base md:text-lg text-white/80 leading-relaxed mb-8 max-w-2xl">
          {t.consulting.body}
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href={`${homePrefix}/#contact`}
            class="group inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-sm font-medium bg-white text-[var(--color-surface-navy)] hover:bg-white/85 hover:-translate-y-0.5 hover:shadow-[0_14px_36px_rgba(0,0,0,0.25)] transition-all duration-200"
          >
            {t.consulting.primaryCta}
            <span
              aria-hidden="true"
              class="group-hover:translate-x-0.5 transition-transform"
              >→</span
            >
          </a>
          <a
            href={pricingHref}
            class="group inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-sm font-medium border border-white/30 text-white hover:bg-white/10 hover:border-white/60 hover:-translate-y-0.5 transition-all duration-200"
          >
            {t.consulting.secondaryCta}
            <span
              aria-hidden="true"
              class="group-hover:translate-x-0.5 transition-transform"
              >↗</span
            >
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
