---
import { tFor } from "~/lib/i18n";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import PortfolioCard from "~/components/ui/PortfolioCard.astro";

const t = tFor(Astro.currentLocale);
---

<section id="portfolio" class="section-spacing" aria-labelledby="portfolio-heading">
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <SectionHeader
      label={t.portfolio.label}
      headline={t.portfolio.headline}
      headlineAccent={t.portfolio.headlineAccent}
      id="portfolio-heading"
    />

    <div class="grid sm:grid-cols-2 gap-6">
      {t.portfolio.items.map((item) => (
        <PortfolioCard
          number={item.number}
          badge={item.badge}
          title={item.title}
          description={item.description}
          stack={item.stack}
          comingSoon={t.portfolio.comingSoon}
          placeholderLabel={t.portfolio.placeholderLabel}
          imagePlaceholder={item.imagePlaceholder}
        />
      ))}
    </div>
  </div>
</section>
