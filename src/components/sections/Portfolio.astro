---
import { tFor, resolveLang } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import PortfolioCard from "~/components/ui/PortfolioCard.astro";

const t = tFor(Astro.currentLocale);
const lang = resolveLang(Astro.currentLocale);
const portfolio = await cmsFor("portfolio", lang, t.portfolio);
---

<section id="portfolio" class="section-spacing" aria-labelledby="portfolio-heading">
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <SectionHeader
      label={portfolio.label}
      headline={portfolio.headline}
      headlineAccent={portfolio.headlineAccent}
      id="portfolio-heading"
    />

    <div class="grid sm:grid-cols-2 gap-6">
      {portfolio.items.map((item) => (
        <PortfolioCard
          number={item.number}
          badge={item.badge}
          title={item.title}
          description={item.description}
          stack={item.stack}
          comingSoon={portfolio.comingSoon}
          placeholderLabel={portfolio.placeholderLabel}
          imagePlaceholder={item.imagePlaceholder}
        />
      ))}
    </div>
  </div>
</section>
