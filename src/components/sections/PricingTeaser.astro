---
import { resolveLang, localizePath } from "~/lib/i18n";
import { getPricingContent } from "~/lib/pricing";
import AccentLetters from "~/components/ui/AccentLetters.astro";

const lang = resolveLang(Astro.currentLocale);
const pricing = await getPricingContent(lang);
const pricingHref = localizePath("/preise", lang);
---

<section id="pricing-teaser" class="py-12 md:py-20" aria-labelledby="pricing-teaser-heading">
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    {/* A NAVY FOCUS SURFACE, not a gradient panel. This block used to be
        a 135° navy→bordeaux gradient with a blurred pink circle bleeding
        out of its top-right corner and a 60px navy drop shadow — three
        of the things the brand direction rules out at once (generischer
        bunter Verlauf, organischer Blob, schwerer Schatten), and the
        second of two blocks on the page that looked identical. It is a
        flat brand navy now, with the bordeaux entering as a cut
        quarter-circle and a capsule — constructed geometry, so the panel
        reads as built rather than as a stock hero card. */}
    <a
      href={pricingHref}
      class="group relative block overflow-hidden tds-tone-navy -mx-6 px-6 py-10 rounded-none md:mx-0 md:rounded-[6px] md:p-12"
    >
      {/* Formen UND Foto liegen jetzt zusammen in einer `.tds-decor`.
          Das ist nicht kosmetisch: die Regel `.tds-decor ~ *` hebt jedes
          folgende Geschwister auf z-index 1 — stünde das Foto als bloßes
          Geschwister der Formen davor, bekämen auch die beiden Formen
          diese Anhebung ab. So bleibt genau ein Geschwister übrig, der
          Inhalt, und der liegt über allem. */}
      <span class="tds-decor" aria-hidden="true">
        {/* Sehr dunkles Motiv mit EINER hellen Fläche. Es steht auf
            Navy, nicht auf Papier, deshalb läuft es deutlich höher als
            die hellen Gründe der Seite — darunter versinkt es schlicht
            in der Fläche. Waagerecht wird hier nichts beschnitten (das
            Panel ist breiter als 2,22:1), `object-position` also nur
            senkrecht: das Blatt sitzt mittig in der Höhe. */}
        <img
          src="/images/sections/pricing.webp"
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          class="pricing-photo absolute inset-0 h-full w-full object-cover"
        />
        {/* Der Scrim ist das NAVY des Panels selbst, von rechts stärker:
            dort stehen Preis und Button, und das ist genau die Stelle, an
            die der Bildausschnitt die helle Fläche legt. */}
        <span class="pricing-photo-scrim absolute inset-0"></span>
        <span
          aria-hidden="true"
          class="tds-shape tds-shape--quarter-bl tds-shape--coral"
          style="top: -3rem; right: -3rem; width: 18rem; height: 18rem; --tds-decor-shape-alpha: 0.22;"
        ></span>
        <span
          aria-hidden="true"
          class="tds-shape tds-shape--capsule tds-shape--coral hidden md:block"
          style="bottom: -5rem; left: 8%; width: 22rem; height: 8rem; --tds-decor-shape-alpha: 0.08;"
        ></span>
      </span>

      <div class="relative grid md:grid-cols-[1.4fr_1fr] gap-8 md:gap-12 items-center">
        <div>
          <h2
            id="pricing-teaser-heading"
            class="display text-4xl md:text-5xl lg:text-6xl mb-4"
          >
            {pricing.teaserHeadline}{" "}
            <AccentLetters text={pricing.teaserHeadlineAccent} tone="dark" />
          </h2>
          <p class="text-white/75 leading-relaxed max-w-xl">{pricing.teaserSub}</p>
        </div>

        <div class="flex flex-col items-start md:items-end gap-6 md:text-right">
          <div class="flex items-baseline gap-2">
            <span class="font-[var(--font-display)] italic text-sm text-white/60 leading-none">
              {pricing.teaserFromLabel}
            </span>
            <span
              class="font-[var(--font-display)] text-5xl md:text-6xl font-medium leading-none tabular-nums"
              style={`font-variation-settings: "opsz" 144`}
            >
              {pricing.rateWebPresence}&nbsp;€
            </span>
            <span class="text-sm text-white/60 leading-none">{pricing.hourSuffix}</span>
          </div>

          <span class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-[var(--color-surface-navy)] text-sm font-medium group-hover:gap-3 transition-all">
            {pricing.teaserCta}
            <span aria-hidden="true" class="group-hover:rotate-45 transition-transform duration-300">↗</span>
          </span>
        </div>
      </div>
    </a>
  </div>
</section>

<style>
  /* Höher als die hellen Gründe (`.about-photo` 0.14,
     `.service-card__photo` 0.18): das Motiv ist fast schwarz und muss
     gegen Navy anlaufen, statt darin zu verschwinden. Im Dark Mode ist
     die Fläche dieselbe — das Panel ist in beiden Themes Navy —, deshalb
     gibt es hier KEINE zweite Deckkraft. */
  .pricing-photo {
    opacity: 0.4;
  }
  .pricing-photo-scrim {
    background: linear-gradient(
      to left,
      var(--color-surface-navy) 16%,
      color-mix(in srgb, var(--color-surface-navy) 72%, transparent) 58%,
      color-mix(in srgb, var(--color-surface-navy) 48%, transparent) 100%
    );
  }
</style>
