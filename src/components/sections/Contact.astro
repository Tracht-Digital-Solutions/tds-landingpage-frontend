---
import { translations } from "@tracht-digital-solutions/tds-shared/i18n";
import ContactForm from "~/components/islands/ContactForm.tsx";

const t = translations.de;
---

<section
  id="contact"
  class="section-spacing bg-[var(--color-primary)]"
  aria-labelledby="contact-heading"
>
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <p class="text-xs font-medium tracking-widest uppercase text-white/40 mb-4">
      {t.contact.label}
    </p>
    <h2
      id="contact-heading"
      class="text-4xl md:text-5xl lg:text-6xl font-[var(--font-display)] font-medium leading-tight tracking-tight text-white mb-4"
      style={`font-variation-settings: "opsz" 144`}
    >
      {t.contact.headline}{" "}
      <em class="not-italic italic text-[var(--color-accent-pink)]">{t.contact.headlineAccent}</em>
    </h2>
    <p class="text-white/60 max-w-lg mb-16 leading-relaxed">{t.contact.sub}</p>

    <div class="grid md:grid-cols-2 gap-16 lg:gap-24">
      <ContactForm client:visible />

      <aside class="space-y-8">
        <div>
          <p class="text-xs font-medium text-white/40 uppercase tracking-widest mb-3">
            {t.contact.info.emailLabel}
          </p>
          <a
            href={`mailto:${t.contact.info.email}`}
            class="flex items-center gap-3 text-white hover:text-[var(--color-accent-pink)] transition-colors"
          >
            <span aria-hidden="true">✉</span>
            {t.contact.info.email}
          </a>
        </div>

        <div>
          <p class="text-xs font-medium text-white/40 uppercase tracking-widest mb-3">
            {t.contact.info.phoneLabel}
          </p>
          <a
            href={`tel:${t.contact.info.phone.replace(/\s/g, "")}`}
            class="flex items-center gap-3 text-white hover:text-[var(--color-accent-pink)] transition-colors"
          >
            <span aria-hidden="true">☎</span>
            {t.contact.info.phone}
          </a>
        </div>

        <div>
          <p class="text-xs font-medium text-white/40 uppercase tracking-widest mb-3">
            {t.contact.info.locationLabel}
          </p>
          <span class="flex items-center gap-3 text-white">
            <span aria-hidden="true">⌂</span>
            {t.contact.info.location}
          </span>
        </div>

        <div>
          <p class="text-xs font-medium text-white/40 uppercase tracking-widest mb-3">
            {t.contact.info.socialLabel}
          </p>
          <div class="flex gap-4">
            <a
              href="#"
              aria-label="LinkedIn"
              class="p-2 rounded-full border border-white/20 text-white/60 hover:text-white hover:border-white/40 transition-colors text-xs font-bold"
            >
              in
            </a>
            <a
              href="#"
              aria-label="GitHub"
              class="p-2 rounded-full border border-white/20 text-white/60 hover:text-white hover:border-white/40 transition-colors text-xs font-bold"
            >
              gh
            </a>
            <a
              href="#"
              aria-label="Xing"
              class="p-2 rounded-full border border-white/20 text-white/60 hover:text-white hover:border-white/40 transition-colors text-xs font-bold"
            >
              Xi
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
