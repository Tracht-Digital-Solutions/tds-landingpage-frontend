---
import { tFor, resolveLang } from "~/lib/i18n";
import ContactForm from "~/components/islands/ContactForm.tsx";

const lang = resolveLang(Astro.currentLocale);
const t = tFor(Astro.currentLocale);

/**
 * Example values — replace before go-live. The shared lib still carries
 * `XXX` for the phone, and social URLs aren't modelled there at all yet.
 * These are visibly placeholder ("1234567", `/example`) so a quick
 * find-replace pass during launch surfaces them. See README's
 * "Replace examples before go-live" section.
 */
const phoneDisplay = "+49 4151 1234567";
const phoneHref = phoneDisplay.replace(/\s/g, "");
const socials = {
  linkedin: "https://www.linkedin.com/in/example",
  github: "https://github.com/example",
  xing: "https://www.xing.com/profile/example",
};
---

<section
  id="contact"
  class="section-spacing bg-[var(--color-primary)]"
  aria-labelledby="contact-heading"
>
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <p class="section-num text-white/60 mb-4">{t.contact.label}</p>
    <h2
      id="contact-heading"
      class="display text-4xl md:text-5xl lg:text-6xl text-white mb-4"
    >
      {t.contact.headline}{" "}
      <em class="not-italic italic text-[var(--color-accent-pink)]" style="font-variation-settings: 'opsz' 144">{t.contact.headlineAccent}</em>
    </h2>
    <p class="text-white/60 max-w-lg mb-16 leading-relaxed">{t.contact.sub}</p>

    <div class="grid md:grid-cols-2 gap-16 lg:gap-24">
      <ContactForm client:visible lang={lang} />

      <aside class="space-y-8">
        <div>
          <p class="eyebrow text-white/50 mb-3">
            {t.contact.info.emailLabel}
          </p>
          <a
            href={`mailto:${t.contact.info.email}`}
            class="flex items-center gap-3 text-white hover:text-[var(--color-accent-pink)] transition-colors"
          >
            <span aria-hidden="true">✉</span>
            {t.contact.info.email}
          </a>
        </div>

        <div>
          <p class="eyebrow text-white/50 mb-3">
            {t.contact.info.phoneLabel}
          </p>
          <a
            href={`tel:${phoneHref}`}
            class="flex items-center gap-3 text-white hover:text-[var(--color-accent-pink)] transition-colors"
          >
            <span aria-hidden="true">☎</span>
            {phoneDisplay}
          </a>
        </div>

        <div>
          <p class="eyebrow text-white/50 mb-3">
            {t.contact.info.locationLabel}
          </p>
          <span class="flex items-center gap-3 text-white">
            <span aria-hidden="true">⌂</span>
            {t.contact.info.location}
          </span>
        </div>

        <div>
          <p class="eyebrow text-white/50 mb-3">
            {t.contact.info.socialLabel}
          </p>
          <div class="flex gap-3">
            <a
              href={socials.linkedin}
              aria-label="LinkedIn"
              rel="noopener noreferrer"
              target="_blank"
              class="p-2.5 rounded-full border border-white/20 text-white/60 hover:text-white hover:border-white/40 hover:-translate-y-0.5 transition-all duration-200"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </a>
            <a
              href={socials.github}
              aria-label="GitHub"
              rel="noopener noreferrer"
              target="_blank"
              class="p-2.5 rounded-full border border-white/20 text-white/60 hover:text-white hover:border-white/40 hover:-translate-y-0.5 transition-all duration-200"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
              </svg>
            </a>
            <a
              href={socials.xing}
              aria-label="Xing"
              rel="noopener noreferrer"
              target="_blank"
              class="p-2.5 rounded-full border border-white/20 text-white/60 hover:text-white hover:border-white/40 hover:-translate-y-0.5 transition-all duration-200"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.188 0c-.517 0-.741.325-.927.66 0 0-7.455 13.224-7.702 13.657.015.024 4.919 9.023 4.919 9.023.17.308.436.66.967.66h3.454c.211 0 .375-.078.463-.22.089-.151.089-.346-.009-.539l-4.879-8.916c-.004-.006-.004-.016 0-.022L21.945.756c.099-.193.099-.387.01-.538C21.866.078 21.702 0 21.49 0h-3.302zM3.648 4.74c-.211 0-.385.074-.473.226-.09.151-.078.347.022.541l2.336 4.04c.007.01.007.016 0 .025L1.86 16.51c-.099.193-.093.39.004.541.092.146.265.219.476.219h3.293c.516 0 .768-.348.946-.667l3.74-6.62-2.387-4.155c-.171-.32-.43-.668-.961-.668H3.648z" />
              </svg>
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<style is:global>
  /* Underline-style inputs on the dark Contact section. Browser
     autofill on Chrome/Safari paints its own background and text
     color, which clashes with the bg-[--color-primary] section.
     Neutralise both via the WebKit autofill pseudo (the 9999s
     transition trick stops Chrome from re-applying the bg on focus). */
  .contact-field:-webkit-autofill,
  .contact-field:-webkit-autofill:hover,
  .contact-field:-webkit-autofill:focus,
  .contact-field:-webkit-autofill:active {
    -webkit-text-fill-color: #ffffff;
    -webkit-box-shadow: 0 0 0 1000px transparent inset;
    box-shadow: 0 0 0 1000px transparent inset;
    transition: background-color 9999s ease-in-out 0s;
    caret-color: #ffffff;
  }
</style>
