---
/**
 * FAQ — the last sweep of questions before a visitor reaches the contact
 * section.
 *
 * ONE native accordion at every width: `<details name="faq">` rows, the first
 * one open. The question is the `<summary>`, which browsers expose as a
 * disclosure control with its expanded/collapsed state — the `aria-expanded`
 * a hand-built accordion would have to keep in sync, for free and without
 * JavaScript. The shared `name` makes it exclusive where supported (opening one
 * closes the other); where it is not, several simply stay open.
 *
 * What it replaced, so nobody restores it: on desktop a master–detail
 * "tablist" — a `ul[role=tablist]` whose `li` children held the `role=tab`
 * buttons — beside a separate answer panel, and below `lg` a second, hidden
 * copy of every question as `<details>`. axe reported the desktop version as
 * CRITICAL (`aria-required-children`, `aria-required-parent` ×7) and serious
 * (`listitem` ×7): a tablist must own its tabs directly, and a list item
 * inside a tablist is neither a list item nor a tab. Every question also
 * existed twice in the document.
 *
 * Content lives in `src/lib/faq.ts` so the FAQPage JSON-LD on the home page
 * renders from the same source — Google drops the rich result when the schema
 * text does not match the visible answer 1:1. A collapsed answer is still in
 * the document, which is what that comparison reads.
 */
import { resolveLang, localizePath } from "~/lib/i18n";
import { getFaqContent } from "~/lib/faq";
import { cmsFor } from "~/lib/cms";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import CircuitRun from "~/components/ui/CircuitRun.astro";

const lang = resolveLang(Astro.currentLocale);
// Admin-edited v2 block overrides the local default at render time;
// falls back to lib/faq.ts when no block is saved or the API is down.
const content = await cmsFor("faq_v2", lang, getFaqContent(lang));

// `content.intro` is deliberately NOT rendered — see the note in `lib/faq.ts`.

// Code-owned chrome, localized here rather than added to the CMS block — the
// Website-CMS structured schema (another repository) does not have to change
// in step with this file.
const ui =
  lang === "de"
    ? {
        moreTitle: "Ihre Frage war nicht dabei?",
        moreText: "Schreiben Sie mir direkt — Antwort in der Regel innerhalb von 24 Stunden.",
        moreCta: "Schreiben Sie mir",
      }
    : {
        moreTitle: "Not the question you had?",
        moreText: "Write to me directly — usually answered within 24 hours.",
        moreCta: "Get in touch",
      };
const contactHref = `${localizePath("/", lang)}#contact`;
---

<section
  id="faq"
  class="relative section-spacing tds-tone-sand"
  aria-labelledby="faq-heading"
>
  {/* The conduit run sits in the one piece of real negative space this section
      has from `lg`: below the call to action in the left column, which is far
      shorter than the list beside it. Hidden where the columns stack. */}
  <div class="tds-decor" aria-hidden="true">
    <CircuitRun class="hidden lg:block bottom-[6%] left-[3%] w-[15rem] h-[8rem]" />
  </div>

  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <div class="faq-layout">
      <div class="faq-layout__head">
        <SectionHeader
          headline={content.headline}
          headlineAccent={content.headlineAccent}
          id="faq-heading"
          headingClass="mb-0"
        />
      </div>

      <div class="faq-list">
        {content.items.map((item, i) => (
          <details name="faq" open={i === 0} class="faq-item" data-reveal>
            <summary class="faq-summary">
              <span class="faq-q">{item.q}</span>
              <span aria-hidden="true" class="faq-chevron">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="9 6 15 12 9 18" />
                </svg>
              </span>
            </summary>
            <p class="faq-a">{item.a}</p>
          </details>
        ))}
      </div>

      {/* The list can only ever answer the questions it anticipated. This is
          the exit for everyone else.

          The whole card is the link, not only the pill inside it. Built like
          the pricing panel once was: an `<a>` with `.tds-decor` for the
          decoration and the content as its only following sibling. NO `.btn`
          — unlayered tds-shared beats every Tailwind utility, so a custom fill
          on `.btn btn-primary` would not apply.

          Rosé, not navy: the contact block directly below is navy, and two
          navy blocks in a row read as one. The title stays a `<span>` — a
          heading here would add an outline level that is not one. */}
      <a
        href={contactHref}
        class="faq-cta group relative block overflow-hidden rounded-[6px] p-7 md:p-8 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-4 focus-visible:ring-offset-[var(--color-soft)]"
      >
        <span class="tds-decor" aria-hidden="true">
          <span
            class="tds-shape tds-shape--quarter-bl tds-shape--coral"
            style="top: -4rem; right: -4rem; width: 14rem; height: 14rem;"
          ></span>
        </span>
        <span class="flex flex-col gap-4">
          <span class="block">
            <span class="block font-[var(--font-display)] text-xl text-[var(--color-black)]">
              {ui.moreTitle}
            </span>
            <span class="faq-cta-sub mt-1.5 block text-sm">
              {ui.moreText}
            </span>
          </span>
          <span class="faq-cta-pill inline-flex shrink-0 items-center gap-2 self-start rounded-full px-5 py-2.5 text-sm font-medium">
            {ui.moreCta}
            <svg
              aria-hidden="true"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="faq-cta-arrow"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  /* One source order, two arrangements: phones read heading → questions →
     way out; from `lg` the heading and the way out share the left column and
     the list runs down the right. Grid areas do this without a second copy of
     anything in the markup. */
  .faq-layout {
    display: grid;
    gap: 2.5rem;
    grid-template-areas:
      "head"
      "list"
      "cta";
  }
  .faq-layout__head {
    grid-area: head;
  }
  .faq-list {
    grid-area: list;
    display: grid;
    gap: 0.25rem;
  }
  .faq-cta {
    grid-area: cta;
  }
  @media (min-width: 64rem) {
    .faq-layout {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        "head list"
        "cta list";
      column-gap: 4rem;
      row-gap: 2rem;
      align-items: start;
    }
  }

  .faq-summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 1rem;
    cursor: pointer;
    list-style: none;
    border-radius: 6px;
  }
  .faq-summary::-webkit-details-marker {
    display: none;
  }
  .faq-q {
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.375;
    color: var(--color-black);
    transition: color 200ms var(--tds-ease-out);
  }
  @media (min-width: 768px) {
    .faq-q {
      font-size: 1.25rem;
    }
  }

  /* Open row: a filled summary + accent colour. The state never rests on
     colour alone — the fill and the rotated chevron carry it with it. */
  .faq-item[open] > .faq-summary {
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
  }
  .faq-item[open] > .faq-summary .faq-q,
  .faq-summary:hover .faq-q {
    color: var(--color-accent);
  }

  .faq-chevron {
    flex-shrink: 0;
    margin-top: 0.25rem;
    color: var(--color-muted);
    /* The rotation springs; the colour beside it eases, because a colour that
       overshoots lands outside the palette. */
    transition:
      transform 320ms var(--lp-ease-bounce),
      color 200ms var(--tds-ease-out);
  }
  .faq-item[open] > .faq-summary .faq-chevron {
    color: var(--color-accent);
    transform: rotate(90deg);
  }

  .faq-a {
    margin: 0;
    max-width: 44rem;
    padding: 0.5rem 1rem 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  /* A `<details>` used to SNAP open and then fade its answer in.
     `::details-content` is the element the browser wraps the answer in, and
     with `interpolate-size: allow-keywords` (set on :root in global.css) a
     transition to `auto` height is animatable. `@supports` does real work:
     without either feature the whole block is skipped and the row opens
     instantly — no measured heights, no JS, no jump. */
  @supports selector(::details-content) {
    .faq-item::details-content {
      block-size: 0;
      overflow: clip;
      opacity: 0;
      transition:
        block-size 320ms var(--lp-ease-soft),
        opacity 220ms var(--tds-ease-out),
        content-visibility 320ms allow-discrete;
      transition-behavior: allow-discrete;
    }
    .faq-item[open]::details-content {
      block-size: auto;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-chevron {
      transition: none;
    }
    /* END STATE. The shared reduced-motion block clamps duration, which for a
       discrete `content-visibility` step is not enough — without this an
       opened row could sit at height 0. */
    @supports selector(::details-content) {
      .faq-item::details-content,
      .faq-item[open]::details-content {
        transition: none;
      }
      .faq-item[open]::details-content {
        block-size: auto;
        opacity: 1;
      }
    }
  }

  /* Die Ausstiegsfläche. Rosé auf dem Sand-Grund des Abschnitts: warm
     genug, um als Einladung zu lesen. Beim Hover eine Stufe kräftiger statt
     einer Bewegung. */
  .faq-cta {
    background: color-mix(in srgb, var(--color-accent-pink) 16%, var(--color-paper));
    transition: background-color 200ms var(--tds-ease-out);
  }
  .faq-cta:hover {
    background: color-mix(in srgb, var(--color-accent-pink) 24%, var(--color-paper));
  }
  /* Der Pseudo-Knopf. Kein `.btn` — die Fläche ist der Link, das hier ist nur
     seine sichtbare Handlungsaufforderung. */
  .faq-cta-pill {
    background: var(--color-accent);
    /* NICHT `#fff`. Der Akzent ist hell Bordeaux (#820933) und dunkel
       Koralle (#ff8fab) — Weiss darauf misst im Dark Mode 2.15:1. Das
       Papier-Token kippt mit dem Theme und liefert in beiden Richtungen
       den hellen bzw. dunklen Gegenpol. */
    color: var(--color-paper);
    transition: gap 200ms var(--tds-ease-out);
  }
  /* `--color-muted` auf der rosé Flaeche misst 4.47:1 und verfehlt die
     4.5 damit um Haaresbreite. Eine Spur dunkler statt die Flaeche heller:
     die Toenung ist der Punkt der Karte. */
  .faq-cta-sub {
    color: color-mix(in srgb, var(--color-muted) 82%, var(--color-black));
  }
  .faq-cta:hover .faq-cta-pill {
    gap: 0.75rem;
  }

  .faq-cta-arrow {
    transition: transform 280ms var(--lp-ease-bounce);
  }
  .faq-cta:hover .faq-cta-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-cta,
    .faq-cta-pill,
    .faq-cta-arrow {
      transition: none;
    }
    .faq-cta:hover .faq-cta-arrow {
      transform: none;
    }
    .faq-cta:hover .faq-cta-pill {
      gap: 0.5rem;
    }
  }
</style>
