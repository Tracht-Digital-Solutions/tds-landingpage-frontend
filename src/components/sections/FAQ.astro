---
/**
 * FAQ — the last sweep of common mid-market objections before a
 * visitor hits the Contact section. Native `<details>`/`<summary>`
 * accordions: zero JS, accessible by default, keyboard navigable.
 *
 * Sits between Consulting (the soft invitation) and Contact (the
 * commit) in the narrative arc. Content lives in `src/lib/faq.ts`
 * so the FAQPage JSON-LD on index.astro can render from the same
 * source — Google strips the rich snippet when the schema text
 * doesn't match the visible answer 1:1.
 */
import { resolveLang } from "~/lib/i18n";
import { getFaqContent } from "~/lib/faq";
import SectionHeader from "~/components/ui/SectionHeader.astro";

const lang = resolveLang(Astro.currentLocale);
const content = getFaqContent(lang);
---

<section
  id="faq"
  class="section-spacing bg-[var(--color-soft)]"
  aria-labelledby="faq-heading"
>
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <SectionHeader
      label={content.label}
      headline={content.headline}
      headlineAccent={content.headlineAccent}
      id="faq-heading"
      headingClass="mb-6"
    />
    <p class="max-w-2xl text-[var(--color-muted)] leading-relaxed mb-12">
      {content.intro}
    </p>

    <ul class="max-w-3xl divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
      {
        content.items.map((item) => (
          <li>
            <details class="group faq-item">
              <summary class="flex items-start justify-between gap-6 cursor-pointer py-5 md:py-6 list-none [&::-webkit-details-marker]:hidden">
                <span class="font-[var(--font-display)] text-lg md:text-xl text-[var(--color-black)] leading-snug group-hover:text-[var(--color-accent)] transition-colors">
                  {item.q}
                </span>
                <span
                  aria-hidden="true"
                  class="flex-shrink-0 inline-flex items-center justify-center w-7 h-7 mt-1 rounded-full border border-[var(--color-line)] text-[var(--color-accent)] bg-[var(--color-card)] group-hover:border-[var(--color-accent)] transition-colors"
                >
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="transition-transform duration-200 group-open:rotate-45"
                  >
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                  </svg>
                </span>
              </summary>
              <p class="text-[var(--color-muted)] leading-relaxed pb-6 md:pb-7 pr-12 -mt-2">
                {item.a}
              </p>
            </details>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Soften the open transition so the answer reveal feels less
     mechanical than the default <details> snap. Browsers without
     CSS interpolate-size still get the standard open/close;
     supporting browsers get the smooth height animation. */
  @supports (interpolate-size: allow-keywords) {
    .faq-item {
      interpolate-size: allow-keywords;
    }
    .faq-item::details-content {
      height: 0;
      opacity: 0;
      overflow: hidden;
      transition:
        height 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
        opacity 220ms ease,
        content-visibility 280ms allow-discrete;
    }
    .faq-item[open]::details-content {
      height: auto;
      opacity: 1;
    }
  }

  /* Wide screens have room to spare to the right of the max-w-3xl
     list, so let each FAQ "drive out" rightward when you hover or
     open it — a bit of horizontal play that reads as interactive.
     Below lg the list is near the viewport edge, so we leave it put. */
  @media (min-width: 1024px) {
    .faq-item {
      transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .faq-item:hover {
      transform: translateX(1.25rem);
    }
    .faq-item[open] {
      transform: translateX(2.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item {
      transition: none;
    }
    .faq-item:hover,
    .faq-item[open] {
      transform: none;
    }
  }
</style>
