---
/**
 * FAQ — the last sweep of common mid-market objections before a
 * visitor hits the Contact section.
 *
 * Master–detail: the questions are a vertical tablist on the left; the
 * answer of the selected question shows in a single shared panel on the
 * right and is replaced when another question is picked. The question
 * rows never change height (the answer lives only in the panel), and the
 * active question is marked with an accent edge + colour. Enhanced by a
 * small inline ARIA-tabs script; without JS the first answer is shown.
 *
 * Content lives in `src/lib/faq.ts` so the FAQPage JSON-LD on
 * index.astro can render from the same source — Google strips the rich
 * snippet when the schema text doesn't match the visible answer 1:1.
 */
import { resolveLang } from "~/lib/i18n";
import { getFaqContent } from "~/lib/faq";
import { cmsFor } from "~/lib/cms";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import CircuitRun from "~/components/ui/CircuitRun.astro";

const lang = resolveLang(Astro.currentLocale);
// Admin-edited v2 block overrides the local default at render time;
// falls back to lib/faq.ts when no block is saved or the API is down.
const content = await cmsFor("faq_v2", lang, getFaqContent(lang));

// `content.intro` is deliberately NOT rendered any more. A heading that
// says "Häufige Fragen" followed by a sentence explaining that these are
// the frequent questions is the definition of a line that earns nothing.
// The field stays in `FaqContent` and in the `faq_v2` block so text an
// admin already saved remains readable in the editor rather than being
// silently dropped from the schema.

// Code-owned chrome, localized here rather than added to the CMS block —
// the same arrangement `ServiceDetailPage.astro` uses for its labels, and
// it means the Website-CMS structured schema (another repository) does not
// have to change in step with this file.
const ui = lang === "de"
  ? {
      moreTitle: "Ihre Frage war nicht dabei?",
      moreText: "Schreiben Sie mir direkt — Antwort in der Regel innerhalb von 24 Stunden.",
      moreCta: "Schreiben Sie mir",
    }
  : {
      moreTitle: "Not the question you had?",
      moreText: "Write to me directly — usually answered within 24 hours.",
      moreCta: "Get in touch",
    };
const contactHref = lang === "de" ? "/#contact" : "/en/#contact";
---

{/* The one conduit run outside the hero. It sits HERE and not in the Journal
    section — which was the first choice — because this is the only section
    with real negative space: the answer column is short and the area below it
    is empty at `lg` and up. In the Journal it landed behind the CTA card, and
    a shape that has to compete for its own space is exactly the "Dekoration
    hinter Inhalt" the brand direction rules out. Hidden below `lg`, where the
    two columns stack and that space no longer exists. */}
<section
  id="faq"
  class="relative section-spacing tds-tone-sand"
  aria-labelledby="faq-heading"
>
  <div class="tds-decor" aria-hidden="true">
    <CircuitRun class="hidden lg:block bottom-[12%] right-[8%] w-[17rem] h-[9rem]" />
  </div>
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <SectionHeader
      headline={content.headline}
      headlineAccent={content.headlineAccent}
      id="faq-heading"
      headingClass="mb-12"
    />

    {/* Mobile/tablet (< lg): native <details> accordion — each answer
        expands inline under its own question. Exclusive (shared `name`),
        first item open by default; no JS needed. The desktop master-detail
        block below is hidden here. */}
    <div class="lg:hidden space-y-1">
      {content.items.map((item, i) => (
        <details name="faq-mobile" open={i === 0} class="faq-m" data-reveal>
          <summary class="faq-m-summary flex items-start justify-between gap-6 py-5 px-4 cursor-pointer">
            <span class="faq-m-q font-[var(--font-display)] text-lg text-[var(--color-black)] leading-snug transition-colors duration-200">
              {item.q}
            </span>
            <span aria-hidden="true" class="faq-m-arrow flex-shrink-0 mt-1 text-[var(--color-muted)]">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 6 15 12 9 18" />
              </svg>
            </span>
          </summary>
          <p class="faq-m-answer text-[var(--color-muted)] leading-relaxed text-lg pl-4 pb-5 pr-4">
            {item.a}
          </p>
        </details>
      ))}
    </div>

    {/* Desktop (≥ lg): master-detail tablist — unchanged. */}
    <div class="hidden lg:grid lg:grid-cols-[minmax(0,30rem)_minmax(0,1fr)] lg:gap-x-12 lg:items-start">
      {/* Questions — vertical tablist */}
      <ul
        role="tablist"
        aria-orientation="vertical"
        aria-label={content.label.replace(/^[—–-]\s*/, "")}
        class="faq-tablist space-y-1 lg:max-h-[30rem] lg:overflow-y-auto lg:pr-3"
      >
        {content.items.map((item, i) => (
          <li>
            <button
              type="button"
              role="tab"
              id={`faq-tab-${i}`}
              aria-controls={`faq-panel-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="faq-tab w-full flex items-start justify-between gap-6 text-left py-5 md:py-6 px-4 cursor-pointer transition-colors duration-200"
            >
              <span class="faq-q font-[var(--font-display)] text-lg md:text-xl text-[var(--color-black)] leading-snug transition-colors duration-200">
                {item.q}
              </span>
              <span aria-hidden="true" class="faq-arrow flex-shrink-0 mt-1 text-[var(--color-muted)]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 6 15 12 9 18" />
                </svg>
              </span>
            </button>
          </li>
        ))}
      </ul>

      {/* Answer — single shared panel (one tabpanel per answer, only the
          active one visible). Sticky beside the list on wide screens; on
          small screens it stacks under the list. */}
      <div class="mt-8 lg:mt-0 lg:sticky lg:top-28 self-start">
        {content.items.map((item, i) => (
          <div
            role="tabpanel"
            id={`faq-panel-${i}`}
            aria-labelledby={`faq-tab-${i}`}
            tabindex="0"
            hidden={i !== 0}
            class="faq-panel"
          >
            <p class="text-[var(--color-muted)] leading-relaxed text-lg md:text-xl max-w-2xl">
              {item.a}
            </p>
          </div>
        ))}
      </div>
    </div>

    {/* The list can only ever answer the questions it anticipated. This is
        the exit for everyone else, and it replaces the intro paragraph that
        used to sit above the list saying nothing.

        Die ganze Fläche ist der Link, nicht nur der Knopf darin. Vorher
        standen Satz und Knopf nebeneinander und nur der Knopf war
        anklickbar — das Ziel ist dasselbe, die Trefferfläche war nur
        unnötig klein.

        Aufgebaut wie das Pricing-Panel (`sections/PricingTeaser.astro`):
        ein `<a>` mit `.tds-decor` für die Dekoration, der Inhalt als
        einziges folgendes Geschwister darüber. KEIN `.btn` — ungelayertes
        tds-shared schlägt jede Tailwind-Utility, eine eigene Fläche an
        `.btn btn-primary` würde also nicht greifen.

        Rosé statt Navy, obwohl Navy die naheliegende Knopf-Farbe wäre:
        das Pricing-Panel weiter oben ist navy und der Kontaktabschnitt
        direkt darunter auch. Ein drittes Navy in Folge liest sich als
        derselbe Block dreimal.

        Der Titel bleibt ein `<p>`. Ein `<h3>` hier würde eine Ebene in die
        Gliederung einziehen, die inhaltlich keine ist. */}
    <a
      href={contactHref}
      class="faq-cta group relative block overflow-hidden mt-12 rounded-[6px] p-7 md:p-9 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-4 focus-visible:ring-offset-[var(--color-soft)]"
      data-reveal
    >
      <span class="tds-decor" aria-hidden="true">
        <span
          class="tds-shape tds-shape--quarter-bl tds-shape--coral"
          style="top: -4rem; right: -4rem; width: 16rem; height: 16rem;"
        ></span>
      </span>
      <span class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
        <span class="block">
          <span class="block font-[var(--font-display)] text-xl text-[var(--color-black)]">
            {ui.moreTitle}
          </span>
          <span class="faq-cta-sub mt-1.5 block text-sm">
            {ui.moreText}
          </span>
        </span>
        <span class="faq-cta-pill inline-flex shrink-0 items-center gap-2 self-start rounded-full px-5 py-2.5 text-sm font-medium sm:self-auto">
          {ui.moreCta}
          <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="faq-cta-arrow"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </span>
    </a>
  </div>
</section>

<style>
  /* Active question: a filled row + accent colour, replacing the accent
     edge the borderless pass removed. The state must never rest on colour
     ALONE, so the fill and the question's own recolour carry it together —
     and the fill is the reason the selected row is still findable at a
     glance in a list of ten. Padding-only geometry, so selecting shifts
     nothing. */
  .faq-tab[aria-selected="true"],
  .faq-m[open] > .faq-m-summary {
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    border-radius: 6px;
  }
  .faq-tab[aria-selected="true"] .faq-q,
  .faq-tab:hover .faq-q {
    color: var(--color-accent);
  }
  .faq-tab[aria-selected="true"] .faq-arrow {
    color: var(--color-accent);
    transform: translateX(2px);
  }
  /* The question list scrolls on its own (desktop) while the answer
     panel stays put — a thin, brand-tinted scrollbar keeps it discreet. */
  .faq-tablist {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--color-accent) 45%, transparent)
      transparent;
    overscroll-behavior: contain;
  }
  .faq-tablist::-webkit-scrollbar {
    width: 6px;
  }
  .faq-tablist::-webkit-scrollbar-thumb {
    background-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: 9999px;
  }
  .faq-tablist::-webkit-scrollbar-track {
    background: transparent;
  }

  /* Both chevrons spring rather than ease. The rotation is the only thing
     on this section that MOVES, so it is where the site's voice has to be
     audible; the colour beside it still eases, because a colour that
     overshoots lands outside the palette. */
  .faq-arrow,
  .faq-m-arrow {
    transition:
      transform 320ms var(--lp-ease-bounce),
      color 200ms var(--tds-ease-out);
  }

  .faq-panel {
    animation: faq-fade 280ms var(--lp-ease-bounce) both;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-panel {
      animation: none;
    }
  }
  @keyframes faq-fade {
    from { opacity: 0; transform: translateY(0.5rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Mobile accordion (<details>). Strip the native marker, rotate the
     chevron, and give the answer a real height transition. */
  .faq-m-summary { list-style: none; }
  .faq-m-summary::-webkit-details-marker { display: none; }
  .faq-m[open] > .faq-m-summary .faq-m-q,
  .faq-m-summary:hover .faq-m-q { color: var(--color-accent); }
  .faq-m[open] > .faq-m-summary .faq-m-arrow {
    color: var(--color-accent);
    transform: rotate(90deg);
  }

  /* A `<details>` used to SNAP open and then fade its answer in, which
     reads as the row jumping and the text arriving late. `::details-content`
     is the element the browser wraps the answer in, and with
     `interpolate-size: allow-keywords` (set on :root in global.css) a
     transition to `auto` height is animatable.

     `@supports` is doing real work: in a browser without either feature
     the whole block is skipped and the row opens instantly, exactly as it
     did before — no measured heights, no JS, no jump. */
  @supports selector(::details-content) {
    .faq-m::details-content {
      block-size: 0;
      overflow: clip;
      opacity: 0;
      transition:
        block-size 320ms var(--lp-ease-soft),
        opacity 220ms var(--tds-ease-out),
        content-visibility 320ms allow-discrete;
      transition-behavior: allow-discrete;
    }
    .faq-m[open]::details-content {
      block-size: auto;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-arrow,
    .faq-m-arrow {
      transition: none;
    }
    /* END STATE. The shared reduced-motion block clamps duration, which
       for a discrete `content-visibility` step is not enough — without
       this an opened row could sit at height 0. */
    @supports selector(::details-content) {
      .faq-m::details-content,
      .faq-m[open]::details-content {
        transition: none;
      }
      .faq-m[open]::details-content {
        block-size: auto;
        opacity: 1;
      }
    }
  }

  /* Die Ausstiegsfläche. Rosé auf dem Sand-Grund des Abschnitts: warm
     genug, um als Einladung zu lesen, und weit genug von den beiden
     Navy-Blöcken darüber und darunter entfernt, um nicht als deren
     Wiederholung durchzugehen. Beim Hover eine Stufe kräftiger statt
     einer Bewegung — der Block ist breit, ein Anheben würde die ganze
     Zeile schieben. */
  .faq-cta {
    background: color-mix(in srgb, var(--color-accent-pink) 16%, var(--color-paper));
    transition: background-color 200ms var(--tds-ease-out);
  }
  .faq-cta:hover {
    background: color-mix(in srgb, var(--color-accent-pink) 24%, var(--color-paper));
  }
  /* Der Pseudo-Knopf. Kein `.btn`, siehe Kommentar am Markup — die Fläche
     ist der Link, das hier ist nur seine sichtbare Handlungsaufforderung. */
  .faq-cta-pill {
    background: var(--color-accent);
    /* NICHT `#fff`. Der Akzent ist hell Bordeaux (#820933) und dunkel
       Koralle (#ff8fab) — Weiss darauf misst im Dark Mode 2.15:1. Das
       Papier-Token kippt mit dem Theme und liefert in beiden Richtungen
       den hellen bzw. dunklen Gegenpol. */
    color: var(--color-paper);
    transition: gap 200ms var(--tds-ease-out);
  }
  /* `--color-muted` auf der rosé Flaeche misst 4.47:1 und verfehlt die
     4.5 damit um Haaresbreite. Eine Spur dunkler statt die Flaeche heller:
     die Toenung ist der Punkt der Karte. */
  .faq-cta-sub {
    color: color-mix(in srgb, var(--color-muted) 82%, var(--color-black));
  }
  .faq-cta:hover .faq-cta-pill {
    gap: 0.75rem;
  }

  .faq-cta-arrow {
    transition: transform 280ms var(--lp-ease-bounce);
  }
  .faq-cta:hover .faq-cta-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-cta,
    .faq-cta-pill,
    .faq-cta-arrow {
      transition: none;
    }
    .faq-cta:hover .faq-cta-arrow {
      transform: none;
    }
    .faq-cta:hover .faq-cta-pill {
      gap: 0.5rem;
    }
  }
</style>

<script>
  // Progressive enhancement: turn the question list + panels into an
  // ARIA tablist. Without this script the first answer stays visible.
  const root = document.getElementById("faq");
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const active = t === tab;
        t.setAttribute("aria-selected", String(active));
        t.tabIndex = active ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !active;
      }
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (e) => {
        let next = -1;
        if (e.key === "ArrowDown" || e.key === "ArrowRight") next = (i + 1) % tabs.length;
        else if (e.key === "ArrowUp" || e.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = tabs.length - 1;
        if (next >= 0) {
          e.preventDefault();
          tabs[next].focus();
          select(tabs[next]);
        }
      });
    });
  }
</script>
