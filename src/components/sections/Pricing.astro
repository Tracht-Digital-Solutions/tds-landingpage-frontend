---
/**
 * Preise — every rate, what it includes, and how a price comes about, visible
 * without a single click.
 *
 * ### What it replaced
 *
 * A navy teaser band ("ab 65 €") that opened a drawer. The drawer scrolled the
 * page to the band first and then slid in, trapped focus correctly but did not
 * give it back after Escape, and did not close on the Back button — Back left
 * the page instead. More fundamentally it put the one thing a visitor weighing
 * a decision wants to compare behind an extra step. Decided 2026-09-12: prices
 * are a section.
 *
 * `/preise`, `/en/preise` and `/en/pricing` answer with a 301 to `#preise`. The
 * old anchor `#pricing-teaser` keeps working through the alias at the top.
 *
 * ### Order
 *
 * The numbers first ("Webseitenpreise zum Festpreis"), then the price
 * calculator's button (`PriceCalculator.astro`, a modal that adds the packages
 * up), then the one call to action. "So entsteht dein Preis" was removed on
 * 2026-10-11.
 *
 * ### No project price ranges
 *
 * Deliberately. The rates are real numbers from the pricing block; a "typical
 * website: 1,500–4,000 €" would be an estimate the site cannot stand behind.
 * What is explained instead is how a price is formed, which is true for every
 * project.
 */
import { resolveLang } from "~/lib/i18n";
import { getPricingContent } from "~/lib/pricing";
import AssistantCard from "~/components/ui/AssistantCard.astro";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import Emphasis from "~/components/ui/Emphasis.astro";
import PricingList from "~/components/PricingList.astro";
import PriceCalculator from "~/components/PriceCalculator.astro";

const lang = resolveLang(Astro.currentLocale);
const pricing = await getPricingContent(lang);
// "So entsteht dein Preis" (`pricing_logic`) no longer renders (2026-10-11);
// its content stays in `homeContent.ts` so a stored block keeps loading. The
// price calculator took its place.
const calcUi =
  lang === "de"
    ? { text: "Mehrere Pakete oder Extras? Rechne deinen Webseitenpreis aus.", button: "Preisrechner öffnen" }
    : { text: "Several packages or extras? Work out your website price.", button: "Open the price calculator" };
---

<section id="preise" class="section-spacing" aria-labelledby="pricing-heading">
  {/* Old deep links (`/#pricing-teaser`) land here too. */}
  <span id="pricing-teaser" class="block" aria-hidden="true"></span>

  <div class="lp-container">
    <div class="max-w-2xl mx-auto md:mx-0">
      <SectionHeader
        headline={pricing.headline}
        headlineAccent={pricing.headlineAccent}
        id="pricing-heading"
        headingClass="mb-6"
      />
      <p class="text-[var(--color-muted)] leading-relaxed text-center md:text-left">
        <Emphasis text={pricing.sub} />
      </p>
    </div>
    {/* The second way into the assistant, for the visitor who reaches the
        prices without knowing which package is theirs. Revealed by
        `ServiceAssistant.astro` once the dialog can open. */}
    <div class="mt-8">
      <AssistantCard lang={lang} variant="compact" />
    </div>

    <div class="pricing-host">
      <PricingList lang={lang} headingLevel={3}>
        {/* The calculator's way in, right under the cards it adds up. Ships
            `hidden`; `PriceCalculator.astro` reveals it once the dialog can
            open. */}
        <div slot="after-packages" class="calc-trigger rounded-[6px]">
          <p class="calc-trigger__text">{calcUi.text}</p>
          <button type="button" class="calc-trigger__button" data-calc-open hidden>
            {calcUi.button}
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </PricingList>
    </div>
  </div>
  <PriceCalculator />
</section>

<style>
  /* The price row bleeds to both window edges (`.lp-band`); without this the
     bleed is horizontal overflow of the document. `clip`, never `hidden`:
     `hidden` would make this a scroll container, and then a card taking
     keyboard focus would scroll THIS box instead of the page. Same rule as
     `#showcase`. */
  #preise {
    overflow-x: clip;
  }

  /* The calculator's row under the packages. */
  .calc-trigger {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin: 0 0 2.5rem;
    padding: 1.25rem 1.5rem;
    border-radius: 6px;
    background: var(--color-soft);
  }
  .calc-trigger__text {
    margin: 0;
    font-weight: 600;
    color: var(--color-black);
  }
  .calc-trigger__button {
    --lp-fill: var(--color-surface-navy);
    --lp-shade: var(--color-accent-pink);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.625rem 1.375rem;
    border: 0;
    border-radius: 100px;
    background: var(--lp-fill);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 200ms var(--tds-ease-out),
      translate 160ms var(--tds-ease-out);
  }
  .calc-trigger__button:hover {
    --lp-fill: var(--color-surface-accent);
    --lp-shade: initial;
  }
  .calc-trigger__button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  :global(:root[data-theme="dark"]) .calc-trigger__button {
    --lp-fill: var(--color-primary);
    color: var(--color-on-primary);
  }

  /* The price list sizes its columns against THIS box (a container query in
     `PricingList.astro`), named so it cannot resolve against another
     ancestor. `inline-size`, never `size`: the height is the content's. */
  .pricing-host {
    container: pricing-list / inline-size;
    margin-top: 2.5rem;
  }
</style>
