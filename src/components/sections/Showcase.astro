---
/**
 * Beispielseiten — my own example sites and projects on ONE horizontally
 * navigable shelf. NOT client work: that is `sections/CustomerCases.astro`.
 *
 * ### Why the reference cases left this shelf
 *
 * Until the 2026-09 redesign the customer cases and the demos shared this
 * carousel, cases first. Nothing on a card said which was a client's project and
 * which a sample about a company that does not exist — and "is this real?" is
 * the first question a visitor judging this business by its work asks. The
 * cases have their own section with a "Kundenprojekt" label now; every card
 * here carries its origin ("Demo · fiktives Beispiel", "Eigenes Projekt", see
 * `DEMO_ORIGINS`), and the framing says "keine Kundenaufträge" in words.
 *
 * `WebsiteDemos.astro` still renders the same demo cards as a grid on the
 * Webauftritt detail page, where the demos ARE the argument.
 *
 * ### The gate
 *
 * The business-card tile always renders — it is a page of this very deployment
 * — so the shelf is never empty. The demo cards are strict about availability
 * (`lib/demos.ts`), and the framing picks its singular or plural copy from the
 * number of demos that survived (`demosCopy`).
 *
 * ### Ground
 *
 * PLAIN PAPER, no `tds-tone-*`: the process section above and the journal
 * below are sand, so the cards take the sand fill instead.
 */
import { resolveLang } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
import { demosCopy, getHomeContent } from "~/lib/homeContent";
import { getDemos } from "~/lib/demos";
import { getServiceById, serviceHref } from "~/lib/services";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import Emphasis from "~/components/ui/Emphasis.astro";
import DemoCard from "~/components/ui/DemoCard.astro";
import BusinessCardTile from "~/components/ui/BusinessCardTile.astro";
import PreviewLightbox from "~/components/ui/PreviewLightbox.astro";

const lang = resolveLang(Astro.currentLocale);
const content = await cmsFor("website_demos", lang, getHomeContent(lang).websiteDemos);

const demos = await getDemos();
const copy = demosCopy(content, demos.length, "home");

/**
 * The service every demo and the business-card tile is evidence for.
 *
 * Resolved once here and handed down, rather than looked up inside the cards:
 * the answer depends on WHERE the card is rendered. On the Webauftritt detail
 * page the same cards get `null`, because a link back to the page the visitor
 * is standing on is a dead end. `demoCatalog.ts` deliberately has no imports,
 * so this is also not a field a demo could carry.
 */
const webPresence = getServiceById("web-presence");
const webPresenceLink = {
  label: webPresence.fallback[lang].title,
  href: serviceHref(webPresence, lang),
};

type Slide =
  | { kind: "demo"; key: string; demo: (typeof demos)[number] }
  | { kind: "business-card"; key: string };

/**
 * The shelf as one list: the demos in catalog order, then the business card.
 *
 * THE LEAD CARD — two tracks wide from `lg` — is the first demo, i.e. the first
 * slide that carries a picture. Wider rather than taller: the slides stretch to
 * the tallest card, so height spent on the lead card would pad every other
 * card. Both card families answer the width through their own container query.
 */
const slides: Slide[] = [
  ...demos.map((demo): Slide => ({ kind: "demo", key: `demo:${demo.definition.id}`, demo })),
  { kind: "business-card", key: "business-card" },
];
const leadKey = demos.length > 0 ? slides[0]!.key : null;

/** Carousel chrome. This site's own words about its own control, so it follows
 *  the page's locale and is not editable copy — a mislabelled control is an
 *  accessibility defect, not a matter of tone. */
const ui =
  lang === "de"
    ? {
        carousel: "Beispielseiten und eigene Projekte",
        prev: "Vorherige Karten",
        next: "Weitere Karten",
      }
    : {
        carousel: "Example sites and own projects",
        prev: "Previous cards",
        next: "More cards",
      };
---

<section id="showcase" class="section-spacing" aria-labelledby="showcase-heading">
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    {/* Masthead only. The arrows flank the track itself, which is where a
        visitor looks when they want the row to move. */}
    <div class="max-w-2xl mx-auto md:mx-0">
      <SectionHeader
        headline={copy.headline}
        headlineAccent={copy.headlineAccent}
        id="showcase-heading"
        headingClass="mb-6"
      />
      <p class="text-[var(--color-muted)] leading-relaxed text-center md:text-left">
        <Emphasis text={copy.intro} />
      </p>
    </div>

    {/* The track is a real scroll container, not a transformed strip. That
        is the whole design: a trackpad swipe, a touch drag, a shift-wheel
        and the arrow buttons all move the same thing, and a card that
        receives focus is scrolled into view by the browser rather than by
        code we would have to write. `data-carousel` is what the script
        binds to; with no JavaScript the row still scrolls, just without
        the buttons — which is why they start `hidden`. */}
    <div class="showcase" data-carousel>
      <div
        class="showcase__track"
        data-carousel-track
        tabindex="0"
        role="group"
        aria-label={ui.carousel}
      >
        {slides.map((slide) => (
          <div
            class:list={["showcase__slide", slide.key === leadKey && "showcase__slide--lead"]}
          >
            {slide.kind === "demo" && (
              <DemoCard demo={slide.demo} lang={lang} serviceLink={webPresenceLink} />
            )}
            {slide.kind === "business-card" && <BusinessCardTile serviceLink={webPresenceLink} />}
          </div>
        ))}
      </div>

      {/* Flanking the track, vertically centred, half over the outermost
          card — one arrangement at every width.

          Hidden from assistive tech, and that is the point rather than an
          oversight: the track is a plain scroll container that a screen
          reader already walks card by card, and a keyboard user reaches
          every card in DOM order. These buttons add nothing there — they
          are a pointer affordance.

          Two conditions gate them, and only one is in this file: the CSS
          shows them on pointer devices alone, and the script keeps them
          `hidden` until it measures a real overflow. */}
      <div class="showcase-nav" aria-hidden="true" data-carousel-nav hidden>
        <button type="button" class="showcase-nav__btn" data-carousel-prev tabindex="-1">
          <span class="sr-only">{ui.prev}</span>
          <svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 5 8 12l7 7" />
          </svg>
        </button>
        <button type="button" class="showcase-nav__btn" data-carousel-next tabindex="-1">
          <span class="sr-only">{ui.next}</span>
          <svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m9 5 7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* Inside the section on purpose: the lightbox script binds each dialog
      to the magnifiers of ITS OWN section, so a second shelf on a future
      page gets its own dialog instead of driving this one. */}
  <PreviewLightbox lang={lang} />
</section>

<style>
  /* The shelf's horizontal overflow stops at this section.

     Measured, not assumed: at 375px the section's own `scrollWidth` grew with
     the bleeding track while its box stayed 375 wide. It was never visible to
     a visitor — `body` already carries `overflow-x: clip` — and that is why it
     belongs HERE rather than left alone: a section that owns a horizontal
     scroller should confine its own overflow instead of relying on a rule
     three ancestors up to hide the evidence.

     `clip`, never `hidden`. `hidden` would make this a scroll container, and
     then a card taking keyboard focus would scroll THIS box instead of the
     track — the shelf would look untouched while the page jumped. */
  #showcase {
    overflow-x: clip;
  }

  .showcase {
    position: relative;
    margin-top: 3rem;
    /* Where the shelf's content edge is, measured from `.showcase` itself.
       It exists because the arrows are positioned against the page's TEXT
       edge, not against this box: on phones `.showcase` is pulled 1.5rem
       wider than the text column (the bleed below), so an arrow at `left: 0`
       would sit at the window edge. Same two values as `padding-inline` and
       `scroll-padding-inline` on the track, and they have to stay that way —
       all three describe the same edge. */
    --showcase-edge: 1.5rem;
    /* The track bleeds to both viewport edges on phones so a half-visible next
       card sits at the screen edge instead of behind a 1.5rem margin — that
       peek is the only thing telling a touch user there is more. The padding
       puts the first card back on the page's text edge. Above the container
       width there is nothing to bleed into, so it is switched off. */
    margin-inline: -1.5rem;
  }

  .showcase__track {
    display: flex;
    /* Slides STRETCH to the tallest card, so the footer bars of all cards
       land on one line across the shelf. Nothing stretches the CARD directly:
       `.showcase__slide` is a grid with `grid-template-rows: 1fr` whose own
       height only becomes definite by being stretched here; the cards'
       `height: 100%` resolves against that row. */
    gap: 1rem;
    padding-inline: 1.5rem;
    /* MUST match `padding-inline`. `scroll-snap-align: start` aligns a slide
       to the scrollport's start edge, and without a matching scroll-padding
       that edge is INSIDE the padding: the track's resting position is then
       `scrollLeft = 24`, not 0, and the "prev" button (which disables on
       `scrollLeft <= 2`) never disables at all. */
    scroll-padding-inline: 1.5rem;
    /* A little vertical room: the cards' focus ring is drawn with a 3px
       offset and would be clipped by the scroll container without it. */
    padding-block: 0.25rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    /* The scrollbar is chrome the arrows already replace. Hidden, never the
       scrolling itself. */
    scrollbar-width: none;
  }
  .showcase__track::-webkit-scrollbar {
    display: none;
  }
  .showcase__track:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .showcase__slide {
    /* `flex: none` with an explicit basis, NOT a percentage width: a flex item
       in a scroll container shrinks to its content otherwise and the whole
       track collapses into one screen of squeezed cards.

       One card and a peek of the next on a phone; the peek is what says the
       row scrolls. */
    flex: 0 0 min(82%, 22rem);
    scroll-snap-align: start;

    /* GRID, and it has to be — this slot was `display: flex` first and the
       demo card rendered exactly 0 pixels wide: `DemoCard`'s root carries
       `container-type: inline-size`, whose inline-size containment makes a
       FLEX item's base size zero. A grid item is stretched to its track
       instead of measured from its content, so the width is definite before
       containment is consulted. Same for the row. */
    display: grid;
    grid-template-rows: 1fr;
  }

  @media (min-width: 768px) {
    .showcase {
      margin-inline: 0;
      --showcase-edge: 0rem;
    }
    .showcase__track {
      gap: 1.5rem;
      padding-inline: 0;
      scroll-padding-inline: 0;
    }
    .showcase__slide {
      flex-basis: calc((100% - 1.5rem) / 2);
    }
  }

  @media (min-width: 1024px) {
    .showcase__slide {
      flex-basis: calc((100% - 3rem) / 3);
    }

    /* THE LEAD CARD, and only here: two of the three tracks plus the gap
       between them, so it lines up with the grid the other cards sit on.
       Deliberately NOT applied at `md`, where two of two is the whole
       container — a lone full-width card is a poster, not a shelf. */
    .showcase__slide--lead {
      flex-basis: calc((100% - 3rem) / 3 * 2 + 1.5rem);
    }
  }

  /* POINTER DEVICES ONLY, and hidden by default so that is the fallback.
     On a phone the shelf is swiped, and a 44px button parked over the card
     would cover content to offer a slower version of the gesture the
     visitor is already making. `hover: hover` AND `pointer: fine`: a laptop
     with both a touchscreen and a mouse must keep the arrows. */
  .showcase-nav {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .showcase-nav {
      display: block;
    }

    /* `.showcase-nav { display: block }` beats the user agent's
       low-specificity `[hidden] { display: none }`, so the attribute the
       script writes would do nothing without this. It has to live INSIDE this
       query: outside it the two rules would race by source order. */
    .showcase-nav[hidden] {
      display: none;
    }

    .showcase__track {
      cursor: grab;
    }
    /* Set by the script for the length of a real drag only. */
    .showcase__track.is-dragging {
      cursor: grabbing;
      user-select: none;
    }
  }

  .showcase-nav__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* The shared 44px minimum. */
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--tds-radius-pill);
    /* PAPER, not sand: half of each button lies over a card whose fill is
       sand. The shadow is the only one on this shelf, which is what says the
       buttons float above the row rather than sit in it. */
    background: var(--color-paper);
    color: var(--color-black);
    box-shadow: 0 6px 20px -8px color-mix(in srgb, var(--color-black) 55%, transparent);
    cursor: pointer;
    transition:
      background-color 200ms var(--tds-ease-out),
      color 200ms var(--tds-ease-out),
      opacity 200ms var(--tds-ease-out);
  }
  [data-carousel-prev] {
    left: var(--showcase-edge);
  }
  [data-carousel-next] {
    right: var(--showcase-edge);
  }
  .showcase-nav__btn:hover {
    background: color-mix(in srgb, var(--color-primary) 8%, var(--color-paper));
    color: var(--color-primary);
  }
  /* Disabled rather than removed at the ends of the track: a control that
     disappears moves the one beside it under the cursor mid-click. */
  .showcase-nav__btn[disabled] {
    opacity: 0.35;
    cursor: default;
  }
  .showcase-nav__btn[disabled]:hover {
    background: var(--color-paper);
    color: var(--color-black);
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-nav__btn {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Arrow navigation and mouse dragging for the showcase shelf.
   *
   * Everything here is an enhancement on top of a track that already scrolls:
   * the buttons ship `hidden` and are only revealed once this measures a real
   * overflow, so a shelf whose cards all fit shows no controls at all, and a
   * failed bundle leaves a plain scrolling row rather than dead arrows.
   *
   * The step is measured from a slide instead of being written down, because
   * the slide width is three different values across two breakpoints and a
   * hardcoded number would drift the first time one of them is tuned.
   */
  const carousels = document.querySelectorAll<HTMLElement>("[data-carousel]");

  for (const root of carousels) {
    const track = root.querySelector<HTMLElement>("[data-carousel-track]");
    // The nav is a sibling of the track's wrapper, not a child, so it is found
    // from the section rather than from `root`.
    const section = root.closest("section");
    const nav = section?.querySelector<HTMLElement>("[data-carousel-nav]") ?? null;
    const prev = nav?.querySelector<HTMLButtonElement>("[data-carousel-prev]") ?? null;
    const next = nav?.querySelector<HTMLButtonElement>("[data-carousel-next]") ?? null;
    if (!track || !nav || !prev || !next) continue;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

    /**
     * One slide plus one gap — how far a click travels.
     *
     * Measured from an ORDINARY slide, not from `firstElementChild`: the first
     * one is the lead card and it is two tracks wide above `lg`, so measuring
     * it would make every arrow click jump two cards and skip whatever sat
     * between them. Falls back to the first child for a shelf that is nothing
     * but a lead card, where two tracks is all there is to travel anyway.
     */
    const step = () => {
      const slide = (track.querySelector(":scope > :not(.showcase__slide--lead)") ??
        track.firstElementChild) as HTMLElement | null;
      if (!slide) return track.clientWidth;
      const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
      return slide.getBoundingClientRect().width + gap;
    };

    /**
     * Native smooth scrolling on the TRACK, not a rAF tween.
     *
     * This is deliberate and worth keeping: the page sets
     * `scroll-behavior: smooth` globally, which starves any hand-written
     * requestAnimationFrame tween (it fights the browser's own animation for
     * the same scroll position). `scrollBy` is the same mechanism, so the two
     * cannot disagree.
     */
    const go = (direction: 1 | -1) => {
      track.scrollBy({
        left: direction * step(),
        behavior: reduce.matches ? "auto" : "smooth",
      });
    };

    prev.addEventListener("click", () => go(-1));
    next.addEventListener("click", () => go(1));

    /**
     * Drag the shelf with a mouse.
     *
     * MOUSE ONLY. Touch already scrolls this container natively, with
     * momentum and snap that no hand-written gesture matches; a second
     * mechanism on top would fight the first. `pointerType` is the whole
     * guard — there is no touch branch to get wrong.
     *
     * The three rules below are not style. They are what a drag gesture over
     * links costs, learned from the journal hero, where getting them wrong
     * killed every link in the slider without erroring once.
     */
    /** Past this many pixels a press is a drag and no longer a click. */
    const DRAG_THRESHOLD = 6;

    let dragging = false;
    let moved = false;
    let startX = 0;
    let startScroll = 0;

    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      track.classList.remove("is-dragging");
      // Hand the track back to the browser: snapping is what puts a card on
      // the edge again, and it can only do that once it owns the scroll
      // position. Restoring these AFTER the gesture is what makes a release
      // settle instead of stopping wherever the cursor was.
      track.style.scrollSnapType = "";
      track.style.scrollBehavior = "";
    };

    track.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" || event.button !== 0) return;
      dragging = true;
      moved = false;
      startX = event.clientX;
      startScroll = track.scrollLeft;
      // RULE 1: no `setPointerCapture` here. While an element holds the
      // pointer the browser retargets the compatibility mouse events — CLICK
      // included — at the capture element, so every link inside the cards
      // would be dead: the click fires on the track and the <a> never sees
      // it. Nothing errors, the cursor still says grab, the arrows still
      // work, and the shelf simply stops leading anywhere. Capture is taken
      // in `pointermove` instead, once this is a real drag; a plain click
      // never gets that far.
    });

    track.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const dx = event.clientX - startX;

      if (!moved) {
        if (Math.abs(dx) < DRAG_THRESHOLD) return;
        moved = true;
        track.classList.add("is-dragging");
        // Two properties the browser would otherwise apply to every frame of
        // this gesture, both from how this shelf is built:
        //
        // `scroll-snap-type: x mandatory` fights a per-frame `scrollLeft`
        // write — the card sticks to the cursor or springs back mid-drag.
        //
        // `scroll-behavior` is `smooth` for the whole page, and per spec that
        // applies to a `scrollLeft` assignment too: the track would ANIMATE
        // towards each new value instead of following the hand. The arrow
        // path deliberately keeps it, which is why `go()` uses `scrollBy`.
        track.style.scrollSnapType = "none";
        track.style.scrollBehavior = "auto";
        // Now it is a drag: take the pointer so a release outside the track
        // still ends the gesture rather than leaving it stuck to the cursor.
        track.setPointerCapture?.(event.pointerId);
      }

      track.scrollLeft = startScroll - dx;
    });

    for (const type of ["pointerup", "pointercancel", "pointerleave"]) {
      track.addEventListener(type, endDrag);
    }

    // RULE 2: without capture on pointerdown, a horizontal press on a link or
    // a card screenshot starts the browser's native drag-and-drop; Chrome
    // then fires `pointercancel` on the FIRST move and the gesture is dead.
    // Nothing turns red — the arrows keep working. It always changes together
    // with rule 1.
    track.addEventListener("dragstart", (event) => event.preventDefault());

    // RULE 3: a drag that ends on a card must not open it. The click arrives
    // after `pointerup`, so the flag is still set; capture phase, because the
    // card's own <a> would otherwise see it first.
    track.addEventListener(
      "click",
      (event) => {
        if (!moved) return;
        moved = false;
        event.preventDefault();
        event.stopPropagation();
      },
      true,
    );

    const sync = () => {
      // `scrollWidth - clientWidth` can be a fraction of a pixel off on a
      // fractional layout, so both ends get a 2px tolerance rather than an
      // exact comparison — without it the "next" button never disables.
      const max = track.scrollWidth - track.clientWidth;
      const overflowing = max > 2;

      nav.hidden = !overflowing;
      // The nav is `aria-hidden`, so its buttons must be unreachable by Tab as
      // well; a focusable element inside an aria-hidden subtree is exactly the
      // state assistive tech has no way to describe.
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
    };

    sync();
    track.addEventListener("scroll", sync, { passive: true });
    // Slide width changes at both breakpoints and when the scrollbar-less
    // track is re-laid-out by a font or image load, so the end states are
    // recomputed from the element rather than from the window.
    if (typeof ResizeObserver !== "undefined") {
      new ResizeObserver(sync).observe(track);
    } else {
      window.addEventListener("resize", sync, { passive: true });
    }
  }
</script>
