---
/**
 * Leistungen, as products: the most important ones and, in the same row, the
 * assistant for whoever cannot say yet which one fits. The Shop carries all of
 * them with their "ab" price; the link below leads to its filtered catalogue.
 */
import { resolveLang } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
import { getHomeContent } from "~/lib/homeContent";
import { imageHints } from "~/lib/imageCatalog";
import { getServiceProducts, shopServicesHref } from "~/lib/serviceProducts";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import AssistantCard from "~/components/ui/AssistantCard.astro";

const lang = resolveLang(Astro.currentLocale);

const servicesContent = await cmsFor(
  "services_overview",
  lang,
  getHomeContent(lang).servicesOverview,
);
const products = await getServiceProducts(lang);
const ui =
  lang === "de"
    ? { more: "Zu den Leistungen" }
    : { more: "To the services" };
---

{/* No ground of its own: the page has ONE ground, `.page-ground` in
    `layouts/Layout.astro`. */}
<section
  id="services"
  class="section-spacing"
  aria-labelledby="services-heading"
>
  <div class="lp-container">
    <SectionHeader
      headline={servicesContent.headline}
      headlineAccent={servicesContent.headlineAccent}
      id="services-heading"
      headingClass="mb-10"
      bar
    />
    <ul class="product-grid">
      {
        products.map((product) => (
          <li class="product-tile" data-reveal>
            <a class="product-tile__link" href={product.href} data-track="service-product">
              <span class="product-tile__media">
                <img
                  class="product-tile__img"
                  src={product.image}
                  srcset={imageHints(product.image, lang)?.srcSet}
                  sizes="(min-width: 48rem) 18vw, 50vw"
                  alt=""
                  width="1536"
                  height="960"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="product-tile__body">
                <span class="product-tile__go" aria-hidden="true">→</span>
                <span class="product-tile__kind">{product.kind[lang]}</span>
                <span class="product-tile__title">{product.title[lang]}</span>
              </span>
            </a>
          </li>
        ))
      }
      {/* The dialog is `components/ServiceAssistant.astro`, which also reveals
          the tile once it can open anything. Without it the row closes up. */}
      <li class="product-tile product-tile--assistant" data-reveal>
        <AssistantCard lang={lang} />
      </li>
    </ul>

    <div class="product-more">
      <a class="product-more__link lp-ink" href={shopServicesHref(lang)} data-cta data-track="services-more">
        {ui.more}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

{/* Global: `ui/AssistantCard.astro` is a tile of this row. */}
<style is:global>
  /* Never a wrapped row: the tiles scale with the page. A phone gets a composed
     layout: the lead tile across, pairs, the assistant across. */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .product-tile {
    container-type: inline-size;
    min-width: 0;
  }
  .product-tile:first-child,
  .product-tile--assistant {
    grid-column: 1 / -1;
  }
  .product-tile--assistant:has(> [hidden]) {
    display: none;
  }
  @media (min-width: 48rem) {
    .product-grid {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      grid-template-columns: none;
      gap: clamp(0.5rem, 1.2vw, 1.25rem);
    }
    .product-tile:first-child,
    .product-tile--assistant {
      grid-column: auto;
    }
  }
  .product-tile__link {
    display: flex;
    flex-direction: column;
    aspect-ratio: 4 / 5;
    height: auto;
    overflow: hidden;
    padding: 0;
    border-radius: 6px;
    background: var(--color-surface-navy);
    color: #fff;
    text-decoration: none;
    box-shadow: var(--tds-shadow-hard);
    transition: translate 160ms var(--tds-ease-out);
  }
  .product-tile:first-child .product-tile__link,
  .product-tile--assistant .product-tile__link {
    aspect-ratio: 16 / 9;
  }
  @media (min-width: 48rem) {
    .product-tile__link,
    .product-tile:first-child .product-tile__link,
    .product-tile--assistant .product-tile__link {
      aspect-ratio: 3 / 4;
    }
  }
  .product-tile__link:is(:hover, :focus-visible) {
    translate: -2px -2px;
    box-shadow: var(--tds-shadow-hard-hover);
  }
  .product-tile__link:active {
    translate: 2px 2px;
    box-shadow: var(--tds-shadow-hard-press);
  }
  .product-tile__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .product-tile__media {
    display: block;
    flex: 1 1 0;
    min-height: 0;
    overflow: hidden;
  }
  .product-tile__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The words stand on solid navy, in both themes. */
  .product-tile__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: clamp(0.75rem, 8cqi, 1.125rem);
  }
  /* Room for two title lines, so every tile in the row cuts its picture at one height. */
  @media (min-width: 48rem) {
    .product-tile__body {
      min-height: clamp(6.25rem, 52cqi, 7.5rem);
    }
  }
  .product-tile__kind {
    font-family: var(--font-mono);
    font-size: clamp(0.625rem, 5.4cqi, 0.75rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.85);
  }
  .product-tile__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1rem, 9.5cqi, 1.5rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
    hyphens: auto;
  }
  /* The button rides the seam between picture and words, with the site's hard
     offset. It answers the tile: pink fill, the shadow's lift. */
  .product-tile__go {
    position: absolute;
    top: 0;
    right: clamp(0.75rem, 8cqi, 1.125rem);
    translate: 0 -50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--tds-radius-pill, 100px);
    background: #fff;
    color: #050f68;
    font-weight: 700;
    box-shadow: 2px 2px 0 0 var(--color-accent-pink);
    transition:
      background-color 160ms var(--tds-ease-out),
      translate 160ms var(--tds-ease-out),
      box-shadow 160ms var(--tds-ease-out);
  }
  .product-tile__link:is(:hover, :focus-visible) .product-tile__go {
    background: var(--color-accent-pink);
    translate: -1px calc(-50% - 1px);
    box-shadow: 3px 3px 0 0 #fff;
  }
  @media (prefers-reduced-motion: reduce) {
    .product-tile__link,
    .product-tile__go {
      transition: none;
    }
    .product-tile__link:is(:hover, :focus-visible) {
      translate: none;
    }
    .product-tile__link:is(:hover, :focus-visible) .product-tile__go {
      translate: 0 -50%;
    }
  }

  .product-more {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }
  .product-more__link {
    --lp-fill: var(--color-accent);
    --lp-shade: initial;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.75rem 1.75rem;
    border-radius: 100px;
    background: var(--lp-fill);
    color: var(--color-paper);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 200ms var(--tds-ease-out);
  }
  .product-more__link:hover {
    --lp-fill: var(--color-surface-navy);
    --lp-shade: var(--color-accent-pink);
  }
  .product-more__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
