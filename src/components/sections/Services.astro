---
import { tFor, resolveLang } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import ServiceCard from "~/components/ui/ServiceCard.astro";

const t = tFor(Astro.currentLocale);
const lang = resolveLang(Astro.currentLocale);

// Editable services — admin block overrides the tds-shared default.
const servicesContent = await cmsFor("services", lang, {
  label: t.services.label,
  headline: t.services.headline,
  headlineAccent: t.services.headlineAccent,
  items: t.services.items,
});

// Odd lists: the last card spans both columns on sm+ so the grid stays
// balanced.
const services = servicesContent.items;
---

{/* Sand — the quiet alternate ground, with the single-field variant of
    the wash so two consecutive decorated sections do not read as the
    same picture twice. `.tds-tone-sand` replaces the hand-written
    `bg-[var(--color-soft)]`: the tone is a named decision now, not a
    utility each section re-guesses. */}
<section
  id="services"
  class="tds-wash tds-wash--calm section-spacing tds-tone-sand"
  aria-labelledby="services-heading"
>
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <SectionHeader
      label={servicesContent.label}
      headline={servicesContent.headline}
      headlineAccent={servicesContent.headlineAccent}
      id="services-heading"
      bar
    />

    <div class="grid sm:grid-cols-2 gap-4 md:gap-6">
      {services.map((item, i) => {
        const orphan = i === services.length - 1 && services.length % 2 === 1;
        return (
          <div class:list={["h-full", orphan && "sm:col-span-2"]}>
            <ServiceCard
              number={item.number}
              title={item.title}
              description={item.description}
              tags={item.tags}
            />
          </div>
        );
      })}
    </div>
  </div>
</section>
