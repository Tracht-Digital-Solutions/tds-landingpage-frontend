---
import { resolveLang } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
import { getHomeContent } from "~/lib/homeContent";
import { platformDefinitions, platformHref } from "~/lib/platforms";
import {
  resolveServiceContent,
  serviceDefinitions,
  serviceHref,
} from "~/lib/services";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import ServiceCard from "~/components/ui/ServiceCard.astro";
import Emphasis from "~/components/ui/Emphasis.astro";
import { FINDER_SECTION } from "~/lib/serviceFinder";

const lang = resolveLang(Astro.currentLocale);

const servicesContent = await cmsFor(
  "services_overview",
  lang,
  getHomeContent(lang).servicesOverview,
);
const services = await Promise.all(
  serviceDefinitions.map(async (definition) => ({
    definition,
    content: await resolveServiceContent(definition, lang),
  })),
);
const systemsLabel = lang === "de" ? "Hilfe für dein System:" : "Help with your system:";
---

{/* No ground of its own. The page has ONE ground now — `.page-ground` in
    `layouts/Layout.astro` — and a section that painted sand or its own wash
    fields would cut it in half at its own edge. */}
<section
  id="services"
  class="section-spacing"
  aria-labelledby="services-heading"
>
  <div class="lp-container">
    <SectionHeader
      headline={servicesContent.headline}
      headlineAccent={servicesContent.headlineAccent}
      id="services-heading"
      headingClass="mb-6"
      bar
    />
    <p class="max-w-2xl text-[var(--color-muted)] leading-relaxed mb-3 text-center md:text-left mx-auto md:mx-0">
      <Emphasis text={servicesContent.intro} />
    </p>
    {/* For the visitor who reads four tiles and still cannot say which one is
        theirs — or what it costs: the assistant asks instead. It opens as a
        dialog (`components/ServiceAssistant.astro`), which also reveals this
        button once it can open anything. */}
    <p class="mb-10 text-center md:text-left">
      <button
        type="button"
        data-assistant-open
        hidden
        class="inline-flex min-h-11 items-center gap-2 text-left text-sm font-medium text-[var(--color-primary)] hover:text-[var(--color-accent)] transition-colors cursor-pointer"
      >
        {FINDER_SECTION[lang].servicesLink}
        <span aria-hidden="true">→</span>
      </button>
    </p>

    {/* One surface divided into four, not four cards floating on sand.

        The separation is a 1px grid gap over a parent painted in
        `--color-line`: the tiles paint their own fill, the gap lets the
        parent show through, and what a visitor sees is a hairline seam.

        `data-reveal` sits on the mosaic rather than on each tile on purpose:
        four tiles sliding up independently would open and close the seams
        while they travel. One picture, one entrance.

        Each tile answers the four questions a visitor scanning services has —
        what problem does it start from, what do I end up with, what does it
        cover, where do I go next — from the SAME resolved content the detail
        page renders, so an edit in the panel moves both. */}
    <div
      data-reveal
      class="-mx-6 md:mx-0 overflow-hidden rounded-none md:rounded-[6px] bg-[var(--color-line)] grid gap-px sm:grid-cols-2"
    >
      {services.map(({ definition, content }) => (
        <ServiceCard
          href={serviceHref(definition, lang)}
          title={content.title}
          problem={content.situations[0] ?? ""}
          result={content.outcomes[0] ?? ""}
          keywords={definition.keywords[lang]}
          image={definition.image}
          lang={lang}
        />
      ))}
    </div>

    {/* The systems people search for by name, one chip each, in the chips'
        own style — the way from "Webauftritt" to "my WooCommerce shop". */}
    <div class="mt-8 flex flex-wrap items-center justify-center md:justify-start gap-x-4 gap-y-3">
      <p class="text-sm font-medium text-[var(--color-muted)]">{systemsLabel}</p>
      <ul class="flex flex-wrap justify-center md:justify-start gap-2">
        {platformDefinitions.map((platform) => (
          <li>
            <a
              href={platformHref(platform, lang)}
              class="inline-flex items-center px-3 py-1 text-xs rounded-full bg-[color-mix(in_srgb,var(--color-accent)_10%,var(--lp-surface-card))] text-[var(--color-accent)] hover:bg-[color-mix(in_srgb,var(--color-accent)_18%,var(--lp-surface-card))] transition-colors [@media(pointer:coarse)]:min-h-11"
            >
              {platform.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
