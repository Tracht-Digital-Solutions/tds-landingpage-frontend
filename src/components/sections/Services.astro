---
import { resolveLang } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
import { getHomeContent } from "~/lib/homeContent";
import {
  resolveServiceContent,
  serviceDefinitions,
  serviceHref,
} from "~/lib/services";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import ServiceCard from "~/components/ui/ServiceCard.astro";
import Emphasis from "~/components/ui/Emphasis.astro";

const lang = resolveLang(Astro.currentLocale);

const servicesContent = await cmsFor(
  "services_overview",
  lang,
  getHomeContent(lang).servicesOverview,
);
const services = await Promise.all(
  serviceDefinitions.map(async (definition) => ({
    definition,
    content: await resolveServiceContent(definition, lang),
  })),
);
---

{/* Sand — the quiet alternate ground, with the single-field variant of
    the wash so two consecutive decorated sections do not read as the
    same picture twice. `.tds-tone-sand` replaces the hand-written
    `bg-[var(--color-soft)]`: the tone is a named decision now, not a
    utility each section re-guesses. */}
<section
  id="services"
  class="tds-wash tds-wash--calm section-spacing tds-tone-sand"
  aria-labelledby="services-heading"
>
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <SectionHeader
      headline={servicesContent.headline}
      headlineAccent={servicesContent.headlineAccent}
      id="services-heading"
      headingClass="mb-6"
      bar
    />
    <p class="max-w-2xl text-[var(--color-muted)] leading-relaxed mb-12">
      <Emphasis text={servicesContent.intro} />
    </p>

    {/* One surface divided into four, not four cards floating on sand.

        The separation is a 1px grid gap over a parent painted in
        `--color-line`: the tiles paint their own fill, the gap lets the
        parent show through, and what a visitor sees is a hairline seam. No
        border per tile, so no doubled lines where two tiles meet, and no
        gutter to make four services look like four unrelated offers.

        `data-reveal` sits on the mosaic rather than on each tile on purpose.
        Per-tile it would stagger — `reveal.ts` groups by parent, and these
        finally share one — but four tiles sliding up independently would open
        and close the seams while they travel. One picture, one entrance.

        Full-bleed below `md` with the idiom Consulting and PricingTeaser
        already use: the negative margin escapes the section's own gutter and
        the radius comes back once there is room for it. */}
    <div
      data-reveal
      class="-mx-6 md:mx-0 overflow-hidden rounded-none md:rounded-[6px] bg-[var(--color-line)] grid gap-px sm:grid-cols-2"
    >
      {services.map(({ definition, content }) => (
        <ServiceCard
          href={serviceHref(definition, lang)}
          title={content.title}
          description={content.summary}
          keywords={definition.keywords[lang]}
          image={definition.image}
        />
      ))}
    </div>
  </div>
</section>
