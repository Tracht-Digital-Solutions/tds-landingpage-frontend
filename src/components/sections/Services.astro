---
/**
 * Leistungen, as products. The most important ones stand here without a price;
 * the Shop carries all of them with their "ab" price. "Alle Leistungen"
 * leads to the catalogue filtered to our own services.
 */
import { resolveLang } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
import { getHomeContent } from "~/lib/homeContent";
import { imageHints } from "~/lib/imageCatalog";
import { getServiceProducts, shopServicesHref } from "~/lib/serviceProducts";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import AssistantCard from "~/components/ui/AssistantCard.astro";

const lang = resolveLang(Astro.currentLocale);

const servicesContent = await cmsFor(
  "services_overview",
  lang,
  getHomeContent(lang).servicesOverview,
);
const products = await getServiceProducts(lang);
const ui =
  lang === "de"
    ? { more: "Alle Leistungen im Shop" }
    : { more: "All services in the shop" };
---

{/* No ground of its own. The page has ONE ground now — `.page-ground` in
    `layouts/Layout.astro` — and a section that painted sand or its own wash
    fields would cut it in half at its own edge. */}
<section
  id="services"
  class="section-spacing"
  aria-labelledby="services-heading"
>
  <div class="lp-container">
    <SectionHeader
      headline={servicesContent.headline}
      headlineAccent={servicesContent.headlineAccent}
      id="services-heading"
      headingClass="mb-10"
      bar
    />
    <ul class="product-grid">
      {
        products.map((product) => (
          <li class="product-tile" data-reveal>
            <a class="product-tile__link" href={product.href} data-track="service-product">
              <img
                class="product-tile__img"
                src={product.image}
                srcset={imageHints(product.image, lang)?.srcSet}
                sizes="(min-width: 48rem) 20vw, 50vw"
                alt=""
                width="1536"
                height="960"
                loading="lazy"
                decoding="async"
              />
              <span class="product-tile__scrim" aria-hidden="true"></span>
              <span class="product-tile__kind">{product.kind[lang]}</span>
              <span class="product-tile__title">{product.title[lang]}</span>
              <span class="product-tile__go" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="product-more">
      <a class="product-more__link lp-ink" href={shopServicesHref(lang)} data-cta data-track="services-more">
        {ui.more}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    {/* For the visitor who reads the list and still cannot say which service
        is theirs — or what it costs: the assistant asks instead. Highlighted
        since 2026-09-22; it opens as a dialog (`components/ServiceAssistant.astro`),
        which also reveals the card once it can open anything. */}
    <div class="mt-10">
      <AssistantCard lang={lang} />
    </div>

  </div>
</section>

<style>
  /* Never a wrapped row: the five tiles scale with the page. A phone gets a
     composed layout, the lead tile across, the other four in pairs. */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .product-tile {
    container-type: inline-size;
    min-width: 0;
  }
  .product-tile:first-child {
    grid-column: 1 / -1;
  }
  @media (min-width: 48rem) {
    .product-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: clamp(0.5rem, 1.2vw, 1.25rem);
    }
    .product-tile:first-child {
      grid-column: auto;
    }
  }
  .product-tile__link {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.25rem;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    padding: clamp(0.75rem, 8cqi, 1.25rem);
    border-radius: 6px;
    background: var(--color-surface-navy);
    color: #fff;
    text-decoration: none;
    box-shadow: var(--tds-shadow-hard);
    transition: translate 160ms var(--tds-ease-out);
  }
  .product-tile:first-child .product-tile__link {
    aspect-ratio: 16 / 9;
  }
  @media (min-width: 48rem) {
    .product-tile__link,
    .product-tile:first-child .product-tile__link {
      aspect-ratio: 3 / 4;
    }
  }
  .product-tile__link:is(:hover, :focus-visible) {
    translate: -2px -2px;
    box-shadow: var(--tds-shadow-hard-hover);
  }
  .product-tile__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .product-tile__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--tds-ease-out);
  }
  .product-tile__link:is(:hover, :focus-visible) .product-tile__img {
    transform: scale(1.06);
  }
  /* Fixed navy, in both themes: it carries white type over any photo. */
  .product-tile__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(5 15 104 / 0.94) 12%, rgb(5 15 104 / 0.55) 48%, rgb(5 15 104 / 0.08) 78%);
  }
  .product-tile__kind,
  .product-tile__title,
  .product-tile__go {
    position: relative;
  }
  .product-tile__kind {
    font-family: var(--font-mono);
    font-size: clamp(0.625rem, 5.4cqi, 0.75rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.85);
  }
  .product-tile__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1rem, 10.5cqi, 1.625rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
    hyphens: auto;
  }
  .product-tile__go {
    position: absolute;
    top: clamp(0.625rem, 6cqi, 1rem);
    right: clamp(0.625rem, 6cqi, 1rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 100px;
    background: var(--color-accent-pink);
    color: #050f68;
    font-weight: 700;
    transition: translate 200ms var(--tds-ease-out);
  }
  .product-tile__link:is(:hover, :focus-visible) .product-tile__go {
    translate: 2px -2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .product-tile__link,
    .product-tile__img,
    .product-tile__go {
      transition: none;
    }
    .product-tile__link:is(:hover, :focus-visible) {
      translate: none;
    }
    .product-tile__link:is(:hover, :focus-visible) .product-tile__img {
      transform: none;
    }
  }

  .product-more {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }
  .product-more__link {
    --lp-fill: var(--color-accent);
    --lp-shade: initial;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.75rem 1.75rem;
    border-radius: 100px;
    background: var(--lp-fill);
    color: var(--color-paper);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 200ms var(--tds-ease-out);
  }
  .product-more__link:hover {
    --lp-fill: var(--color-surface-navy);
    --lp-shade: var(--color-accent-pink);
  }
  .product-more__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
