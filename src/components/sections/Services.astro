---
import { resolveLang } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
import { getHomeContent } from "~/lib/homeContent";
import {
  resolveServiceContent,
  serviceDefinitions,
  serviceHref,
} from "~/lib/services";
import SectionHeader from "~/components/ui/SectionHeader.astro";
import ServiceCard from "~/components/ui/ServiceCard.astro";

const lang = resolveLang(Astro.currentLocale);

const servicesContent = await cmsFor(
  "services_overview",
  lang,
  getHomeContent(lang).servicesOverview,
);
const services = await Promise.all(
  serviceDefinitions.map(async (definition) => ({
    definition,
    content: await resolveServiceContent(definition, lang),
  })),
);
---

{/* Sand — the quiet alternate ground, with the single-field variant of
    the wash so two consecutive decorated sections do not read as the
    same picture twice. `.tds-tone-sand` replaces the hand-written
    `bg-[var(--color-soft)]`: the tone is a named decision now, not a
    utility each section re-guesses. */}
<section
  id="services"
  class="tds-wash tds-wash--calm section-spacing tds-tone-sand"
  aria-labelledby="services-heading"
>
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <SectionHeader
      headline={servicesContent.headline}
      headlineAccent={servicesContent.headlineAccent}
      id="services-heading"
      headingClass="mb-6"
      bar
    />
    <p class="max-w-2xl text-[var(--color-muted)] leading-relaxed mb-12">
      {servicesContent.intro}
    </p>

    <div class="grid sm:grid-cols-2 gap-4 md:gap-6">
      {services.map(({ definition, content }) => (
          <div class="h-full">
            <ServiceCard
              href={serviceHref(definition, lang)}
              number={definition.number}
              title={content.title}
              description={content.summary}
              tags={content.responsibilities.slice(0, 3)}
            />
          </div>
      ))}
    </div>
  </div>
</section>
