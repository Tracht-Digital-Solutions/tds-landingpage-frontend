---
import { tFor, resolveLang } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
import SectionHeader from "~/components/ui/SectionHeader.astro";

const t = tFor(Astro.currentLocale);
const lang = resolveLang(Astro.currentLocale);
// Section header copy is editable; the marquee chips below stay hardcoded
// (brand/tool identity, not marketing copy).
const tech = await cmsFor("tech", lang, t.tech);

const techItems = [
  { label: "Node.js", italic: false },
  { label: "TypeScript", italic: true },
  { label: "Angular", italic: false },
  { label: "Vue", italic: false },
  { label: "C#", italic: true },
  { label: "Python", italic: false },
  { label: "Claude", italic: true },
  { label: "WordPress", italic: false },
  { label: "n8n", italic: true },
  { label: "KNIME", italic: false },
  { label: "SQL", italic: false },
];

const allItems = [...techItems, ...techItems];
---

<section id="tech" class="section-spacing tds-tone-navy overflow-hidden" aria-labelledby="tech-heading">
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12 mb-12">
    <SectionHeader
      headline={tech.headline}
      headlineAccent={tech.headlineAccent}
      id="tech-heading"
      dark
      headingClass="mb-6"
    />
    <p class="max-w-2xl text-white/70 leading-relaxed">
      {tech.body}
    </p>
  </div>

  <div
    class="relative"
    style={`mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);`}
    aria-label="Tech stack marquee"
  >
    <div class="flex marquee-track" aria-hidden="true">
      {allItems.map((item) => (
        <span
          class:list={[
            "whitespace-nowrap pr-12 text-3xl md:text-4xl font-[var(--font-display)] font-medium leading-none py-2",
            item.italic && "italic",
          ]}
          style={`color: ${item.italic ? "var(--color-accent-pink)" : "rgba(255,255,255,0.7)"}`}
        >
          {item.label}
        </span>
      ))}
    </div>
  </div>

  <ul class="sr-only">
    {techItems.map((item) => <li>{item.label}</li>)}
  </ul>
</section>
