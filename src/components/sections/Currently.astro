---
/**
 * "Currently" / "Aktuell" — transparency about what's actively in the
 * workshop and what shapes which projects come next. Lives in the
 * landingpage rather than tds-shared because the content changes more
 * often than the rest of the i18n bundle — promote individual fields
 * upstream if they stabilise.
 *
 * Sits between Process and PricingTeaser in the narrative arc:
 *   …how I work in general → what I'm working on right now → what it
 *   costs.
 */
import { resolveLang } from "~/lib/i18n";
import SectionHeader from "~/components/ui/SectionHeader.astro";

const lang = resolveLang(Astro.currentLocale);

const content =
  lang === "de"
    ? {
        label: "— Aktuell",
        headline: "Aktuelle",
        headlineAccent: "Themen.",
        projectsLabel: "Im Bau",
        projects: [
          {
            title: "TDS Customer Portal",
            description:
              "Self-Service-Zugang für Mittelstandskunden — Projekte, Rechnungen, Dokumente. In aktiver Entwicklung.",
            stack: "Astro · Slim · Stripe",
          },
          {
            title: "KI-Prozessanalyse",
            description:
              "Datenpipelines mit Claude und n8n für eine Manufaktur — von der Bestellannahme bis zur Auslieferung.",
            stack: "Python · Claude · n8n · KNIME",
          },
          {
            title: "Tracht Digital Journal",
            description:
              "Längere Texte zu Architektur, Mittelstand und KI im täglichen Einsatz.",
            stack: "Astro · Markdown · OG-Karten",
          },
        ],
        intentionsLabel: "Im Fokus",
        intentions: [
          "Lieber tief in zwei bis drei Projekte gleichzeitig — als oberflächlich in zehn.",
          "Eigene Werkzeuge dort, wo Standardlösungen versagen. Saubere Sägen, kein Schreinerei-Spielzeug.",
          "Wissen offen teilen — Journal als Werkbank, nicht Schaufenster.",
          "KI ernst nehmen, aber nicht andichten. Claude als Partner, kein Marketing-Trick.",
        ],
      }
    : {
        label: "— Currently",
        headline: "Current",
        headlineAccent: "topics.",
        projectsLabel: "In the workshop",
        projects: [
          {
            title: "TDS Customer Portal",
            description:
              "Self-service access for mid-market clients — projects, invoices, documents. In active development.",
            stack: "Astro · Slim · Stripe",
          },
          {
            title: "AI process analysis",
            description:
              "Data pipelines with Claude and n8n for a manufactory — from order intake to delivery.",
            stack: "Python · Claude · n8n · KNIME",
          },
          {
            title: "Tracht Digital Journal",
            description:
              "Longer-form writing on architecture, mid-market work, and AI in daily use.",
            stack: "Astro · Markdown · OG cards",
          },
        ],
        intentionsLabel: "Focused on",
        intentions: [
          "Going deep on two or three projects at a time — not shallow on ten.",
          "Custom tools where off-the-shelf stops working. Clean saws, not gimmicks.",
          "Sharing what I learn — Journal as workbench, not storefront.",
          "Taking AI seriously without overselling it. Claude as a partner, not a marketing trick.",
        ],
      };
---

<section
  id="currently"
  class="section-spacing"
  aria-labelledby="currently-heading"
>
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <SectionHeader
      label={content.label}
      headline={content.headline}
      headlineAccent={content.headlineAccent}
      id="currently-heading"
    />

    <div class="grid md:grid-cols-2 gap-12 lg:gap-20">
      {/* Active projects — what's actually in the workshop right now. */}
      <div>
        <div class="flex items-center gap-3 mb-8">
          <span
            aria-hidden="true"
            class="inline-block w-2.5 h-2.5 rounded-full bg-[var(--color-accent)] animate-pulse"
          ></span>
          <p class="eyebrow !mb-0">{content.projectsLabel}</p>
        </div>
        <ul class="space-y-6">
          {
            content.projects.map((p) => (
              <li class="pb-6 border-b border-[var(--color-line)] last:border-b-0 last:pb-0">
                <h3 class="font-[var(--font-display)] text-xl text-[var(--color-black)] mb-2 leading-tight">
                  {p.title}
                </h3>
                <p class="text-sm text-[var(--color-muted)] leading-relaxed mb-3">
                  {p.description}
                </p>
                <p class="text-xs font-mono text-[var(--color-accent)] tracking-wide">
                  {p.stack}
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Intentions — principles shaping which projects come next. */}
      <div class="md:sticky md:top-28 md:self-start">
        <div class="flex items-center gap-3 mb-8">
          <span
            aria-hidden="true"
            class="inline-flex items-center justify-center w-2.5 h-2.5 text-[var(--color-accent)]"
          >
            <svg
              viewBox="0 0 10 10"
              fill="currentColor"
              class="w-full h-full"
              aria-hidden="true"
            >
              <polygon points="5,0 6.5,3.5 10,5 6.5,6.5 5,10 3.5,6.5 0,5 3.5,3.5" />
            </svg>
          </span>
          <p class="eyebrow !mb-0">{content.intentionsLabel}</p>
        </div>
        <ul class="space-y-5">
          {
            content.intentions.map((i) => (
              <li class="relative pl-6 text-[var(--color-black)] leading-relaxed">
                <span
                  aria-hidden="true"
                  class="absolute left-0 top-0 text-[var(--color-accent)] font-[var(--font-display)] italic text-lg leading-tight"
                >
                  →
                </span>
                <span>{i}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
