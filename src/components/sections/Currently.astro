---
/**
 * "Currently" / "Aktuelle Themen" — left column lists the most
 * recent published posts from tds-content-api so the page always
 * surfaces the *actual* current themes, not a hand-curated list
 * that drifts. Right column is hand-curated intentions / principles
 * shaping which projects come next.
 *
 * Falls back to a hand-written project list when the content API
 * is unreachable so the section still renders meaningfully on
 * first-deploy or transient outage.
 *
 * Sits between Process and PricingTeaser in the narrative arc:
 *   …how I work in general → what topics are live right now → what
 *   it costs.
 */
import { resolveLang } from "~/lib/i18n";
import { fetchTopics, topicHref, topicFallback } from "~/lib/content";
import SectionHeader from "~/components/ui/SectionHeader.astro";

const lang = resolveLang(Astro.currentLocale);

const liveTopics = await fetchTopics(lang, 3);

const copy =
  lang === "de"
    ? {
        label: "— Aktuell",
        headline: "Aktuelle",
        headlineAccent: "Themen.",
        topicsLabel: "Aus dem Journal",
        readMore: "Weiterlesen",
        intentionsLabel: "Im Fokus",
        intentions: [
          "Lieber tief in zwei bis drei Projekte gleichzeitig — als oberflächlich in zehn.",
          "Eigene Werkzeuge dort, wo Standardlösungen versagen. Saubere Sägen, kein Schreinerei-Spielzeug.",
          "Wissen offen teilen — Journal als Werkbank, nicht Schaufenster.",
          "KI ernst nehmen, aber nicht andichten. Claude als Partner, kein Marketing-Trick.",
        ],
      }
    : {
        label: "— Currently",
        headline: "Current",
        headlineAccent: "topics.",
        topicsLabel: "From the journal",
        readMore: "Read more",
        intentionsLabel: "Focused on",
        intentions: [
          "Going deep on two or three projects at a time — not shallow on ten.",
          "Custom tools where off-the-shelf stops working. Clean saws, not gimmicks.",
          "Sharing what I learn — Journal as workbench, not storefront.",
          "Taking AI seriously without overselling it. Claude as a partner, not a marketing trick.",
        ],
      };

const topics = liveTopics.length > 0 ? liveTopics : topicFallback(lang);
const dateFormatter = new Intl.DateTimeFormat(
  lang === "de" ? "de-DE" : "en-IE",
  { year: "numeric", month: "long", day: "numeric" },
);
---

<section
  id="currently"
  class="section-spacing"
  aria-labelledby="currently-heading"
>
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
    <SectionHeader
      label={copy.label}
      headline={copy.headline}
      headlineAccent={copy.headlineAccent}
      id="currently-heading"
    />

    <div class="grid md:grid-cols-2 gap-12 lg:gap-20">
      {/* Live topics — recent posts pulled from tds-content-api. */}
      <div>
        <div class="flex items-center gap-3 mb-8">
          <span
            aria-hidden="true"
            class="inline-block w-2.5 h-2.5 rounded-full bg-[var(--color-accent)] animate-pulse"
          ></span>
          <p class="eyebrow !mb-0">{copy.topicsLabel}</p>
        </div>
        <ul class="space-y-6">
          {
            topics.map((p) => (
              <li class="pb-6 border-b border-[var(--color-line)] last:border-b-0 last:pb-0">
                <a
                  href={topicHref(p.slug)}
                  rel="noopener"
                  class="group block"
                >
                  <p class="text-xs font-medium tracking-widest text-[var(--color-accent)] uppercase mb-2">
                    {p.category}
                  </p>
                  <h3 class="font-[var(--font-display)] text-xl text-[var(--color-black)] mb-2 leading-tight group-hover:text-[var(--color-accent)] transition-colors">
                    {p.title}
                  </h3>
                  <p class="text-sm text-[var(--color-muted)] leading-relaxed mb-3 line-clamp-3">
                    {p.excerpt}
                  </p>
                  <div class="flex items-center justify-between text-xs text-[var(--color-muted)]">
                    <span>
                      {p.publishedAt
                        ? dateFormatter.format(new Date(p.publishedAt))
                        : ""}
                    </span>
                    <span class="font-medium group-hover:text-[var(--color-accent)] group-hover:gap-2 inline-flex items-center gap-1 transition-all">
                      {copy.readMore}
                      <span aria-hidden="true">↗</span>
                    </span>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Intentions — principles shaping which projects come next. */}
      <div class="md:sticky md:top-28 md:self-start">
        <div class="flex items-center gap-3 mb-8">
          <span
            aria-hidden="true"
            class="inline-flex items-center justify-center w-2.5 h-2.5 text-[var(--color-accent)]"
          >
            <svg
              viewBox="0 0 10 10"
              fill="currentColor"
              class="w-full h-full"
              aria-hidden="true"
            >
              <polygon points="5,0 6.5,3.5 10,5 6.5,6.5 5,10 3.5,6.5 0,5 3.5,3.5" />
            </svg>
          </span>
          <p class="eyebrow !mb-0">{copy.intentionsLabel}</p>
        </div>
        <ul class="space-y-5">
          {
            copy.intentions.map((i) => (
              <li class="relative pl-6 text-[var(--color-black)] leading-relaxed">
                <span
                  aria-hidden="true"
                  class="absolute left-0 top-0 text-[var(--color-accent)] font-[var(--font-display)] italic text-lg leading-tight"
                >
                  →
                </span>
                <span>{i}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
