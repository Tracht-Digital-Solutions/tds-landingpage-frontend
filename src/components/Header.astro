---
import LanguageToggle from "~/components/islands/LanguageToggle.tsx";
import { ThemeToggle } from "@tracht-digital-solutions/tds-shared/components";
import { tFor, resolveLang, localizePath } from "~/lib/i18n";
import { siteConfig } from "~/lib/seo";

const lang = resolveLang(Astro.currentLocale);
const t = tFor(Astro.currentLocale);

const items = [
  { id: "about", label: t.nav.about },
  { id: "services", label: t.nav.services },
  { id: "tech", label: t.nav.tech },
  // Portfolio temporarily hidden — see README § "Portfolio (temporarily hidden)".
  // { id: "portfolio", label: t.nav.portfolio },
  { id: "process", label: t.nav.process },
];

const homeHref = localizePath("/", lang);
const pricingHref = localizePath("/preise", lang);
const menuLabel = lang === "en" ? "Menu" : "Menü";

// Section links must resolve against the homepage — the sections only
// exist there, so a bare `#about` does nothing on subpages like /preise.
// Anchoring to homeHref (`/#about`, or `/en/#about`) scrolls on the home
// page and navigates home-then-scrolls from anywhere else.
const sectionHref = (id: string) => `${homeHref}#${id}`;
---

<header
  id="site-header"
  class="site-header fixed top-0 lg:top-4 left-3 right-3 lg:left-1/2 lg:right-auto lg:-translate-x-1/2 z-40 px-2.5 py-2 lg:px-3"
  data-scrolled="false"
>
  <nav class="flex items-center justify-between gap-2 text-sm lg:justify-start lg:gap-1">
    <a
      href={homeHref}
      class="flex items-center gap-2 px-2 lg:px-2.5 py-1 lg:py-1 text-[var(--color-primary)] hover:opacity-90 transition-opacity"
      aria-label="Tracht Digital Solutions"
    >
      <img
        src="/images/logo.webp"
        alt=""
        width="40"
        height="28"
        class="h-6 lg:h-7 w-auto"
      />
      <span class="font-[var(--font-display)] text-lg lg:text-base font-medium leading-none">
        TDS
      </span>
    </a>

    <div class="hidden md:flex items-center gap-1">
      {items.map((item) => (
        <a
          href={sectionHref(item.id)}
          class="px-3 py-1.5 text-[var(--color-muted)] hover:text-[var(--color-primary)] rounded-full transition-colors"
        >
          {item.label}
        </a>
      ))}
      <a
        href={pricingHref}
        class="px-3 py-1.5 text-[var(--color-muted)] hover:text-[var(--color-primary)] rounded-full transition-colors"
      >
        {t.nav.pricing}
      </a>
      <a
        href={siteConfig.blogUrl}
        rel="me noopener"
        class="inline-flex items-center gap-1 px-3 py-1.5 text-[var(--color-muted)] hover:text-[var(--color-primary)] rounded-full transition-colors"
      >
        {t.nav.blog}
        <span aria-hidden="true" class="text-[10px] leading-none">↗</span>
      </a>
      <a
        href={sectionHref("contact")}
        class="ml-2 px-4 py-1.5 text-white rounded-full bg-[var(--color-surface-navy)] hover:bg-[var(--color-surface-accent)] hover:-translate-y-0.5 transition-all duration-200"
      >
        {t.nav.cta}
      </a>
    </div>

    <div class="flex items-center gap-1.5 lg:gap-0">
      <ThemeToggle
        client:load
        labelToDark={lang === "en" ? "Switch to dark mode" : "Auf Dunkel umschalten"}
        labelToLight={lang === "en" ? "Switch to light mode" : "Auf Hell umschalten"}
      />
      <LanguageToggle client:load lang={lang} />

      <button
        id="menu-toggle"
        type="button"
        class="menu-toggle md:hidden relative inline-flex items-center justify-center w-11 h-11 rounded-full text-[var(--color-primary)] hover:bg-black/5 active:bg-black/10 transition-colors cursor-pointer"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={menuLabel}
      >
        <span class="menu-bar menu-bar-top" aria-hidden="true"></span>
        <span class="menu-bar menu-bar-mid" aria-hidden="true"></span>
        <span class="menu-bar menu-bar-bot" aria-hidden="true"></span>
      </button>
    </div>
  </nav>
</header>

<div
  id="mobile-menu"
  class="mobile-menu md:hidden fixed inset-x-3 top-16 z-30 origin-top rounded-2xl bg-[color-mix(in_srgb,var(--color-card)_95%,transparent)] backdrop-blur-md border border-[color-mix(in_srgb,var(--color-primary)_18%,var(--color-line))] shadow-[0_24px_60px_-20px_rgba(5,15,104,0.35)] p-3"
  aria-hidden="true"
>
  <ul class="space-y-0.5">
    {items.map((item) => (
      <li>
        <a
          href={sectionHref(item.id)}
          data-menu-link
          class="flex items-center min-h-12 px-4 text-lg font-[var(--font-display)] text-[var(--color-black)] rounded-xl hover:bg-black/5 active:bg-black/10 transition-colors"
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>

  <div class="my-2 mx-4 border-t border-[var(--color-line)]"></div>

  <ul class="space-y-0.5">
    <li>
      <a
        href={pricingHref}
        data-menu-link
        class="flex items-center min-h-12 px-4 text-lg font-[var(--font-display)] text-[var(--color-black)] rounded-xl hover:bg-black/5 active:bg-black/10 transition-colors"
      >
        {t.nav.pricing}
      </a>
    </li>
    <li>
      <a
        href={siteConfig.blogUrl}
        rel="me noopener"
        data-menu-link
        class="flex items-center justify-between min-h-12 px-4 text-lg font-[var(--font-display)] text-[var(--color-black)] rounded-xl hover:bg-black/5 active:bg-black/10 transition-colors"
      >
        <span>{t.nav.blog}</span>
        <span aria-hidden="true" class="text-sm text-[var(--color-muted)]">↗</span>
      </a>
    </li>
  </ul>

  <a
    href={sectionHref("contact")}
    data-menu-link
    class="mt-3 flex items-center justify-center min-h-12 px-4 rounded-full text-base font-medium bg-[var(--color-surface-navy)] text-white hover:bg-[var(--color-surface-accent)] active:bg-[var(--color-surface-accent)] transition-colors"
  >
    {t.nav.cta}
  </a>
</div>

<style>
  /* Mobile + tablet default — pill is docked flush against the top
     edge, top corners squared, glassmorphic. Heavier blur + slight
     saturation pulls the colour out of whatever's behind it (the
     hero blob aurora especially), and the inset top highlight reads
     like light catching the rim of a piece of glass. */
  .site-header {
    border-radius: 0 0 24px 24px;
    border-top-width: 0;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-style: solid;
    border-color: color-mix(
      in srgb,
      var(--color-primary) 14%,
      rgb(255 255 255 / 0.6)
    );
    background-color: color-mix(in srgb, var(--color-card) 60%, transparent);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.55),
      0 10px 30px -10px rgba(5, 15, 104, 0.22),
      0 2px 6px -2px rgba(5, 15, 104, 0.12);
    backdrop-filter: blur(40px) saturate(185%);
    -webkit-backdrop-filter: blur(40px) saturate(185%);
  }

  /* Desktop ( >=lg / 1024px ) — floating full pill. At the top of the
     page, where the pill integrates into the hero, the fill is fully
     transparent — no tint, no border, no shadow — but a very strong
     backdrop blur still frosts whatever sits behind it, so it reads as
     a clear sheet of heavily-blurred glass rather than a panel. Once
     scrolled past 8px a card-tinted fill, border and shadow fade in so
     the pill detaches cleanly from the content scrolling underneath.
     The blur stays very strong in both states. */
  @media (min-width: 1024px) {
    .site-header {
      border-radius: 9999px;
      border-top-width: 1px;
      border-color: transparent;
      background-color: transparent;
      box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.35);
      backdrop-filter: blur(64px) saturate(190%);
      -webkit-backdrop-filter: blur(64px) saturate(190%);
      transition:
        background-color 250ms ease,
        border-color 250ms ease,
        box-shadow 250ms ease;
    }

    .site-header[data-scrolled="true"] {
      border-color: color-mix(
        in srgb,
        var(--color-primary) 14%,
        rgb(255 255 255 / 0.6)
      );
      background-color: color-mix(in srgb, var(--color-card) 72%, transparent);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.55),
        0 10px 30px -10px rgba(5, 15, 104, 0.28);
    }
  }

  /* Animated hamburger ↔ × — three absolutely-positioned bars
     transform on aria-expanded. The top and bottom bars rotate
     into an × at the centre while the middle bar fades. */
  .menu-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 1.75px;
    background-color: currentColor;
    border-radius: 2px;
    transform-origin: center;
    transform: translate(-50%, -50%);
    transition:
      transform 220ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 180ms ease;
  }
  .menu-bar-top {
    transform: translate(-50%, calc(-50% - 6px));
  }
  .menu-bar-bot {
    transform: translate(-50%, calc(-50% + 6px));
  }

  .menu-toggle[aria-expanded="true"] .menu-bar-top {
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] .menu-bar-mid {
    opacity: 0;
    transform: translate(-50%, -50%) scaleX(0.6);
  }
  .menu-toggle[aria-expanded="true"] .menu-bar-bot {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* Mobile menu panel — closed: scaled, transparent, untouchable.
     Open: full-size, opaque, interactive. Pointer-events flip with
     visibility so closed panel doesn't intercept taps. */
  .mobile-menu {
    opacity: 0;
    transform: scale(0.96) translateY(-8px);
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      visibility 0s linear 200ms;
  }
  .mobile-menu[data-open="true"] {
    opacity: 1;
    transform: scale(1) translateY(0);
    pointer-events: auto;
    visibility: visible;
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      visibility 0s linear 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .mobile-menu {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  if (header) {
    const THRESHOLD = 8;
    const updateScroll = () => {
      header.dataset.scrolled =
        window.scrollY > THRESHOLD ? "true" : "false";
    };
    updateScroll();
    window.addEventListener("scroll", updateScroll, { passive: true });
  }

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      menu.dataset.open = open ? "true" : "false";
      menu.setAttribute("aria-hidden", open ? "false" : "true");
      document.body.style.overflow = open ? "hidden" : "";
    };

    toggle.addEventListener("click", () => {
      const next = toggle.getAttribute("aria-expanded") !== "true";
      setOpen(next);
    });

    menu.querySelectorAll<HTMLAnchorElement>("[data-menu-link]").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
      }
    });

    document.addEventListener("click", (e) => {
      if (toggle.getAttribute("aria-expanded") !== "true") return;
      const target = e.target as Node;
      if (menu.contains(target) || toggle.contains(target)) return;
      setOpen(false);
    });

    // Close the panel automatically when crossing the md breakpoint
    // (768px) so it never lingers after a viewport resize.
    const mq = window.matchMedia("(min-width: 768px)");
    mq.addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
