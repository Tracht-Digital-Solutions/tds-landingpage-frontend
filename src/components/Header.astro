---
import LanguageToggle from "~/components/islands/LanguageToggle.tsx";
import { ThemeToggle } from "@tracht-digital-solutions/tds-shared/components";
import { tFor, resolveLang, localizePath } from "~/lib/i18n";
import { siteConfig } from "~/lib/seo";

const lang = resolveLang(Astro.currentLocale);
const t = tFor(Astro.currentLocale);

const items = [
  { id: "about", label: t.nav.about },
  { id: "services", label: t.nav.services },
  { id: "tech", label: t.nav.tech },
  // Portfolio temporarily hidden — see README § "Portfolio (temporarily hidden)".
  // { id: "portfolio", label: t.nav.portfolio },
  { id: "process", label: t.nav.process },
];

const homeHref = localizePath("/", lang);
const pricingHref = localizePath("/preise", lang);
const menuLabel = lang === "en" ? "Menu" : "Menü";

// Section links must resolve against the homepage — the sections only
// exist there, so a bare `#about` does nothing on subpages like /preise.
// Anchoring to homeHref (`/#about`, or `/en/#about`) scrolls on the home
// page and navigates home-then-scrolls from anywhere else.
const sectionHref = (id: string) => `${homeHref}#${id}`;
---

<header
  id="site-header"
  class="site-header fixed top-3 left-3 right-3 z-40 px-3 py-2.5 lg:px-5"
  data-scrolled="false"
>
  <nav class="flex items-center justify-between gap-2 text-sm lg:justify-center lg:gap-5">
    <a
      id="logo-link"
      href={homeHref}
      class="flex items-center gap-2 px-2 lg:px-2.5 py-1 lg:py-1 text-[var(--color-primary)] hover:opacity-90 transition-opacity"
      aria-label="Tracht Digital Solutions"
    >
      <img
        src="/images/logo.webp"
        alt=""
        width="40"
        height="28"
        class="site-logo h-6 lg:h-7 w-auto"
      />
      <img
        src="/images/logo-letters.png"
        alt=""
        width="1289"
        height="639"
        class="site-logo h-6 lg:h-7 w-auto"
      />
    </a>

    {/* Links + controls live in one connected cluster so the nav reads
        as a single unit. A hairline divider sets the theme/language
        controls apart from the section links while keeping them
        integrated into the same row rather than floating off the edge. */}
    <div class="flex items-center gap-1">
      <div class="hidden lg:flex items-center gap-1">
        {items.map((item) => (
          <a
            href={sectionHref(item.id)}
            class="px-3 py-1.5 text-[var(--color-muted)] hover:text-[var(--color-primary)] focus-visible:text-[var(--color-primary)] rounded-full transition-colors"
          >
            {item.label}
          </a>
        ))}
        <a
          href={pricingHref}
          class="px-3 py-1.5 text-[var(--color-muted)] hover:text-[var(--color-primary)] focus-visible:text-[var(--color-primary)] rounded-full transition-colors"
        >
          {t.nav.pricing}
        </a>
        <a
          href={siteConfig.blogUrl}
          rel="me noopener"
          class="inline-flex items-center gap-1 px-3 py-1.5 text-[var(--color-muted)] hover:text-[var(--color-primary)] focus-visible:text-[var(--color-primary)] rounded-full transition-colors"
        >
          {t.nav.blog}
          <span aria-hidden="true" class="text-[10px] leading-none">↗</span>
        </a>
      </div>

      <span
        class="hidden lg:block h-5 w-px mx-1 bg-[var(--color-line)]"
        aria-hidden="true"
      ></span>

      <ThemeToggle
        client:load
        labelToDark={lang === "en" ? "Switch to dark mode" : "Auf Dunkel umschalten"}
        labelToLight={lang === "en" ? "Switch to light mode" : "Auf Hell umschalten"}
      />
      <LanguageToggle client:load lang={lang} />

      <button
        id="menu-toggle"
        type="button"
        class="menu-toggle lg:hidden relative inline-flex items-center justify-center w-11 h-11 rounded-full text-[var(--color-primary)] hover:bg-black/5 active:bg-black/10 transition-colors cursor-pointer"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={menuLabel}
      >
        <span class="menu-bar menu-bar-top" aria-hidden="true"></span>
        <span class="menu-bar menu-bar-mid" aria-hidden="true"></span>
        <span class="menu-bar menu-bar-bot" aria-hidden="true"></span>
      </button>
    </div>
  </nav>
</header>

<div
  id="mobile-menu"
  class="mobile-menu lg:hidden fixed inset-x-3 top-[5.25rem] z-30 origin-top rounded-2xl bg-[color-mix(in_srgb,var(--color-card)_95%,transparent)] backdrop-blur-md border border-[color-mix(in_srgb,var(--color-primary)_18%,var(--color-line))] shadow-[0_24px_60px_-20px_rgba(5,15,104,0.35)] p-3"
  aria-hidden="true"
>
  <ul class="space-y-0.5">
    {items.map((item) => (
      <li>
        <a
          href={sectionHref(item.id)}
          data-menu-link
          class="flex items-center min-h-12 px-4 text-lg font-[var(--font-display)] text-[var(--color-black)] rounded-xl hover:bg-black/5 active:bg-black/10 transition-colors"
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>

  <div class="my-2 mx-4 border-t border-[var(--color-line)]"></div>

  <ul class="space-y-0.5">
    <li>
      <a
        href={pricingHref}
        data-menu-link
        class="flex items-center min-h-12 px-4 text-lg font-[var(--font-display)] text-[var(--color-black)] rounded-xl hover:bg-black/5 active:bg-black/10 transition-colors"
      >
        {t.nav.pricing}
      </a>
    </li>
    <li>
      <a
        href={siteConfig.blogUrl}
        rel="me noopener"
        data-menu-link
        class="flex items-center justify-between min-h-12 px-4 text-lg font-[var(--font-display)] text-[var(--color-black)] rounded-xl hover:bg-black/5 active:bg-black/10 transition-colors"
      >
        <span>{t.nav.blog}</span>
        <span aria-hidden="true" class="text-sm text-[var(--color-muted)]">↗</span>
      </a>
    </li>
  </ul>
</div>

<style>
  /* The brand mark ships in its dark navy colour; in dark mode flip it
     to solid white so it stays legible against the dark surface. */
  :global(:root[data-theme="dark"]) .site-logo {
    filter: brightness(0) invert(1);
  }

  /* Logo grows while the visitor is at the very top of the page (the
     header is docked + full-bleed there) and shrinks back to its
     compact size once they scroll and the bar morphs into the pill.
     Tweens alongside the 320ms header morph. */
  .site-logo {
    transition: height 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .site-header[data-scrolled="false"] .site-logo {
    height: 2rem;
  }
  @media (min-width: 1024px) {
    .site-header[data-scrolled="false"] .site-logo {
      height: 3rem;
    }
    /* At the top, push the enlarged logo hard-left and keep the
       controls on the right; the centred pill returns on scroll. */
    .site-header[data-scrolled="false"] nav {
      justify-content: space-between;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-logo {
      transition-duration: 0.01ms;
    }
  }

  /* Mobile + tablet default — a glassmorphic bar floating a little
     below the top edge with a matching margin on every side, fully
     rounded. A moderate frosted blur + slight saturation pulls the
     colour out of whatever's behind it; the inset top highlight reads
     like light catching the rim of a piece of glass. */
  .site-header {
    border-radius: 24px;
    border: 1px solid transparent;
    background-color: color-mix(in srgb, var(--color-card) 60%, transparent);
    /* Only a faint glass rim highlight — no drop shadow. */
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.5);
    /* Only the unprefixed property is authored — lightningcss adds the
       `-webkit-` prefix at build time per the configured cssTarget.
       Hand-writing both makes lightningcss collapse them to `-webkit-`
       only, which drops the blur in Firefox. See astro.config.mjs. */
    backdrop-filter: blur(28px) saturate(180%);
  }

  /* Dark mode — give the bar a faint tinted fill + hairline border so the
     nav stays legible against the dark hero instead of dissolving into it.
     (Previously every shadow/rim was dropped and the bar could vanish.) */
  :global(:root[data-theme="dark"]) .site-header {
    background-color: color-mix(in srgb, var(--color-card) 55%, transparent);
    border-color: color-mix(in srgb, var(--color-line) 60%, transparent);
    box-shadow: none;
  }
  :global(:root[data-theme="dark"]) .site-header[data-scrolled="true"] {
    background-color: color-mix(in srgb, var(--color-card) 82%, transparent);
    box-shadow: 0 18px 50px -24px rgba(0, 0, 0, 0.6);
  }
  @media (min-width: 1024px) {
    :global(:root[data-theme="dark"]) .site-header {
      background-color: color-mix(in srgb, var(--color-card) 45%, transparent);
    }
    :global(:root[data-theme="dark"]) .site-header[data-scrolled="true"] {
      background-color: color-mix(in srgb, var(--color-card) 82%, transparent);
    }
  }

  /* Desktop ( >=lg / 1024px ) — the bar morphs between two states as
     the user scrolls. The header spans the full viewport (left/right 0)
     and `margin-inline: auto` keeps it centred once it is constrained by
     max-width, so the same element can animate from an edge-to-edge dock
     to a compact centred pill purely by tweening max-width + top +
     border-radius.

     At the top of the page (data-scrolled="false") it is DOCKED: flush
     against the top edge, full-bleed, top corners squared, integrated
     into the hero with a fully transparent fill — only the heavy frosted
     blur and the glass-rim highlight read. The blur stays very strong in
     both states. */
  @media (min-width: 1024px) {
    .site-header {
      left: 0;
      right: 0;
      transform: none;
      margin-inline: auto;

      top: 0.75rem;
      max-width: 100%;
      border-radius: 22px;
      background-color: transparent;
      box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.35);
      backdrop-filter: blur(40px) saturate(185%);
      transition:
        max-width 320ms cubic-bezier(0.4, 0, 0.2, 1),
        top 320ms cubic-bezier(0.4, 0, 0.2, 1),
        border-radius 320ms cubic-bezier(0.4, 0, 0.2, 1),
        background-color 250ms ease,
        box-shadow 250ms ease;
    }

    /* Scrolled away from the top — the bar lifts off the edge and morphs
       into a compact, fully-rounded floating pill, card-tinted with a
       soft drop shadow that sells the "lifted" feel. */
    .site-header[data-scrolled="true"] {
      top: 1rem;
      max-width: 56rem;
      border-radius: 9999px;
      border-top-width: 1px;
      background-color: color-mix(in srgb, var(--color-card) 72%, transparent);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.5),
        0 18px 50px -24px rgba(5, 15, 104, 0.45);
    }
  }

  /* Animated hamburger ↔ × — three absolutely-positioned bars
     transform on aria-expanded. The top and bottom bars rotate
     into an × at the centre while the middle bar fades. */
  .menu-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 1.75px;
    background-color: currentColor;
    border-radius: 2px;
    transform-origin: center;
    transform: translate(-50%, -50%);
    transition:
      transform 220ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 180ms ease;
  }
  .menu-bar-top {
    transform: translate(-50%, calc(-50% - 6px));
  }
  .menu-bar-bot {
    transform: translate(-50%, calc(-50% + 6px));
  }

  .menu-toggle[aria-expanded="true"] .menu-bar-top {
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] .menu-bar-mid {
    opacity: 0;
    transform: translate(-50%, -50%) scaleX(0.6);
  }
  .menu-toggle[aria-expanded="true"] .menu-bar-bot {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* Mobile menu panel — closed: scaled, transparent, untouchable.
     Open: full-size, opaque, interactive. Pointer-events flip with
     visibility so closed panel doesn't intercept taps. */
  .mobile-menu {
    opacity: 0;
    transform: scale(0.96) translateY(-8px);
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      visibility 0s linear 200ms;
  }
  .mobile-menu[data-open="true"] {
    opacity: 1;
    transform: scale(1) translateY(0);
    pointer-events: auto;
    visibility: visible;
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      visibility 0s linear 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .mobile-menu {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  if (header) {
    const THRESHOLD = 8;
    let scrolled: boolean | null = null;
    const updateScroll = () => {
      const next = window.scrollY > THRESHOLD;
      if (next === scrolled) return;
      scrolled = next;
      header.dataset.scrolled = next ? "true" : "false";
    };
    updateScroll();
    window.addEventListener("scroll", updateScroll, { passive: true });
  }

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      menu.dataset.open = open ? "true" : "false";
      menu.setAttribute("aria-hidden", open ? "false" : "true");
      document.body.style.overflow = open ? "hidden" : "";
    };

    toggle.addEventListener("click", () => {
      const next = toggle.getAttribute("aria-expanded") !== "true";
      setOpen(next);
    });

    menu.querySelectorAll<HTMLAnchorElement>("[data-menu-link]").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
      }
    });

    document.addEventListener("click", (e) => {
      if (toggle.getAttribute("aria-expanded") !== "true") return;
      const target = e.target as Node;
      if (menu.contains(target) || toggle.contains(target)) return;
      setOpen(false);
    });

    // Close the panel automatically when crossing into the desktop
    // (lg / 1024px) nav so it never lingers after a viewport resize.
    const mq = window.matchMedia("(min-width: 1024px)");
    mq.addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // Logo: when we're already on the page it links to (the homepage in
  // either locale), don't reload — just smooth-scroll back up to the
  // hero. On any other page it stays a normal link home. Compares the
  // link's own pathname to the current one (trailing slash normalised)
  // so it works for both `/` and `/en/`.
  const logo = document.getElementById("logo-link") as HTMLAnchorElement | null;
  if (logo) {
    const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
    logo.addEventListener("click", (event) => {
      if (normalize(new URL(logo.href).pathname) !== normalize(location.pathname)) {
        return;
      }
      event.preventDefault();
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const lenis = (window as unknown as {
        lenis?: { scrollTo: (target: number, options?: { immediate?: boolean }) => void };
      }).lenis;
      if (lenis) {
        lenis.scrollTo(0, { immediate: reduce });
      } else {
        window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      }
    });
  }
</script>
