---
import { translations } from "@tracht-digital-solutions/tds-shared/i18n";
import LanguageToggle from "~/components/islands/LanguageToggle.tsx";

const t = translations.de;

const items = [
  { id: "about", label: t.nav.about },
  { id: "services", label: t.nav.services },
  { id: "tech", label: t.nav.tech },
  { id: "portfolio", label: t.nav.portfolio },
  { id: "process", label: t.nav.process },
  { id: "blog", label: t.nav.blog },
];
---

<header
  id="site-header"
  class="site-header fixed top-0 left-1/2 -translate-x-1/2 z-40 px-3 py-2"
  data-scrolled="false"
>
  <nav class="flex items-center gap-1 text-sm">
    <a
      href="/"
      class="px-3 py-1.5 font-[var(--font-display)] font-medium text-[var(--color-primary)]"
    >
      TDS
    </a>
    {items.map((item) => (
      <a
        href={`#${item.id}`}
        class="hidden md:inline-block px-3 py-1.5 text-[var(--color-muted)] hover:text-[var(--color-primary)] rounded-full transition-colors"
      >
        {item.label}
      </a>
    ))}
    <a
      href="/preise"
      class="hidden md:inline-block px-3 py-1.5 text-[var(--color-muted)] hover:text-[var(--color-primary)] rounded-full transition-colors"
    >
      {t.nav.pricing}
    </a>
    <a
      href="#contact"
      class="ml-2 px-4 py-1.5 text-white rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-accent)] hover:-translate-y-0.5 transition-all duration-200"
    >
      {t.nav.cta}
    </a>
    <LanguageToggle client:load />
  </nav>
</header>

<style>
  /* Default — sitting at the top of the page, no chrome: nav appears
     to belong to the page header itself. The pill materialises once
     the user starts scrolling. */
  .site-header {
    border-radius: 0 0 9999px 9999px;
    border: 1px solid transparent;
    border-top: 0;
    background-color: transparent;
    box-shadow: none;
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    transition:
      background-color 250ms ease,
      border-color 250ms ease,
      box-shadow 250ms ease,
      backdrop-filter 250ms ease,
      -webkit-backdrop-filter 250ms ease;
  }

  .site-header[data-scrolled="true"] {
    background-color: rgb(255 255 255 / 0.85);
    border-color: color-mix(
      in srgb,
      var(--color-primary) 18%,
      var(--color-line)
    );
    box-shadow: 0 10px 30px -10px rgba(5, 15, 104, 0.28);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
</style>

<script>
  const header = document.getElementById("site-header");
  if (header) {
    const THRESHOLD = 8;
    const update = () => {
      header.dataset.scrolled =
        window.scrollY > THRESHOLD ? "true" : "false";
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
