---
import LanguageToggle from "~/components/islands/LanguageToggle.tsx";
import { tFor, resolveLang, localizePath } from "~/lib/i18n";
import { siteConfig } from "~/lib/seo";

const lang = resolveLang(Astro.currentLocale);
const t = tFor(Astro.currentLocale);

const items = [
  { id: "about", label: t.nav.about },
  { id: "services", label: t.nav.services },
  { id: "tech", label: t.nav.tech },
  { id: "portfolio", label: t.nav.portfolio },
  { id: "process", label: t.nav.process },
];

const homeHref = localizePath("/", lang);
const pricingHref = localizePath("/preise", lang);
const menuLabel = lang === "en" ? "Menu" : "Menü";
---

<header
  id="site-header"
  class="site-header fixed top-0 lg:top-4 left-3 right-3 lg:left-1/2 lg:right-auto lg:-translate-x-1/2 z-40 px-2.5 py-2 lg:px-3"
  data-scrolled="false"
>
  <nav class="flex items-center justify-between gap-2 text-sm lg:justify-start lg:gap-1">
    <a
      href={homeHref}
      class="px-3 py-2 lg:py-1.5 font-[var(--font-display)] text-lg lg:text-base font-medium text-[var(--color-primary)] leading-none"
    >
      TDS
    </a>

    <div class="hidden md:flex items-center gap-1">
      {items.map((item) => (
        <a
          href={`#${item.id}`}
          class="px-3 py-1.5 text-[var(--color-muted)] hover:text-[var(--color-primary)] rounded-full transition-colors"
        >
          {item.label}
        </a>
      ))}
      <a
        href={pricingHref}
        class="px-3 py-1.5 text-[var(--color-muted)] hover:text-[var(--color-primary)] rounded-full transition-colors"
      >
        {t.nav.pricing}
      </a>
      <a
        href={siteConfig.blogUrl}
        rel="me noopener"
        class="inline-flex items-center gap-1 px-3 py-1.5 text-[var(--color-muted)] hover:text-[var(--color-primary)] rounded-full transition-colors"
      >
        {t.nav.blog}
        <span aria-hidden="true" class="text-[10px] leading-none">↗</span>
      </a>
      <a
        href="#contact"
        class="ml-2 px-4 py-1.5 text-white rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-accent)] hover:-translate-y-0.5 transition-all duration-200"
      >
        {t.nav.cta}
      </a>
    </div>

    <div class="flex items-center gap-1.5 lg:gap-0">
      <LanguageToggle client:load lang={lang} />

      <button
        id="menu-toggle"
        type="button"
        class="md:hidden inline-flex items-center justify-center w-11 h-11 rounded-full text-[var(--color-primary)] hover:bg-black/5 active:bg-black/10 transition-colors cursor-pointer"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={menuLabel}
      >
        <svg class="menu-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
        <svg class="menu-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<div
  id="mobile-menu"
  class="mobile-menu md:hidden fixed inset-x-3 top-16 z-30 origin-top rounded-2xl bg-white/95 backdrop-blur-md border border-[color-mix(in_srgb,var(--color-primary)_18%,var(--color-line))] shadow-[0_24px_60px_-20px_rgba(5,15,104,0.35)] p-3"
  aria-hidden="true"
>
  <ul class="space-y-0.5">
    {items.map((item) => (
      <li>
        <a
          href={`#${item.id}`}
          data-menu-link
          class="flex items-center min-h-12 px-4 text-lg font-[var(--font-display)] text-[var(--color-black)] rounded-xl hover:bg-black/5 active:bg-black/10 transition-colors"
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>

  <div class="my-2 mx-4 border-t border-[var(--color-line)]"></div>

  <ul class="space-y-0.5">
    <li>
      <a
        href={pricingHref}
        data-menu-link
        class="flex items-center min-h-12 px-4 text-lg font-[var(--font-display)] text-[var(--color-black)] rounded-xl hover:bg-black/5 active:bg-black/10 transition-colors"
      >
        {t.nav.pricing}
      </a>
    </li>
    <li>
      <a
        href={siteConfig.blogUrl}
        rel="me noopener"
        data-menu-link
        class="flex items-center justify-between min-h-12 px-4 text-lg font-[var(--font-display)] text-[var(--color-black)] rounded-xl hover:bg-black/5 active:bg-black/10 transition-colors"
      >
        <span>{t.nav.blog}</span>
        <span aria-hidden="true" class="text-sm text-[var(--color-muted)]">↗</span>
      </a>
    </li>
  </ul>

  <a
    href="#contact"
    data-menu-link
    class="mt-3 flex items-center justify-center min-h-12 px-4 rounded-full text-base font-medium bg-[var(--color-primary)] text-white hover:bg-[var(--color-accent)] active:bg-[var(--color-accent)] transition-colors"
  >
    {t.nav.cta}
  </a>
</div>

<style>
  /* Mobile + tablet default — pill is docked flush against the top
     edge (top: 0 in Tailwind) and the top corners are squared so
     the chrome looks like it grew out of the viewport edge rather
     than floating in front of it. Always rendered filled — the
     scroll-morph only makes sense when there's air around the pill. */
  .site-header {
    border-radius: 0 0 9999px 9999px;
    border-top-width: 0;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-style: solid;
    border-color: color-mix(
      in srgb,
      var(--color-primary) 18%,
      var(--color-line)
    );
    background-color: rgb(255 255 255 / 0.9);
    box-shadow: 0 8px 24px -12px rgba(5, 15, 104, 0.22);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  /* Desktop ( >=lg / 1024px ) — back to the floating full pill with
     the scroll-morph behaviour. At rest the pill is transparent so
     the nav reads as part of the hero; once the page scrolls past
     8px the data-scrolled attribute switches the chrome on. */
  @media (min-width: 1024px) {
    .site-header {
      border-radius: 9999px;
      border-top-width: 1px;
      border-color: transparent;
      background-color: transparent;
      box-shadow: none;
      backdrop-filter: blur(0);
      -webkit-backdrop-filter: blur(0);
      transition:
        background-color 250ms ease,
        border-color 250ms ease,
        box-shadow 250ms ease,
        backdrop-filter 250ms ease,
        -webkit-backdrop-filter 250ms ease;
    }

    .site-header[data-scrolled="true"] {
      background-color: rgb(255 255 255 / 0.85);
      border-color: color-mix(
        in srgb,
        var(--color-primary) 18%,
        var(--color-line)
      );
      box-shadow: 0 10px 30px -10px rgba(5, 15, 104, 0.28);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
  }

  /* Menu pill always shows the open icon by default; the close icon
     swaps in when the toggle has aria-expanded="true". */
  .menu-icon-close {
    display: none;
  }
  #menu-toggle[aria-expanded="true"] .menu-icon-open {
    display: none;
  }
  #menu-toggle[aria-expanded="true"] .menu-icon-close {
    display: block;
  }

  /* Mobile menu panel — closed: scaled, transparent, untouchable.
     Open: full-size, opaque, interactive. Pointer-events flip with
     visibility so closed panel doesn't intercept taps. */
  .mobile-menu {
    opacity: 0;
    transform: scale(0.96) translateY(-8px);
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      visibility 0s linear 200ms;
  }
  .mobile-menu[data-open="true"] {
    opacity: 1;
    transform: scale(1) translateY(0);
    pointer-events: auto;
    visibility: visible;
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      visibility 0s linear 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .mobile-menu {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  if (header) {
    const THRESHOLD = 8;
    const updateScroll = () => {
      header.dataset.scrolled =
        window.scrollY > THRESHOLD ? "true" : "false";
    };
    updateScroll();
    window.addEventListener("scroll", updateScroll, { passive: true });
  }

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      menu.dataset.open = open ? "true" : "false";
      menu.setAttribute("aria-hidden", open ? "false" : "true");
      document.body.style.overflow = open ? "hidden" : "";
    };

    toggle.addEventListener("click", () => {
      const next = toggle.getAttribute("aria-expanded") !== "true";
      setOpen(next);
    });

    menu.querySelectorAll<HTMLAnchorElement>("[data-menu-link]").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
      }
    });

    document.addEventListener("click", (e) => {
      if (toggle.getAttribute("aria-expanded") !== "true") return;
      const target = e.target as Node;
      if (menu.contains(target) || toggle.contains(target)) return;
      setOpen(false);
    });

    // Close the panel automatically when crossing the md breakpoint
    // (768px) so it never lingers after a viewport resize.
    const mq = window.matchMedia("(min-width: 768px)");
    mq.addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
