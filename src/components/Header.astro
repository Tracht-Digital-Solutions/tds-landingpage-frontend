---
import LanguageSwitch from "~/components/LanguageSwitch.astro";
import { ThemeToggle } from "@tracht-digital-solutions/tds-shared/components";
import { resolveLang, localizePath } from "~/lib/i18n";
import { propertyLinks, sectionLinks } from "~/lib/navigation";
import { LOGO, logoSrc, logoSrcset } from "~/lib/imageVariants";
import ScrollProgress from "~/components/islands/ScrollProgress.tsx";

const lang = resolveLang(Astro.currentLocale);

// One list for the desktop bar, the mobile menu and the footer — see
// `lib/navigation.ts` for why there is no second copy of it here any more.
const items = sectionLinks(lang);
const properties = propertyLinks(lang);

const homeHref = localizePath("/", lang);
const menuLabel = lang === "en" ? "Menu" : "Menü";
const navLabel = lang === "en" ? "Main navigation" : "Hauptnavigation";
const homeLabel =
  lang === "en" ? "Tracht Digital Solutions – home" : "Tracht Digital Solutions – Startseite";

// Section links must resolve against the homepage — the sections only
// exist there, so a bare `#services` does nothing on a service page.
// Anchoring to homeHref (`/#services`, or `/en/#services`) scrolls on the
// home page and navigates home-then-scrolls from anywhere else.
const sectionHref = (id: string) => `${homeHref}#${id}`;
---

<header
  id="site-header"
  class="site-header fixed top-3 left-3 right-3 z-40 px-3 py-2.5 lg:px-5"
  data-scrolled="false"
>
  <nav aria-label={navLabel} class="flex items-center justify-between gap-2 text-sm lg:gap-5">
    <a
      id="logo-link"
      href={homeHref}
      class="flex items-center gap-2 px-2 lg:px-2.5 py-1 lg:py-1 text-[var(--color-primary)] hover:opacity-90 transition-opacity rounded-full [@media(pointer:coarse)]:min-h-11"
      aria-label={homeLabel}
    >
      {/* Pre-sized lossless WebP copies (`LOGO` in lib/imageVariants.ts). The
          wordmark used to be the 1289 px PNG: 35 KB for an image at most 97 px
          wide, fetched before the headline on every phone. */}
      <img
        src={logoSrc("mark", LOGO.mark.widths[1])}
        srcset={logoSrcset("mark")}
        sizes="(min-width: 1024px) 72px, 48px"
        alt=""
        width={LOGO.mark.width}
        height={LOGO.mark.height}
        class="site-logo h-6 lg:h-7 w-auto"
      />
      <img
        src={logoSrc("letters", LOGO.letters.widths[1])}
        srcset={logoSrcset("letters")}
        sizes="(min-width: 1024px) 100px, 66px"
        alt=""
        width={LOGO.letters.width}
        height={LOGO.letters.height}
        class="site-logo h-6 lg:h-7 w-auto"
      />
    </a>

    {/* Links + controls live in one connected cluster so the nav reads
        as a single unit. The theme/language controls used to be set apart
        by a hairline divider; with the borderless pass that separation is
        carried by the wider gap alone. */}
    <div class="flex items-center gap-1 lg:gap-3">
      {/* `data-nav-links` + the pill: Motion glides the pill behind the
          link of the section on screen and marks it `aria-current`
          (lib/motion/ux.ts). Home page only — elsewhere no section matches
          and the pill stays invisible. */}
      {/* The chrome's ink is `--lp-nav-ink`, and it changes with the bar's
          state — see the derivation at the CSS declaration below. Everything on
          this bar reads it (links, language switch, theme toggle) so the bar is
          one weight rather than three. */}
      <div class="hidden lg:flex items-center gap-1 relative" data-nav-links>
        <span class="nav-pill" data-nav-pill aria-hidden="true"></span>
        {items.map((item) => (
          <a
            href={sectionHref(item.id)}
            data-section={item.id}
            class="relative inline-flex items-center px-3 py-1.5 text-[var(--lp-nav-ink)] hover:text-[var(--color-primary)] focus-visible:text-[var(--color-primary)] rounded-full transition-colors [@media(pointer:coarse)]:min-h-11"
          >
            {item.label}
          </a>
        ))}
        {/* No "Journal" here since 2026-09-22: the journal is one of the
            bookmarks on the left edge (`PropertyTabs.astro`) on a desktop,
            and in the mobile menu's second block on a phone. */}
      </div>

      {/* `client:idle`, not `client:load`: this one button was what loaded the
          React runtime among the requests a phone waits on before the
          headline. Until it hydrates it carries its server-rendered label. */}
      <ThemeToggle
        client:idle
        labelToDark={lang === "en" ? "Switch to dark mode" : "Auf Dunkel umschalten"}
        labelToLight={lang === "en" ? "Switch to light mode" : "Auf Hell umschalten"}
      />
      {/* Renders nothing on a page without a twin in the other language. */}
      <LanguageSwitch />

      {/* Geometry, colour and the 44px target come from the shared classes;
          the breakpoint comes from `.tds-menu-toggle` itself, NOT from an
          `lg:hidden` here — a utility loses to unlayered `.btn { display }`
          and the button would stay visible on desktop with nothing to say so. */}
      <button
        id="menu-toggle"
        type="button"
        class="btn btn-ghost tds-menu-toggle"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={menuLabel}
      >
        <span class="tds-menu-bar tds-menu-bar-top" aria-hidden="true"></span>
        <span class="tds-menu-bar tds-menu-bar-mid" aria-hidden="true"></span>
        <span class="tds-menu-bar tds-menu-bar-bot" aria-hidden="true"></span>
      </button>
    </div>
  </nav>

  {/* The reading progress, on the bar's lower edge (2026-09-29).

      It used to be `fixed top-0 left-0 right-0` — a separate 2px line pinned to
      the window, a few pixels above a bar that floats with its own margin, so
      the two never related to each other. Inside the header it inherits the
      docking morph for free: it narrows with the bar from full-bleed to 56rem
      and lifts off the edge with it, which is what makes the progress and the
      "click in" one movement rather than two things happening at once.

      Inset from the ends rather than run edge to edge: the bar is a full pill,
      so a straight line across its whole width would leave the shape at the
      curves. */}
  <ScrollProgress client:idle />
</header>

{/* Sheet, motion, scroll behaviour and the breakpoint are `.tds-mobile-menu`
    (tds-shared). Only the docking offset stays here, because each header
    floats differently — and it is published as `--tds-mobile-menu-inset` so
    the panel's max-height leaves the viewport instead of running past it. */}
<div
  id="mobile-menu"
  class="tds-mobile-menu inset-x-3 top-[5.25rem]"
  style="--tds-mobile-menu-inset: 5.25rem"
  aria-hidden="true"
>
  <nav aria-label={navLabel}>
    <ul class="space-y-0.5">
      {items.map((item) => (
        <li>
          <a
            href={sectionHref(item.id)}
            data-menu-link
            class="tds-mobile-menu__link"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="h-4" aria-hidden="true"></div>

    {/* The sister properties — on a desktop they are the bookmarks on the
        left edge (`PropertyTabs.astro`), which open on hover and so have no
        phone form. Same list, same order. */}
    <ul class="space-y-0.5">
      {properties.map((property) => (
        <li>
          <a
            href={property.href}
            rel={property.id === "journal" ? "me noopener" : "noopener"}
            data-menu-link
            class="tds-mobile-menu__link justify-between"
          >
            <span>{property.label}</span>
            <span aria-hidden="true" class="text-sm text-[var(--color-muted)]">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  /* The brand mark ships in its dark navy colour; in dark mode flip it
     to solid white so it stays legible against the dark surface. */
  :global(:root[data-theme="dark"]) .site-logo {
    filter: brightness(0) invert(1);
  }

  /* Logo grows while the visitor is at the very top of the page (the
     header is docked + full-bleed there) and shrinks back to its
     compact size once they scroll and the bar morphs into the pill.
     Tweens alongside the 320ms header morph. */
  .site-logo {
    transition: height 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .site-header[data-scrolled="false"] .site-logo {
    height: 2rem;
  }
  @media (min-width: 1024px) {
    .site-header[data-scrolled="false"] .site-logo {
      height: 3rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-logo {
      transition-duration: 0.01ms;
    }
  }

  /* Mobile + tablet default — a light capsule floating a little below
     the top edge with a matching margin on every side, fully rounded.

     TRANSLUCENT, not the near-opaque sheet this used to be. The bar has
     three states and only the middle one changed: docked at the top it is
     fully transparent (below), and once the visitor scrolls away from the
     dock it becomes FROSTED GLASS — a light tint plus a heavy blur, so the
     page keeps moving visibly underneath instead of disappearing behind a
     solid strip.

     `--tds-header-tint` is the single knob for that. It exists because the
     value is set in four places (light/dark × docked/scrolled) and they
     drifted apart the last two times they were tuned by hand. Anything
     below roughly 45% stops carrying dark body text over a light photo;
     anything above ~75% is not glass any more. Judge it in a browser
     against the hero, not in the diff — the whole effect is the
     background showing through, which no test can see. */
  .site-header {
    /* 90%. It was 62%, then 78%, and this is the third pass at the same
       complaint: the navigation reads too dark in light mode.

       ### Why opacity is the only lever

       The fill is used only where the bar is filled at all — the docked bar is
       `transparent` below — and there the glass samples whatever the page puts
       under it. Measured across the whole page at 1440px, the darkest thing the
       backdrop reaches is L 0.006 (a journal card), 0.023 (the navy contact
       block), 0.077 (a demo card's CTA). Two things it is NOT, both settled by
       measurement rather than reasoning: the decoration field (moving it out from
       under the bar changed the sample by one point) and the shadow plate (hiding
       it, also one point).

       An ADAPTIVE bar was measured before settling here — find the page's dark
       blocks by computed background, flip the bar over them, stay glassy
       elsewhere. It does not help. 14 of 32 scroll positions sit over a dark
       block, so the bar would spend the page flipping; and even with every one of
       them excluded, the worst LIGHT backdrop at 70% tint is L 0.54, where the
       previous ink reached only 4.73:1. A translucent paper bar over any content
       lands near L 0.5–0.6, and a light grey needs L ≥ 0.82. The fill has to
       carry it.

       ### What each tint buys

       Darkest composite over the whole page, and the lightest ink that clears
       4.5:1 against it:

         62%  L 0.37   near-black only
         78%  L 0.60   #4b4b48  5.75:1     ← the previous pass
         90%  L 0.69   #5a5a55  4.85:1     ← here
         94%  L 0.71   #5a5a55  5.04:1

       `--color-muted` (#6b6b66) never clears it — 3.89:1 even at 94%. That is
       this bar's floor, and it is why "just use muted" is not available.

       ### The cost, stated plainly

       90% is not glass. The scrolled pill is effectively opaque, and that is the
       price of a light navigation, asked for twice. The DOCKED bar is untouched:
       fully transparent with only the blur, over the hero, which is where the
       effect reads anyway. */
    --tds-header-tint: 90%;

    /* The chrome's ink, per state.

       DOCKED the bar has no fill at all — only the blur — so the links sit
       directly on the hero photograph and need the full ink. That is the same
       reason `LanguageSwitch.astro` reached for `--color-black`.

       SCROLLED there is a 90% paper fill under them, so the ink comes up: 68% of
       the way from paper to ink, which resolves to (89,89,86) ≈ #5a5a55 and
       measures 4.85:1 against the darkest composite on the page. That is the
       lightest grey this bar can carry — see the tint note above for why
       `--color-muted` is not reachable at any opacity.

       The percentage was MEASURED, not derived: `color-mix(in oklab, …)` is not
       linear in sRGB, and 68% lands where a linear 71% would. Anything computed
       on paper here would be a few points off.

       `color-mix` and not a hex, so it follows the theme: in dark mode ink is
       #ebe9e1 and paper is #070a14, and the same expression lands on a light
       mid-tone on a dark bar. `npm run audit:contrast` measures both. */
    --lp-nav-ink: var(--color-ink);
    /* Fully round in EVERY state, not just once the desktop bar has
       scrolled — "komplett rund und nicht nur runde Ecken". The radius is
       the shared pill token rather than a hand-written literal (it used to
       be 24px here and 22px docked), which is also what keeps the three
       states from drifting apart again. */
    border-radius: var(--tds-radius-pill);
    /* THE FILL IS A VALUE NOW, NOT A DECLARATION (2026-09-29).

       Every state below sets `--tds-header-fill` and `::before` paints it. The
       element's own background stays transparent, and that is what lets the
       shadow plate get BEHIND the glass — see the long note at `::after`.

       It also collapses the duplication the comment above complains about: the
       nine places that used to declare `background-color` now set one value. */
    --tds-header-fill: color-mix(in srgb, var(--color-paper) var(--tds-header-tint), transparent);
    background-color: transparent;
    /* No rim. The fill alone separates the bar from the page — the warm
       hairline (and before it the white glass highlight) is exactly the
       kind of 1px box the borderless pass removes. It was an INSET
       box-shadow, not a border, so it survived every `border` search;
       whatever replaces it must be judged in a browser, not in a grep. */
  }

  /* The glass. Own layer so the plate can sit under it.

     Only the unprefixed `backdrop-filter` is authored — lightningcss adds the
     `-webkit-` prefix at build time per the configured cssTarget. Hand-writing
     both makes lightningcss collapse them to `-webkit-` only, which drops the
     blur in Firefox. See astro.config.mjs.

     The blur carries the bar on its own: with a 62% tint it is the difference
     between "frosted" and "you can read the hero straight through the nav".
     Removing it does not merely soften the look, it breaks legibility — a
     browser without backdrop-filter gets the tint alone, which is why the tint
     is not lower still.

     `z-index: 0` and not `auto`: it has to be a positioned box with a stacking
     level, so the nav above it (level 1) and the plate below it (level -1) sort
     around it predictably. */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background-color: var(--tds-header-fill);
    backdrop-filter: blur(22px) saturate(150%);
    transition: background-color 250ms ease;
  }

  /* LIGHT MODE ONLY, and the `:not()` is the whole point.

     "Richtung Papier" is a different direction in each theme: in light mode paper
     is #fafaf7 and a lower ink share lightens the text, in dark mode paper is
     #070a14 and the same number DARKENS it. Applied to both, 68% gave 5.46:1
     light and 3.92:1 dark — a failure introduced by lightening the other theme by
     accident.

     Dark mode needs no lightening at all: the complaint was about light mode, and
     the full `--color-ink` (#ebe9e1) measures 10.48:1 on the dark bar. So it
     keeps the base value and only light mode comes up. */
  :root:not([data-theme="dark"]) .site-header[data-scrolled="true"] {
    --lp-nav-ink: color-mix(in oklab, var(--color-ink) 68%, var(--color-paper));
  }

  /* The content, above both layers. */
  .site-header > nav {
    position: relative;
    z-index: 1;
  }

  /* One weight for the whole bar. The theme toggle ships as `--color-muted`
     from tds-shared, which is right on a panel's opaque top bar and is 2.13:1
     here — under the 3:1 that WCAG 1.4.11 asks of an icon, let alone text. The
     language switch went the other way and used `--color-black`, a shade darker
     than the links beside it. Both now read the same token as everything else,
     so the bar stops being three inks in a row. */
  .site-header :global(.tds-theme-toggle) {
    color: var(--lp-nav-ink);
  }

  /* === The shadow, as a plate that clicks in ==========================

     Asked for 2026-09-29: the shadow should travel in and out as the bar
     docks, "als würde die Navigationsleiste reinklicken", instead of
     switching on and off between the two states.

     A `box-shadow` cannot do that. It is PAINTED, not composited, so
     animating it repaints the bar every frame — and this repo's own rule
     ("never transition a box-shadow") exists because of it. What can move is
     a plate: a copy of the bar's own shape sitting behind it, offset
     down-right, moving on `translate` and `opacity`, both of which the
     compositor handles without a single repaint.

     ### Why the fill had to move to `::before` for this to work

     `z-index: -1` does NOT put a child behind its parent's background when the
     parent forms a stacking context — and this one does twice over (`position:
     fixed` with a `z-index`, plus `backdrop-filter`). Inside a stacking context
     the parent's own background and borders paint FIRST, then negative-z
     children, then everything else. So a plate at -1 under a filled bar paints
     ON TOP of that fill: a navy pill offset 3px, under the nav links, over the
     glass. Which is what this did in its first draft.

     The fix is to give the element no background of its own and paint the glass
     on `::before` (level 0) instead. Then the order inside the bar is: nothing →
     plate (-1) → glass (0) → nav (1), which is the order a shadow needs.

     A side effect worth keeping: `::before` blurs its own backdrop, and the
     plate is part of that backdrop now. So the shadow is blurred exactly where
     the bar overlaps it and sharp where it sticks out past the edge — which is
     the "Schatten-Tinte soll auch Blur haben" half of the same request.

     `border-radius: inherit` keeps it the same pill in all three states; the
     radius is a token, so there is nothing to keep in step by hand. The ink is
     `--tds-shadow-ink`, which the dark theme redefines (tds-shared base.css)
     and `global.css` makes translucent on this surface — so the dark bar and the
     see-through shadow both come for free, which is what six hand-written
     `box-shadow` declarations used to do between them. */
  .site-header::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--tds-shadow-ink);
    /* The hard shadow's small offset, as a number rather than the token: the
       token is a whole `box-shadow` value and cannot be split. 3px is
       `--tds-shadow-hard-sm` on the marketing surface. */
    translate: 3px 3px;
    transition:
      translate 320ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 200ms var(--tds-ease-out);
  }
  /* Docked: the plate slides INTO the bar and goes. Same 320ms as the
     `max-width`/`top` morph below, so the bar shrinking and the shadow
     retracting are one movement. */
  .site-header[data-scrolled="false"]::after {
    translate: 0 0;
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header::after {
      transition: none;
    }
  }

  /* No `box-shadow` on the bar in any state since 2026-09-29 — the plate above
     carries it, and it reads `--tds-shadow-ink`, which the dark theme redefines
     for itself. Four hand-written declarations used to do that between them. */

  /* Dark mode — same glass, a slightly denser tint. There is no rim to
     help here (the borderless pass removed it), and white-on-dark type
     over a bright photo scrolling underneath is the harder of the two
     directions, so dark runs a few points above light rather than at the
     same value. Do not lower it without looking at the scrolled bar over
     the dark hero. */
  :global(:root[data-theme="dark"]) .site-header {
    --tds-header-tint: 68%;
    --tds-header-fill: color-mix(in srgb, var(--color-card) var(--tds-header-tint), transparent);
  }
  :global(:root[data-theme="dark"]) .site-header[data-scrolled="true"] {
    --tds-header-fill: color-mix(in srgb, var(--color-card) var(--tds-header-tint), transparent);
  }

  /* Mobile + tablet, docked at the very top of the hero: dissolve the bar
     into the background exactly like the desktop dock — transparent fill,
     no shadow, only the frosted blur reads. Once the visitor scrolls, the
     bar settles back into the filled floating pill (the base
     `.site-header` styling above). */
  @media (max-width: 1023px) {
    .site-header[data-scrolled="false"] {
      --tds-header-fill: transparent;
    }
    :global(:root[data-theme="dark"]) .site-header[data-scrolled="false"] {
      --tds-header-fill: transparent;
    }
  }

  @media (min-width: 1024px) {
    /* Docked at the very top: in dark mode the bar must dissolve into the
       hero exactly like light mode — fully transparent fill, so only the
       heavy frosted blur reads. (An earlier rule gave it a card-tinted fill
       at every scroll state, leaving a visible navy panel at the top of the
       hero.) Only the scrolled pill is filled — and since the dark base
       fill above is now dense enough to replace the rim, this override is
       what keeps the docked bar from inheriting it. */
    :global(:root[data-theme="dark"]) .site-header[data-scrolled="false"] {
      --tds-header-fill: transparent;
    }
    :global(:root[data-theme="dark"]) .site-header[data-scrolled="true"] {
      --tds-header-fill: color-mix(in srgb, var(--color-card) var(--tds-header-tint), transparent);
    }
  }

  /* Desktop ( >=lg / 1024px ) — the bar morphs between two states as
     the user scrolls. The header spans the full viewport (left/right 0)
     and `margin-inline: auto` keeps it centred once it is constrained by
     max-width, so the same element can animate from an edge-to-edge dock
     to a compact centred pill purely by tweening max-width + top. The
     radius no longer tweens: both states are the full pill now, so there
     is nothing left to interpolate between.

     At the top of the page (data-scrolled="false") it is DOCKED: flush
     against the top edge, full-bleed and fully transparent, so only the
     heavy frosted blur reads. The blur stays very strong in both states. */
  @media (min-width: 1024px) {
    .site-header {
      left: 0;
      right: 0;
      transform: none;
      margin-inline: auto;

      top: 0.75rem;
      max-width: 100%;
      --tds-header-fill: transparent;
      /* Only the geometry transitions on the element now. The fill fades on
         `::before`, which owns it, and leaving `background-color` listed here
         would name a property this element no longer changes. */
      transition:
        max-width 320ms cubic-bezier(0.4, 0, 0.2, 1),
        top 320ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    /* A heavier blur on the desktop bar — on `::before`, or it would be applied
       twice: once by the layer that paints the glass and once by the element
       behind it. */
    .site-header::before {
      backdrop-filter: blur(24px) saturate(150%);
    }

    /* Scrolled away from the top — the bar lifts off the edge and shrinks
       into a compact floating capsule of FROSTED GLASS: a light tint over
       a heavy blur, so the page reads through it, plus the SUGGESTION of a
       shadow and no rim at all. This state used to be a near-opaque warm
       white; it is the one the visitor spends the whole page inside, which
       is why the translucency is spent here rather than on the dock.

       The shadow is not declared here any more (2026-09-29) — the plate at
       `.site-header::after` carries it in every state, keyed on
       `[data-scrolled]` alone, so it retracts into the bar as it docks instead
       of switching off. What has NOT changed is how much work it is doing: the
       old `0 18px 50px -24px rgba(5,15,104,.45)` was a 50px navy plume that
       read as grey haze on the warm ground, and the hard offset that replaced
       it is most of what separates this translucent capsule from the content
       sliding under it. Do not take the plate away along with the opacity. */
    .site-header[data-scrolled="true"] {
      top: 1rem;
      max-width: 56rem;
      --tds-header-fill: color-mix(in srgb, var(--color-paper) var(--tds-header-tint), transparent);
    }
  }

  /* SHORT viewports — a landscape phone, or a desktop window zoomed to 400 %
     (1280×1024 → 320×256 CSS px). There a fixed bar is a permanent quarter of
     the screen: measured on the live site, header + cookie notice + floating
     button covered 94 % of a 320×256 viewport. The bar scrolls away with the
     page instead (WCAG 1.4.10). The menu toggle is still the first thing on
     the page, which is where a reader who zoomed that far starts anyway. */
  @media (max-height: 30rem) {
    .site-header {
      position: absolute;
    }
  }

  /* The animated hamburger ↔ × bars are `.tds-menu-bar*` from
     tds-shared primitives.css — the blog header carried the same block.
     The 2px bar radius comes from `--tds-radius-bar` (the marketing
     surface default), and the shared block also brings the
     prefers-reduced-motion rule this copy never had. */

  /* The mobile menu panel is `.tds-mobile-menu` (tds-shared) as of 0.25.0.
     This file used to own its geometry, its fade and its reduced-motion
     rule; the blog and the tools site now render the same sheet, so the
     copy that lived here was the thing keeping them apart. Its two
     literal `200ms ease` transitions are `--tds-dur-base`/`--tds-ease-out`
     in the shared block, which is also what the library's own test
     demands. Only the docking offset stayed behind, on the element. */

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  // NOT `is:inline` — an inline script is not bundled, so this import would
  // reach the browser as a bare specifier.
  import { mountMobileNav } from "@tracht-digital-solutions/tds-shared/nav";

  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  if (header) {
    const THRESHOLD = 8;
    let scrolled: boolean | null = null;
    const updateScroll = () => {
      const next = window.scrollY > THRESHOLD;
      if (next === scrolled) return;
      scrolled = next;
      header.dataset.scrolled = next ? "true" : "false";
    };
    updateScroll();
    window.addEventListener("scroll", updateScroll, { passive: true });
  }

  // The open/close mechanics are shared (tds-shared 0.25.0). This file used
  // to own ~35 lines of them and was the reference the blog and the tools
  // site were measured against — which is exactly why it had to move rather
  // than be copied twice more. The shared version also brings the two things
  // this copy never had: focus moves into the panel on open, and Escape
  // hands it back to the hamburger.
  if (toggle && menu) {
    mountMobileNav({ toggle, panel: menu });
  }

  // Logo: when we're already on the page it links to (the homepage in
  // either locale), don't reload — just smooth-scroll back up to the
  // hero. On any other page it stays a normal link home. Compares the
  // link's own pathname to the current one (trailing slash normalised)
  // so it works for both `/` and `/en/`.
  const logo = document.getElementById("logo-link") as HTMLAnchorElement | null;
  if (logo) {
    const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
    logo.addEventListener("click", (event) => {
      if (normalize(new URL(logo.href).pathname) !== normalize(location.pathname)) {
        return;
      }
      event.preventDefault();
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const bounceScroll = (window as unknown as {
        tdsScrollTo?: (target: number, opts?: { immediate?: boolean }) => void;
      }).tdsScrollTo;
      if (bounceScroll) {
        bounceScroll(0, { immediate: reduce });
      } else {
        window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      }
    });
  }
</script>
