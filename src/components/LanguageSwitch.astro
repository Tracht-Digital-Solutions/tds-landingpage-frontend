---
/**
 * The DE|EN switch in the header: ONE link to this very page in the other
 * language — or nothing, when that page does not exist.
 *
 * What it replaced, so nobody restores it: a React dropdown (`LanguageToggle`)
 * whose menu was `role="listbox"` with buttons inside `role="option"` (an
 * invalid pattern), behind a 52×26px trigger, that found its target by reading
 * the head's alternates or by gluing `/en` onto the path — see
 * `lib/languageSwitch.ts` for the 404 that fallback produced.
 *
 * Server-rendered: no island, no hydration, and it works before JavaScript
 * arrives. The visible text is the language code; the accessible name repeats
 * it ("EN – English version"), so voice control can target what it sees
 * (WCAG 2.5.3). `lang` on the link makes the name pronounced in its own
 * language.
 */
import { resolveLang, type Lang } from "~/lib/i18n";
import { alternatePath } from "~/lib/languageSwitch";

const lang = resolveLang(Astro.currentLocale);
const target: Lang = lang === "de" ? "en" : "de";
const href = alternatePath(Astro.url.pathname, target);
const label =
  target === "en"
    ? { code: "EN", name: "English version" }
    : { code: "DE", name: "Deutsche Version" };
---

{
  href && (
    <a href={href} hreflang={target} lang={target} class="lang-switch" data-lang-switch>
      <span class="lang-switch__flag" aria-hidden="true">
        {target === "en" ? (
          <svg viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice" focusable="false">
            <clipPath id="lang-switch-gb-clip">
              <path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" />
            </clipPath>
            <path d="M0,0 v30 h60 v-30 z" fill="#012169" />
            <path d="M0,0 L60,30 M60,0 L0,30" stroke="#ffffff" stroke-width="6" />
            <path
              d="M0,0 L60,30 M60,0 L0,30"
              clip-path="url(#lang-switch-gb-clip)"
              stroke="#C8102E"
              stroke-width="4"
            />
            <path d="M30,0 v30 M0,15 h60" stroke="#ffffff" stroke-width="10" />
            <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
          </svg>
        ) : (
          <svg viewBox="0 0 5 3" preserveAspectRatio="xMidYMid slice" focusable="false">
            <rect width="5" height="1" y="0" fill="#000000" />
            <rect width="5" height="1" y="1" fill="#DD0000" />
            <rect width="5" height="1" y="2" fill="#FFCE00" />
          </svg>
        )}
      </span>
      <span>{label.code}</span><span class="sr-only"> – {label.name}</span>
    </a>
  )
}

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 2.25rem;
    min-height: 2.25rem;
    padding-inline: 0.625rem;
    border-radius: var(--tds-radius-pill, 100px);
    /* Ink, not muted: the docked header is transparent over the hero photo,
       and a 13px muted label over a photograph is where contrast gets lost. */
    color: var(--color-black);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      color var(--tds-dur-fast) var(--tds-ease-out),
      background-color var(--tds-dur-fast) var(--tds-ease-out);
  }
  .lang-switch:hover {
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-black) 6%, transparent);
  }
  .lang-switch__flag {
    display: block;
    flex: none;
    width: 1.25rem;
    height: 0.875rem;
    overflow: hidden;
    border-radius: 2px;
  }
  .lang-switch__flag svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* The trigger this replaced was 26px tall. On a finger it is a full target. */
  @media (pointer: coarse) {
    .lang-switch {
      min-width: 2.75rem;
      min-height: 2.75rem;
    }
  }
</style>

<script>
  // Keep the visitor's place across the switch: `/#preise` → `/en/#preise`.
  // The page is server-rendered and cached, so the hash is only known here.
  for (const link of document.querySelectorAll<HTMLAnchorElement>("a[data-lang-switch]")) {
    link.addEventListener("click", () => {
      if (location.hash) link.hash = location.hash;
    });
  }
</script>
