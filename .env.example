# tds-landingpage — local dev environment
#
# Copy to `.env` (gitignored) before `npm run dev` or `npm run build`.
# Astro inlines anything prefixed with `PUBLIC_` into the client bundle at
# build time. Anything without the prefix stays server-only.
#
# The defaults below are the production URLs, so an empty `.env` is enough for
# read-only development against live content. Point them at
# `http://localhost:<port>` to work against a local API — `:8080` is the
# gateway in tds-gateway-api's Docker stack, `:8000` the one from
# `composer start`.

# ContactForm POSTs JSON here. Wired in src/components/islands/ContactForm.tsx.
PUBLIC_CONTACT_API_URL=https://api.tracht-digital.de/contact

# API base for CMS blocks, journal teasers and legal documents. The `/content`
# routes are served by tds-core-frontend-api, the composed frontend API that is
# the gateway's default catch-all. (They used to come from a separate
# `tds-content-api`; that backend is archived — see MIGRATION-STATUS.md.)
# This value doubles as the fallback API origin for the runtime connection:
# `src/lib/connection.ts` strips the trailing `/content` off it.
PUBLIC_CONTENT_API_URL=https://api.tracht-digital.de/content

# BlogPostCard links to "${PUBLIC_BLOG_BASE_URL}/${slug}" for each teaser.
# Same domain serves the blog at blog.tracht-digital.de in prod.
PUBLIC_BLOG_BASE_URL=https://blog.tracht-digital.de

# Demo-Modus. Mit `true` zeigt die Startseite die statischen Demo-Themen
# (topicFallback) statt live von der API zu lesen — ideal für eine Auslieferung
# ohne Backend. Ohne das Flag fällt die Seite ohnehin automatisch auf diese
# Themen zurück, wenn keine API erreichbar ist.
PUBLIC_DEMO_MODE=false

# --- shell-only (NOT in .env) ---
# NPM_TOKEN is consumed by .npmrc to authenticate against GitHub Packages
# for `@tracht-digital-solutions/tds-shared`. Set it as an env var in your
# shell, not in this file (npm doesn't auto-load .env).
#
# PowerShell (current session):
#   $env:NPM_TOKEN = "ghp_…"
# PowerShell (persistent for the user):
#   [System.Environment]::SetEnvironmentVariable("NPM_TOKEN", "ghp_…", "User")
# bash / zsh:
#   export NPM_TOKEN=ghp_…

# Site key — the credential this site presents to the API for its content
# reads. Issued in the admin portal under Einstellungen → Site-Verbindungen and
# shown there only once.
#
# Optional. Unset, the site behaves exactly as before and the public read
# routes stay open unless an admin switched enforcement on. Set, a rejected key
# is deliberately NOT cached, so a credential problem cannot become a
# long-lived page of baked-in fallbacks.
#
# Deliberately NOT PUBLIC_-prefixed: a PUBLIC_ variable is inlined into the
# shipped bundle, which would publish the credential. It is read via
# process.env (Node), never import.meta.env — Astro/Vite inline only PUBLIC_
# names there, so import.meta.env.TDS_SITE_KEY would be undefined in every
# build, silently. In CI it comes from secrets.TDS_SITE_KEY.
TDS_SITE_KEY=

# Token for this site's own cache control plane (`/tds/cache/{status,rebuild,
# purge}`), which the admin panel calls after a CMS save. Must match the token
# entered in the panel. Unset → the control plane answers 503 and does nothing;
# the site still works, it just re-renders on every request. Server-only, for
# the same reason as TDS_SITE_KEY.
TDS_CACHE_TOKEN=

# --- Local note: no pairing over http ---
# The `/install` wizard pairs a DEPLOYED site with the API and stores the
# credentials outside the checkout. It cannot be used on localhost: the
# connection store accepts only `https:` origins when it writes
# (tds-shared/connection), so a local attempt gets as far as saving and then
# fails with `state_write_failed` (500). Locally the two variables above ARE
# the connection.
