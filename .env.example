# tds-landingpage — local dev environment
#
# Copy to `.env` (gitignored) before `npm run dev` or `npm run build`.
# Astro inlines anything prefixed with `PUBLIC_` into the client bundle
# at build time. Anything without the prefix stays server-only.
#
# The defaults below are the production URLs — fine for local dev when
# you want to read live blog teasers from tds-content-api etc. Point at
# `http://localhost:<port>` if you're running an API locally.

# ContactForm POSTs JSON here. Wired in src/components/islands/ContactForm.tsx.
PUBLIC_CONTACT_API_URL=https://api.tracht-digital.de/contact

# Journal.astro build-time fetches the 3 most recent posts from this URL.
# Failure falls back to the static teaser copy in tds-shared translations.
PUBLIC_CONTENT_API_URL=https://api.tracht-digital.de/content

# BlogPostCard links to "${PUBLIC_BLOG_BASE_URL}/${slug}" for each teaser.
# Same domain serves the static blog at blog.tracht-digital.de in prod.
PUBLIC_BLOG_BASE_URL=https://blog.tracht-digital.de

# Demo-Modus. Mit `true` zeigt die Startseite die statischen Demo-Themen
# (topicFallback) statt live von der Content-API zu lesen — ideal für eine
# Auslieferung ohne Backend. Ohne das Flag fällt die Seite ohnehin
# automatisch auf diese Themen zurück, wenn keine API erreichbar ist.
PUBLIC_DEMO_MODE=false

# --- shell-only (NOT in .env) ---
# NPM_TOKEN is consumed by .npmrc to authenticate against GitHub Packages
# for `@tracht-digital-solutions/tds-shared`. Set it as an env var in your
# shell, not in this file (npm doesn't auto-load .env).
#
# PowerShell (current session):
#   $env:NPM_TOKEN = "ghp_…"
# PowerShell (persistent for the user):
#   [System.Environment]::SetEnvironmentVariable("NPM_TOKEN", "ghp_…", "User")
# bash / zsh:
#   export NPM_TOKEN=ghp_…
