{
  "name": "tds-landingpage-frontend",
  "version": "0.27.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/pack-release.mjs",
    "preview": "astro preview",
    "start": "node app.cjs",
    "type-check": "astro check",
    "og:smoke": "tsx scripts/og-smoke.ts",
    "demos:sync": "tsx scripts/demos-sync.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "references:sync": "tsx scripts/references-sync.ts",
    "businesscard:sync": "tsx scripts/business-card-sync.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.4",
    "@astrojs/react": "^6.0.4",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource/lato": "^5.2.7",
    "@hookform/resolvers": "5.9.1",
    "@tailwindcss/postcss": "~4.3.3",
    "@tracht-digital-solutions/tds-shared": "^0.34.0",
    "astro": "^7.2.6",
    "lenis": "^1.3.26",
    "marked": "^18.0.11",
    "motion": "13.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.75.0",
    "tailwindcss": "~4.3.3",
    "typescript": "^6.0.3",
    "zod": "^4.0.0"
  },
  "tds": {
    "notes": {
      "release": "What scripts/pack-release.mjs assembles for the production host. runtimeDependencies must stay PUBLIC-REGISTRY ONLY: the host has no GitHub Packages token, and everything first-party is bundled into server/ by vite.ssr.noExternal instead. sharp is here because it is a native addon and Rollup cannot bundle one; react/react-dom because @astrojs/react externalises them for island SSR.",
      "devDependencies": "satori + @resvg/resvg-js render the OG card. Every OG route is prerendered, so they run during `astro build` and never enter the server bundle — which is what keeps a native addon out of the production runtime on the host."
    },
    "release": {
      "name": "tds-landingpage-release",
      "extraFiles": [
        {
          "from": "src/assets/legal",
          "to": "assets/legal"
        }
      ],
      "runtimeDependencies": {
        "@astrojs/node": "^11.1.4",
        "astro": "^7.2.6",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "sharp": "^0.35.0"
      }
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^30.0.1",
    "qrcode": "1.5.4",
    "playwright-core": "^1.62.1",
    "satori": "^0.33.4",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  }
}
